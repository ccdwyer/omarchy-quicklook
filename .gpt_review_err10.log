   130	    path.is_file()
   131	}
   132	
   133	/// Serialize tests that mutate process-wide `PATH`. Restores PATH on unwind.
   134	pub fn with_path_lock<R, F: FnOnce() -> R>(f: F) -> R {
   135	    static LOCK: Mutex<()> = Mutex::new(());
   136	    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
   137	    let old = std::env::var("PATH").unwrap_or_default();
   138	    struct Restore(String);
   139	    impl Drop for Restore {
   140	        fn drop(&mut self) {
   141	            std::env::set_var("PATH", &self.0);
   142	        }
   143	    }
   144	    let _restore = Restore(old);
   145	    f()
   146	}
