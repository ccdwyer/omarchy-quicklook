   296	def find_names(q: str, limit: int) -> list[dict]:
   297	    roots = [r for r in SETTINGS["roots"] if r]
   298	    if not roots:
   299	        roots = [str(HOME)]
   300	    cap = min(int(limit), 40)
   301	    q = "".join(ch for ch in q if ch.isalnum() or ch in "._-")
   302	    if not q:
   303	        return []
   304	    located = plocate_names(q, cap)
   305	    if located:
   306	        return located
   307	    if shutil.which("find") is None:
   308	        return []
   309	    skip = skip_parts()
   310	    prune: list[str] = []
   311	    for name in skip:
   312	        if prune:
   313	            prune.append("-o")
   314	        prune.extend(["-name", name])
   315	    if prune:
   316	        prune.extend(["-o", "-name", ".*"])
   317	    else:
   318	        prune.extend(["-name", ".*"])
   319	    cmd = ["find", *roots, "-mindepth", "1"]
   320	    cmd.extend(["(", *prune, ")", "-prune", "-o", "-iname", f"*{q}*", "-print"])
   321	    try:
   322	        proc = run_killable(cmd, timeout_s=2, capture_output=True, text=True)
   323	    except (subprocess.TimeoutExpired, OSError):
   324	        return []
   325	    return _hits_from_paths(proc.stdout.splitlines(), q, cap)
