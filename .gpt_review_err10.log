   113	    let pattern = Pattern::parse(query, CaseMatching::Smart, Normalization::Smart);
   114	    let mut path_buf = Vec::new();
   115	    let mut name_buf = Vec::new();
   116	    let mut scored: Vec<(i64, &IndexedFile)> = Vec::new();
   117	    for f in files {
   118	        let mut score = 0i64;
   119	        if let Some(s) = pattern.score(Utf32Str::new(&f.path, &mut path_buf), &mut matcher) {
   120	            score = s as i64;
   121	        }
   122	        if let Some(s) = pattern.score(Utf32Str::new(&f.name, &mut name_buf), &mut matcher) {
   123	            score = score.max(s as i64 + 40);
