    77	        opacity: 0.6
    78	        font.family: root.fontFamily
    79	        font.pixelSize: Style.font.body
    80	        wrapMode: Text.WordWrap
    81	        horizontalAlignment: Text.AlignHCenter
    82	      }
    83	    }
    84	
    85	    // image / pdf raster / video poster
    86	    Item {
    87	      anchors.fill: parent
    88	      visible: (root.kind === "image" || root.pdfRaster) && !root.loading
    89	
    90	      Canvas {
    91	        id: checker
    92	        anchors.fill: parent
    93	        visible: root.kind === "image"
    94	        onPaint: {
    95	          var ctx = getContext("2d")
    96	          var s = 14
    97	          var a = root.palette.checkerA || "#2a2a2a"
    98	          var b = root.palette.checkerB || "#3a3a3a"
    99	          for (var y = 0; y < height; y += s) {
   100	            for (var x = 0; x < width; x += s) {
   101	              ctx.fillStyle = ((x / s + y / s) % 2 === 0) ? a : b
   102	              ctx.fillRect(x, y, s, s)
