   251	        try:
   252	            st = p.stat()
   253	        except OSError:
   254	            continue
   255	        out.append(
   256	            {
   257	                "path": str(p),
   258	                "name": p.name,
   259	                "kind": kind_of(p, p.is_dir()),
   260	                "score": fuzzy(p.name, q),
   261	                "mtime": int(st.st_mtime * 1000),
   262	                "size": st.st_size,
   263	            }
   264	        )
   265	        if len(out) >= cap:
   266	            break
   267	    return out
