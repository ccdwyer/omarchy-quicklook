   206	def fuzzy(hay: str, needle: str) -> int:
   207	    h = hay.lower()
   208	    n = needle.lower()
   209	    if not n:
   210	        return 1
   211	    if n in h:
   212	        return 800 - h.find(n)
   213	    hi = 0
   214	    score = 0
   215	    for ch in n:
   216	        pos = h.find(ch, hi)
   217	        if pos < 0:
   218	            return 0
   219	        score += 8
   220	        hi = pos + 1
   221	    return score
