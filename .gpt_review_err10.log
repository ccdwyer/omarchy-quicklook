   748	def preview(path_s: str, page: int = 1) -> dict:
   749	    path = Path(path_s)
   750	    if not path.exists():
   751	        return {"kind": "hex", "magic": "missing", "label": "can't render this — hex view"}
   752	    if path.is_dir():
   753	        entries = []
   754	        total = 0
   755	        try:
   756	            kids = []
   757	            for i, kid in enumerate(path.iterdir()):
   758	                if i >= 200:
   759	                    break
   760	                kids.append(kid)
   761	            kids.sort(key=lambda p: p.name)
   762	        except OSError:
   763	            kids = []
   764	        for kid in kids:
   765	            try:
   766	                st = kid.stat()
   767	                total += st.st_size if kid.is_file() else 0
   768	                entries.append({"name": kid.name, "kind": kind_of(kid, kid.is_dir()), "size": st.st_size})
   769	            except OSError:
   770	                continue
   771	        return {"kind": "dir", "entries": entries, "total_size": total, "path": str(path)}
   772	    k = kind_of(path)
   773	    if k == "image":
   774	        return preview_image(path)
   775	    if k == "code":
   776	        data = read_capped(path, 200 * 1024)
   777	        try:
   778	            large = path.stat().st_size > 200 * 1024
   779	        except OSError:
   780	            large = False
   781	        text = data.decode("utf-8", errors="replace")
   782	        html = "<pre>" + (
   783	            text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
   784	        ) + "</pre>"
   785	        return {"kind": "code", "html": html, "lang": path.suffix.lstrip("."), "large": large,
   786	                "capped": large, "label": "large file" if large else "", "path": str(path)}
   787	    if k == "csv":
   788	        text = read_capped(path, 1024 * 1024).decode("utf-8", errors="replace")
   789	        first = text.split("\n", 1)[0]
   790	        delim = ","
   791	        if first.count("\t") > first.count(","):
   792	            delim = "\t"
   793	        elif first.count(";") > first.count(","):
   794	            delim = ";"
   795	        elif first.count("|") > first.count(","):
   796	            delim = "|"
   797	        lines = text.splitlines()
   798	        rows = [ln.split(delim) for ln in lines[:501]]
   799	        headers = rows[0] if rows else []
   800	        body = rows[1:501] if rows else []
   801	        try:
   802	            oversized = path.stat().st_size > 1024 * 1024
   803	        except OSError:
   804	            oversized = False
   805	        return {
   806	            "kind": "csv",
   807	            "headers": headers,
   808	            "rows": body,
   809	            "truncated": len(lines) > 501 or oversized,
   810	        }
   811	    if k == "pdf":
   812	        return preview_pdf(path, page)
   813	    return hex_preview(path, "data", "can't render this — hex view")
   814	
   815	
   816	def open_path(path_s: str, reveal: bool = False) -> dict:
   817	    path = Path(path_s)
   818	    if not path.exists():
   819	        return {"ok": False, "error": "missing"}
   820	    target = path if not reveal else (path if path.is_dir() else path.parent)
   821	    opener = shutil.which("gio")
   822	    args = ["open", str(target)] if opener else None
   823	    if opener is None:
   824	        opener = shutil.which("xdg-open") or shutil.which("open")
   825	        args = [str(target)]
   826	    if opener is None:
   827	        return {"ok": False, "error": "no opener"}
   828	    try:
   829	        run_killable([opener, *args], timeout_s=8, limits=False)
   830	    except (subprocess.TimeoutExpired, OSError):
   831	        return {"ok": False, "error": "opener timeout"}
   832	    return {"ok": True}
   833	
   834	
   835	def status() -> dict:
   836	    return {
   837	        "indexing": False,
   838	        "progress": 1.0,
   839	        "backend": "compat",
   840	        "files": 5,
   841	        "watchCount": 0,
   842	        "watchCap": SETTINGS["watchCap"],
   843	        "roots": list(SETTINGS["roots"]),
   844	        "cacheBytes": 0,
   845	        "cacheBudget": SETTINGS["cacheMb"] * 1024 * 1024,
   846	        "poppler": shutil.which("pdftoppm") is not None,
   847	        "plocate": shutil.which("plocate") is not None or shutil.which("locate") is not None,
   848	        "ffmpeg": shutil.which("ffmpeg") is not None,
   849	        "helper": "compat",
   850	        "version": "1.0.0",
   851	    }
   852	
   853	
   854	def handle(req: dict) -> dict:
   855	    rid = int(req.get("id") or 0)
   856	    cmd = req.get("cmd") or ("query" if "q" in req else "preview" if "path" in req else "status")
   857	    if cmd == "query":
   858	        hits, backend = search(str(req.get("q") or ""))
   859	        return {"id": rid, "kind": "results", "results": hits, "indexing": False, "progress": 1.0, "backend": backend}
   860	    if cmd in ("preview", "prefetch", "page"):
   861	        return {"id": rid, "kind": "preview", "preview": preview(str(req.get("path") or ""), int(req.get("page") or 1))}
   862	    if cmd == "open":
   863	        r = open_path(str(req.get("path") or ""), False)
   864	        return {"id": rid, "kind": "ok" if r.get("ok") else "error", "error": r.get("error")}
   865	    if cmd == "reveal":
   866	        r = open_path(str(req.get("path") or ""), True)
   867	        return {"id": rid, "kind": "ok" if r.get("ok") else "error", "error": r.get("error")}
   868	    if cmd == "config":
   869	        apply_settings(req, persist=True)
   870	        body = {"id": rid, "kind": "status", "status": status(), "indexing": False, "progress": 1.0, "backend": "compat"}
   871	        return body
   872	    if cmd in ("status", "capabilities", "warmup", "theme", "select"):
   873	        body = {"id": rid, "kind": "status" if cmd in ("status", "capabilities") else "ok"}
   874	        if body["kind"] == "status":
   875	            body["status"] = status()
   876	            body["indexing"] = False
   877	            body["progress"] = 1.0
   878	            body["backend"] = "compat"
   879	        return body
   880	    return {"id": rid, "kind": "error", "error": f"unknown cmd {cmd}"}
   881	
   882	
   883	def main() -> None:
   884	    oneshot = "--oneshot" in sys.argv
   885	    if oneshot:
   886	        payload = ""
   887	        if "--oneshot" in sys.argv:
   888	            i = sys.argv.index("--oneshot")
   889	            if i + 1 < len(sys.argv):
   890	                payload = sys.argv[i + 1]
   891	        if not payload:
   892	            payload = sys.stdin.readline()
   893	        try:
   894	            req = json.loads(payload)
   895	        except json.JSONDecodeError as e:
   896	            print(json.dumps({"id": 0, "kind": "error", "error": str(e)}), flush=True)
   897	            return
   898	        print(json.dumps(handle(req), ensure_ascii=False), flush=True)
   899	        return
   900	    for line in sys.stdin:
   901	        line = line.strip()
   902	        if not line:
   903	            continue
   904	        try:
   905	            req = json.loads(line)
   906	        except json.JSONDecodeError as e:
   907	            print(json.dumps({"id": 0, "kind": "error", "error": str(e)}), flush=True)
   908	            continue
   909	        print(json.dumps(handle(req), ensure_ascii=False), flush=True)
   910	
   911	
   912	if __name__ == "__main__":
   913	    main()
FILE compat/quicklookd.sh
     1	#!/bin/sh
     2	# Dependency-free fallback when bin/quicklookd is missing.
     3	# Prefers Python 3 (compat/quicklookd.py). Without Python this POSIX
     4	# responder still honors inline config, does a pruned bounded find, and
     5	# actually opens/reveals files.
     6	set -eu
     7	
     8	ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
     9	export QUICKLOOK_PLUGIN_DIR="${QUICKLOOK_PLUGIN_DIR:-$ROOT}"
    10	
    11	if [ "${QUICKLOOK_FORCE_SH:-}" != "1" ] && command -v python3 >/dev/null 2>&1; then
    12	  exec python3 "$ROOT/compat/quicklookd.py" "$@"
    13	fi
    14	
    15	# One watchdog for every path-consuming command: new process group, TERM the
    16	# group, grace, then UNCONDITIONAL KILL of the group. GNU timeout already
    17	# uses a new process group + --kill-after. The portable path needs setsid
    18	# (or python os.setsid). If neither isolation method exists, skip.
    19	TIMEOUT_BIN=""
    20	TIMEOUT_STYLE=""
    21	HAVE_SETSID=0
    22	SETSID_PY=0
    23	
    24	init_watchdog() {
    25	  if command -v timeout >/dev/null 2>&1; then
    26	    if timeout --kill-after=1s 1s true >/dev/null 2>&1; then
    27	      TIMEOUT_BIN=timeout
    28	      TIMEOUT_STYLE=gnu-long
    29	    elif timeout -k 1 1 true >/dev/null 2>&1; then
    30	      TIMEOUT_BIN=timeout
    31	      TIMEOUT_STYLE=gnu-short
    32	    fi
    33	  fi
    34	  if [ -z "$TIMEOUT_STYLE" ] && command -v gtimeout >/dev/null 2>&1; then
    35	    if gtimeout --kill-after=1s 1s true >/dev/null 2>&1; then
    36	      TIMEOUT_BIN=gtimeout
    37	      TIMEOUT_STYLE=gnu-long
    38	    fi
    39	  fi
    40	  if command -v setsid >/dev/null 2>&1; then
    41	    HAVE_SETSID=1
    42	  elif command -v python3 >/dev/null 2>&1; then
    43	    SETSID_PY=1
    44	  fi
    45	}
    46	
    47	init_watchdog
    48	
    49	watchdog_ok() {
    50	  # GNU timeout creates and kills a process group. Otherwise we need setsid.
    51	  if [ -n "$TIMEOUT_STYLE" ]; then
    52	    return 0
    53	  fi
    54	  [ "$HAVE_SETSID" = 1 ] || [ "$SETSID_PY" = 1 ]
    55	}
    56	
    57	spawn_group() {
    58	  if [ "$HAVE_SETSID" = 1 ]; then
    59	    setsid "$@" &
    60	    return
    61	  fi
    62	  python3 -c 'import os, sys
    63	os.setsid()
    64	os.execvp(sys.argv[1], sys.argv[1:])
    65	' "$@" &
    66	}
    67	
    68	# Portable: own process group, TERM the group, then KILL the group.
    69	portable_watchdog() {
    70	  secs=$1
    71	  shift
    72	  spawn_group "$@"
    73	  pid=$!
    74	  pgid=$pid
    75	  (
    76	    n=0
    77	    while [ "$n" -lt "$secs" ]; do
    78	      sleep 1
    79	      n=$((n + 1))
    80	      kill -0 "$pid" 2>/dev/null || exit 0
    81	    done
    82	    kill -TERM -"$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    83	    sleep 1
    84	    kill -KILL -"$pgid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    85	  ) &
    86	  killer=$!
    87	  st=0
    88	  wait "$pid" || st=$?
    89	  # Unconditional group KILL even if the leader already exited.
    90	  kill -KILL -"$pgid" 2>/dev/null || true
    91	  kill -KILL "$killer" 2>/dev/null || true
    92	  wait "$killer" 2>/dev/null || true
    93	  return $st
    94	}
    95	
    96	run_watchdog() {
    97	  secs=$1
    98	  shift
    99	  [ "$#" -ge 1 ] || return 1
   100	  watchdog_ok || return 124
   101	  case "$TIMEOUT_STYLE" in
   102	    gnu-long)
   103	      "$TIMEOUT_BIN" --kill-after=1s "${secs}s" "$@"
   104	      ;;
   105	    gnu-short)
   106	      "$TIMEOUT_BIN" -k 1 "$secs" "$@"
   107	      ;;
   108	    *)
   109	      portable_watchdog "$secs" "$@"
   110	      ;;
   111	  esac
   112	}
   113	
   114	HOME_DIR=${HOME:-/tmp}
   115	STATE_DIR="${XDG_STATE_HOME:-$HOME_DIR/.local/state}/quicklook"
   116	CONFIG_FILE="$STATE_DIR/compat-config.env"
   117	SAMP="$ROOT/samples"
   118	
   119	ROOTS="$HOME_DIR"
   120	EXTRA_EXCLUDE=""
   121	WATCH_CAP=2000
   122	CACHE_MB=500
   123	MAX_FILES=500000
   124	
   125	expand_tilde() {
   126	  case "$1" in
   127	    "~") printf '%s' "$HOME_DIR" ;;
   128	    ~/*) printf '%s' "$HOME_DIR/${1#~/}" ;;
   129	    *) printf '%s' "$1" ;;
   130	  esac
   131	}
   132	
   133	# Config is a tagged line file (never sourced / eval'd).
   134	#   R<TAB>absolute-root
   135	#   E<TAB>exclude-name
   136	#   W<TAB>watchCap
   137	#   C<TAB>cacheMb
   138	#   M<TAB>maxFiles
   139	load_config() {
   140	  ROOTS="$HOME_DIR"
   141	  EXTRA_EXCLUDE=""
   142	  WATCH_CAP=2000
   143	  CACHE_MB=500
   144	  MAX_FILES=500000
   145	  [ -f "$CONFIG_FILE" ] || return 0
   146	  loaded_roots=""
   147	  while IFS= read -r line || [ -n "$line" ]; do
   148	    tag=${line%%	*}
   149	    val=${line#*	}
   150	    case "$tag" in
   151	      R)
   152	        [ -n "$val" ] || continue
   153	        if [ -z "$loaded_roots" ]; then
   154	          loaded_roots=$val
   155	        else
   156	          loaded_roots="$loaded_roots|$val"
   157	        fi
   158	        ;;
   159	      E)
   160	        [ -n "$val" ] || continue
   161	        if [ -z "$EXTRA_EXCLUDE" ]; then
   162	          EXTRA_EXCLUDE=$val
   163	        else
   164	          EXTRA_EXCLUDE="$EXTRA_EXCLUDE|$val"
   165	        fi
   166	        ;;
   167	      W) WATCH_CAP=$val ;;
   168	      C) CACHE_MB=$val ;;
   169	      M) MAX_FILES=$val ;;
   170	    esac
   171	  done < "$CONFIG_FILE"
   172	  [ -n "$loaded_roots" ] && ROOTS=$loaded_roots
   173	}
   174	
   175	save_config() {
   176	  mkdir -p "$STATE_DIR"
   177	  : > "$CONFIG_FILE"
   178	  oldifs=$IFS
   179	  IFS='|'
   180	  for r in $ROOTS; do
   181	    [ -n "$r" ] || continue
   182	    printf 'R\t%s\n' "$r" >> "$CONFIG_FILE"
   183	  done
   184	  for e in $EXTRA_EXCLUDE; do
   185	    [ -n "$e" ] || continue
   186	    printf 'E\t%s\n' "$e" >> "$CONFIG_FILE"
   187	  done
   188	  IFS=$oldifs
   189	  printf 'W\t%s\n' "$WATCH_CAP" >> "$CONFIG_FILE"
   190	  printf 'C\t%s\n' "$CACHE_MB" >> "$CONFIG_FILE"
   191	  printf 'M\t%s\n' "$MAX_FILES" >> "$CONFIG_FILE"
   192	}
   193	
   194	json_escape() {
   195	  # JSON string contents: \, ", C0 controls (including newline).
   196	  printf '%s' "$1" | od -An -t u1 -v | awk '
   197	    BEGIN { ORS="" }
   198	    {
   199	      for (i = 1; i <= NF; i++) {
   200	        n = $i + 0
   201	        if (n == 92) printf "\\\\"
   202	        else if (n == 34) printf "\\\""
   203	        else if (n == 10) printf "\\n"
   204	        else if (n == 13) printf "\\r"
   205	        else if (n == 9) printf "\\t"
   206	        else if (n < 32) printf "\\u%04x", n
   207	        else printf "%c", n
   208	      }
   209	    }
   210	  '
   211	}
   212	
   213	extract_id() {
   214	  printf '%s' "$1" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p'
   215	}
   216	
   217	extract_string() {
   218	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"
   219	}
   220	
   221	extract_number() {
   222	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p"
   223	}
   224	
   225	extract_array_inner() {
   226	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\[\\([^]]*\\)\\].*/\\1/p"
   227	}
   228	
   229	quoted_to_pipe() {
   230	  printf '%s' "$1" | sed 's/"[[:space:]]*,[[:space:]]*"/|/g; s/^[[:space:]]*"//; s/"[[:space:]]*$//; s/"//g'
   231	}
   232	
   233	apply_config_line() {
   234	  inner=$(extract_array_inner "$1" "roots")
   235	  if [ -n "$inner" ]; then
   236	    ROOTS=""
   237	    oldifs=$IFS
   238	    IFS='|'
   239	    set -- $(quoted_to_pipe "$inner")
   240	    IFS=$oldifs
   241	    for item in "$@"; do
   242	      [ -n "$item" ] || continue
   243	      exp=$(expand_tilde "$item")
   244	      if [ -z "$ROOTS" ]; then
   245	        ROOTS="$exp"
   246	      else
   247	        ROOTS="$ROOTS|$exp"
   248	      fi
   249	    done
   250	    [ -n "$ROOTS" ] || ROOTS="$HOME_DIR"
   251	  fi
   252	  inner=$(extract_array_inner "$1" "extraExclude")
   253	  if [ -n "$inner" ]; then
   254	    EXTRA_EXCLUDE=$(quoted_to_pipe "$inner")
   255	  fi
   256	  n=$(extract_number "$1" "watchCap")
   257	  [ -n "$n" ] && WATCH_CAP=$n
   258	  n=$(extract_number "$1" "cacheMb")
   259	  [ -n "$n" ] && CACHE_MB=$n
   260	  n=$(extract_number "$1" "maxFiles")
   261	  [ -n "$n" ] && MAX_FILES=$n
   262	  save_config
   263	}
   264	
   265	safe_glob() {
   266	  printf '%s' "$1" | tr -cd 'A-Za-z0-9._-'
   267	}
   268	
   269	kind_of() {
   270	  base=$(printf '%s' "$1" | sed 's|.*/||')
   271	  ext=$(printf '%s' "$base" | awk -F. '{print tolower($NF)}')
   272	  if [ -d "$1" ]; then
   273	    printf 'dir'
   274	    return
   275	  fi
   276	  case "$ext" in
   277	    png|jpg|jpeg|webp|svg|gif|bmp|ico) printf 'image' ;;
   278	    pdf) printf 'pdf' ;;
   279	    csv|tsv) printf 'csv' ;;
   280	    rs|js|ts|py|go|c|h|md|txt|toml|json|yml|yaml|qml|lua) printf 'code' ;;
   281	    *) printf 'hex' ;;
   282	  esac
   283	}
   284	
   285	score_name() {
   286	  name=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
   287	  q=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
   288	  case "$name" in
   289	    "$q") printf '1000' ;;
   290	    "$q"*) printf '800' ;;
   291	    *"$q"*) printf '600' ;;
   292	    *) printf '0' ;;
   293	  esac
   294	}
   295	
   296	demo_hit() {
   297	  path="$SAMP/$1"
   298	  kind=$(kind_of "$path")
   299	  printf '{"path":"%s","name":"%s","kind":"%s","score":%s,"mtime":0,"size":0}' \
   300	    "$(json_escape "$path")" "$1" "$kind" "$2"
   301	}
   302	
   303	demo_results() {
   304	  printf '[%s,%s,%s,%s,%s]' \
   305	    "$(demo_hit invoice.pdf 900)" \
   306	    "$(demo_hit photo.png 880)" \
   307	    "$(demo_hit sales.csv 860)" \
   308	    "$(demo_hit themed.rs 840)" \
   309	    "$(demo_hit README.md 820)"
   310	}
   311	
   312	prune_names() {
   313	  printf '%s' ".ssh|.gnupg|.password-store|node_modules|target|.git|.hg|.svn|.bzr|__pycache__|.venv|venv|.tox|.mypy_cache|.pytest_cache|.cargo|.rustup|.npm|.cache|.Trash|.local|keyrings|kwalletd|Keychains"
   314	  if [ -n "$EXTRA_EXCLUDE" ]; then
   315	    printf '|%s' "$EXTRA_EXCLUDE"
   316	  fi
   317	}
   318	
   319	is_secret_file() {
   320	  case "$1" in
   321	    .env|.env.*|*.env) return 0 ;;
   322	    id_rsa|id_ed25519|id_rsa.*) return 0 ;;
   323	  esac
   324	  return 1
   325	}
   326	
   327	path_is_secret() {
   328	  case "$1" in
   329	    */.ssh/*|*/.gnupg/*|*/.password-store/*|*/.local/share/keyrings/*|*/.local/share/kwalletd/*|*/Library/Keychains/*)
   330	      return 0
   331	      ;;
   332	  esac
   333	  is_secret_file "$(printf '%s' "$1" | sed 's|.*/||')"
   334	}
   335	
   336	hidden_ancestor() {
   337	  # Skip hidden/heavy directories unless they are an explicit root.
   338	  cur=$(dirname "$1")
   339	  while [ -n "$cur" ] && [ "$cur" != "/" ]; do
   340	    skip_this=0
   341	    oldifs=$IFS
   342	    IFS='|'
   343	    for r in $ROOTS; do
   344	      [ "$cur" = "$r" ] && skip_this=1
   345	    done
   346	    IFS=$oldifs
   347	    [ "$skip_this" -eq 0 ] || return 1
   348	    base=$(printf '%s' "$cur" | sed 's|.*/||')
   349	    case "$base" in
   350	      .*) return 0 ;;
   351	    esac
   352	    oldifs=$IFS
   353	    IFS='|'
   354	    for n in $(prune_names); do
   355	      [ "$base" = "$n" ] && return 0
   356	    done
   357	    IFS=$oldifs
   358	    np=$(dirname "$cur")
   359	    [ "$np" = "$cur" ] && break
   360	    cur=$np
   361	  done
   362	  return 1
   363	}
   364	
   365	append_hit() {
   366	  dest="$1"
   367	  p="$2"
   368	  q="$3"
   369	  path_is_secret "$p" && return 0
   370	  hidden_ancestor "$p" && return 0
   371	  sc=$(score_name "$(printf '%s' "$p" | sed 's|.*/||')" "$q")
   372	  [ "$sc" -gt 0 ] || return 0
   373	  k=$(kind_of "$p")
   374	  bn=$(printf '%s' "$p" | sed 's|.*/||')
   375	  printf '%s {"path":"%s","name":"%s","kind":"%s","score":%s,"mtime":0,"size":0}\n' \
   376	    "$sc" "$(json_escape "$p")" "$(json_escape "$bn")" "$k" "$sc" >> "$dest"
   377	}
   378	
   379	run_capped_find() {
   380	  root="$1"
   381	  q="$2"
   382	  out="$3"
   383	  names=$(prune_names)
   384	  set -f
   385	  set -- find "$root" -mindepth 1 -maxdepth 6 '(' -name '.*'
   386	  oldifs=$IFS
   387	  IFS='|'
   388	  for n in $names; do
   389	    [ -n "$n" ] || continue
   390	    set -- "$@" -o -name "$n"
   391	  done
   392	  IFS=$oldifs
   393	  set -- "$@" ')' -prune -o -iname "*$q*" -print
   394	  set +f
   395	  run_watchdog 2 "$@" > "$out" 2>/dev/null || true
   396	}
   397	
   398	find_hits() {
   399	  q=$(safe_glob "$1")
   400	  dest="$2"
   401	  [ -n "$q" ] || return 0
   402	  raw=$(mktemp)
   403	  located=$(mktemp)
   404	  if command -v plocate >/dev/null 2>&1; then
   405	    run_watchdog 2 plocate -il 40 -- "$q" > "$located" 2>/dev/null || true
   406	  elif command -v locate >/dev/null 2>&1; then
   407	    run_watchdog 2 locate -il 40 -- "$q" > "$located" 2>/dev/null || true
   408	  fi
   409	  if [ -s "$located" ]; then
   410	    while IFS= read -r lp; do
   411	      [ -n "$lp" ] || continue
   412	      under=0
   413	      oldifs=$IFS
   414	      IFS='|'
   415	      for root in $ROOTS; do
   416	        case "$lp" in
   417	          "$root"|"$root"/*) under=1 ;;
   418	        esac
   419	      done
   420	      IFS=$oldifs
   421	      [ "$under" -eq 1 ] && printf '%s\n' "$lp" >> "$raw"
   422	    done < "$located"
   423	  fi
   424	  rm -f "$located"
   425	  if [ ! -s "$raw" ]; then
   426	    oldifs=$IFS
   427	    IFS='|'
   428	    set -- $ROOTS
   429	    IFS=$oldifs
   430	    : > "$raw"
   431	    for root in "$@"; do
   432	      [ -d "$root" ] || continue
   433	      part=$(mktemp)
   434	      run_capped_find "$root" "$q" "$part"
   435	      cat "$part" >> "$raw" 2>/dev/null || true
   436	      rm -f "$part"
   437	    done
   438	  fi
   439	  n=0
   440	  while IFS= read -r p; do
   441	    [ -n "$p" ] || continue
   442	    n=$((n + 1))
   443	    [ "$n" -le 80 ] || break
   444	    append_hit "$dest" "$p" "$q"
   445	  done < "$raw"
   446	  rm -f "$raw"
   447	}
   448	
   449	reply_status() {
   450	  id="$1"
   451	  roots_json=""
   452	  oldifs=$IFS
   453	  IFS='|'
   454	  for r in $ROOTS; do
   455	    [ -n "$r" ] || continue
   456	    if [ -z "$roots_json" ]; then
   457	      roots_json="\"$(json_escape "$r")\""
   458	    else
   459	      roots_json="$roots_json,\"$(json_escape "$r")\""
   460	    fi
   461	  done
   462	  IFS=$oldifs
   463	  budget=$((CACHE_MB * 1024 * 1024))
   464	  poppler=false
   465	  command -v pdftoppm >/dev/null 2>&1 && poppler=true
   466	  plocate=false
   467	  { command -v plocate >/dev/null 2>&1 || command -v locate >/dev/null 2>&1; } && plocate=true
   468	  printf '{"id":%s,"kind":"status","indexing":false,"progress":1,"backend":"compat","status":{"indexing":false,"progress":1,"backend":"compat","files":5,"watchCount":0,"watchCap":%s,"roots":[%s],"cacheBytes":0,"cacheBudget":%s,"poppler":%s,"plocate":%s,"ffmpeg":false,"helper":"compat","version":"1.0.0"}}\n' \
   469	    "$id" "$WATCH_CAP" "$roots_json" "$budget" "$poppler" "$plocate"
   470	}
   471	
   472	reply_query() {
   473	  id="$1"
   474	  q="$2"
   475	  if [ -z "$q" ]; then
   476	    printf '{"id":%s,"kind":"results","results":%s,"indexing":false,"progress":1,"backend":"demo"}\n' "$id" "$(demo_results)"
   477	    return
   478	  fi
   479	  tmp=$(mktemp)
   480	  ql=$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')
   481	  for name in invoice.pdf photo.png sales.csv themed.rs README.md; do
   482	    sc=$(score_name "$name" "$ql")
   483	    if [ "$sc" -gt 0 ]; then
   484	      printf '%s %s\n' "$((sc + 200))" "$(demo_hit "$name" "$((sc + 200))")" >> "$tmp"
   485	    fi
   486	  done
   487	  find_hits "$q" "$tmp"
   488	  sorted=$(mktemp)
   489	  sort -nr -k1,1 "$tmp" > "$sorted" 2>/dev/null || true
   490	  body=""
   491	  n=0
   492	  while read -r _sc hit; do
   493	    [ -n "$hit" ] || continue
   494	    n=$((n + 1))
   495	    [ "$n" -le 40 ] || break
   496	    if [ -z "$body" ]; then
   497	      body="$hit"
   498	    else
   499	      body="$body,$hit"
   500	    fi
   501	  done < "$sorted"
   502	  printf '{"id":%s,"kind":"results","results":[%s],"indexing":false,"progress":1,"backend":"compat"}\n' "$id" "$body"
   503	  rm -f "$tmp" "$sorted"
   504	}
   505	
   506	png_wh() {
   507	  hex=$(read_user_file dd if="$1" bs=1 skip=16 count=8 2>/dev/null | od -An -tx1 | tr -cd '0-9a-f')
   508	  [ "${#hex}" -ge 16 ] || return 1
   509	  w=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c1-8)")
   510	  h=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c9-16)")
   511	  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   512	  printf '%s %s' "$w" "$h"
   513	}
   514	
   515	gif_wh() {
   516	  hex=$(read_user_file dd if="$1" bs=1 skip=6 count=4 2>/dev/null | od -An -tx1 | tr -cd '0-9a-f')
   517	  [ "${#hex}" -ge 8 ] || return 1
   518	  w=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c3-4)$(printf '%s' "$hex" | cut -c1-2)")
   519	  h=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c7-8)$(printf '%s' "$hex" | cut -c5-6)")
   520	  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   521	  printf '%s %s' "$w" "$h"
   522	}
   523	
   524	svg_wh() {
   525	  head=$(read_user_file dd if="$1" bs=1 count=8192 2>/dev/null)
   526	  vb=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Vv]iew[Bb]ox=["'\'']\([^"'\'']*\)["'\''].*/\1/p')
   527	  if [ -n "$vb" ]; then
   528	    set -- $vb
   529	    if [ "$#" -ge 4 ]; then
   530	      w=$(printf '%s' "$3" | tr -cd '0-9.')
   531	      h=$(printf '%s' "$4" | tr -cd '0-9.')
   532	      w=${w%%.*}
   533	      h=${h%%.*}
   534	      [ -n "$w" ] && [ -n "$h" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   535	      printf '%s %s' "$w" "$h"
   536	      return 0
   537	    fi
   538	  fi
   539	  w=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Ww]idth=["'\'']\([0-9.][0-9.]*\).*/\1/p')
   540	  h=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Hh]eight=["'\'']\([0-9.][0-9.]*\).*/\1/p')
   541	  w=${w%%.*}
   542	  h=${h%%.*}
   543	  [ -n "$w" ] && [ -n "$h" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   544	  printf '%s %s' "$w" "$h"
   545	}
   546	
   547	read_user_file() {
   548	  run_watchdog 1 "$@"
   549	}
   550	
   551	hex_head() {
   552	  read_user_file od -An -tx1 -N 256 "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //'
   553	}
   554	
   555	html_escape_file() {
   556	  read_user_file head -c 204800 "$1" 2>/dev/null | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
   557	}
   558	
   559	csv_preview_json() {
   560	  path="$1"
   561	  read_user_file head -n 501 "$path" 2>/dev/null | awk '
   562	    function esc(s) {
   563	      gsub(/\\/, "\\\\", s)
   564	      gsub(/"/, "\\\"", s)
   565	      return s
   566	    }
   567	    function arr(line,    n, i, out, a) {
   568	      n = split(line, a, FS)
   569	      out = "["
   570	      for (i = 1; i <= n; i++) {
   571	        if (i > 1) out = out ","
   572	        out = out "\"" esc(a[i]) "\""
   573	      }
   574	      return out "]"
   575	    }
   576	    BEGIN { headers = "[]"; rows = ""; nbody = 0 }
   577	    NR == 1 {
   578	      line = $0
   579	      c = gsub(/,/, ",", line)
   580	      line = $0
   581	      t = gsub(/\t/, "\t", line)
   582	      line = $0
   583	      s = gsub(/;/, ";", line)
   584	      line = $0
   585	      p = gsub(/\|/, "|", line)
   586	      FS = ","
   587	      if (t > c && t >= s && t >= p) FS = "\t"
   588	      else if (s > c && s >= t && s >= p) FS = ";"
   589	      else if (p > c && p >= t && p >= s) FS = "|"
   590	      $0 = $0
   591	      headers = arr($0)
   592	      next
   593	    }
   594	    {
   595	      if (nbody) rows = rows ","
   596	      rows = rows arr($0)
   597	      nbody++
   598	    }
   599	    END {
   600	      trunc = (NR > 501) ? "true" : "false"
   601	      printf "{\"kind\":\"csv\",\"headers\":%s,\"rows\":[%s],\"truncated\":%s}", headers, rows, trunc
   602	    }
   603	  '
   604	}
   605	
   606	dir_preview_json() {
   607	  path="$1"
   608	  tmp=$(mktemp)
   609	  read_user_file ls -1 "$path" 2>/dev/null | head -n 200 > "$tmp"
   610	  entries=""
   611	  while IFS= read -r name || [ -n "$name" ]; do
   612	    [ -n "$name" ] || continue
   613	    full="$path/$name"
   614	    k=$(kind_of "$full")
   615	    sz=0
   616	    if [ -f "$full" ] && watchdog_ok; then
   617	      sz=$(run_watchdog 1 stat -c %s "$full" 2>/dev/null) || \
   618	        sz=$(run_watchdog 1 stat -f %z "$full" 2>/dev/null) || sz=0
   619	      [ -n "$sz" ] || sz=0
   620	    fi
   621	    ent="{\"name\":\"$(json_escape "$name")\",\"kind\":\"$k\",\"size\":$sz}"
   622	    if [ -z "$entries" ]; then
   623	      entries="$ent"
   624	    else
   625	      entries="$entries,$ent"
   626	    fi
   627	  done < "$tmp"
   628	  rm -f "$tmp"
   629	  printf '{"kind":"dir","entries":[%s],"path":"%s"}' "$entries" "$(json_escape "$path")"
   630	}
   631	
   632	isolation_ok() {
   633	  watchdog_ok
   634	}
   635	
   636	run_isolated() {
   637	  watchdog_ok || return 1
   638	  (
   639	    ulimit -t 8 2>/dev/null || true
   640	    ulimit -v 524288 2>/dev/null || true
   641	    ulimit -f 65536 2>/dev/null || true
   642	    ulimit -u 32 2>/dev/null || true
   643	    run_watchdog 8 "$@"
   644	  ) >/dev/null 2>&1 || true
   645	}
   646	
   647	run_pdftoppm() {
   648	  path="$1"
   649	  page="$2"
   650	  dest="$3"
   651	  prefix="${dest%.png}"
   652	  if ! isolation_ok; then
   653	    return 1
   654	  fi
   655	  run_isolated pdftoppm -f "$page" -l "$page" -png -r 140 -singlefile "$path" "$prefix"
   656	}
   657	
   658	downsample_image() {
   659	  src="$1"
   660	  dest="$2"
   661	  nw="$3"
   662	  nh="$4"
   663	  if ! isolation_ok; then
   664	    return 1
   665	  fi
   666	  if command -v ffmpeg >/dev/null 2>&1; then
   667	    run_isolated ffmpeg -nostdin -hide_banner -loglevel error -i "$src" -vf "scale=${nw}:${nh}" -frames:v 1 -y "$dest"
   668	    [ -s "$dest" ] && return 0
   669	  fi
   670	  if command -v magick >/dev/null 2>&1; then
   671	    run_isolated magick "$src" -resize "${nw}x${nh}" "$dest"
   672	    [ -s "$dest" ] && return 0
   673	  fi
   674	  if command -v convert >/dev/null 2>&1; then
   675	    run_isolated convert "$src" -resize "${nw}x${nh}" "$dest"
   676	    [ -s "$dest" ] && return 0
   677	  fi
   678	  return 1
   679	}
   680	
   681	reply_preview() {
   682	  id="$1"
   683	  path="$2"
   684	  page="${3:-1}"
   685	  [ -n "$page" ] || page=1
   686	  kind=$(kind_of "$path")
   687	  case "$kind" in
   688	    image)
   689	      ext=$(printf '%s' "$path" | awk -F. '{print tolower($NF)}')
   690	      wh=""
   691	      case "$ext" in
   692	        png) wh=$(png_wh "$path") || wh="" ;;
   693	        gif) wh=$(gif_wh "$path") || wh="" ;;
   694	        svg) wh=$(svg_wh "$path") || wh="" ;;
   695	        *) wh="" ;;
   696	      esac
   697	      if [ -n "$wh" ]; then
   698	        set -- $wh
   699	        w=$1
   700	        h=$2
   701	        pix=$((w * h))
   702	        if [ "$pix" -le 20000000 ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   703	          anim=false
   704	          [ "$ext" = gif ] && anim=true
   705	          printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":%s,"width":%s,"height":%s}}\n' \
   706	            "$id" "$(json_escape "$path")" "$anim" "$w" "$h"
   707	        elif [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   708	          nw=$w
   709	          nh=$h
   710	          # integer sqrt-ish shrink so nw*nh <= 20e6
   711	          while [ $((nw * nh)) -gt 20000000 ]; do
   712	            nw=$((nw / 2))
   713	            nh=$((nh / 2))
   714	            [ "$nw" -gt 0 ] && [ "$nh" -gt 0 ] || break
   715	          done
   716	          [ "$nw" -gt 0 ] || nw=1
   717	          [ "$nh" -gt 0 ] || nh=1
   718	          cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/previews"
   719	          mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-previews"
   720	          mkdir -p "$cache_dir"
   721	          dest="$cache_dir/ds-$$.png"
   722	          if downsample_image "$path" "$dest" "$nw" "$nh" && [ -s "$dest" ]; then
   723	            printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":false,"width":%s,"height":%s,"label":"downsampled"}}\n' \
   724	              "$id" "$(json_escape "$dest")" "$nw" "$nh"
   725	          else
   726	            printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"image %sx%s","label":"image exceeds 20 MP — hex view","width":%s,"height":%s,"path":"%s"}}\n' \
   727	              "$id" "$(json_escape "$(hex_head "$path")")" "$w" "$h" "$w" "$h" "$(json_escape "$path")"
   728	          fi
   729	        fi
   730	      else
   731	        printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"unverifiable image","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   732	          "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   733	      fi
   734	      ;;
   735	    pdf)
   736	      if command -v pdftoppm >/dev/null 2>&1 && isolation_ok; then
   737	        cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/pdf"
   738	        mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-pdf"
   739	        mkdir -p "$cache_dir"
   740	        dest="$cache_dir/p${page}-$$.png"
   741	        run_pdftoppm "$path" "$page" "$dest"
   742	        if [ ! -s "$dest" ] && [ -s "${dest%.png}-1.png" ]; then
   743	          dest="${dest%.png}-1.png"
   744	        fi
   745	        if [ -s "$dest" ]; then
   746	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","path":"%s","page":%s,"page_count":1,"need_poppler":false}}\n' \
   747	            "$id" "$(json_escape "$dest")" "$page"
   748	        else
   749	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"render_error":true,"page":%s,"page_count":1,"label":"couldn'\''t render this page","magic":"PDF document","hex":"%s"}}\n' \
   750	            "$id" "$page" "$(json_escape "$(hex_head "$path")")"
   751	        fi
   752	      elif command -v pdftoppm >/dev/null 2>&1; then
   753	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"page":%s,"page_count":1,"label":"PDF metadata only — no isolated renderer","magic":"PDF document"}}\n' \
   754	          "$id" "$page"
   755	      else
   756	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":true,"page":%s,"page_count":1,"label":"install poppler for PDF previews","magic":"PDF document","path":"%s"}}\n' \
   757	          "$id" "$page" "$(json_escape "$path")"
   758	      fi
   759	      ;;
   760	    code)
   761	      printf '{"id":%s,"kind":"preview","preview":{"kind":"code","html":"<pre>%s</pre>","lang":"text","path":"%s"}}\n' \
   762	        "$id" "$(json_escape "$(html_escape_file "$path")")" "$(json_escape "$path")"
   763	      ;;
   764	    csv)
   765	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(csv_preview_json "$path")"
   766	      ;;
   767	    dir)
   768	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(dir_preview_json "$path")"
   769	      ;;
   770	    *)
   771	      printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"data","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   772	        "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   773	      ;;
   774	  esac
   775	}
   776	
   777	do_open() {
   778	  path="$1"
   779	  reveal="$2"
   780	  if [ ! -e "$path" ]; then
   781	    return 1
   782	  fi
   783	  target="$path"
   784	  if [ "$reveal" = 1 ] && [ ! -d "$path" ]; then
   785	    target=$(dirname "$path")
   786	  fi
   787	  watchdog_ok || return 2
   788	  if command -v gio >/dev/null 2>&1; then
   789	    run_watchdog 8 gio open "$target" >/dev/null 2>&1 || true
   790	    return 0
   791	  fi
   792	  if command -v xdg-open >/dev/null 2>&1; then
   793	    run_watchdog 8 xdg-open "$target" >/dev/null 2>&1 || true
   794	    return 0
   795	  fi
   796	  if command -v open >/dev/null 2>&1; then
   797	    run_watchdog 8 open "$target" >/dev/null 2>&1 || true
   798	    return 0
   799	  fi
   800	  return 2
   801	}
   802	
   803	handle_line() {
   804	  load_config
   805	  line="$1"
   806	  id=$(extract_id "$line")
   807	  [ -n "$id" ] || id=0
   808	  case "$line" in
   809	    *'"cmd":"config"'*|*'cmd": "config"'*)
   810	      apply_config_line "$line"
   811	      reply_status "$id"
   812	      ;;
   813	    *'"cmd":"status"'*|*'cmd": "status"'*|*'cmd":"capabilities"'*)
   814	      reply_status "$id"
   815	      ;;
   816	    *'"cmd":"preview"'*|*'cmd": "preview"'*|*'cmd":"prefetch"'*|*'cmd": "prefetch"'*|*'cmd":"page"'*|*'cmd": "page"'*)
   817	      reply_preview "$id" "$(extract_string "$line" "path")" "$(extract_number "$line" "page")"
   818	      ;;
   819	    *'"cmd":"open"'*|*'cmd": "open"'*)
   820	      path=$(extract_string "$line" "path")
   821	      if do_open "$path" 0; then
   822	        printf '{"id":%s,"kind":"ok"}\n' "$id"
   823	      else
   824	        printf '{"id":%s,"kind":"error","error":"open failed"}\n' "$id"
   825	      fi
   826	      ;;
   827	    *'"cmd":"reveal"'*|*'cmd": "reveal"'*)
   828	      path=$(extract_string "$line" "path")
   829	      if do_open "$path" 1; then
   830	        printf '{"id":%s,"kind":"ok"}\n' "$id"
   831	      else
   832	        printf '{"id":%s,"kind":"error","error":"reveal failed"}\n' "$id"
   833	      fi
   834	      ;;
   835	    *'"cmd":"theme"'*|*'cmd":"select"'*|*'cmd":"warmup"'*)
   836	      printf '{"id":%s,"kind":"ok"}\n' "$id"
   837	      ;;
   838	    *'"q":'*|*'cmd":"query"'*|*'cmd": "query"'*)
   839	      q=$(extract_string "$line" "q")
   840	      reply_query "$id" "$q"
   841	      ;;
   842	    *)
   843	      reply_preview "$id" "$(extract_string "$line" "path")" "$(extract_number "$line" "page")"
   844	      ;;
   845	  esac
   846	}
   847	
   848	oneshot=0
   849	payload=""
   850	while [ "$#" -gt 0 ]; do
   851	  case "$1" in
   852	    --plugin-dir)
   853	      shift
   854	      if [ -n "${1:-}" ]; then
   855	        export QUICKLOOK_PLUGIN_DIR="$1"
   856	        SAMP="$1/samples"
   857	      fi
   858	      ;;
   859	    --oneshot)
   860	      oneshot=1
   861	      shift
   862	      payload="${1:-}"
   863	      ;;
   864	    --watchdog-selftest)
   865	      shift
   866	      secs=${1:-2}
   867	      [ "$#" -gt 0 ] && shift
   868	      run_watchdog "$secs" "$@"
   869	      exit $?
   870	      ;;
   871	    *)
   872	      break
   873	      ;;
   874	  esac
   875	  [ "$#" -gt 0 ] && shift
   876	done
   877	
   878	load_config
   879	
   880	if [ "$oneshot" -eq 1 ]; then
   881	  if [ -z "$payload" ]; then
   882	    IFS= read -r payload || payload="{}"
   883	  fi
   884	  handle_line "$payload"
   885	  exit 0
   886	fi
   887	
   888	while IFS= read -r line; do
   889	  [ -n "$line" ] || continue
   890	  handle_line "$line"
   891	done
FILE js/Binds.js
     1	.pragma library
     2	
     3	var SUPER = 64
     4	var SHIFT = 1
     5	var CTRL = 4
     6	var ALT = 8
     7	
     8	function keyIsPeriod(key) {
     9	  var k = String(key || "").toLowerCase()
    10	  return k === "period" || k === "."
    11	}
    12	
    13	function hasBit(mask, bit) {
    14	  return (Number(mask) & bit) === bit
    15	}
    16	
    17	function isSuperPeriod(bind) {
    18	  if (!bind || typeof bind !== "object")
    19	    return false
    20	  if (!keyIsPeriod(bind.key))
    21	    return false
    22	  var mask = Number(bind.modmask)
    23	  if (isNaN(mask))
    24	    return false
    25	  if (!hasBit(mask, SUPER))
    26	    return false
    27	  if (hasBit(mask, SHIFT) || hasBit(mask, CTRL) || hasBit(mask, ALT))
    28	    return false
    29	  return true
    30	}
    31	
    32	function parseBinds(jsonText) {
    33	  var s = String(jsonText || "").trim()
    34	  if (!s.length)
    35	    return []
    36	  try {
    37	    var arr = JSON.parse(s)
    38	    if (arr && typeof arr.length === "number")
    39	      return arr
    40	  } catch (e) {}
    41	  return []
    42	}
    43	
    44	function superPeriodBound(jsonText) {
    45	  var binds = parseBinds(jsonText)
    46	  for (var i = 0; i < binds.length; i++) {
    47	    if (isSuperPeriod(binds[i]))
    48	      return true
    49	  }
    50	  return false
    51	}
