   439	fn font_span(style: Style, text: &str) -> String {
   440	    let c = style.foreground;
   441	    format!(
   442	        "<font color=\"#{:02x}{:02x}{:02x}\">{}</font>",
   443	        c.r,
   444	        c.g,
   445	        c.b,
   446	        escape_html(text)
   447	    )
   448	}
   449	
   450	fn escape_html(s: &str) -> String {
   451	    let mut out = String::with_capacity(s.len());
   452	    for ch in s.chars() {
   453	        match ch {
   454	            '&' => out.push_str("&amp;"),
   455	            '<' => out.push_str("&lt;"),
   456	            '>' => out.push_str("&gt;"),
   457	            '"' => out.push_str("&quot;"),
   458	            _ => out.push(ch),
   459	        }
   460	    }
   461	    out
   462	}
