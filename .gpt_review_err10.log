   611	pub fn pdf_page_count(path: &Path) -> u32 {
   612	    if let Some(n) = pdfinfo_page_count(path) {
   613	        return n;
   614	    }
   615	    count_from_pdf_head(path)
   616	}
   617	
   618	fn pdfinfo_page_count(path: &Path) -> Option<u32> {
   619	    let bin = which("pdfinfo")?;
   620	    let mut cmd = Command::new(bin);
   621	    cmd.arg(path);
   622	    let out = run_limited(cmd, Duration::from_millis(1500), 64 * 1024 * 1024, 2).ok()?;
   623	    parse_pdfinfo_pages(&String::from_utf8_lossy(&out.stdout))
   624	}
   625	
   626	fn parse_pdfinfo_pages(text: &str) -> Option<u32> {
   627	    for line in text.lines() {
   628	        if let Some(rest) = line.strip_prefix("Pages:") {
   629	            if let Ok(n) = rest.trim().parse::<u32>() {
   630	                return Some(n.max(1));
   631	            }
   632	        }
   633	    }
   634	    None
   635	}
   636	
   637	fn count_from_pdf_head(path: &Path) -> u32 {
   638	    let bytes = read_capped(path, PDF_HEAD).unwrap_or_default();
   639	    let s = String::from_utf8_lossy(&bytes);
   640	    let mut best = 1u32;
   641	    let mut idx = 0;
   642	    while let Some(at) = s[idx..].find("/Count") {
   643	        let rest = s[idx + at + 6..].trim_start();
   644	        let n: u32 = rest
   645	            .split(|c: char| !c.is_ascii_digit())
   646	            .next()
   647	            .and_then(|x| x.parse().ok())
   648	            .unwrap_or(0);
   649	        if n > best && n < 10_000 {
   650	            best = n;
   651	        }
   652	        idx += at + 6;
   653	        if idx >= s.len() {
   654	            break;
   655	        }
   656	    }
   657	    best
   658	}
   659	
   660	pub fn preview_dir(path: &Path) -> Preview {
   661	    let mut entries = Vec::new();
   662	    let mut total = 0u64;
   663	    if let Ok(rd) = fs::read_dir(path) {
   664	        let mut raw: Vec<_> = rd.flatten().collect();
   665	        raw.sort_by_key(|e| e.file_name());
   666	        for ent in raw.iter().take(200) {
   667	            let p = ent.path();
   668	            let meta = ent.metadata().ok();
   669	            let is_dir = meta.as_ref().map(|m| m.is_dir()).unwrap_or(false);
   670	            let size = meta.as_ref().map(|m| m.len()).unwrap_or(0);
   671	            if !is_dir {
   672	                total += size;
   673	            }
   674	            entries.push(DirEnt {
   675	                name: ent.file_name().to_string_lossy().into(),
   676	                kind: kind_of(&p, is_dir).as_str().into(),
   677	                size,
   678	            });
   679	        }
   680	    }
   681	    let walked = dir_total_size(path, 4000);
   682	    Preview {
   683	        kind: "dir".into(),
   684	        entries: Some(entries),
   685	        total_size: Some(if walked.0 > total { walked.0 } else { total }),
   686	        truncated: Some(walked.1),
   687	        path: Some(path.to_string_lossy().into()),
   688	        ..Preview::default()
   689	    }
   690	}
   691	
   692	fn dir_total_size(path: &Path, cap: usize) -> (u64, bool) {
   693	    let mut n = 0u64;
   694	    let mut count = 0usize;
   695	    for ent in walkdir::WalkDir::new(path).follow_links(false).into_iter().flatten() {
   696	        if ent.file_type().is_file() {
   697	            n += ent.metadata().map(|m| m.len()).unwrap_or(0);
   698	            count += 1;
   699	            if count >= cap {
   700	                return (n, true);
   701	            }
   702	        }
   703	    }
   704	    (n, false)
   705	}
