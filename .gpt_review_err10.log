   154	  function callIpc(method, arg) {
   155	    var job = { method: String(method || ""), arg: arg === undefined || arg === null ? "" : String(arg) }
   156	    if (job.method === "snapshot") {
   157	      var kept = []
   158	      for (var i = 0; i < root.ipcQueue.length; i++) {
   159	        if (root.ipcQueue[i].method !== "snapshot")
   160	          kept.push(root.ipcQueue[i])
   161	      }
   162	      root.ipcQueue = kept
   163	    }
   164	    root.ipcQueue.push(job)
   165	    root.runIpc()
   166	  }
   167	
   168	  function runIpc() {
   169	    if (ipcProc.running || root.ipcCurrent)
   170	      return
   171	    if (!root.ipcQueue.length)
   172	      return
   173	    var next = null
   174	    var rest = []
   175	    var snap = null
   176	    for (var i = 0; i < root.ipcQueue.length; i++) {
   177	      var job = root.ipcQueue[i]
   178	      if (job.method === "snapshot")
   179	        snap = job
   180	      else if (!next)
   181	        next = job
   182	      else
   183	        rest.push(job)
   184	    }
   185	    if (!next)
   186	      next = snap
   187	    else if (snap)
   188	      rest.push(snap)
   189	    root.ipcQueue = rest
   190	    root.ipcCurrent = next
   191	    ipcProc.command = ["omarchy-shell", "shell", "call", root.pluginId, next.method, next.arg]
   192	    ipcProc.running = true
   193	  }
