   164	impl Engine {
   165	    pub fn new(cfg: AppConfig) -> Self {
   166	        let _ = std::fs::create_dir_all(&cfg.cache_dir);
   167	        let _ = std::fs::create_dir_all(&cfg.state_dir);
   168	        let db = cfg.state_dir.join("index.sqlite");
   169	        let frecency = Frecency::open(&db);
   170	        let persisted = frecency.load_files();
   171	        let cache = PreviewCache::new(cfg.cache_dir.clone(), cfg.cache_bytes);
   172	        cache.gc();
   173	        let samples = search::demo_files(&cfg.samples_dir);
   174	        let palette = Palette::default();
   175	        let syn = syntect_theme(&palette);
   176	        let inner = Inner {
   177	            cfg: Mutex::new(cfg),
   178	            files: Mutex::new(if persisted.is_empty() {
   179	                samples.clone()
   180	            } else {
   181	                search::merge_unique(samples.clone(), persisted)
   182	            }),
   183	            indexing: AtomicBool::new(false),
   184	            progress_cents: AtomicU32::new(0),
   185	            backend: Mutex::new("demo".into()),
   186	            watch_count: AtomicU32::new(0),
   187	            theme: Mutex::new(palette),
   188	            syn_theme: Mutex::new(syn),
   189	            frecency: Mutex::new(frecency),
   190	            cache,
   191	            poppler: which("pdftoppm").is_some(),
   192	            plocate: search::plocate_available(),
   193	            ffmpeg: which("ffmpeg").is_some(),
   194	            latest_preview: AtomicU64::new(0),
   195	            samples: Mutex::new(samples),
   196	            index_gen: AtomicU64::new(0),
   197	        };
   198	        Self {
   199	            inner: Arc::new(inner),
   200	        }
   201	    }
