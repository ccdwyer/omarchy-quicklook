   627	def pdf_page_count(path: Path) -> int:
   628	    info = shutil.which("pdfinfo")
   629	    if info:
   630	        try:
   631	            proc = run_killable(
   632	                [info, str(path)],
   633	                timeout_s=2,
   634	                capture_output=True,
   635	                text=True,
   636	            )
   637	            for line in proc.stdout.splitlines():
   638	                if line.startswith("Pages:"):
   639	                    n = int(line.split(":", 1)[1].strip() or "1")
   640	                    return max(1, n)
   641	        except (subprocess.TimeoutExpired, OSError, ValueError):
   642	            pass
   643	    head = read_capped(path, 256 * 1024).decode("latin-1", errors="replace")
   644	    best = 1
   645	    idx = 0
   646	    while True:
   647	        at = head.find("/Count", idx)
   648	        if at < 0:
   649	            break
   650	        rest = head[at + 6 :].lstrip()
   651	        digits = ""
   652	        for ch in rest:
   653	            if ch.isdigit():
   654	                digits += ch
   655	            elif digits:
   656	                break
   657	        if digits:
   658	            n = int(digits)
   659	            if 1 < n < 10_000 and n > best:
   660	                best = n
   661	        idx = at + 6
   662	    return best
