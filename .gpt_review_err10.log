   340	def hex_dump(data: bytes) -> str:
   341	    hex_lines = []
   342	    for i in range(0, len(data), 16):
   343	        chunk = data[i : i + 16]
   344	        hx = " ".join(f"{b:02x}" for b in chunk)
   345	        asc = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
   346	        hex_lines.append(f"{i:08x}  {hx:<48} {asc}")
   347	    return "\n".join(hex_lines) or "(empty)"
