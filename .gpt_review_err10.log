   382	def _kill_group(proc: subprocess.Popen, pgid: int | None = None) -> None:
   383	    gid = pgid if pgid is not None else proc.pid
   384	    try:
   385	        os.killpg(gid, signal.SIGTERM)
   386	    except OSError:
   387	        try:
   388	            proc.terminate()
   389	        except OSError:
   390	            pass
   391	    try:
   392	        proc.wait(timeout=1)
   393	    except (subprocess.TimeoutExpired, OSError):
   394	        pass
   395	    # Always SIGKILL the recorded group, even if the leader already exited.
   396	    try:
   397	        os.killpg(gid, signal.SIGKILL)
   398	    except OSError:
   399	        try:
   400	            proc.kill()
   401	        except OSError:
   402	            pass
   403	    try:
   404	        proc.wait(timeout=1)
   405	    except (subprocess.TimeoutExpired, OSError):
   406	        pass
