   472	reply_query() {
   473	  id="$1"
   474	  q="$2"
   475	  if [ -z "$q" ]; then
   476	    printf '{"id":%s,"kind":"results","results":%s,"indexing":false,"progress":1,"backend":"demo"}\n' "$id" "$(demo_results)"
   477	    return
   478	  fi
   479	  tmp=$(mktemp)
   480	  ql=$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')
   481	  for name in invoice.pdf photo.png sales.csv themed.rs README.md; do
   482	    sc=$(score_name "$name" "$ql")
