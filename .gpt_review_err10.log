FILE src/quicklookd/src/cache.rs
     1	use sha2::{Digest, Sha256};
     2	use std::fs;
     3	use std::path::{Path, PathBuf};
     4	use std::sync::atomic::{AtomicU64, Ordering};
     5	use std::time::SystemTime;
     6	
     7	pub struct PreviewCache {
     8	    pub dir: PathBuf,
     9	    budget: AtomicU64,
    10	}
    11	
    12	impl PreviewCache {
    13	    pub fn new(dir: PathBuf, budget: u64) -> Self {
    14	        let previews = dir.join("previews");
    15	        let _ = fs::create_dir_all(&previews);
    16	        Self {
    17	            dir,
    18	            budget: AtomicU64::new(budget.max(1)),
    19	        }
    20	    }
    21	
    22	    pub fn budget(&self) -> u64 {
    23	        self.budget.load(Ordering::SeqCst)
    24	    }
    25	
    26	    pub fn set_budget(&self, bytes: u64) {
    27	        self.budget.store(bytes.max(1), Ordering::SeqCst);
    28	        self.gc();
    29	    }
    30	
    31	    pub fn preview_dir(&self) -> PathBuf {
    32	        self.dir.join("previews")
    33	    }
    34	
    35	    pub fn key(&self, parts: &[&str]) -> String {
    36	        let mut h = Sha256::new();
    37	        for p in parts {
    38	            h.update(p.as_bytes());
    39	            h.update([0]);
    40	        }
    41	        hex::encode(h.finalize())
    42	    }
    43	
    44	    pub fn path_for(&self, parts: &[&str], ext: &str) -> PathBuf {
    45	        self.preview_dir().join(format!("{}.{}", self.key(parts), ext))
    46	    }
    47	
    48	    pub fn bytes_used(&self) -> u64 {
    49	        walk_size(&self.preview_dir())
    50	    }
    51	
    52	    pub fn gc(&self) {
    53	        let dir = self.preview_dir();
    54	        let mut files: Vec<(SystemTime, u64, PathBuf)> = Vec::new();
    55	        let mut total = 0u64;
    56	        if let Ok(rd) = fs::read_dir(&dir) {
    57	            for ent in rd.flatten() {
    58	                let p = ent.path();
    59	                if !p.is_file() {
    60	                    continue;
    61	                }
    62	                let meta = match p.metadata() {
    63	                    Ok(m) => m,
    64	                    Err(_) => continue,
    65	                };
    66	                let mtime = meta.modified().unwrap_or(SystemTime::UNIX_EPOCH);
    67	                let size = meta.len();
    68	                total += size;
    69	                files.push((mtime, size, p));
    70	            }
    71	        }
    72	        let budget = self.budget();
    73	        if total <= budget {
    74	            return;
    75	        }
    76	        files.sort_by(|a, b| a.0.cmp(&b.0));
    77	        for (_, size, path) in files {
    78	            if total <= budget {
    79	                break;
    80	            }
    81	            if fs::remove_file(&path).is_ok() {
    82	                total = total.saturating_sub(size);
    83	            }
    84	        }
    85	    }
    86	
    87	    pub fn store_bytes(&self, parts: &[&str], ext: &str, bytes: &[u8]) -> std::io::Result<PathBuf> {
    88	        let dest = self.path_for(parts, ext);
    89	        if let Some(parent) = dest.parent() {
    90	            fs::create_dir_all(parent)?;
    91	        }
    92	        fs::write(&dest, bytes)?;
    93	        if self.bytes_used() > self.budget() {
    94	            self.gc();
    95	        }
    96	        Ok(dest)
    97	    }
    98	}
    99	
   100	fn walk_size(dir: &Path) -> u64 {
   101	    let mut n = 0u64;
   102	    let rd = match fs::read_dir(dir) {
   103	        Ok(r) => r,
   104	        Err(_) => return 0,
   105	    };
   106	    for ent in rd.flatten() {
   107	        let p = ent.path();
   108	        if p.is_file() {
   109	            n += p.metadata().map(|m| m.len()).unwrap_or(0);
   110	        }
   111	    }
   112	    n
   113	}
