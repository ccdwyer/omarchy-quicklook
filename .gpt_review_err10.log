   362	def _limit_child() -> None:
   363	    try:
   364	        import resource
   365	    except ImportError:
   366	        return
   367	    for name, soft in (
   368	        ("RLIMIT_CPU", 8),
   369	        ("RLIMIT_AS", 512 * 1024 * 1024),
   370	        ("RLIMIT_NPROC", 8),
   371	        ("RLIMIT_FSIZE", 32 * 1024 * 1024),
   372	    ):
   373	        lim = getattr(resource, name, None)
   374	        if lim is None:
   375	            continue
   376	        try:
   377	            resource.setrlimit(lim, (soft, soft))
   378	        except (ValueError, OSError):
   379	            pass
   380	
   381	
   382	def _kill_group(proc: subprocess.Popen, pgid: int | None = None) -> None:
   383	    gid = pgid if pgid is not None else proc.pid
   384	    try:
   385	        os.killpg(gid, signal.SIGTERM)
   386	    except OSError:
   387	        try:
   388	            proc.terminate()
   389	        except OSError:
   390	            pass
   391	    try:
   392	        proc.wait(timeout=1)
   393	    except (subprocess.TimeoutExpired, OSError):
   394	        pass
   395	    # Always SIGKILL the recorded group, even if the leader already exited.
   396	    try:
   397	        os.killpg(gid, signal.SIGKILL)
   398	    except OSError:
   399	        try:
   400	            proc.kill()
   401	        except OSError:
   402	            pass
   403	    try:
   404	        proc.wait(timeout=1)
   405	    except (subprocess.TimeoutExpired, OSError):
   406	        pass
   407	
   408	
   409	def run_killable(
   410	    argv: list[str],
   411	    timeout_s: float = 8,
   412	    capture_output: bool = False,
   413	    text: bool = False,
   414	    limits: bool = True,
   415	) -> subprocess.CompletedProcess:
   416	    """Spawn in a new session and kill the whole process group on timeout."""
   417	    stdout = subprocess.PIPE if capture_output else subprocess.DEVNULL
   418	    stderr = subprocess.PIPE if capture_output else subprocess.DEVNULL
   419	    # New session so timeout can kill the whole group. Cannot combine
   420	    # start_new_session with preexec_fn; setsid in preexec when limits apply.
   421	    if limits:
   422	        def preexec() -> None:
   423	            try:
   424	                os.setsid()
   425	            except OSError:
   426	                pass
   427	            _limit_child()
   428	
   429	        extra = {"preexec_fn": preexec}
   430	    else:
   431	        extra = {"start_new_session": True}
   432	
   433	    proc = subprocess.Popen(
   434	        argv,
   435	        stdout=stdout,
   436	        stderr=stderr,
   437	        **extra,
   438	    )
   439	    pgid = proc.pid
   440	    try:
   441	        out, err = proc.communicate(timeout=timeout_s)
   442	    except subprocess.TimeoutExpired as exc:
   443	        _kill_group(proc, pgid)
   444	        try:
   445	            out, err = proc.communicate(timeout=2)
   446	        except (subprocess.TimeoutExpired, OSError):
   447	            out, err = exc.output or b"", exc.stderr or b""
   448	        raise subprocess.TimeoutExpired(argv, timeout_s, output=out, stderr=err) from None
   449	    if text:
   450	        enc = sys.getdefaultencoding()
   451	        out = out.decode(enc, errors="replace") if isinstance(out, (bytes, bytearray)) else (out or "")
   452	        err = err.decode(enc, errors="replace") if isinstance(err, (bytes, bytearray)) else (err or "")
   453	    return subprocess.CompletedProcess(argv, proc.returncode, out, err)
   454	
   455	
   456	def svg_dims(path: Path) -> tuple[int, int] | None:
   457	    text = read_capped(path, 16 * 1024).decode("utf-8", errors="replace")
   458	    lower = text.lower()
   459	    def token_len(raw: str) -> int | None:
   460	        raw = raw.strip().strip("\"'")
   461	        if raw.endswith("%"):
   462	            return None
   463	        i = 0
   464	        while i < len(raw) and (raw[i].isdigit() or raw[i] in ".+-"):
   465	            i += 1
   466	        if not i:
   467	            return None
   468	        try:
   469	            v = float(raw[:i])
   470	        except ValueError:
   471	            return None
   472	        if v <= 0 or v > 1_000_000:
   473	            return None
   474	        return int(round(v))
   475	
   476	    idx = lower.find("viewbox")
   477	    if idx >= 0:
   478	        rest = text[idx + 7 :].lstrip(" \t=\n\"'")
   479	        parts = rest.replace(",", " ").split()
   480	        if len(parts) >= 4:
   481	            w = token_len(parts[2])
   482	            h = token_len(parts[3])
   483	            if w and h:
   484	                return w, h
   485	    def attr(name: str) -> int | None:
   486	        key = name + "="
   487	        at = lower.find(key)
   488	        if at < 0:
   489	            return None
   490	        rest = text[at + len(key) :].lstrip()
   491	        rest = rest.lstrip("\"'")
   492	        tok = ""
   493	        for ch in rest:
   494	            if ch in "\"' \t>/":
   495	                break
   496	            tok += ch
   497	        return token_len(tok)
   498	
   499	    w = attr("width")
   500	    h = attr("height")
   501	    if w and h:
   502	        return w, h
   503	    return None
   504	
   505	
   506	def image_dims(path: Path) -> tuple[int, int] | None:
   507	    head = read_capped(path, 96 * 1024)
   508	    if not head:
   509	        return None
   510	    if len(head) >= 24 and head[:8] == b"\x89PNG\r\n\x1a\n":
   511	        return _be_u32(head[16:20]), _be_u32(head[20:24])
   512	    if len(head) >= 10 and head[:6] in (b"GIF87a", b"GIF89a"):
   513	        return int.from_bytes(head[6:8], "little"), int.from_bytes(head[8:10], "little")
   514	    if head[:2] == b"\xff\xd8":
   515	        i = 2
   516	        while i + 9 < len(head):
   517	            if head[i] != 0xFF:
   518	                i += 1
   519	                continue
   520	            marker = head[i + 1]
   521	            if marker in (0xC0, 0xC1, 0xC2, 0xC3):
   522	                return int.from_bytes(head[i + 5 : i + 7], "big"), int.from_bytes(
   523	                    head[i + 7 : i + 9], "big"
   524	                )
   525	            if marker in (0xD8, 0xD9):
   526	                i += 2
   527	                continue
   528	            seglen = int.from_bytes(head[i + 2 : i + 4], "big")
   529	            i += 2 + seglen
   530	        return None
   531	    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
   532	        kind = head[12:16]
   533	        if kind == b"VP8X" and len(head) >= 30:
   534	            w = 1 + int.from_bytes(head[24:27], "little")
   535	            h = 1 + int.from_bytes(head[27:30], "little")
   536	            return w, h
   537	        if kind == b"VP8 " and len(head) >= 26:
   538	            return int.from_bytes(head[26:28], "little") & 0x3FFF, int.from_bytes(
   539	                head[28:30], "little"
   540	            ) & 0x3FFF
   541	    return None
   542	
   543	
   544	def fit_megapixels(w: int, h: int, cap: int = MEGAPIXELS) -> tuple[int, int]:
   545	    pixels = max(1, w * h)
   546	    if pixels <= cap:
   547	        return max(1, w), max(1, h)
   548	    scale = (cap / pixels) ** 0.5
   549	    return max(1, int(w * scale)), max(1, int(h * scale))
   550	
   551	
   552	def downsample_image(path: Path, w: int, h: int) -> dict | None:
   553	    nw, nh = fit_megapixels(w, h)
   554	    cache_dir = CACHE / "previews"
   555	    try:
   556	        cache_dir.mkdir(parents=True, exist_ok=True)
   557	    except OSError:
   558	        cache_dir = Path("/tmp") / "quicklook-previews"
   559	        cache_dir.mkdir(parents=True, exist_ok=True)
   560	    dest = cache_dir / f"ds-{abs(hash((str(path), w, h, nw, nh)))}.png"
   561	    if dest.is_file() and dest.stat().st_size > 0:
   562	        return {
   563	            "kind": "image",
   564	            "path": str(dest),
   565	            "width": nw,
   566	            "height": nh,
   567	            "label": "downsampled",
   568	            "animated": False,
   569	        }
   570	    src = str(path)
   571	    dst = str(dest)
   572	    cmds: list[list[str]] = []
   573	    if shutil.which("ffmpeg"):
   574	        cmds.append(
   575	            [
   576	                "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
   577	                "-i", src, "-vf", f"scale={nw}:{nh}", "-frames:v", "1", "-y", dst,
   578	            ]
   579	        )
   580	    if shutil.which("magick"):
   581	        cmds.append(["magick", src, "-resize", f"{nw}x{nh}", dst])
   582	    if shutil.which("convert"):
   583	        cmds.append(["convert", src, "-resize", f"{nw}x{nh}", dst])
   584	    for cmd in cmds:
   585	        try:
   586	            run_killable(cmd, timeout_s=12, capture_output=True)
   587	        except (subprocess.TimeoutExpired, OSError):
   588	            continue
   589	        if dest.is_file() and dest.stat().st_size > 0:
   590	            return {
   591	                "kind": "image",
   592	                "path": str(dest),
   593	                "width": nw,
   594	                "height": nh,
   595	                "label": "downsampled",
   596	                "animated": False,
   597	            }
   598	    return None
   599	
