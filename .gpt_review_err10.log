   681	reply_preview() {
   682	  id="$1"
   683	  path="$2"
   684	  page="${3:-1}"
   685	  [ -n "$page" ] || page=1
   686	  kind=$(kind_of "$path")
   687	  case "$kind" in
   688	    image)
   689	      ext=$(printf '%s' "$path" | awk -F. '{print tolower($NF)}')
   690	      wh=""
   691	      case "$ext" in
   692	        png) wh=$(png_wh "$path") || wh="" ;;
   693	        gif) wh=$(gif_wh "$path") || wh="" ;;
   694	        svg) wh=$(svg_wh "$path") || wh="" ;;
   695	        *) wh="" ;;
   696	      esac
   697	      if [ -n "$wh" ]; then
   698	        set -- $wh
   699	        w=$1
   700	        h=$2
   701	        pix=$((w * h))
   702	        if [ "$pix" -le 20000000 ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   703	          anim=false
   704	          [ "$ext" = gif ] && anim=true
   705	          printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":%s,"width":%s,"height":%s}}\n' \
   706	            "$id" "$(json_escape "$path")" "$anim" "$w" "$h"
   707	        elif [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   708	          nw=$w
   709	          nh=$h
   710	          # integer sqrt-ish shrink so nw*nh <= 20e6
   711	          while [ $((nw * nh)) -gt 20000000 ]; do
   712	            nw=$((nw / 2))
   713	            nh=$((nh / 2))
   714	            [ "$nw" -gt 0 ] && [ "$nh" -gt 0 ] || break
   715	          done
   716	          [ "$nw" -gt 0 ] || nw=1
   717	          [ "$nh" -gt 0 ] || nh=1
   718	          cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/previews"
   719	          mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-previews"
   720	          mkdir -p "$cache_dir"
   721	          dest="$cache_dir/ds-$$.png"
   722	          if downsample_image "$path" "$dest" "$nw" "$nh" && [ -s "$dest" ]; then
   723	            printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":false,"width":%s,"height":%s,"label":"downsampled"}}\n' \
   724	              "$id" "$(json_escape "$dest")" "$nw" "$nh"
   725	          else
   726	            printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"image %sx%s","label":"image exceeds 20 MP — hex view","width":%s,"height":%s,"path":"%s"}}\n' \
   727	              "$id" "$(json_escape "$(hex_head "$path")")" "$w" "$h" "$w" "$h" "$(json_escape "$path")"
   728	          fi
   729	        fi
   730	      else
   731	        printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"unverifiable image","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   732	          "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   733	      fi
   734	      ;;
   735	    pdf)
   736	      if command -v pdftoppm >/dev/null 2>&1 && isolation_ok; then
   737	        cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/pdf"
   738	        mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-pdf"
   739	        mkdir -p "$cache_dir"
   740	        dest="$cache_dir/p${page}-$$.png"
   741	        run_pdftoppm "$path" "$page" "$dest"
   742	        if [ ! -s "$dest" ] && [ -s "${dest%.png}-1.png" ]; then
   743	          dest="${dest%.png}-1.png"
   744	        fi
   745	        if [ -s "$dest" ]; then
   746	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","path":"%s","page":%s,"page_count":1,"need_poppler":false}}\n' \
   747	            "$id" "$(json_escape "$dest")" "$page"
   748	        else
   749	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"render_error":true,"page":%s,"page_count":1,"label":"couldn'\''t render this page","magic":"PDF document","hex":"%s"}}\n' \
   750	            "$id" "$page" "$(json_escape "$(hex_head "$path")")"
   751	        fi
   752	      elif command -v pdftoppm >/dev/null 2>&1; then
   753	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"page":%s,"page_count":1,"label":"PDF metadata only — no isolated renderer","magic":"PDF document"}}\n' \
   754	          "$id" "$page"
   755	      else
   756	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":true,"page":%s,"page_count":1,"label":"install poppler for PDF previews","magic":"PDF document","path":"%s"}}\n' \
   757	          "$id" "$page" "$(json_escape "$path")"
   758	      fi
   759	      ;;
   760	    code)
   761	      printf '{"id":%s,"kind":"preview","preview":{"kind":"code","html":"<pre>%s</pre>","lang":"text","path":"%s"}}\n' \
   762	        "$id" "$(json_escape "$(html_escape_file "$path")")" "$(json_escape "$path")"
   763	      ;;
   764	    csv)
   765	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(csv_preview_json "$path")"
   766	      ;;
   767	    dir)
   768	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(dir_preview_json "$path")"
   769	      ;;
   770	    *)
   771	      printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"data","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   772	        "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   773	      ;;
   774	  esac
   775	}
