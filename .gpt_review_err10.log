   118	pub fn which(name: &str) -> Option<std::path::PathBuf> {
   119	    let path = std::env::var_os("PATH")?;
   120	    for dir in std::env::split_paths(&path) {
   121	        let candidate = dir.join(name);
   122	        if candidate.is_file() {
   123	            return Some(candidate);
   124	        }
   125	    }
   126	    None
   127	}
