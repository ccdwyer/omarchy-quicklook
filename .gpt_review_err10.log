   658	downsample_image() {
   659	  src="$1"
   660	  dest="$2"
   661	  nw="$3"
   662	  nh="$4"
   663	  if ! isolation_ok; then
   664	    return 1
   665	  fi
   666	  if command -v ffmpeg >/dev/null 2>&1; then
   667	    run_isolated ffmpeg -nostdin -hide_banner -loglevel error -i "$src" -vf "scale=${nw}:${nh}" -frames:v 1 -y "$dest"
   668	    [ -s "$dest" ] && return 0
   669	  fi
   670	  if command -v magick >/dev/null 2>&1; then
   671	    run_isolated magick "$src" -resize "${nw}x${nh}" "$dest"
   672	    [ -s "$dest" ] && return 0
   673	  fi
   674	  if command -v convert >/dev/null 2>&1; then
   675	    run_isolated convert "$src" -resize "${nw}x${nh}" "$dest"
   676	    [ -s "$dest" ] && return 0
   677	  fi
   678	  return 1
   679	}
