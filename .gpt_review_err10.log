FILE .github/workflows/release.yml
     1	name: release
     2	
     3	# Builds static musl quicklookd binaries for x86_64 and aarch64.
     4	# This checkout is authored on macOS and cannot produce those binaries locally.
     5	# Never commit fake helpers. Tag a release (v*) or run this workflow by hand;
     6	# artifacts and CHECKSUMS.txt attach to the GitHub release.
     7	
     8	on:
     9	  push:
    10	    tags: ["v*"]
    11	  workflow_dispatch:
    12	
    13	permissions:
    14	  contents: write
    15	
    16	jobs:
    17	  musl:
    18	    runs-on: ubuntu-latest
    19	    strategy:
    20	      fail-fast: false
    21	      matrix:
    22	        target:
    23	          - x86_64-unknown-linux-musl
    24	          - aarch64-unknown-linux-musl
    25	    steps:
    26	      - uses: actions/checkout@v4
    27	      - uses: dtolnay/rust-toolchain@stable
    28	        with:
    29	          targets: ${{ matrix.target }}
    30	      - uses: taiki-e/setup-cross-toolchain-action@v1
    31	        with:
    32	          target: ${{ matrix.target }}
    33	      - name: Build
    34	        run: cargo build --release --locked --target ${{ matrix.target }} --manifest-path src/quicklookd/Cargo.toml
    35	      - name: Stage
    36	        run: |
    37	          mkdir -p dist
    38	          src="src/quicklookd/target/${{ matrix.target }}/release/quicklookd"
    39	          test -x "$src"
    40	          cp "$src" "dist/quicklookd-${{ matrix.target }}"
    41	      - uses: actions/upload-artifact@v4
    42	        with:
    43	          name: quicklookd-${{ matrix.target }}
    44	          path: dist/quicklookd-${{ matrix.target }}
    45	
    46	  checksums:
    47	    needs: musl
    48	    runs-on: ubuntu-latest
    49	    steps:
    50	      - uses: actions/download-artifact@v4
    51	        with:
    52	          path: dist
    53	          merge-multiple: true
    54	      - name: Checksums
    55	        run: |
    56	          cd dist
    57	          sha256sum quicklookd-* | tee ../CHECKSUMS.txt
    58	          cat ../CHECKSUMS.txt
    59	      - uses: actions/upload-artifact@v4
    60	        with:
    61	          name: CHECKSUMS
    62	          path: CHECKSUMS.txt
    63	      - name: Attach to GitHub release
    64	        if: startsWith(github.ref, 'refs/tags/')
    65	        env:
    66	          GH_TOKEN: ${{ github.token }}
    67	        run: |
    68	          gh release create "${{ github.ref_name }}" --generate-notes --title "${{ github.ref_name }}" || true
    69	          gh release upload "${{ github.ref_name }}" dist/quicklookd-* CHECKSUMS.txt --clobber
FILE bin/README.md
     1	# `bin/`
     2	
     3	This directory ships `quicklook`, a tiny summon wrapper.
     4	
     5	It does **not** contain `quicklookd` Linux binaries. This repository is authored on macOS; committing fake or foreign-arch helpers would be a lie.
     6	
     7	Get a real helper:
     8	
     9	1. `../build.sh` on the Omarchy (Linux) machine, or
    10	2. GitHub Actions `.github/workflows/release.yml` (musl x86_64 + aarch64 + checksums), then `../scripts/fetch-helper.sh`.
    11	
    12	Until then, QML uses `../compat/quicklookd.sh`.
FILE samples/README.md
     1	# Harbor Notes
     2	
     3	A tiny sample document shipped with QuickLook so the overlay is useful before your home directory has been indexed.
     4	
     5	- Invoice #1042 lives next to this file
     6	- `sales.csv` has five thousand rows of pretend retail data
     7	- `themed.rs` shows syntax colors from the active Omarchy palette
     8	- `photo.png` is a generated still, not a network fetch
     9	
    10	Everything is local. Nothing leaves the machine.
FILE CHECKSUMS.txt
     1	# No prebuilt musl binaries are committed from the macOS authoring host.
     2	# Authentic x86_64 / aarch64 helpers are produced only by
     3	#   .github/workflows/release.yml
     4	# which publishes sha256 lines for:
     5	#   quicklookd-x86_64-unknown-linux-musl
     6	#   quicklookd-aarch64-unknown-linux-musl
     7	# scripts/fetch-helper.sh will not install a download that is not in that list.
     8	# Until a release exists, `omarchy plugin add --enable` uses compat/ + samples/.

