   464	pub fn preview_csv(path: &Path) -> Preview {
   465	    let data = match read_capped(path, CSV_CAP) {
   466	        Ok(d) => d,
   467	        Err(_) => return preview_hex(path),
   468	    };
   469	    preview_csv_bytes(&data)
   470	}
   471	
   472	pub fn preview_csv_bytes(data: &[u8]) -> Preview {
   473	    let delim = sniff_delim(data);
   474	    let mut rdr = csv::ReaderBuilder::new()
   475	        .delimiter(delim)
   476	        .has_headers(false)
   477	        .flexible(true)
   478	        .from_reader(data);
   479	    let mut rows: Vec<Vec<String>> = Vec::new();
   480	    for rec in rdr.records() {
   481	        match rec {
   482	            Ok(r) => rows.push(r.iter().map(|s| s.to_string()).collect()),
   483	            Err(_) => continue,
   484	        }
   485	        if rows.len() > CSV_ROWS {
   486	            break;
   487	        }
   488	    }
   489	    if rows.is_empty() {
   490	        return Preview {
   491	            kind: "hex".into(),
   492	            hex: Some(hex_dump(&data[..data.len().min(HEX_BYTES)])),
   493	            magic: Some("empty table".into()),
   494	            ..Preview::default()
   495	        };
   496	    }
   497	    let headers = rows.remove(0);
   498	    let truncated = rows.len() >= CSV_ROWS;
   499	    Preview {
   500	        kind: "csv".into(),
   501	        headers: Some(headers),
   502	        rows: Some(rows),
   503	        truncated: Some(truncated),
   504	        ..Preview::default()
   505	    }
   506	}
   507	
   508	fn sniff_delim(data: &[u8]) -> u8 {
   509	    let line = data.split(|b| *b == b'\n').next().unwrap_or(data);
   510	    let comma = line.iter().filter(|b| **b == b',').count();
   511	    let tab = line.iter().filter(|b| **b == b'\t').count();
   512	    let semi = line.iter().filter(|b| **b == b';').count();
   513	    let pipe = line.iter().filter(|b| **b == b'|').count();
   514	    let mut best = (comma, b',');
   515	    if tab > best.0 {
   516	        best = (tab, b'\t');
   517	    }
   518	    if semi > best.0 {
   519	        best = (semi, b';');
   520	    }
   521	    if pipe > best.0 {
   522	        best = (pipe, b'|');
   523	    }
   524	    best.1
   525	}
