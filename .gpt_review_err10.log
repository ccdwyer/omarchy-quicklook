   385	            std::env::set_var("PATH", format!("{}:{old}", dir.display()));
   386	            let start = std::time::Instant::now();
   387	            let hits = plocate("invoice", 10, &[], &[dir.clone()]);
   388	            let elapsed = start.elapsed();
   389	            std::env::set_var("PATH", old);
   390	            assert!(
   391	                elapsed < std::time::Duration::from_secs(5),
   392	                "hung plocate was not killed: {elapsed:?}"
   393	            );
   394	            assert!(hits.is_none());
   395	            let _ = std::fs::remove_dir_all(&dir);
   396	        });
   397	    }
   398	}
