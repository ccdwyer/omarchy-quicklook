   112	
   113	pub fn fit_megapixels(w: u32, h: u32, cap: u64) -> (u32, u32) {
   114	    let pixels = (w as u64).saturating_mul(h as u64).max(1);
   115	    if pixels <= cap {
   116	        return (w.max(1), h.max(1));
   117	    }
   118	    let scale = (cap as f64 / pixels as f64).sqrt();
   119	    let nw = ((w as f64) * scale).floor().max(1.0) as u32;
   120	    let nh = ((h as f64) * scale).floor().max(1.0) as u32;
   121	    (nw.max(1), nh.max(1))
   122	}
   123	
   124	fn downsample_cached(path: &Path, cache: &PreviewCache, w: u32, h: u32) -> Option<Preview> {
   125	    let (nw, nh) = fit_megapixels(w, h, MEGAPIXELS);
   126	    let mtime = fs::metadata(path)
   127	        .ok()
   128	        .and_then(|m| m.modified().ok())
   129	        .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
   130	        .map(|d| d.as_millis().to_string())
   131	        .unwrap_or_default();
   132	    let dest = cache.path_for(
   133	        &[
   134	            &path.to_string_lossy(),
   135	            &mtime,
   136	            "ds",
   137	            &nw.to_string(),
   138	            &nh.to_string(),
   139	        ],
   140	        "png",
   141	    );
   142	    if usable_cache_file(&dest) {
   143	        return Some(downsampled_preview(&dest, nw, nh));
   144	    }
   145	    if let Some(parent) = dest.parent() {
   146	        let _ = fs::create_dir_all(parent);
   147	    }
   148	    if downsample_external(path, &dest, nw, nh) || downsample_self(path, &dest, nw, nh) {
   149	        if usable_cache_file(&dest) {
   150	            cache.gc();
   151	            return Some(downsampled_preview(&dest, nw, nh));
   152	        }
   153	    }
   154	    None
   155	}
