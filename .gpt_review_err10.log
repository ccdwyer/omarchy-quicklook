     1	use std::io;
     2	use std::path::Path;
     3	use std::process::{Command, Output, Stdio};
     4	use std::sync::atomic::{AtomicU32, Ordering};
     5	use std::sync::mpsc;
     6	use std::sync::Mutex;
     7	use std::thread;
     8	use std::time::{Duration, Instant};
     9	
    10	static PARSE_THREADS: AtomicU32 = AtomicU32::new(0);
    11	static LIVE_THREADS: AtomicU32 = AtomicU32::new(0);
    12	const MAX_PARSE_THREADS: u32 = 2;
    13	const MAX_LIVE_THREADS: u32 = 16;
    14	
    15	pub fn with_timeout<T, F>(ms: u64, f: F) -> Result<T, String>
    16	where
    17	    T: Send + 'static,
    18	    F: FnOnce() -> T + Send + 'static,
    19	{
    20	    let live = LIVE_THREADS.fetch_add(1, Ordering::SeqCst);
    21	    if live >= MAX_LIVE_THREADS {
    22	        LIVE_THREADS.fetch_sub(1, Ordering::SeqCst);
    23	        return Err("parser busy".into());
    24	    }
    25	    loop {
    26	        let n = PARSE_THREADS.load(Ordering::SeqCst);
    27	        if n >= MAX_PARSE_THREADS {
    28	            LIVE_THREADS.fetch_sub(1, Ordering::SeqCst);
    29	            return Err("parser busy".into());
    30	        }
    31	        if PARSE_THREADS
    32	            .compare_exchange(n, n + 1, Ordering::SeqCst, Ordering::SeqCst)
    33	            .is_ok()
    34	        {
    35	            break;
    36	        }
    37	    }
    38	    let released = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
    39	    let released_t = released.clone();
    40	    let (tx, rx) = mpsc::channel();
    41	    thread::spawn(move || {
    42	        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));
    43	        if !released_t.swap(true, Ordering::SeqCst) {
    44	            PARSE_THREADS.fetch_sub(1, Ordering::SeqCst);
    45	        }
    46	        LIVE_THREADS.fetch_sub(1, Ordering::SeqCst);
    47	        let _ = tx.send(result);
    48	    });
    49	    match rx.recv_timeout(Duration::from_millis(ms)) {
    50	        Ok(Ok(v)) => Ok(v),
    51	        Ok(Err(_)) => Err("parser panicked".into()),
    52	        Err(_) => {
    53	            if !released.swap(true, Ordering::SeqCst) {
    54	                PARSE_THREADS.fetch_sub(1, Ordering::SeqCst);
    55	            }
    56	            Err("timeout".into())
    57	        }
    58	    }
    59	}
    60	
    61	pub fn run_limited(mut cmd: Command, timeout: Duration, mem_bytes: u64, cpu_secs: u64) -> io::Result<Output> {
    62	    apply_rlimits(&mut cmd, mem_bytes, cpu_secs);
    63	    cmd.stdin(Stdio::null());
    64	    cmd.stdout(Stdio::piped());
    65	    cmd.stderr(Stdio::piped());
    66	    let mut child = cmd.spawn()?;
    67	    let start = Instant::now();
    68	    loop {
    69	        match child.try_wait()? {
    70	            Some(_) => return child.wait_with_output(),
    71	            None => {
    72	                if start.elapsed() >= timeout {
    73	                    let _ = child.kill();
    74	                    let _ = child.wait();
    75	                    return Err(io::Error::new(io::ErrorKind::TimedOut, "killed"));
    76	                }
    77	                thread::sleep(Duration::from_millis(20));
    78	            }
    79	        }
    80	    }
    81	}
    82	
    83	fn apply_rlimits(cmd: &mut Command, mem_bytes: u64, cpu_secs: u64) {
    84	    #[cfg(unix)]
    85	    {
    86	        use std::os::unix::process::CommandExt;
    87	        let mem = mem_bytes;
    88	        let cpu = cpu_secs;
    89	        unsafe {
    90	            cmd.pre_exec(move || {
    91	                let as_lim = libc::rlimit {
    92	                    rlim_cur: mem,
    93	                    rlim_max: mem,
    94	                };
    95	                libc::setrlimit(libc::RLIMIT_AS, &as_lim);
    96	                let cpu_lim = libc::rlimit {
    97	                    rlim_cur: cpu,
    98	                    rlim_max: cpu,
    99	                };
   100	                libc::setrlimit(libc::RLIMIT_CPU, &cpu_lim);
   101	                let nproc = libc::rlimit {
   102	                    rlim_cur: 32,
   103	                    rlim_max: 32,
   104	                };
   105	                #[cfg(any(target_os = "linux", target_os = "android"))]
   106	                libc::setrlimit(libc::RLIMIT_NPROC, &nproc);
   107	                let _ = nproc;
   108	                Ok(())
   109	            });
   110	        }
   111	    }
   112	    #[cfg(not(unix))]
   113	    {
   114	        let _ = (cmd, mem_bytes, cpu_secs);
   115	    }
   116	}
