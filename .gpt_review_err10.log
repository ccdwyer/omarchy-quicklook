   217	    pub fn handle_line(&self, line: &str) -> String {
   218	        match protocol::parse(line) {
   219	            Ok(req) => serde_json::to_string(&self.handle(req)).unwrap_or_else(|e| {
   220	                format!(r#"{{"id":0,"kind":"error","error":"{}"}}"#, e)
   221	            }),
   222	            Err(e) => serde_json::to_string(&Response::error(0, e)).unwrap(),
   223	        }
   224	    }
   225	
   226	    pub fn handle(&self, req: Request) -> Response {
   227	        match req.command() {
   228	            "query" => self.do_query(&req),
   229	            "preview" | "prefetch" | "page" => self.do_preview(&req),
   230	            "open" => self.do_open(&req, false),
   231	            "reveal" => self.do_open(&req, true),
   232	            "select" => self.do_select(&req),
   233	            "status" | "capabilities" => self.do_status(&req),
   234	            "theme" => self.do_theme(&req),
   235	            "warmup" => {
   236	                self.warmup_async();
   237	                let mut resp = Response::ok(req.id);
   238	                resp.indexing = Some(true);
   239	                resp
   240	            }
   241	            "config" => self.do_config(&req),
   242	            other => Response::error(req.id, format!("unknown cmd {other}")),
   243	        }
   244	    }
   245	
   246	    fn do_config(&self, req: &Request) -> Response {
   247	        {
   248	            let mut cfg = self.inner.cfg.lock().unwrap();
   249	            if let Some(roots) = &req.roots {
   250	                let home = cfg.home.clone();
   251	                cfg.roots = roots.iter().map(|r| expand_home(r, &home)).collect();
   252	                if cfg.roots.is_empty() {
   253	                    cfg.roots.push(home);
   254	                }
   255	            }
   256	            if let Some(n) = req.watch_cap {
   257	                cfg.watch_cap = n.max(16);
   258	            }
   259	            if let Some(n) = req.cache_mb {
   260	                let bytes = (n.max(16) as u64) * 1024 * 1024;
   261	                cfg.cache_bytes = bytes;
   262	                self.inner.cache.set_budget(bytes);
   263	            }
   264	            if let Some(n) = req.max_files {
   265	                cfg.max_files = n.max(1000) as usize;
   266	            }
   267	            if let Some(ex) = &req.extra_exclude {
   268	                cfg.extra_exclude = ex.clone();
   269	            }
   270	        }
   271	        self.warmup_async();
   272	        self.do_status(req)
   273	    }
   274	
   275	    fn do_theme(&self, req: &Request) -> Response {
   276	        if let Some(p) = &req.palette {
   277	            let mut pal = self.inner.theme.lock().unwrap();
   278	            theme::apply_in(&mut pal, p);
   279	            let syn = syntect_theme(&pal);
   280	            *self.inner.syn_theme.lock().unwrap() = syn;
   281	        }
   282	        Response::ok(req.id)
   283	    }
   284	
   285	    fn do_select(&self, req: &Request) -> Response {
   286	        if let Some(path) = &req.path {
   287	            let _ = self.inner.frecency.lock().unwrap().touch(path);
   288	        }
   289	        Response::ok(req.id)
   290	    }
   291	
   292	    fn do_open(&self, req: &Request, reveal: bool) -> Response {
   293	        let path = match req.path.as_deref() {
   294	            Some(p) => PathBuf::from(p),
   295	            None => return Response::error(req.id, "missing path"),
   296	        };
   297	        if let Some(s) = req.path.as_deref() {
   298	            let _ = self.inner.frecency.lock().unwrap().touch(s);
   299	        }
   300	        let r = if reveal {
   301	            open::reveal_path(&path)
   302	        } else {
   303	            open::open_path(&path)
   304	        };
   305	        match r {
   306	            Ok(()) => Response::ok(req.id),
   307	            Err(e) => Response::error(req.id, e),
   308	        }
   309	    }
   310	
   311	    fn do_status(&self, req: &Request) -> Response {
   312	        let mut resp = Response::ok(req.id);
   313	        resp.kind = "status".into();
   314	        resp.status = Some(self.status_now());
   315	        resp.indexing = Some(self.inner.indexing.load(Ordering::SeqCst));
   316	        resp.progress = Some(self.progress());
   317	        resp.backend = Some(self.inner.backend.lock().unwrap().clone());
   318	        resp
   319	    }
   320	
   321	    fn progress(&self) -> f32 {
   322	        self.inner.progress_cents.load(Ordering::SeqCst) as f32 / 10000.0
   323	    }
   324	
   325	    fn status_now(&self) -> Status {
   326	        let cfg = self.inner.cfg.lock().unwrap();
   327	        let files = self.inner.files.lock().unwrap().len() as u64;
   328	        Status {
   329	            indexing: self.inner.indexing.load(Ordering::SeqCst),
   330	            progress: self.progress(),
   331	            backend: self.inner.backend.lock().unwrap().clone(),
   332	            files,
   333	            watch_count: self.inner.watch_count.load(Ordering::SeqCst),
   334	            watch_cap: cfg.watch_cap,
   335	            roots: cfg.roots.iter().map(|p| p.to_string_lossy().into()).collect(),
   336	            cache_bytes: self.inner.cache.bytes_used(),
   337	            cache_budget: self.inner.cache.budget(),
   338	            poppler: self.inner.poppler,
   339	            plocate: self.inner.plocate,
   340	            ffmpeg: self.inner.ffmpeg,
   341	            helper: "rust".into(),
   342	            version: VERSION.into(),
   343	        }
   344	    }
   345	
   346	    fn do_query(&self, req: &Request) -> Response {
   347	        let q = req.q.clone().unwrap_or_default();
   348	        let samples = self.inner.samples.lock().unwrap().clone();
   349	        let indexed = self.inner.files.lock().unwrap().clone();
   350	        let cfg = self.inner.cfg.lock().unwrap().clone();
   351	        let frecency = self.inner.frecency.lock().unwrap();
   352	        let (hits, backend) = if q.trim().is_empty() {
   353	            let recent_paths = frecency.recent(12);
   354	            let mut recent = Vec::new();
   355	            for p in recent_paths {
   356	                if let Some(f) = indexed.iter().find(|x| x.path == p).cloned() {
   357	                    recent.push(f);
   358	                } else if let Some(f) = search::IndexedFile::from_path(std::path::Path::new(&p)) {
   359	                    recent.push(f);
   360	                }
   361	            }
   362	            let merged = search::merge_unique(samples, recent);
   363	            (search::rank(&merged, "", &frecency, 40), "demo".to_string())
   364	        } else if !indexed.is_empty() && self.inner.progress_cents.load(Ordering::SeqCst) > 0 {
   365	            let backend = if self.inner.indexing.load(Ordering::SeqCst) {
   366	                "index-warming".to_string()
   367	            } else {
   368	                "index".to_string()
   369	            };
   370	            let pool = search::merge_unique(samples, indexed);
   371	            (search::rank(&pool, &q, &frecency, 40), backend)
   372	        } else if let Some(found) = search::plocate(&q, 80, &cfg.extra_exclude, &cfg.roots) {
   373	            let pool = search::merge_unique(samples, found);
   374	            (search::rank(&pool, &q, &frecency, 40), "plocate".to_string())
   375	        } else {
   376	            let walk_cfg = WalkConfig {
   377	                roots: cfg.roots.clone(),
   378	                extra_exclude: cfg.extra_exclude.clone(),
   379	                max_files: 2500,
   380	                max_depth: 8,
   381	            };
   382	            let walked = search::bounded_walk_query(&walk_cfg, &q, 2500);
   383	            let pool = search::merge_unique(samples, walked);
   384	            (search::rank(&pool, &q, &frecency, 40), "walk".to_string())
   385	        };
   386	        *self.inner.backend.lock().unwrap() = backend.clone();
   387	        drop(frecency);
   388	        Response {
   389	            id: req.id,
   390	            kind: "results".into(),
   391	            results: Some(hits),
   392	            preview: None,
   393	            status: None,
   394	            error: None,
   395	            indexing: Some(self.inner.indexing.load(Ordering::SeqCst)),
   396	            progress: Some(self.progress()),
   397	            backend: Some(backend),
   398	        }
   399	    }
