   140	pub struct WalkConfig {
   141	    pub roots: Vec<PathBuf>,
   142	    pub extra_exclude: Vec<String>,
   143	    pub max_files: usize,
   144	    pub max_depth: usize,
   145	}
   146	
   147	pub fn walk_index(cfg: &WalkConfig, mut on_batch: impl FnMut(&[IndexedFile], usize) -> bool) -> Vec<IndexedFile> {
   148	    let mut out = Vec::new();
   149	    let mut seen = 0usize;
   150	    for root in &cfg.roots {
   151	        if !root.exists() {
   152	            continue;
   153	        }
   154	        let walker = WalkDir::new(root)
   155	            .follow_links(false)
   156	            .max_depth(cfg.max_depth)
   157	            .into_iter();
   158	        for ent in walker.filter_entry(|e| {
   159	            if e.depth() == 0 {
   160	                return true;
   161	            }
   162	            let p = e.path();
   163	            if e.file_type().is_dir() {
   164	                !exclude::should_skip_dir(p, &cfg.extra_exclude, root)
   165	            } else {
   166	                !exclude::should_skip_file(p)
   167	            }
   168	        }) {
   169	            let ent = match ent {
   170	                Ok(e) => e,
   171	                Err(_) => continue,
   172	            };
   173	            if ent.depth() == 0 && ent.file_type().is_dir() {
   174	                continue;
   175	            }
   176	            if let Some(rec) = IndexedFile::from_path(ent.path()) {
   177	                out.push(rec);
   178	                seen += 1;
   179	                if seen % 400 == 0 && !on_batch(&out, seen) {
   180	                    return out;
   181	                }
   182	                if out.len() >= cfg.max_files {
   183	                    return out;
   184	                }
   185	            }
   186	        }
   187	    }
   188	    let _ = on_batch(&out, seen);
   189	    out
   190	}
   191	
   192	pub fn bounded_walk_query(cfg: &WalkConfig, query: &str, budget: usize) -> Vec<IndexedFile> {
   193	    let mut limited = cfg.clone();
   194	    limited.max_files = budget;
   195	    limited.max_depth = limited.max_depth.min(8);
   196	    let files = walk_index(&limited, |_, _| true);
   197	    if query.is_empty() {
   198	        return files.into_iter().take(40).collect();
   199	    }
   200	    let hits = rank_owned(&files, query, 40);
   201	    hits.into_iter()
   202	        .filter_map(|h| files.iter().find(|f| f.path == h.path).cloned())
   203	        .collect()
   204	}
