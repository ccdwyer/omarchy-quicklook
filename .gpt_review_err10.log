   365	append_hit() {
   366	  dest="$1"
   367	  p="$2"
   368	  q="$3"
   369	  path_is_secret "$p" && return 0
   370	  hidden_ancestor "$p" && return 0
   371	  sc=$(score_name "$(printf '%s' "$p" | sed 's|.*/||')" "$q")
   372	  [ "$sc" -gt 0 ] || return 0
   373	  k=$(kind_of "$p")
   374	  bn=$(printf '%s' "$p" | sed 's|.*/||')
   375	  printf '%s {"path":"%s","name":"%s","kind":"%s","score":%s,"mtime":0,"size":0}\n' \
   376	    "$sc" "$(json_escape "$p")" "$(json_escape "$bn")" "$k" "$sc" >> "$dest"
   377	}
