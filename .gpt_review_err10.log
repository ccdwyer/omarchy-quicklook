    75	#[cfg(test)]
    76	mod tests {
    77	    use super::*;
    78	    use std::path::PathBuf;
    79	
    80	    #[test]
    81	    fn detects_common_kinds() {
    82	        assert_eq!(kind_of(&PathBuf::from("a/invoice.pdf"), false), Kind::Pdf);
    83	        assert_eq!(kind_of(&PathBuf::from("a/photo.png"), false), Kind::Image);
    84	        assert_eq!(kind_of(&PathBuf::from("a/sales.csv"), false), Kind::Csv);
    85	        assert_eq!(kind_of(&PathBuf::from("a/themed.rs"), false), Kind::Code);
    86	        assert_eq!(kind_of(&PathBuf::from("a/README.md"), false), Kind::Code);
    87	        assert_eq!(kind_of(&PathBuf::from("a/clip.webm"), false), Kind::Video);
    88	        assert_eq!(kind_of(&PathBuf::from("a/blob.bin"), false), Kind::Hex);
    89	        assert_eq!(kind_of(&PathBuf::from("a/src"), true), Kind::Dir);
    90	        assert_eq!(kind_of(&PathBuf::from("Makefile"), false), Kind::Code);
    91	    }
