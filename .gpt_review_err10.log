     2	# Behavioral: TERM-ignoring descendants in the process group must be reaped.
     3	set -eu
     4	ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
     5	WORKDIR=$(mktemp -d)
     6	trap 'rm -rf "$WORKDIR"' EXIT
     7	
     8	ignore="$WORKDIR/ignore-term"
     9	cat > "$ignore" << 'EOF'
    10	#!/bin/sh
    11	trap '' TERM
    12	sleep 30
    13	EOF
    14	chmod +x "$ignore"
    15	
    16	parent="$WORKDIR/parent"
    17	cat > "$parent" << 'EOF'
    18	#!/bin/sh
    19	# TERM-responsive leader that leaves a TERM-ignoring descendant.
    20	"$1" &
    21	echo $! > "$2"
    22	wait
    23	EOF
    24	chmod +x "$parent"
    25	
    26	alive() {
    27	  kill -0 "$1" 2>/dev/null
    28	}
    29	
    30	# --- POSIX watchdog: descendant PID must disappear ---
    31	descfile="$WORKDIR/desc.pid"
    32	: > "$descfile"
    33	export QUICKLOOK_FORCE_SH=1
    34	set +e
    35	sh "$ROOT/compat/quicklookd.sh" --watchdog-selftest 2 "$parent" "$ignore" "$descfile"
    36	st=$?
    37	set -e
    38	sleep 1
    39	if [ ! -s "$descfile" ]; then
    40	  echo "FAIL shell parent did not record descendant pid"
    41	  exit 1
    42	fi
    43	dpid=$(tr -d ' \n' < "$descfile")
    44	if alive "$dpid"; then
    45	  echo "FAIL shell watchdog left TERM-ignoring descendant pid $dpid alive"
    46	  kill -KILL "$dpid" 2>/dev/null || true
    47	  exit 1
    48	fi
    49	echo "ok  posix watchdog KILL reaps TERM-ignoring descendant (status $st, pid $dpid)"
