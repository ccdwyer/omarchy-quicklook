   398	find_hits() {
   399	  q=$(safe_glob "$1")
   400	  dest="$2"
   401	  [ -n "$q" ] || return 0
   402	  raw=$(mktemp)
   403	  located=$(mktemp)
   404	  if command -v plocate >/dev/null 2>&1; then
   405	    run_watchdog 2 plocate -il 40 -- "$q" > "$located" 2>/dev/null || true
   406	  elif command -v locate >/dev/null 2>&1; then
   407	    run_watchdog 2 locate -il 40 -- "$q" > "$located" 2>/dev/null || true
   408	  fi
   409	  if [ -s "$located" ]; then
   410	    while IFS= read -r lp; do
   411	      [ -n "$lp" ] || continue
   412	      under=0
   413	      oldifs=$IFS
   414	      IFS='|'
   415	      for root in $ROOTS; do
   416	        case "$lp" in
   417	          "$root"|"$root"/*) under=1 ;;
   418	        esac
   419	      done
   420	      IFS=$oldifs
   421	      [ "$under" -eq 1 ] && printf '%s\n' "$lp" >> "$raw"
   422	    done < "$located"
   423	  fi
   424	  rm -f "$located"
   425	  if [ ! -s "$raw" ]; then
   426	    oldifs=$IFS
   427	    IFS='|'
   428	    set -- $ROOTS
   429	    IFS=$oldifs
   430	    : > "$raw"
   431	    for root in "$@"; do
   432	      [ -d "$root" ] || continue
   433	      part=$(mktemp)
   434	      run_capped_find "$root" "$q" "$part"
   435	      cat "$part" >> "$raw" 2>/dev/null || true
   436	      rm -f "$part"
   437	    done
   438	  fi
   439	  n=0
   440	  while IFS= read -r p; do
   441	    [ -n "$p" ] || continue
   442	    n=$((n + 1))
   443	    [ "$n" -le 80 ] || break
   444	    append_hit "$dest" "$p" "$q"
   445	  done < "$raw"
   446	  rm -f "$raw"
   447	}
