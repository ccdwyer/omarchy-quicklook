   325	fn svg_dims(path: &Path) -> Option<(u32, u32)> {
   326	    let bytes = read_capped(path, 16 * 1024).ok()?;
   327	    let text = String::from_utf8_lossy(&bytes);
   328	    if let Some((w, h)) = parse_svg_viewbox(&text) {
   329	        if w > 0 && h > 0 {
   330	            return Some((w, h));
   331	        }
   332	    }
   333	    let w = parse_svg_len(&text, "width")?;
   334	    let h = parse_svg_len(&text, "height")?;
   335	    if w > 0 && h > 0 {
   336	        Some((w, h))
   337	    } else {
   338	        None
   339	    }
   340	}
   341	
   342	fn parse_svg_viewbox(s: &str) -> Option<(u32, u32)> {
   343	    let lower = s.to_ascii_lowercase();
   344	    let idx = lower.find("viewbox")?;
   345	    let rest = s[idx + 7..].trim_start();
   346	    let rest = rest.trim_start_matches(['=', '"', '\'', ' ', '\t']);
   347	    let mut nums = rest.split(|c: char| c.is_whitespace() || c == ',' || c == '"' || c == '\'');
   348	    let _x = nums.next()?;
   349	    let _y = nums.next()?;
   350	    let w = parse_svg_len_token(nums.next()?)?;
   351	    let h = parse_svg_len_token(nums.next()?)?;
   352	    Some((w, h))
   353	}
   354	
   355	fn parse_svg_len(s: &str, attr: &str) -> Option<u32> {
   356	    let lower = s.to_ascii_lowercase();
   357	    let key = format!("{attr}=");
   358	    let idx = lower.find(&key)?;
   359	    let rest = s[idx + key.len()..].trim_start();
   360	    let rest = rest.trim_start_matches(['"', '\'']);
   361	    let token = rest
   362	        .split(|c: char| c.is_whitespace() || c == '"' || c == '\'' || c == '>' || c == '/')
   363	        .next()?;
   364	    parse_svg_len_token(token)
   365	}
   366	
   367	fn parse_svg_len_token(t: &str) -> Option<u32> {
   368	    let t = t.trim();
   369	    if t.ends_with('%') {
   370	        return None;
   371	    }
   372	    let t = t.trim_end_matches(|c: char| c.is_ascii_alphabetic());
   373	    let v: f64 = t.parse().ok()?;
   374	    if !v.is_finite() || v <= 0.0 || v > 1_000_000.0 {
   375	        return None;
   376	    }
   377	    Some(v.round() as u32)
   378	}
