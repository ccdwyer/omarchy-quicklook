   606	dir_preview_json() {
   607	  path="$1"
   608	  tmp=$(mktemp)
   609	  read_user_file ls -1 "$path" 2>/dev/null | head -n 200 > "$tmp"
   610	  entries=""
   611	  while IFS= read -r name || [ -n "$name" ]; do
   612	    [ -n "$name" ] || continue
   613	    full="$path/$name"
   614	    k=$(kind_of "$full")
   615	    sz=0
   616	    if [ -f "$full" ] && watchdog_ok; then
   617	      sz=$(run_watchdog 1 stat -c %s "$full" 2>/dev/null) || \
   618	        sz=$(run_watchdog 1 stat -f %z "$full" 2>/dev/null) || sz=0
   619	      [ -n "$sz" ] || sz=0
   620	    fi
   621	    ent="{\"name\":\"$(json_escape "$name")\",\"kind\":\"$k\",\"size\":$sz}"
   622	    if [ -z "$entries" ]; then
   623	      entries="$ent"
   624	    else
   625	      entries="$entries,$ent"
   626	    fi
   627	  done < "$tmp"
   628	  rm -f "$tmp"
   629	  printf '{"kind":"dir","entries":[%s],"path":"%s"}' "$entries" "$(json_escape "$path")"
   630	}
