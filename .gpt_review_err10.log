    67	
    68	  function applyHostSettings() {
    69	    var entry = {
    70	      roots: root.roots,
    71	      watchCap: root.watchCap,
    72	      cacheMb: root.cacheMb,
    73	      maxFiles: root.maxFiles,
    74	      extraExclude: root.extraExclude
    75	    }
    76	    Config.applyInline(entry, root.home)
    77	  }
    78	
    79	  function helperCommand() {
    80	    return root.helperIsBinary ? root.helperBin : root.helperSh
    81	  }
    82	
    83	  function helperLaunch(oneshotJson) {
    84	    var cmd = [root.helperCommand(), "--plugin-dir", root.pluginDir]
    85	    if (oneshotJson !== undefined && oneshotJson !== null) {
    86	      cmd.push("--oneshot")
    87	      cmd.push(String(oneshotJson))
    88	    }
    89	    return cmd
    90	  }
    91	
    92	  function writeLine(line) {
    93	    try {
    94	      if (typeof helper.write === "function") {
    95	        helper.write(line)
    96	        return true
    97	      }
    98	    } catch (e) {}
    99	    try {
   100	      if (helper.stdin && typeof helper.stdin.write === "function") {
   101	        helper.stdin.write(line)
   102	        return true
   103	      }
   104	    } catch (e2) {}
   105	    return false
   106	  }
   107	
   108	  function send(obj) {
   109	    if (!obj)
   110	      return 0
   111	    if (!obj.id)
   112	      obj.id = Protocol.nextId()
   113	    var line = JSON.stringify(obj) + "\n"
   114	    if (root.oneshotMode || !helper.running) {
   115	      root.enqueueOneshot(obj)
   116	      return obj.id
   117	    }
   118	    if (!root.writeLine(line)) {
   119	      root.sendQueue.push(obj)
   120	      if (!root.oneshotMode && root.pingSent)
   121	        root.oneshotMode = true
   122	      root.flushSendQueue()
   123	    }
   124	    return obj.id
   125	  }
   126	
   127	  function flushSendQueue() {
   128	    var leftover = []
   129	    for (var i = 0; i < root.sendQueue.length; i++) {
   130	      var job = root.sendQueue[i]
   131	      if (root.oneshotMode || !helper.running) {
   132	        root.enqueueOneshot(job)
   133	      } else if (!root.writeLine(JSON.stringify(job) + "\n")) {
   134	        leftover.push(job)
   135	      }
   136	    }
   137	    root.sendQueue = leftover
   138	  }
   139	
   140	  function enterCompatFallback() {
   141	    root.helperDead = true
   142	    root.usingFallback = true
   143	    root.oneshotMode = true
   144	    root.helperIsBinary = false
   145	    root.helperCmd = root.helperSh
   146	    root.lastStatus = "compat"
   147	    helper.running = false
   148	    var abandoned = Protocol.abandonInFlight()
   149	    root.flushSendQueue()
   150	    if (abandoned.queuedPreview)
   151	      root.enqueueOneshot(abandoned.queuedPreview)
   152	    if (abandoned.previewId && abandoned.previewPath) {
   153	      root.applyLocalPreview(abandoned.previewId, abandoned.previewPath)
   154	      root.enqueueOneshot({
   155	        id: Protocol.nextId(),
   156	        cmd: "preview",
   157	        path: abandoned.previewPath
   158	      })
   159	    }
   160	    if (abandoned.queuedPrefetch)
   161	      root.enqueueOneshot(abandoned.queuedPrefetch)
   162	  }
   163	
   164	  function enqueueOneshot(obj) {
   165	    if (obj && (obj.cmd === "preview" || obj.cmd === "prefetch" || obj.cmd === "page")) {
   166	      var kept = []
   167	      for (var i = 0; i < oneshotQueue.length; i++) {
   168	        var c = oneshotQueue[i].cmd
   169	        var same = obj.cmd === "prefetch" ? c === "prefetch" : (c === "preview" || c === "page")
   170	        if (!same)
   171	          kept.push(oneshotQueue[i])
   172	      }
   173	      oneshotQueue = kept
   174	    }
   175	    oneshotQueue.push(obj)
   176	    runOneshot()
   177	  }
   178	
   179	  function dispatchPending() {
   180	    var nextPrev = Protocol.takeReadyPreview()
   181	    if (nextPrev)
   182	      root.send(nextPrev)
   183	    var nextPref = Protocol.takeReadyPrefetch()
   184	    if (nextPref)
   185	      root.send(nextPref)
   186	  }
   187	
   188	  function applyLocalPreview(id, path) {
   189	    Protocol.dropInFlight(id)
   190	    root.lastPreview = Format.localPreview(path)
   191	    root.previewRevision += 1
   192	    root.dispatchPending()
   193	  }
   194	
   195	  property var oneshotQueue: []
   196	  property var oneshotCurrent: null
   197	
   198	  function runOneshot() {
   199	    if (oneshotProc.running || root.oneshotCurrent)
   200	      return
   201	    if (!oneshotQueue.length)
   202	      return
   203	    root.oneshotCurrent = oneshotQueue.shift()
   204	    oneshotProc.command = root.helperLaunch(JSON.stringify(root.oneshotCurrent))
   205	    oneshotProc.running = true
   206	  }
   207	
   208	  function onHelperLine(line) {
   209	    root.lastLine = String(line || "")
   210	    var msg = Protocol.parseLine(line)
   211	    if (!msg)
   212	      return
   213	    root.stdinWorks = true
   214	    if (msg.kind === "results") {
   215	      if (!Protocol.acceptQuery(msg))
   216	        return
   217	      root.lastResults = msg.results || []
   218	      if (msg.indexing !== undefined)
   219	        root.indexing = !!msg.indexing
   220	      if (msg.progress !== undefined)
   221	        root.indexProgress = Number(msg.progress) || 0
   222	      if (msg.backend)
   223	        root.backend = String(msg.backend)
   224	      root.resultsRevision += 1
   225	    } else if (msg.kind === "preview") {
   226	      var cls = Protocol.slotClass(msg.id)
   227	      var inflightPath = Protocol.pathForInFlight(msg.id)
   228	      Protocol.classifyAndClear(msg.id)
   229	      root.dispatchPending()
   230	      if (cls === "prefetch")
   231	        return
   232	      if (msg.error === "stale" && !msg.preview)
   233	        return
   234	      if (!Protocol.acceptForegroundPreview(msg))
   235	        return
   236	      root.lastPreview = msg.preview || Format.localPreview(inflightPath)
   237	      root.previewRevision += 1
   238	    } else if (msg.kind === "status") {
   239	      root.lastCaps = msg.status || {}
   240	      if (msg.indexing !== undefined)
   241	        root.indexing = !!msg.indexing
   242	      if (msg.status && msg.status.indexing !== undefined)
   243	        root.indexing = !!msg.status.indexing
   244	      if (msg.progress !== undefined)
   245	        root.indexProgress = Number(msg.progress) || 0
   246	      if (msg.status && msg.status.progress !== undefined)
   247	        root.indexProgress = Number(msg.status.progress) || 0
   248	      if (msg.backend)
   249	        root.backend = String(msg.backend)
   250	      else if (msg.status && msg.status.backend)
   251	        root.backend = String(msg.status.backend)
   252	      root.statusRevision += 1
   253	    } else if (msg.kind === "error") {
   254	      var errPath = Protocol.pathForInFlight(msg.id)
   255	      var errClass = Protocol.slotClass(msg.id)
   256	      Protocol.dropInFlight(msg.id)
   257	      root.lastStatus = "error:" + String(msg.error || "")
   258	      if (errClass === "preview")
   259	        root.applyLocalPreview(msg.id, errPath)
   260	      else
   261	        root.dispatchPending()
   262	    } else if (msg.kind === "ok") {
   263	      root.lastStatus = "ok"
   264	    }
   265	  }
   266	
   267	  function localQuery(q) {
   268	    var items = Fallback.defaultSamples(root.pluginDir)
   269	    var hits = Fallback.search(items, q, 40)
   270	    root.lastResults = hits
   271	    root.backend = "local"
   272	    root.indexing = false
   273	    root.indexProgress = 1
   274	    root.resultsRevision += 1
   275	    return hits
   276	  }
