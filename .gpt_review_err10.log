   601	def preview_image(path: Path) -> dict:
   602	    ext = path.suffix.lower().lstrip(".")
   603	    dims = svg_dims(path) if ext == "svg" else image_dims(path)
   604	    if not dims or dims[0] <= 0 or dims[1] <= 0:
   605	        return hex_preview(path, "unverifiable image", "can't render this — hex view")
