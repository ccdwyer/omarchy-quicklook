FILE bindings.lua
     1	-- QuickLook keybind snippet for Omarchy / Hyprland.
     2	-- Default: SUPER + period (.). Alternate: SUPER+SHIFT+P.
     3	-- First-run collision check: parse hyprctl binds -j objects and require
     4	-- both key=period and SUPER (modmask bit 64) without SHIFT/CTRL/ALT.
     5	--
     6	-- This file is a snippet. Paste the bind line into hyprland.conf (or your
     7	-- Omarchy bindings file). QuickLook does not write compositor config itself.
     8	--
     9	-- Hyprland:
    10	--   bind = SUPER, period, exec, omarchy-shell shell toggle io.github.chris.quicklook '{}'
    11	--   bind = SUPER SHIFT, P, exec, omarchy-shell shell toggle io.github.chris.quicklook '{}'
    12	-- File manager custom action:
    13	--   omarchy-shell shell summon io.github.chris.quicklook '{"path":"%f"}'
    14	
    15	local SUPER, SHIFT, CTRL, ALT = 64, 1, 4, 8
    16	
    17	local function binds_json()
    18	  local h = io.popen("hyprctl binds -j 2>/dev/null")
    19	  if not h then
    20	    return ""
    21	  end
    22	  local json = h:read("*a") or ""
    23	  h:close()
    24	  return json
    25	end
    26	
    27	local function has_bit(mask, bit)
    28	  return math.floor(mask / bit) % 2 == 1
    29	end
    30	
    31	local function key_is_period(key)
    32	  return key == "period" or key == "." or key == "Period"
    33	end
    34	
    35	local function super_period_bound(json)
    36	  if not json or json == "" then
    37	    return false
    38	  end
    39	  for obj in json:gmatch("%b{}") do
    40	    local key = obj:match('"key"%s*:%s*"([^"]*)"')
    41	    local mask = tonumber(obj:match('"modmask"%s*:%s*(%-?%d+)'))
    42	    if key and mask and key_is_period(key) and has_bit(mask, SUPER)
    43	        and not has_bit(mask, SHIFT) and not has_bit(mask, CTRL) and not has_bit(mask, ALT) then
    44	      return true
    45	    end
    46	  end
    47	  return false
    48	end
    49	
    50	if super_period_bound(binds_json()) then
    51	  io.stderr:write("quicklook: SUPER+. looks already bound; use SUPER+SHIFT+P instead\n")
    52	  io.stderr:write("  bind = SUPER SHIFT, P, exec, omarchy-shell shell toggle io.github.chris.quicklook '{}'\n")
    53	else
    54	  io.stderr:write("quicklook: suggested bind\n")
    55	  io.stderr:write("  bind = SUPER, period, exec, omarchy-shell shell toggle io.github.chris.quicklook '{}'\n")
    56	end
FILE build.sh
     1	#!/bin/sh
     2	# Build quicklookd. QML degrades to compat/quicklookd.sh when the binary is
     3	# missing, so a failed build is not fatal at runtime.
     4	
     5	set -eu
     6	
     7	ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
     8	SRC="$ROOT/src/quicklookd"
     9	OUT="$ROOT/bin"
    10	
    11	mkdir -p "$OUT"
    12	chmod +x "$ROOT/compat/quicklookd.sh" "$ROOT/compat/quicklookd.py" 2>/dev/null || true
    13	
    14	write_checksums() {
    15	  if command -v sha256sum >/dev/null 2>&1; then
    16	    (cd "$OUT" && sha256sum quicklookd > "$ROOT/CHECKSUMS.txt") || true
    17	  elif command -v shasum >/dev/null 2>&1; then
    18	    (cd "$OUT" && shasum -a 256 quicklookd > "$ROOT/CHECKSUMS.txt") || true
    19	  fi
    20	}
    21	
    22	if ! command -v cargo >/dev/null 2>&1; then
    23	  echo "build.sh: cargo not found; not installing a fake bin/quicklookd." >&2
    24	  echo "build.sh: Service will use compat/quicklookd.sh (degraded fallback)." >&2
    25	  exit 1
    26	fi
    27	
    28	if ! cargo build --release --manifest-path "$SRC/Cargo.toml"; then
    29	  echo "build.sh: cargo build FAILED; not installing the POSIX fallback as bin/quicklookd." >&2
    30	  echo "build.sh: the authentic helper did not compile. Service will use compat/quicklookd.sh." >&2
    31	  exit 1
    32	fi
    33	
    34	BIN="$SRC/target/release/quicklookd"
    35	if [ ! -x "$BIN" ]; then
    36	  echo "build.sh: release binary missing after cargo build" >&2
    37	  exit 1
    38	fi
    39	cp "$BIN" "$OUT/quicklookd"
    40	chmod +x "$OUT/quicklookd"
    41	write_checksums
    42	echo "build.sh: wrote $OUT/quicklookd"
    43	if [ -f "$ROOT/CHECKSUMS.txt" ]; then
    44	  echo "build.sh: checksums -> $ROOT/CHECKSUMS.txt"
    45	fi
FILE bin/quicklook
     1	#!/bin/sh
     2	# File-manager / terminal bridge: summon QuickLook on a path, or toggle the finder.
     3	set -eu
     4	id="io.github.chris.quicklook"
     5	if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
     6	  printf '%s\n' "usage: quicklook [path]" "  no args  toggle the finder overlay" "  path     summon a preview of that file"
     7	  exit 0
     8	fi
     9	if [ -n "${1:-}" ]; then
    10	  path=$1
    11	  case "$path" in
    12	    /*) ;;
    13	    *) path=$(pwd)/$path ;;
    14	  esac
    15	  esc=$(printf '%s' "$path" | od -An -t u1 -v | awk '
    16	    BEGIN { ORS="" }
    17	    {
    18	      for (i = 1; i <= NF; i++) {
    19	        n = $i + 0
    20	        if (n == 92) printf "\\\\"
    21	        else if (n == 34) printf "\\\""
    22	        else if (n == 10) printf "\\n"
    23	        else if (n == 13) printf "\\r"
    24	        else if (n == 9) printf "\\t"
    25	        else if (n < 32) printf "\\u%04x", n
    26	        else printf "%c", n
    27	      }
    28	    }
    29	  ')
    30	  exec omarchy-shell shell summon "$id" "{\"path\":\"$esc\"}"
    31	fi
    32	exec omarchy-shell shell toggle "$id" '{}'
FILE compat/quicklookd.py
     1	#!/usr/bin/env python3
     2	"""POSIX/Python fallback for quicklookd when the Rust binary is missing.
     3	
     4	Speaks the same newline-delimited JSON protocol. No nucleo, no sqlite, no
     5	watches — demo corpus + a bounded find walk + basic previews.
     6	"""
     7	from __future__ import annotations
     8	
     9	import json
    10	import os
    11	import shutil
    12	import signal
    13	import subprocess
    14	import sys
    15	from pathlib import Path
    16	
    17	def _argv_value(flag: str) -> str | None:
    18	    argv = sys.argv
    19	    for i, a in enumerate(argv):
    20	        if a == flag and i + 1 < len(argv):
    21	            return argv[i + 1]
    22	    return None
    23	
    24	
    25	_pd = _argv_value("--plugin-dir") or os.environ.get("QUICKLOOK_PLUGIN_DIR")
    26	PLUGIN_DIR = Path(_pd) if _pd else Path(__file__).resolve().parent.parent
    27	SAMPLES = PLUGIN_DIR / "samples"
    28	HOME = Path(os.environ.get("HOME", "/tmp"))
    29	STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "quicklook"
    30	CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "quicklook"
    31	SETTINGS_PATH = STATE / "compat-config.json"
    32	
    33	DEFAULT_SKIP = (
    34	    ".ssh",
    35	    ".gnupg",
    36	    ".password-store",
    37	    "node_modules",
    38	    "target",
    39	    ".git",
    40	    ".hg",
    41	    ".svn",
    42	    ".bzr",
    43	    "__pycache__",
    44	    ".venv",
    45	    "venv",
    46	    ".tox",
    47	    ".mypy_cache",
    48	    ".pytest_cache",
    49	    ".cargo",
    50	    ".rustup",
    51	    ".npm",
    52	    ".cache",
    53	    ".Trash",
    54	    ".local",
    55	    "keyrings",
    56	    "kwalletd",
    57	    "Keychains",
    58	)
    59	SKIP_PATH_PARTS = (
    60	    "/.ssh/",
    61	    "/.gnupg/",
    62	    "/.password-store/",
    63	    "/.local/share/keyrings/",
    64	    "/.local/share/kwalletd/",
    65	    "/Library/Keychains/",
    66	)
    67	MEGAPIXELS = 20_000_000
    68	
    69	SETTINGS = {
    70	    "roots": [str(HOME)],
    71	    "extraExclude": [],
    72	    "watchCap": 2000,
    73	    "cacheMb": 500,
    74	    "maxFiles": 500000,
    75	}
    76	
    77	
    78	def _expand(p: str) -> str:
    79	    if p == "~":
    80	        return str(HOME)
    81	    if p.startswith("~/"):
    82	        return str(HOME / p[2:])
    83	    return p
    84	
    85	
    86	def load_settings() -> None:
    87	    if not SETTINGS_PATH.is_file():
    88	        return
    89	    try:
    90	        data = json.loads(SETTINGS_PATH.read_text())
    91	    except (OSError, json.JSONDecodeError):
    92	        return
    93	    apply_settings(data, persist=False)
    94	
    95	
    96	def apply_settings(data: dict, persist: bool = True) -> None:
    97	    if not isinstance(data, dict):
    98	        return
    99	    if data.get("roots") is not None:
   100	        roots = data["roots"]
   101	        if isinstance(roots, str):
   102	            roots = [r.strip() for r in roots.split(",") if r.strip()]
   103	        SETTINGS["roots"] = [_expand(str(r)) for r in roots] or [str(HOME)]
   104	    if data.get("extraExclude") is not None:
   105	        extra = data["extraExclude"]
   106	        if isinstance(extra, str):
   107	            extra = [x.strip() for x in extra.split(",") if x.strip()]
   108	        SETTINGS["extraExclude"] = [str(x) for x in extra]
   109	    if data.get("watchCap") is not None:
   110	        SETTINGS["watchCap"] = max(16, int(data["watchCap"] or 2000))
   111	    if data.get("cacheMb") is not None:
   112	        SETTINGS["cacheMb"] = max(16, int(data["cacheMb"] or 500))
   113	    if data.get("maxFiles") is not None:
   114	        SETTINGS["maxFiles"] = max(1000, int(data["maxFiles"] or 500000))
   115	    if persist:
   116	        try:
   117	            STATE.mkdir(parents=True, exist_ok=True)
   118	            SETTINGS_PATH.write_text(json.dumps(SETTINGS))
   119	        except OSError:
   120	            pass
   121	
   122	
   123	def skip_parts() -> tuple[str, ...]:
   124	    return DEFAULT_SKIP + tuple(SETTINGS["extraExclude"])
   125	
   126	
   127	def is_secret_filename(name: str) -> bool:
   128	    if name == ".env" or name.startswith(".env.") or name.endswith(".env"):
   129	        return True
   130	    if name in ("id_rsa", "id_ed25519") or name.startswith("id_rsa."):
   131	        return True
   132	    return False
   133	
   134	
   135	def path_is_secret(path: Path) -> bool:
   136	    s = str(path)
   137	    if any(part in s for part in SKIP_PATH_PARTS):
   138	        return True
   139	    return is_secret_filename(path.name)
   140	
   141	
   142	def hidden_or_heavy_dir(name: str, extra: list[str]) -> bool:
   143	    if name in DEFAULT_SKIP or name in extra:
   144	        return True
   145	    return name.startswith(".") and name not in (".", "..")
   146	
   147	
   148	def should_skip_result(path: Path, extra: list[str] | None = None) -> bool:
   149	    extra = extra if extra is not None else list(SETTINGS["extraExclude"])
   150	    roots = [Path(r) for r in SETTINGS["roots"] if r]
   151	    if path_is_secret(path):
   152	        return True
   153	    for parent in [path] + list(path.parents):
   154	        if any(parent == r or parent == Path(str(r)) for r in roots):
   155	            break
   156	        if hidden_or_heavy_dir(parent.name, extra):
   157	            return True
   158	    return False
   159	
   160	
   161	load_settings()
   162	
   163	
   164	def kind_of(path: Path, is_dir: bool = False) -> str:
   165	    if is_dir or path.is_dir():
   166	        return "dir"
   167	    ext = path.suffix.lower().lstrip(".")
   168	    name = path.name.lower()
   169	    if name in ("makefile", "dockerfile"):
   170	        return "code"
   171	    if ext in ("png", "jpg", "jpeg", "webp", "svg", "gif", "bmp", "ico"):
   172	        return "image"
   173	    if ext == "pdf":
   174	        return "pdf"
   175	    if ext in ("csv", "tsv"):
   176	        return "csv"
   177	    if ext in ("mp4", "webm", "mkv", "mov", "avi"):
   178	        return "video"
   179	    if ext in (
   180	        "rs", "js", "ts", "py", "go", "c", "h", "cpp", "java", "kt", "rb", "php",
   181	        "sh", "lua", "qml", "json", "yaml", "yml", "toml", "md", "html", "css",
   182	        "xml", "sql", "swift", "txt", "conf", "ini",
   183	    ):
   184	        return "code"
   185	    return "hex"
   186	
   187	
   188	def demo() -> list[dict]:
   189	    names = ["invoice.pdf", "photo.png", "sales.csv", "themed.rs", "README.md"]
   190	    out = []
   191	    for i, name in enumerate(names):
   192	        p = SAMPLES / name
   193	        out.append(
   194	            {
   195	                "path": str(p),
   196	                "name": name,
   197	                "kind": kind_of(p),
   198	                "score": 900 - i * 10,
   199	                "mtime": int(p.stat().st_mtime * 1000) if p.exists() else 0,
   200	                "size": p.stat().st_size if p.exists() else 0,
   201	            }
   202	        )
   203	    return out
   204	
   205	
   206	def fuzzy(hay: str, needle: str) -> int:
   207	    h = hay.lower()
   208	    n = needle.lower()
   209	    if not n:
   210	        return 1
   211	    if n in h:
   212	        return 800 - h.find(n)
   213	    hi = 0
   214	    score = 0
   215	    for ch in n:
   216	        pos = h.find(ch, hi)
   217	        if pos < 0:
   218	            return 0
   219	        score += 8
   220	        hi = pos + 1
   221	    return score
   222	
   223	
   224	def search(q: str) -> tuple[list[dict], str]:
   225	    if not q.strip():
   226	        return demo(), "demo"
   227	    hits = []
   228	    for item in demo():
   229	        s = max(fuzzy(item["name"], q), fuzzy(item["path"], q))
   230	        if s > 0:
   231	            item = dict(item)
   232	            item["score"] = s + 200
   233	            hits.append(item)
   234	    backend = "compat"
   235	    found = find_names(q, 40)
   236	    for item in found:
   237	        if any(h["path"] == item["path"] for h in hits):
   238	            continue
   239	        hits.append(item)
   240	    hits.sort(key=lambda x: (-x["score"], x["name"]))
   241	    return hits[:40], backend
   242	
   243	
   244	def _hits_from_paths(paths: list[str], q: str, cap: int) -> list[dict]:
   245	    extra = list(SETTINGS["extraExclude"])
   246	    out: list[dict] = []
   247	    for line in paths:
   248	        p = Path(line)
   249	        if should_skip_result(p, extra):
   250	            continue
   251	        try:
   252	            st = p.stat()
   253	        except OSError:
   254	            continue
   255	        out.append(
   256	            {
   257	                "path": str(p),
   258	                "name": p.name,
   259	                "kind": kind_of(p, p.is_dir()),
   260	                "score": fuzzy(p.name, q),
   261	                "mtime": int(st.st_mtime * 1000),
   262	                "size": st.st_size,
   263	            }
   264	        )
   265	        if len(out) >= cap:
   266	            break
   267	    return out
