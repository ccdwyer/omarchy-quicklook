   601	def preview_image(path: Path) -> dict:
   602	    ext = path.suffix.lower().lstrip(".")
   603	    dims = svg_dims(path) if ext == "svg" else image_dims(path)
   604	    if not dims or dims[0] <= 0 or dims[1] <= 0:
   605	        return hex_preview(path, "unverifiable image", "can't render this — hex view")
   606	    w, h = dims
   607	    if w * h > MEGAPIXELS:
   608	        ds = downsample_image(path, w, h)
   609	        if ds:
   610	            return ds
   611	        return hex_preview(
   612	            path,
   613	            f"image {w}x{h}",
   614	            "image exceeds 20 MP — hex view",
   615	            width=w,
   616	            height=h,
   617	        )
   618	    return {
   619	        "kind": "image",
   620	        "path": str(path),
   621	        "animated": ext == "gif",
   622	        "width": w,
   623	        "height": h,
   624	    }
   625	
   626	
   627	def pdf_page_count(path: Path) -> int:
   628	    info = shutil.which("pdfinfo")
   629	    if info:
   630	        try:
   631	            proc = run_killable(
   632	                [info, str(path)],
   633	                timeout_s=2,
   634	                capture_output=True,
   635	                text=True,
   636	            )
   637	            for line in proc.stdout.splitlines():
   638	                if line.startswith("Pages:"):
   639	                    n = int(line.split(":", 1)[1].strip() or "1")
   640	                    return max(1, n)
   641	        except (subprocess.TimeoutExpired, OSError, ValueError):
   642	            pass
   643	    head = read_capped(path, 256 * 1024).decode("latin-1", errors="replace")
   644	    best = 1
   645	    idx = 0
   646	    while True:
   647	        at = head.find("/Count", idx)
   648	        if at < 0:
   649	            break
   650	        rest = head[at + 6 :].lstrip()
   651	        digits = ""
   652	        for ch in rest:
   653	            if ch.isdigit():
   654	                digits += ch
   655	            elif digits:
   656	                break
   657	        if digits:
   658	            n = int(digits)
   659	            if 1 < n < 10_000 and n > best:
   660	                best = n
   661	        idx = at + 6
   662	    return best
   663	
   664	
   665	def preview_pdf(path: Path, page: int = 1) -> dict:
   666	    has_poppler = shutil.which("pdftoppm") is not None
   667	    page_count = pdf_page_count(path)
   668	    page = max(1, min(int(page or 1), page_count))
   669	    if not has_poppler:
   670	        return {
   671	            "kind": "pdf",
   672	            "need_poppler": True,
   673	            "page": page,
   674	            "page_count": page_count,
   675	            "magic": "PDF document",
   676	            "label": "install poppler for PDF previews",
   677	            "path": str(path),
   678	        }
   679	    cache_dir = CACHE / "pdf"
   680	    try:
   681	        cache_dir.mkdir(parents=True, exist_ok=True)
   682	    except OSError:
   683	        cache_dir = Path("/tmp") / "quicklook-pdf"
   684	        cache_dir.mkdir(parents=True, exist_ok=True)
   685	    key = abs(hash(f"{path}:{path.stat().st_mtime if path.exists() else 0}:{page}"))
   686	    dest = cache_dir / f"{key}.png"
   687	    if dest.is_file() and dest.stat().st_size > 0:
   688	        return {
   689	            "kind": "pdf",
   690	            "path": str(dest),
   691	            "page": page,
   692	            "page_count": page_count,
   693	            "need_poppler": False,
   694	        }
   695	    prefix = dest.with_suffix("")
   696	    try:
   697	        proc = run_killable(
   698	            [
   699	                "pdftoppm",
   700	                "-f",
   701	                str(page),
   702	                "-l",
   703	                str(page),
   704	                "-png",
   705	                "-r",
   706	                "140",
   707	                "-singlefile",
   708	                str(path),
   709	                str(prefix),
   710	            ],
   711	            timeout_s=8,
   712	            capture_output=True,
   713	        )
   714	    except (subprocess.TimeoutExpired, OSError):
   715	        proc = None
   716	    if dest.is_file() and dest.stat().st_size > 0:
   717	        return {
   718	            "kind": "pdf",
   719	            "path": str(dest),
   720	            "page": page,
   721	            "page_count": page_count,
   722	            "need_poppler": False,
   723	        }
   724	    # Some pdftoppm builds append -1 even with -singlefile.
   725	    alt = Path(str(prefix) + "-1.png")
   726	    if alt.is_file() and alt.stat().st_size > 0:
   727	        return {
   728	            "kind": "pdf",
   729	            "path": str(alt),
   730	            "page": page,
   731	            "page_count": page_count,
   732	            "need_poppler": False,
   733	        }
   734	    _ = proc
   735	    return {
   736	        "kind": "pdf",
   737	        "need_poppler": False,
   738	        "render_error": True,
   739	        "page": page,
   740	        "page_count": page_count,
   741	        "label": "couldn't render this page",
   742	        "magic": "PDF document",
   743	        "hex": hex_dump(read_capped(path, 256)),
   744	        "path": None,
   745	    }
