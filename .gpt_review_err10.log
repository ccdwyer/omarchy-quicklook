   270	def plocate_names(q: str, limit: int) -> list[dict] | None:
   271	    binary = shutil.which("plocate") or shutil.which("locate")
   272	    if not binary:
   273	        return None
   274	    try:
   275	        proc = run_killable(
   276	            [binary, "-il", str(limit), "--", q],
   277	            timeout_s=2,
   278	            capture_output=True,
   279	            text=True,
   280	        )
   281	    except (subprocess.TimeoutExpired, OSError):
   282	        return None
   283	    if not proc.stdout.strip():
   284	        return None
   285	    hits = _hits_from_paths(proc.stdout.splitlines(), q, limit)
   286	    roots = [Path(r) for r in SETTINGS["roots"] if r]
   287	    if roots:
   288	        hits = [
   289	            h
   290	            for h in hits
   291	            if any(Path(h["path"]) == r or str(h["path"]).startswith(str(r) + "/") for r in roots)
   292	        ]
   293	    return hits or None
