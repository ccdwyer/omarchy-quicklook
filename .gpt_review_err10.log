   559	csv_preview_json() {
   560	  path="$1"
   561	  read_user_file head -n 501 "$path" 2>/dev/null | awk '
   562	    function esc(s) {
   563	      gsub(/\\/, "\\\\", s)
   564	      gsub(/"/, "\\\"", s)
   565	      return s
   566	    }
   567	    function arr(line,    n, i, out, a) {
   568	      n = split(line, a, FS)
   569	      out = "["
   570	      for (i = 1; i <= n; i++) {
   571	        if (i > 1) out = out ","
   572	        out = out "\"" esc(a[i]) "\""
   573	      }
   574	      return out "]"
   575	    }
   576	    BEGIN { headers = "[]"; rows = ""; nbody = 0 }
   577	    NR == 1 {
   578	      line = $0
   579	      c = gsub(/,/, ",", line)
   580	      line = $0
   581	      t = gsub(/\t/, "\t", line)
   582	      line = $0
   583	      s = gsub(/;/, ";", line)
   584	      line = $0
   585	      p = gsub(/\|/, "|", line)
   586	      FS = ","
   587	      if (t > c && t >= s && t >= p) FS = "\t"
   588	      else if (s > c && s >= t && s >= p) FS = ";"
   589	      else if (p > c && p >= t && p >= s) FS = "|"
   590	      $0 = $0
   591	      headers = arr($0)
   592	      next
   593	    }
   594	    {
   595	      if (nbody) rows = rows ","
   596	      rows = rows arr($0)
   597	      nbody++
   598	    }
   599	    END {
   600	      trunc = (NR > 501) ? "true" : "false"
   601	      printf "{\"kind\":\"csv\",\"headers\":%s,\"rows\":[%s],\"truncated\":%s}", headers, rows, trunc
   602	    }
   603	  '
   604	}
