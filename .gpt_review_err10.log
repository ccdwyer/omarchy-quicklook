   120	    #[test]
   121	    fn gc_drops_oldest_until_budget() {
   122	        let dir = env::temp_dir().join(format!("ql-cache-{}", std::process::id()));
   123	        let _ = fs::remove_dir_all(&dir);
   124	        let cache = PreviewCache::new(dir.clone(), 64);
   125	        cache.store_bytes(&["a"], "bin", &[0u8; 50]).unwrap();
   126	        std::thread::sleep(std::time::Duration::from_millis(20));
