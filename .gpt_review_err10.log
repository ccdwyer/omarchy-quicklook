FILE scripts/fetch-helper.sh
     1	#!/bin/sh
     2	# Optional: download a musl quicklookd from the latest GitHub release.
     3	# Verifies the published CHECKSUMS.txt before installing.
     4	# Not required — the plugin runs without it via compat/.
     5	set -eu
     6	
     7	ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
     8	OUT="$ROOT/bin"
     9	REPO="${QUICKLOOK_RELEASE_REPO:-}"
    10	
    11	if [ -z "$REPO" ]; then
    12	  echo "fetch-helper: set QUICKLOOK_RELEASE_REPO=owner/repo to download a musl build" >&2
    13	  echo "fetch-helper: or run $ROOT/build.sh to compile locally" >&2
    14	  exit 1
    15	fi
    16	
    17	arch=$(uname -m)
    18	case "$arch" in
    19	  x86_64|amd64) target=x86_64-unknown-linux-musl ;;
    20	  aarch64|arm64) target=aarch64-unknown-linux-musl ;;
    21	  *) echo "fetch-helper: unsupported arch $arch" >&2; exit 1 ;;
    22	esac
    23	
    24	asset="quicklookd-$target"
    25	base="https://github.com/$REPO/releases/latest/download"
    26	mkdir -p "$OUT"
    27	tmp=$(mktemp)
    28	sumfile=$(mktemp)
    29	cleanup() { rm -f "$tmp" "$sumfile"; }
    30	trap cleanup EXIT
    31	
    32	if ! command -v curl >/dev/null 2>&1; then
    33	  echo "fetch-helper: curl required" >&2
    34	  exit 1
    35	fi
    36	if ! curl -fsSL "$base/CHECKSUMS.txt" -o "$sumfile"; then
    37	  echo "fetch-helper: could not download CHECKSUMS.txt from $base" >&2
    38	  exit 1
    39	fi
    40	if ! curl -fsSL "$base/$asset" -o "$tmp"; then
    41	  echo "fetch-helper: download failed ($base/$asset)" >&2
    42	  exit 1
    43	fi
    44	
    45	if command -v sha256sum >/dev/null 2>&1; then
    46	  got=$(sha256sum "$tmp" | awk '{print $1}')
    47	elif command -v shasum >/dev/null 2>&1; then
    48	  got=$(shasum -a 256 "$tmp" | awk '{print $1}')
    49	else
    50	  echo "fetch-helper: need sha256sum or shasum to verify the download" >&2
    51	  exit 1
    52	fi
    53	
    54	expected=$(awk -v a="$asset" '$2 == a { print $1; exit }' "$sumfile")
    55	if [ -z "$expected" ]; then
    56	  echo "fetch-helper: $asset not listed in CHECKSUMS.txt" >&2
    57	  cat "$sumfile" >&2
    58	  exit 1
    59	fi
    60	if [ "$expected" != "$got" ]; then
    61	  echo "fetch-helper: checksum mismatch for $asset" >&2
    62	  echo "  expected $expected" >&2
    63	  echo "  got      $got" >&2
    64	  exit 1
    65	fi
    66	
    67	chmod +x "$tmp"
    68	mv "$tmp" "$OUT/quicklookd"
    69	trap - EXIT
    70	echo "fetch-helper: wrote $OUT/quicklookd (sha256 $got)"
