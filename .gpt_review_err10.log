   777	do_open() {
   778	  path="$1"
   779	  reveal="$2"
   780	  if [ ! -e "$path" ]; then
   781	    return 1
   782	  fi
   783	  target="$path"
   784	  if [ "$reveal" = 1 ] && [ ! -d "$path" ]; then
   785	    target=$(dirname "$path")
   786	  fi
   787	  watchdog_ok || return 2
   788	  if command -v gio >/dev/null 2>&1; then
   789	    run_watchdog 8 gio open "$target" >/dev/null 2>&1 || true
   790	    return 0
   791	  fi
