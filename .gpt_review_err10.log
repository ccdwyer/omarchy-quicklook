   485	    fi
   486	  done
   487	  find_hits "$q" "$tmp"
   488	  sorted=$(mktemp)
   489	  sort -nr -k1,1 "$tmp" > "$sorted" 2>/dev/null || true
   490	  body=""
   491	  n=0
   492	  while read -r _sc hit; do
   493	    [ -n "$hit" ] || continue
   494	    n=$((n + 1))
   495	    [ "$n" -le 40 ] || break
   496	    if [ -z "$body" ]; then
   497	      body="$hit"
   498	    else
   499	      body="$body,$hit"
   500	    fi
   501	  done < "$sorted"
   502	  printf '{"id":%s,"kind":"results","results":[%s],"indexing":false,"progress":1,"backend":"compat"}\n' "$id" "$body"
   503	  rm -f "$tmp" "$sorted"
