     1	import QtQuick
     2	import qs.Commons
     3	import qs.Ui
     4	import "js/Format.js" as Format
     5	import "js/Theme.js" as Theme
     6	
     7	Item {
     8	  id: root
     9	
    10	  property var preview: ({})
    11	  property string emptyReason: ""
    12	  property string emptyDetail: ""
    13	  property bool loading: false
    14	  property var palette: Theme.defaultPalette()
    15	  property color foreground: "#c0caf5"
    16	  property color accent: "#7aa2f7"
    17	  property string fontFamily: "sans-serif"
    18	  property string monoFamily: "monospace"
    19	  property int pinPage: 1
    20	
    21	  readonly property string kind: String(preview && preview.kind ? preview.kind : "")
    22	  readonly property bool needPoppler: preview && preview.need_poppler === true
    23	  readonly property bool renderError: preview && preview.render_error === true
    24	  readonly property bool pdfRaster: {
    25	    if (root.kind !== "pdf" || root.needPoppler || root.renderError)
    26	      return false
    27	    if (!preview || !preview.path)
    28	      return false
    29	    return Format.isRasterPath(preview.path)
    30	  }
    31	  readonly property bool largeFile: preview && (preview.large === true || preview.capped === true)
    32	
    33	  function cellText(row, col) {
    34	    if (!preview || !preview.rows || col >= preview.rows[row].length)
    35	      return ""
    36	    return String(preview.rows[row][col] || "")
    37	  }
    38	
    39	  Rectangle {
    40	    anchors.fill: parent
    41	    color: "transparent"
    42	
    43	    // loading
    44	    Column {
    45	      anchors.centerIn: parent
    46	      spacing: Style.space(8)
    47	      visible: root.loading && root.kind === ""
    48	      Text {
    49	        text: "rendering…"
    50	        color: root.foreground
    51	        font.family: root.fontFamily
    52	        font.pixelSize: Style.font.body
    53	        opacity: 0.7
    54	      }
    55	    }
    56	
    57	    // designed empty states
    58	    Column {
    59	      anchors.centerIn: parent
    60	      width: Math.min(parent.width - Style.space(40), Style.space(420))
    61	      spacing: Style.space(10)
    62	      visible: !root.loading && root.kind === "" && root.emptyReason.length > 0
    63	
    64	      Text {
    65	        width: parent.width
    66	        text: root.emptyReason
    67	        color: root.foreground
    68	        font.family: root.fontFamily
    69	        font.pixelSize: Style.font.title
    70	        wrapMode: Text.WordWrap
    71	        horizontalAlignment: Text.AlignHCenter
    72	      }
    73	      Text {
    74	        width: parent.width
    75	        text: root.emptyDetail
