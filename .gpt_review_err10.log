   408	
   409	def run_killable(
   410	    argv: list[str],
   411	    timeout_s: float = 8,
   412	    capture_output: bool = False,
   413	    text: bool = False,
   414	    limits: bool = True,
   415	) -> subprocess.CompletedProcess:
   416	    """Spawn in a new session and kill the whole process group on timeout."""
   417	    stdout = subprocess.PIPE if capture_output else subprocess.DEVNULL
   418	    stderr = subprocess.PIPE if capture_output else subprocess.DEVNULL
   419	    # New session so timeout can kill the whole group. Cannot combine
   420	    # start_new_session with preexec_fn; setsid in preexec when limits apply.
   421	    if limits:
   422	        def preexec() -> None:
   423	            try:
   424	                os.setsid()
   425	            except OSError:
   426	                pass
   427	            _limit_child()
   428	
   429	        extra = {"preexec_fn": preexec}
   430	    else:
   431	        extra = {"start_new_session": True}
   432	
   433	    proc = subprocess.Popen(
   434	        argv,
   435	        stdout=stdout,
   436	        stderr=stderr,
   437	        **extra,
   438	    )
   439	    pgid = proc.pid
   440	    try:
   441	        out, err = proc.communicate(timeout=timeout_s)
   442	    except subprocess.TimeoutExpired as exc:
   443	        _kill_group(proc, pgid)
   444	        try:
   445	            out, err = proc.communicate(timeout=2)
   446	        except (subprocess.TimeoutExpired, OSError):
   447	            out, err = exc.output or b"", exc.stderr or b""
   448	        raise subprocess.TimeoutExpired(argv, timeout_s, output=out, stderr=err) from None
   449	    if text:
   450	        enc = sys.getdefaultencoding()
   451	        out = out.decode(enc, errors="replace") if isinstance(out, (bytes, bytearray)) else (out or "")
   452	        err = err.decode(enc, errors="replace") if isinstance(err, (bytes, bytearray)) else (err or "")
   453	    return subprocess.CompletedProcess(argv, proc.returncode, out, err)
