   362	def _limit_child() -> None:
   363	    try:
   364	        import resource
   365	    except ImportError:
   366	        return
   367	    for name, soft in (
   368	        ("RLIMIT_CPU", 8),
   369	        ("RLIMIT_AS", 512 * 1024 * 1024),
   370	        ("RLIMIT_NPROC", 8),
   371	        ("RLIMIT_FSIZE", 32 * 1024 * 1024),
   372	    ):
   373	        lim = getattr(resource, name, None)
   374	        if lim is None:
   375	            continue
   376	        try:
   377	            resource.setrlimit(lim, (soft, soft))
   378	        except (ValueError, OSError):
   379	            pass
