   271	fn header_dims(path: &Path) -> Option<(u32, u32)> {
   272	    if let Some(d) = sniff_raster_dims(path) {
   273	        return Some(d);
   274	    }
   275	    let reader = image::ImageReader::open(path).ok()?;
   276	    let reader = reader.with_guessed_format().ok()?;
   277	    reader.into_dimensions().ok()
   278	}
   279	
   280	fn sniff_raster_dims(path: &Path) -> Option<(u32, u32)> {
   281	    let head = read_capped(path, 96 * 1024).ok()?;
   282	    if head.len() >= 24 && head.starts_with(b"\x89PNG\r\n\x1a\n") {
   283	        let w = u32::from_be_bytes(head[16..20].try_into().ok()?);
   284	        let h = u32::from_be_bytes(head[20..24].try_into().ok()?);
   285	        if w > 0 && h > 0 {
   286	            return Some((w, h));
   287	        }
   288	    }
   289	    if head.len() >= 10 && (head.starts_with(b"GIF87a") || head.starts_with(b"GIF89a")) {
   290	        let w = u16::from_le_bytes(head[6..8].try_into().ok()?) as u32;
   291	        let h = u16::from_le_bytes(head[8..10].try_into().ok()?) as u32;
   292	        if w > 0 && h > 0 {
   293	            return Some((w, h));
   294	        }
   295	    }
   296	    None
   297	}
