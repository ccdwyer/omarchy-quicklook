   270	def plocate_names(q: str, limit: int) -> list[dict] | None:
   271	    binary = shutil.which("plocate") or shutil.which("locate")
   272	    if not binary:
   273	        return None
   274	    try:
   275	        proc = run_killable(
   276	            [binary, "-il", str(limit), "--", q],
   277	            timeout_s=2,
   278	            capture_output=True,
   279	            text=True,
   280	        )
   281	    except (subprocess.TimeoutExpired, OSError):
   282	        return None
   283	    if not proc.stdout.strip():
   284	        return None
   285	    hits = _hits_from_paths(proc.stdout.splitlines(), q, limit)
   286	    roots = [Path(r) for r in SETTINGS["roots"] if r]
   287	    if roots:
   288	        hits = [
   289	            h
   290	            for h in hits
   291	            if any(Path(h["path"]) == r or str(h["path"]).startswith(str(r) + "/") for r in roots)
   292	        ]
   293	    return hits or None
   294	
   295	
   296	def find_names(q: str, limit: int) -> list[dict]:
   297	    roots = [r for r in SETTINGS["roots"] if r]
   298	    if not roots:
   299	        roots = [str(HOME)]
   300	    cap = min(int(limit), 40)
   301	    q = "".join(ch for ch in q if ch.isalnum() or ch in "._-")
   302	    if not q:
   303	        return []
   304	    located = plocate_names(q, cap)
   305	    if located:
   306	        return located
   307	    if shutil.which("find") is None:
   308	        return []
   309	    skip = skip_parts()
   310	    prune: list[str] = []
   311	    for name in skip:
   312	        if prune:
   313	            prune.append("-o")
   314	        prune.extend(["-name", name])
   315	    if prune:
   316	        prune.extend(["-o", "-name", ".*"])
   317	    else:
   318	        prune.extend(["-name", ".*"])
   319	    cmd = ["find", *roots, "-mindepth", "1"]
   320	    cmd.extend(["(", *prune, ")", "-prune", "-o", "-iname", f"*{q}*", "-print"])
   321	    try:
   322	        proc = run_killable(cmd, timeout_s=2, capture_output=True, text=True)
   323	    except (subprocess.TimeoutExpired, OSError):
   324	        return []
   325	    return _hits_from_paths(proc.stdout.splitlines(), q, cap)
