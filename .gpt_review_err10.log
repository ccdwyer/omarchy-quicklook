   380	pub fn preview_code(path: &Path, theme: &Theme) -> Preview {
   381	    let bytes = match read_capped(path, CODE_CAP + 1) {
   382	        Ok(b) => b,
   383	        Err(_) => return preview_hex(path),
   384	    };
   385	    let large = bytes.len() > CODE_CAP;
   386	    let slice = if large { &bytes[..CODE_CAP] } else { &bytes };
   387	    let text = String::from_utf8_lossy(slice);
   388	    if looks_binary(slice) {
   389	        return preview_hex(path);
   390	    }
   391	    let ext = ext_of(path);
   392	    let ps = syntaxes();
   393	    let syntax = ps
   394	        .find_syntax_by_extension(&ext)
   395	        .or_else(|| ps.find_syntax_by_name("Plain Text"))
   396	        .unwrap_or_else(|| ps.find_syntax_plain_text());
   397	    let mut h = HighlightLines::new(syntax, theme);
   398	    let mut html = String::from("<pre>");
   399	    for line in LinesWithEndings::from(&text) {
   400	        let ranges = h.highlight_line(line, ps).unwrap_or_default();
   401	        for (style, chunk) in ranges {
   402	            html.push_str(&font_span(style, chunk));
   403	        }
   404	    }
   405	    html.push_str("</pre>");
   406	    Preview {
   407	        kind: "code".into(),
   408	        html: Some(html),
   409	        lang: Some(if syntax.name == "Plain Text" {
   410	            "text".into()
   411	        } else {
   412	            syntax.name.to_ascii_lowercase()
   413	        }),
   414	        capped: Some(large),
   415	        large: Some(large),
   416	        label: if large { Some("large file".into()) } else { None },
   417	        path: Some(path.to_string_lossy().into()),
   418	        ..Preview::default()
   419	    }
   420	}
