   157	fn downsampled_preview(dest: &Path, nw: u32, nh: u32) -> Preview {
   158	    Preview {
   159	        kind: "image".into(),
   160	        path: Some(dest.to_string_lossy().into()),
   161	        width: Some(nw),
   162	        height: Some(nh),
   163	        label: Some("downsampled".into()),
   164	        animated: Some(false),
   165	        ..Preview::default()
   166	    }
   167	}
   168	
   169	fn downsample_external(src: &Path, dest: &Path, nw: u32, nh: u32) -> bool {
   170	    let src_s = src.to_string_lossy().into_owned();
   171	    let dest_s = dest.to_string_lossy().into_owned();
   172	    let scale = format!("{nw}:{nh}");
   173	    let geom = format!("{nw}x{nh}");
   174	    let candidates: Vec<Command> = {
   175	        let mut v = Vec::new();
   176	        if let Some(bin) = which("ffmpeg") {
   177	            let mut c = Command::new(bin);
   178	            c.args([
   179	                "-nostdin",
   180	                "-hide_banner",
   181	                "-loglevel",
   182	                "error",
   183	                "-i",
   184	                &src_s,
   185	                "-vf",
   186	                &format!("scale={scale}"),
   187	                "-frames:v",
   188	                "1",
   189	                "-y",
   190	                &dest_s,
   191	            ]);
   192	            v.push(c);
   193	        }
   194	        if let Some(bin) = which("magick") {
   195	            let mut c = Command::new(bin);
   196	            c.args([&src_s, "-resize", &geom, &dest_s]);
   197	            v.push(c);
   198	        }
   199	        if let Some(bin) = which("convert") {
   200	            let mut c = Command::new(bin);
   201	            c.args([&src_s, "-resize", &geom, &dest_s]);
   202	            v.push(c);
   203	        }
   204	        v
   205	    };
   206	    for cmd in candidates {
   207	        if dest.is_file() {
   208	            let _ = fs::remove_file(dest);
   209	        }
   210	        if run_limited(cmd, Duration::from_secs(12), 512 * 1024 * 1024, 12).is_ok()
   211	            && usable_cache_file(dest)
   212	        {
   213	            return true;
   214	        }
   215	    }
   216	    false
   217	}
   218	
   219	fn downsample_self(src: &Path, dest: &Path, nw: u32, nh: u32) -> bool {
   220	    if cfg!(test) {
   221	        return false;
   222	    }
   223	    let exe = match std::env::current_exe() {
   224	        Ok(e) => e,
   225	        Err(_) => return false,
   226	    };
   227	    let name = exe.file_name().and_then(|n| n.to_str()).unwrap_or("");
   228	    if name != "quicklookd" {
   229	        return false;
   230	    }
   231	    let mut cmd = Command::new(exe);
   232	    cmd.args([
   233	        "--downsample",
   234	        &src.to_string_lossy(),
   235	        &dest.to_string_lossy(),
   236	        &nw.to_string(),
   237	        &nh.to_string(),
   238	    ]);
   239	    run_limited(cmd, Duration::from_secs(12), 512 * 1024 * 1024, 12).is_ok() && usable_cache_file(dest)
   240	}
   241	
   242	pub fn downsample_cli(src: &Path, dest: &Path, nw: u32, nh: u32) -> i32 {
   243	    let nw = nw.max(1);
   244	    let nh = nh.max(1);
   245	    let img = match decode_for_downsample(src) {
   246	        Ok(i) => i,
   247	        Err(_) => return 1,
   248	    };
   249	    let resized = img.resize(nw, nh, image::imageops::FilterType::Triangle);
   250	    if let Some(parent) = dest.parent() {
   251	        let _ = fs::create_dir_all(parent);
   252	    }
   253	    if resized.save(dest).is_ok() {
   254	        0
   255	    } else {
   256	        1
   257	    }
   258	}
