   401	    fn do_preview(&self, req: &Request) -> Response {
   402	        let path = match req.path.as_deref() {
   403	            Some(p) => PathBuf::from(p),
   404	            None => return Response::error(req.id, "missing path"),
   405	        };
   406	        self.inner.latest_preview.store(req.id, Ordering::SeqCst);
   407	        let theme = self.inner.syn_theme.lock().unwrap().clone();
   408	        let palette = self.inner.theme.lock().unwrap().clone();
   409	        let page = req.page.unwrap_or(1);
   410	        let preview = preview::render(
   411	            &path,
   412	            page,
   413	            &theme,
   414	            &palette,
   415	            &self.inner.cache,
   416	            self.inner.ffmpeg,
   417	            self.inner.poppler,
   418	        );
   419	        if self.inner.latest_preview.load(Ordering::SeqCst) != req.id {
   420	            return Response {
   421	                id: req.id,
   422	                kind: "preview".into(),
   423	                results: None,
   424	                preview: None,
   425	                status: None,
   426	                error: Some("stale".into()),
   427	                indexing: None,
   428	                progress: None,
   429	                backend: None,
   430	            };
   431	        }
   432	        Response {
   433	            id: req.id,
   434	            kind: "preview".into(),
   435	            results: None,
   436	            preview: Some(preview),
   437	            status: None,
   438	            error: None,
   439	            indexing: None,
   440	            progress: None,
   441	            backend: None,
   442	        }
   443	    }
   444	}
   445	
   446	fn still_current(inner: &Inner, gen: u64) -> bool {
   447	    inner.index_gen.load(Ordering::SeqCst) == gen
   448	}
   449	
   450	fn warmup_loop(inner: Arc<Inner>, gen: u64) {
   451	    if !still_current(&inner, gen) {
   452	        return;
   453	    }
   454	    inner.indexing.store(true, Ordering::SeqCst);
   455	    inner.progress_cents.store(0, Ordering::SeqCst);
   456	    let cfg = inner.cfg.lock().unwrap().clone();
   457	    let walk_cfg = WalkConfig {
   458	        roots: cfg.roots.clone(),
   459	        extra_exclude: cfg.extra_exclude.clone(),
   460	        max_files: cfg.max_files,
   461	        max_depth: 16,
   462	    };
   463	    let samples = search::demo_files(&cfg.samples_dir);
   464	    *inner.samples.lock().unwrap() = samples.clone();
   465	    let collected = search::walk_index(&walk_cfg, |batch, seen| {
   466	        if !still_current(&inner, gen) {
   467	            return false;
   468	        }
   469	        let cap = walk_cfg.max_files.max(1);
   470	        let pct = ((seen.min(cap) as f32 / cap as f32) * 10000.0) as u32;
   471	        inner.progress_cents.store(pct.min(9999), Ordering::SeqCst);
   472	        let merged = search::merge_unique(samples.clone(), batch.to_vec());
   473	        *inner.files.lock().unwrap() = merged;
   474	        *inner.backend.lock().unwrap() = "index-warming".into();
   475	        true
   476	    });
   477	    if !still_current(&inner, gen) {
   478	        return;
   479	    }
   480	    let merged = search::merge_unique(samples, collected);
   481	    if let Ok(db) = inner.frecency.lock() {
   482	        let _ = db.replace_files(&merged);
   483	    }
   484	    *inner.files.lock().unwrap() = merged.clone();
   485	    inner.progress_cents.store(10000, Ordering::SeqCst);
   486	    *inner.backend.lock().unwrap() = "index".into();
   487	    inner.indexing.store(false, Ordering::SeqCst);
   488	
   489	    let mut last_full = std::time::Instant::now();
   490	    loop {
   491	        if !still_current(&inner, gen) {
   492	            return;
   493	        }
   494	        thread::sleep(Duration::from_secs(3));
   495	        if !still_current(&inner, gen) {
   496	            return;
   497	        }
   498	        let cfg = inner.cfg.lock().unwrap().clone();
   499	        let mut current = inner.files.lock().unwrap().clone();
   500	        let dirs = search::top_dirs(&current, cfg.watch_cap as usize);
   501	        inner
   502	            .watch_count
   503	            .store(dirs.len() as u32, Ordering::SeqCst);
   504	        for dir in &dirs {
   505	            let kids = search::rescan_dir(dir, &cfg.extra_exclude);
   506	            for kid in kids {
   507	                if let Some(existing) = current.iter_mut().find(|f| f.path == kid.path) {
   508	                    *existing = kid;
   509	                } else {
   510	                    current.push(kid);
   511	                }
   512	            }
   513	        }
   514	        if last_full.elapsed() > Duration::from_secs(90) {
   515	            if !still_current(&inner, gen) {
   516	                return;
   517	            }
   518	            let walk_cfg = WalkConfig {
   519	                roots: cfg.roots.clone(),
   520	                extra_exclude: cfg.extra_exclude.clone(),
   521	                max_files: cfg.max_files,
   522	                max_depth: 16,
   523	            };
   524	            let samples = search::demo_files(&cfg.samples_dir);
   525	            let collected = search::walk_index(&walk_cfg, |_, _| still_current(&inner, gen));
   526	            if !still_current(&inner, gen) {
   527	                return;
   528	            }
   529	            current = search::merge_unique(samples, collected);
   530	            last_full = std::time::Instant::now();
   531	            if let Ok(db) = inner.frecency.lock() {
   532	                let _ = db.replace_files(&current);
   533	            }
   534	        }
   535	        if current.len() > cfg.max_files {
   536	            current.truncate(cfg.max_files);
   537	        }
   538	        *inner.files.lock().unwrap() = current;
   539	    }
   540	}
