   222	    fn atime_is_not_used_in_boost() {
   223	        let now = 1_700_000_000_000u64;
   224	        assert_eq!(recency_boost(now - 1_000, now), 200);
   225	        assert_eq!(recency_boost(now - 3_600_000 * 2, now), 100);
