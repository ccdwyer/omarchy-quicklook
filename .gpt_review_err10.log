   350	def hex_preview(path: Path, magic: str, label: str, **extra) -> dict:
   351	    body = {
   352	        "kind": "hex",
   353	        "hex": hex_dump(read_capped(path, 256)),
   354	        "magic": magic,
   355	        "label": label,
   356	        "path": str(path),
   357	    }
   358	    body.update(extra)
   359	    return body
