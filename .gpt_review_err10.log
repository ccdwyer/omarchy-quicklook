    61	pub fn run_limited(mut cmd: Command, timeout: Duration, mem_bytes: u64, cpu_secs: u64) -> io::Result<Output> {
    62	    apply_rlimits(&mut cmd, mem_bytes, cpu_secs);
    63	    cmd.stdin(Stdio::null());
    64	    cmd.stdout(Stdio::piped());
    65	    cmd.stderr(Stdio::piped());
    66	    let mut child = cmd.spawn()?;
    67	    let start = Instant::now();
    68	    loop {
    69	        match child.try_wait()? {
    70	            Some(_) => return child.wait_with_output(),
    71	            None => {
    72	                if start.elapsed() >= timeout {
    73	                    let _ = child.kill();
    74	                    let _ = child.wait();
    75	                    return Err(io::Error::new(io::ErrorKind::TimedOut, "killed"));
    76	                }
    77	                thread::sleep(Duration::from_millis(20));
    78	            }
    79	        }
    80	    }
    81	}
    82	
    83	fn apply_rlimits(cmd: &mut Command, mem_bytes: u64, cpu_secs: u64) {
    84	    #[cfg(unix)]
    85	    {
    86	        use std::os::unix::process::CommandExt;
    87	        let mem = mem_bytes;
    88	        let cpu = cpu_secs;
    89	        unsafe {
    90	            cmd.pre_exec(move || {
    91	                let as_lim = libc::rlimit {
    92	                    rlim_cur: mem,
    93	                    rlim_max: mem,
    94	                };
    95	                libc::setrlimit(libc::RLIMIT_AS, &as_lim);
    96	                let cpu_lim = libc::rlimit {
    97	                    rlim_cur: cpu,
    98	                    rlim_max: cpu,
    99	                };
   100	                libc::setrlimit(libc::RLIMIT_CPU, &cpu_lim);
   101	                let nproc = libc::rlimit {
   102	                    rlim_cur: 32,
   103	                    rlim_max: 32,
   104	                };
   105	                #[cfg(any(target_os = "linux", target_os = "android"))]
   106	                libc::setrlimit(libc::RLIMIT_NPROC, &nproc);
   107	                let _ = nproc;
   108	                Ok(())
   109	            });
   110	        }
   111	    }
   112	    #[cfg(not(unix))]
   113	    {
   114	        let _ = (cmd, mem_bytes, cpu_secs);
   115	    }
   116	}
