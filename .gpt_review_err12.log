   467	def run_killable(
   468	    argv: list[str],
   469	    timeout_s: float = 8,
   470	    capture_output: bool = False,
   471	    text: bool = False,
   472	    limits: bool = True,
   473	) -> subprocess.CompletedProcess:
   474	    """Spawn in a new session and kill the whole process group on timeout.
   475	
   476	    Output is drained concurrently under a hard OUTPUT_CAP so a flooding child
   477	    cannot exhaust memory or deadlock on a full pipe. When `limits` is set, the
   478	    child MUST become its own session leader; if setsid() fails the child exits
   479	    without exec-ing, so we never run untrusted code without a group guarantee.
   480	    """
   481	    stdout = subprocess.PIPE if capture_output else subprocess.DEVNULL
   482	    stderr = subprocess.PIPE if capture_output else subprocess.DEVNULL
   483	
   484	    if limits:
   485	        def preexec() -> None:
   486	            try:
   487	                os.setsid()
   488	            except OSError:
   489	                # Cannot establish the process-group guarantee — do NOT exec the
   490	                # untrusted command. Exit so the parent sees a failed run and
   491	                # skips the path-consuming feature rather than running unbounded.
   492	                os._exit(127)
   493	            _limit_child()
   494	
   495	        extra = {"preexec_fn": preexec}
   496	    else:
   497	        extra = {"start_new_session": True}
   498	
   499	    proc = subprocess.Popen(
   500	        argv,
   501	        stdout=stdout,
   502	        stderr=stderr,
   503	        **extra,
   504	    )
   505	    pgid = proc.pid
   506	
   507	    sink: dict = {}
   508	    drains: list[threading.Thread] = []
   509	    if capture_output:
   510	        if proc.stdout is not None:
   511	            t = threading.Thread(target=_drain_capped, args=(proc.stdout, sink, "out"), daemon=True)
   512	            t.start()
   513	            drains.append(t)
   514	        if proc.stderr is not None:
   515	            t = threading.Thread(target=_drain_capped, args=(proc.stderr, sink, "err"), daemon=True)
   516	            t.start()
   517	            drains.append(t)
   518	
   519	    timed_out = False
   520	    try:
   521	        proc.wait(timeout=timeout_s)
   522	    except subprocess.TimeoutExpired:
   523	        timed_out = True
   524	        _kill_group(proc, pgid)
   525	
   526	    # The leader has now exited (cleanly or via the timeout kill above). A
   527	    # descendant may still be in the group holding stdout/stderr open, which
   528	    # would make the drain joins below hang and leak the descendant + threads.
   529	    # On the clean-exit path _kill_group has NOT run, so force the group down
   530	    # here whenever it is non-empty (TERM, grace, unconditional KILL) before
   531	    # joining. Skipped when the group is already empty — the common clean case —
   532	    # so a well-behaved tool returns with no added latency.
   533	    if not timed_out and _group_has_members(pgid):
   534	        _kill_group(proc, pgid)
   535	
   536	    # The group is guaranteed down, so every drain reaches EOF and joins
   537	    # promptly; the bounded join is a belt-and-suspenders backstop (the threads
   538	    # are daemons and can never wedge process exit).
   539	    for t in drains:
   540	        t.join(timeout=2)
   541	
   542	    out = sink.get("out", b"")
   543	    err = sink.get("err", b"")
   544	    if text:
   545	        enc = sys.getdefaultencoding()
   546	        out = out.decode(enc, errors="replace") if isinstance(out, (bytes, bytearray)) else (out or "")
   547	        err = err.decode(enc, errors="replace") if isinstance(err, (bytes, bytearray)) else (err or "")
   548	
   549	    if timed_out:
   550	        raise subprocess.TimeoutExpired(argv, timeout_s, output=out, stderr=err)
   551	    return subprocess.CompletedProcess(argv, proc.returncode, out, err)
   552	
