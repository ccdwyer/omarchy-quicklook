   851	handle_line() {
   852	  load_config
   853	  line="$1"
   854	  id=$(extract_id "$line")
   855	  [ -n "$id" ] || id=0
   856	  case "$line" in
   857	    *'"cmd":"config"'*|*'cmd": "config"'*)
   858	      apply_config_line "$line"
   859	      reply_status "$id"
   860	      ;;
   861	    *'"cmd":"status"'*|*'cmd": "status"'*|*'cmd":"capabilities"'*)
   862	      reply_status "$id"
   863	      ;;
   864	    *'"cmd":"preview"'*|*'cmd": "preview"'*|*'cmd":"prefetch"'*|*'cmd": "prefetch"'*|*'cmd":"page"'*|*'cmd": "page"'*)
   865	      reply_preview "$id" "$(extract_string "$line" "path")" "$(extract_number "$line" "page")"
   866	      ;;
   867	    *'"cmd":"open"'*|*'cmd": "open"'*)
   868	      path=$(extract_string "$line" "path")
   869	      if do_open "$path" 0; then
   870	        printf '{"id":%s,"kind":"ok"}\n' "$id"
   871	      else
   872	        printf '{"id":%s,"kind":"error","error":"open failed"}\n' "$id"
   873	      fi
   874	      ;;
   875	    *'"cmd":"reveal"'*|*'cmd": "reveal"'*)
   876	      path=$(extract_string "$line" "path")
   877	      if do_open "$path" 1; then
   878	        printf '{"id":%s,"kind":"ok"}\n' "$id"
   879	      else
   880	        printf '{"id":%s,"kind":"error","error":"reveal failed"}\n' "$id"
   881	      fi
   882	      ;;
   883	    *'"cmd":"theme"'*|*'cmd":"select"'*|*'cmd":"warmup"'*)
   884	      printf '{"id":%s,"kind":"ok"}\n' "$id"
   885	      ;;
   886	    *'"q":'*|*'cmd":"query"'*|*'cmd": "query"'*)
   887	      q=$(extract_string "$line" "q")
   888	      reply_query "$id" "$q"
   889	      ;;
   890	    *)
   891	      reply_preview "$id" "$(extract_string "$line" "path")" "$(extract_number "$line" "page")"
   892	      ;;
   893	  esac
   894	}
   895	
   896	oneshot=0
   897	payload=""
   898	while [ "$#" -gt 0 ]; do
   899	  case "$1" in
   900	    --plugin-dir)
   901	      shift
   902	      if [ -n "${1:-}" ]; then
   903	        export QUICKLOOK_PLUGIN_DIR="$1"
   904	        SAMP="$1/samples"
   905	      fi
   906	      ;;
   907	    --oneshot)
   908	      oneshot=1
   909	      shift
   910	      payload="${1:-}"
   911	      ;;
   912	    --watchdog-selftest)
   913	      shift
   914	      secs=${1:-2}
   915	      [ "$#" -gt 0 ] && shift
   916	      run_watchdog "$secs" "$@"
   917	      exit $?
   918	      ;;
   919	    *)
   920	      break
   921	      ;;
   922	  esac
   923	  [ "$#" -gt 0 ] && shift
   924	done
   925	
   926	load_config
   927	
   928	if [ "$oneshot" -eq 1 ]; then
   929	  if [ -z "$payload" ]; then
   930	    IFS= read -r payload || payload="{}"
   931	  fi
   932	  handle_line "$payload"
   933	  exit 0
   934	fi
   935	
   936	while IFS= read -r line; do
   937	  [ -n "$line" ] || continue
   938	  handle_line "$line"
   939	done
