   468	      var job = root.oneshotCurrent
   469	      root.oneshotCurrent = null
   470	      if (text && String(text).trim().length) {
   471	        root.onHelperLine(String(text).trim().split("\n").pop())
   472	      } else if (job && job.cmd === "query") {
   473	        root.localQuery(job.q || "")
   474	      } else if (job && job.cmd === "prefetch") {
   475	        Protocol.dropInFlight(job.id)
