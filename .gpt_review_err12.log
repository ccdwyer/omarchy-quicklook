   203	    pub fn warmup_async(&self) {
   204	        let gen = self.inner.index_gen.fetch_add(1, Ordering::SeqCst) + 1;
   205	        let inner = self.inner.clone();
   206	        thread::spawn(move || warmup_loop(inner, gen));
   207	    }
