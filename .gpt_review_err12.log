    82	    if (b.score !== a.score)
    83	      return b.score - a.score
    84	    if (a.name < b.name)
    85	      return -1
    86	    if (a.name > b.name)
    87	      return 1
    88	    return 0
    89	  })
    90	  return scored.slice(0, cap)
    91	}
