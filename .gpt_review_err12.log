    60	function search(items, query, limit) {
    61	  var q = String(query || "")
    62	  var cap = Number(limit) || 40
    63	  var src = items || []
    64	  if (!q.length)
    65	    return src.slice(0, cap)
    66	  var scored = []
    67	  for (var i = 0; i < src.length; i++) {
    68	    var it = src[i]
    69	    var s = Math.max(fuzzyScore(it.name, q), fuzzyScore(it.path, q))
    70	    if (s <= 0)
    71	      continue
    72	    scored.push({
    73	      path: it.path,
    74	      name: it.name || sampleBasename(it.path),
    75	      kind: it.kind || "hex",
    76	      score: s,
    77	      mtime: it.mtime || 0,
    78	      size: it.size || 0
    79	    })
    80	  }
