   249	        else if (n == 10) printf "\\n"
   250	        else if (n == 13) printf "\\r"
   251	        else if (n == 9) printf "\\t"
   252	        else if (n < 32) printf "\\u%04x", n
   253	        else printf "%c", n
   254	      }
   255	    }
   256	  '
   257	}
