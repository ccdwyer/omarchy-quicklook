   178	
   179	# Config is a tagged line file (never sourced / eval'd).
   180	#   R<TAB>absolute-root
   181	#   E<TAB>exclude-name
   182	#   W<TAB>watchCap
   183	#   C<TAB>cacheMb
   184	#   M<TAB>maxFiles
   185	load_config() {
   186	  ROOTS="$HOME_DIR"
   187	  EXTRA_EXCLUDE=""
   188	  WATCH_CAP=2000
   189	  CACHE_MB=500
   190	  MAX_FILES=500000
   191	  [ -f "$CONFIG_FILE" ] || return 0
   192	  loaded_roots=""
   193	  while IFS= read -r line || [ -n "$line" ]; do
   194	    tag=${line%%	*}
   195	    val=${line#*	}
   196	    case "$tag" in
   197	      R)
   198	        [ -n "$val" ] || continue
   199	        if [ -z "$loaded_roots" ]; then
   200	          loaded_roots=$val
   201	        else
   202	          loaded_roots="$loaded_roots|$val"
   203	        fi
   204	        ;;
   205	      E)
   206	        [ -n "$val" ] || continue
   207	        if [ -z "$EXTRA_EXCLUDE" ]; then
   208	          EXTRA_EXCLUDE=$val
   209	        else
   210	          EXTRA_EXCLUDE="$EXTRA_EXCLUDE|$val"
   211	        fi
   212	        ;;
   213	      W) WATCH_CAP=$val ;;
   214	      C) CACHE_MB=$val ;;
   215	      M) MAX_FILES=$val ;;
   216	    esac
   217	  done < "$CONFIG_FILE"
   218	  [ -n "$loaded_roots" ] && ROOTS=$loaded_roots
   219	}
   220	
   221	save_config() {
