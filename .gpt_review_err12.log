   430	    }
   431	    stderr: SplitParser {
   432	      onRead: function(data) { console.warn("quicklookd:", data) }
   433	    }
   434	    onExited: {
   435	      if (root.shuttingDown)
   436	        return
   437	      if (root.restarts < 3) {
   438	        root.restarts += 1
   439	        root.lastStatus = "restart " + root.restarts
   440	        restartTimer.interval = 300 * root.restarts
   441	        restartTimer.start()
   442	      } else {
   443	        root.enterCompatFallback()
   444	      }
   445	    }
   446	    onRunningChanged: {
   447	      if (running) {
   448	        root.lastStatus = "running"
