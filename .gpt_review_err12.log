    16	    { path: base + "/photo.png", name: "photo.png", kind: "image", score: 880, mtime: 0, size: 0 },
    17	    { path: base + "/sales.csv", name: "sales.csv", kind: "csv", score: 860, mtime: 0, size: 0 },
    18	    { path: base + "/themed.rs", name: "themed.rs", kind: "code", score: 840, mtime: 0, size: 0 },
