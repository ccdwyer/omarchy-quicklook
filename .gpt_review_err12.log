   240	json_escape() {
   241	  # JSON string contents: \, ", C0 controls (including newline).
   242	  printf '%s' "$1" | od -An -t u1 -v | awk '
   243	    BEGIN { ORS="" }
   244	    {
   245	      for (i = 1; i <= NF; i++) {
   246	        n = $i + 0
   247	        if (n == 92) printf "\\\\"
