    23	function fuzzyScore(hay, needle) {
    24	  var h = String(hay || "").toLowerCase()
    25	  var n = String(needle || "").toLowerCase()
    26	  if (!n.length)
    27	    return 1
    28	  if (h === n)
    29	    return 1000
    30	  var idx = h.indexOf(n)
    31	  if (idx === 0)
    32	    return 800 - Math.min(h.length, 80)
    33	  if (idx > 0)
    34	    return 600 - idx
    35	  var hi = 0
    36	  var streak = 0
    37	  var score = 0
    38	  for (var ni = 0; ni < n.length; ni++) {
    39	    var found = -1
    40	    for (var j = hi; j < h.length; j++) {
    41	      if (h.charAt(j) === n.charAt(ni)) {
    42	        found = j
    43	        break
    44	      }
    45	    }
    46	    if (found < 0)
    47	      return 0
    48	    if (found === hi)
    49	      streak += 1
    50	    else
    51	      streak = 1
    52	    score += 8 + streak * 4
    53	    if (found === 0 || h.charAt(found - 1) === "/" || h.charAt(found - 1) === "." || h.charAt(found - 1) === "_" || h.charAt(found - 1) === "-")
    54	      score += 20
    55	    hi = found + 1
    56	  }
    57	  return score
    58	}
