   357	
   358	prune_names() {
   359	  printf '%s' ".ssh|.gnupg|.password-store|node_modules|target|.git|.hg|.svn|.bzr|__pycache__|.venv|venv|.tox|.mypy_cache|.pytest_cache|.cargo|.rustup|.npm|.cache|.Trash|.local|keyrings|kwalletd|Keychains"
   360	  if [ -n "$EXTRA_EXCLUDE" ]; then
   361	    printf '|%s' "$EXTRA_EXCLUDE"
   362	  fi
   363	}
   364	
   365	is_secret_file() {
   366	  case "$1" in
   367	    .env|.env.*|*.env) return 0 ;;
   368	    id_rsa|id_ed25519|id_rsa.*) return 0 ;;
   369	  esac
   370	  return 1
   371	}
   372	
   373	path_is_secret() {
   374	  case "$1" in
   375	    */.ssh/*|*/.gnupg/*|*/.password-store/*|*/.local/share/keyrings/*|*/.local/share/kwalletd/*|*/Library/Keychains/*)
   376	      return 0
   377	      ;;
   378	  esac
   379	  is_secret_file "$(printf '%s' "$1" | sed 's|.*/||')"
   380	}
   381	
   382	hidden_ancestor() {
   383	  # Skip hidden/heavy directories unless they are an explicit root.
   384	  cur=$(dirname "$1")
   385	  while [ -n "$cur" ] && [ "$cur" != "/" ]; do
   386	    skip_this=0
   387	    oldifs=$IFS
   388	    IFS='|'
   389	    for r in $ROOTS; do
   390	      [ "$cur" = "$r" ] && skip_this=1
   391	    done
   392	    IFS=$oldifs
   393	    [ "$skip_this" -eq 0 ] || return 1
   394	    base=$(printf '%s' "$cur" | sed 's|.*/||')
   395	    case "$base" in
   396	      .*) return 0 ;;
   397	    esac
   398	    oldifs=$IFS
   399	    IFS='|'
   400	    for n in $(prune_names); do
   401	      [ "$base" = "$n" ] && return 0
   402	    done
   403	    IFS=$oldifs
   404	    np=$(dirname "$cur")
   405	    [ "$np" = "$cur" ] && break
   406	    cur=$np
   407	  done
   408	  return 1
   409	}
   410	
   411	append_hit() {
   412	  dest="$1"
   413	  p="$2"
   414	  q="$3"
   415	  path_is_secret "$p" && return 0
   416	  hidden_ancestor "$p" && return 0
   417	  sc=$(score_name "$(printf '%s' "$p" | sed 's|.*/||')" "$q")
   418	  [ "$sc" -gt 0 ] || return 0
   419	  k=$(kind_of "$p")
   420	  bn=$(printf '%s' "$p" | sed 's|.*/||')
   421	  printf '%s {"path":"%s","name":"%s","kind":"%s","score":%s,"mtime":0,"size":0}\n' \
   422	    "$sc" "$(json_escape "$p")" "$(json_escape "$bn")" "$k" "$sc" >> "$dest"
   423	}
   424	
   425	run_capped_find() {
   426	  root="$1"
   427	  q="$2"
   428	  out="$3"
   429	  names=$(prune_names)
   430	  set -f
   431	  set -- find "$root" -mindepth 1 -maxdepth 6 '(' -name '.*'
   432	  oldifs=$IFS
   433	  IFS='|'
   434	  for n in $names; do
   435	    [ -n "$n" ] || continue
   436	    set -- "$@" -o -name "$n"
   437	  done
   438	  IFS=$oldifs
   439	  set -- "$@" ')' -prune -o -iname "*$q*" -print
   440	  set +f
   441	  run_watchdog_capped 2 "$out" -- "$@"
   442	}
   443	
   444	find_hits() {
   445	  q=$(safe_glob "$1")
   446	  dest="$2"
   447	  [ -n "$q" ] || return 0
   448	  raw=$(mktemp)
   449	  located=$(mktemp)
   450	  if command -v plocate >/dev/null 2>&1; then
   451	    run_watchdog_capped 2 "$located" -- plocate -il 40 -- "$q"
   452	  elif command -v locate >/dev/null 2>&1; then
   453	    run_watchdog_capped 2 "$located" -- locate -il 40 -- "$q"
   454	  fi
   455	  if [ -s "$located" ]; then
   456	    while IFS= read -r lp; do
   457	      [ -n "$lp" ] || continue
   458	      under=0
   459	      oldifs=$IFS
   460	      IFS='|'
   461	      for root in $ROOTS; do
   462	        case "$lp" in
   463	          "$root"|"$root"/*) under=1 ;;
   464	        esac
   465	      done
   466	      IFS=$oldifs
   467	      [ "$under" -eq 1 ] && printf '%s\n' "$lp" >> "$raw"
   468	    done < "$located"
   469	  fi
   470	  rm -f "$located"
   471	  if [ ! -s "$raw" ]; then
   472	    oldifs=$IFS
   473	    IFS='|'
   474	    set -- $ROOTS
   475	    IFS=$oldifs
   476	    : > "$raw"
   477	    for root in "$@"; do
   478	      [ -d "$root" ] || continue
   479	      part=$(mktemp)
   480	      run_capped_find "$root" "$q" "$part"
   481	      cat "$part" >> "$raw" 2>/dev/null || true
   482	      rm -f "$part"
   483	    done
   484	  fi
   485	  n=0
   486	  while IFS= read -r p; do
   487	    [ -n "$p" ] || continue
   488	    n=$((n + 1))
   489	    [ "$n" -le 80 ] || break
   490	    append_hit "$dest" "$p" "$q"
   491	  done < "$raw"
   492	  rm -f "$raw"
   493	}
   494	
   495	reply_status() {
   496	  id="$1"
   497	  roots_json=""
   498	  oldifs=$IFS
   499	  IFS='|'
   500	  for r in $ROOTS; do
   501	    [ -n "$r" ] || continue
   502	    if [ -z "$roots_json" ]; then
   503	      roots_json="\"$(json_escape "$r")\""
   504	    else
   505	      roots_json="$roots_json,\"$(json_escape "$r")\""
   506	    fi
   507	  done
   508	  IFS=$oldifs
   509	  budget=$((CACHE_MB * 1024 * 1024))
   510	  poppler=false
   511	  command -v pdftoppm >/dev/null 2>&1 && poppler=true
   512	  plocate=false
   513	  { command -v plocate >/dev/null 2>&1 || command -v locate >/dev/null 2>&1; } && plocate=true
   514	  printf '{"id":%s,"kind":"status","indexing":false,"progress":1,"backend":"compat","status":{"indexing":false,"progress":1,"backend":"compat","files":5,"watchCount":0,"watchCap":%s,"roots":[%s],"cacheBytes":0,"cacheBudget":%s,"poppler":%s,"plocate":%s,"ffmpeg":false,"helper":"compat","version":"1.0.0"}}\n' \
   515	    "$id" "$WATCH_CAP" "$roots_json" "$budget" "$poppler" "$plocate"
   516	}
   517	
   518	reply_query() {
   519	  id="$1"
   520	  q="$2"
   521	  if [ -z "$q" ]; then
   522	    printf '{"id":%s,"kind":"results","results":%s,"indexing":false,"progress":1,"backend":"demo"}\n' "$id" "$(demo_results)"
   523	    return
   524	  fi
   525	  tmp=$(mktemp)
   526	  ql=$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')
   527	  for name in invoice.pdf photo.png sales.csv themed.rs README.md; do
   528	    sc=$(score_name "$name" "$ql")
   529	    if [ "$sc" -gt 0 ]; then
   530	      printf '%s %s\n' "$((sc + 200))" "$(demo_hit "$name" "$((sc + 200))")" >> "$tmp"
   531	    fi
   532	  done
   533	  find_hits "$q" "$tmp"
   534	  sorted=$(mktemp)
   535	  sort -nr -k1,1 "$tmp" > "$sorted" 2>/dev/null || true
   536	  body=""
   537	  n=0
   538	  while read -r _sc hit; do
   539	    [ -n "$hit" ] || continue
   540	    n=$((n + 1))
   541	    [ "$n" -le 40 ] || break
   542	    if [ -z "$body" ]; then
   543	      body="$hit"
   544	    else
   545	      body="$body,$hit"
   546	    fi
   547	  done < "$sorted"
   548	  printf '{"id":%s,"kind":"results","results":[%s],"indexing":false,"progress":1,"backend":"compat"}\n' "$id" "$body"
   549	  rm -f "$tmp" "$sorted"
   550	}
   551	
   552	png_wh() {
   553	  hex=$(read_user_file dd if="$1" bs=1 skip=16 count=8 2>/dev/null | od -An -tx1 | tr -cd '0-9a-f')
   554	  [ "${#hex}" -ge 16 ] || return 1
   555	  w=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c1-8)")
   556	  h=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c9-16)")
   557	  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   558	  printf '%s %s' "$w" "$h"
   559	}
   560	
   561	gif_wh() {
   562	  hex=$(read_user_file dd if="$1" bs=1 skip=6 count=4 2>/dev/null | od -An -tx1 | tr -cd '0-9a-f')
   563	  [ "${#hex}" -ge 8 ] || return 1
   564	  w=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c3-4)$(printf '%s' "$hex" | cut -c1-2)")
   565	  h=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c7-8)$(printf '%s' "$hex" | cut -c5-6)")
   566	  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   567	  printf '%s %s' "$w" "$h"
   568	}
   569	
   570	svg_wh() {
   571	  head=$(read_user_file dd if="$1" bs=1 count=8192 2>/dev/null)
   572	  vb=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Vv]iew[Bb]ox=["'\'']\([^"'\'']*\)["'\''].*/\1/p')
   573	  if [ -n "$vb" ]; then
   574	    set -- $vb
   575	    if [ "$#" -ge 4 ]; then
   576	      w=$(printf '%s' "$3" | tr -cd '0-9.')
   577	      h=$(printf '%s' "$4" | tr -cd '0-9.')
   578	      w=${w%%.*}
   579	      h=${h%%.*}
   580	      [ -n "$w" ] && [ -n "$h" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   581	      printf '%s %s' "$w" "$h"
   582	      return 0
   583	    fi
   584	  fi
   585	  w=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Ww]idth=["'\'']\([0-9.][0-9.]*\).*/\1/p')
   586	  h=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Hh]eight=["'\'']\([0-9.][0-9.]*\).*/\1/p')
   587	  w=${w%%.*}
   588	  h=${h%%.*}
   589	  [ -n "$w" ] && [ -n "$h" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   590	  printf '%s %s' "$w" "$h"
   591	}
   592	
   593	read_user_file() {
   594	  run_watchdog 1 "$@"
   595	}
   596	
   597	hex_head() {
   598	  read_user_file od -An -tx1 -N 256 "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //'
   599	}
   600	
   601	html_escape_file() {
   602	  read_user_file head -c "$OUTPUT_CAP" "$1" 2>/dev/null | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
   603	}
   604	
   605	csv_preview_json() {
   606	  path="$1"
   607	  # Byte-cap FIRST (bounds a pathological single no-newline row), then line-cap.
   608	  read_user_file head -c "$OUTPUT_CAP" "$path" 2>/dev/null | head -n 501 | awk '
   609	    function esc(s) {
   610	      gsub(/\\/, "\\\\", s)
   611	      gsub(/"/, "\\\"", s)
   612	      return s
   613	    }
   614	    function arr(line,    n, i, out, a) {
   615	      n = split(line, a, FS)
   616	      out = "["
   617	      for (i = 1; i <= n; i++) {
   618	        if (i > 1) out = out ","
   619	        out = out "\"" esc(a[i]) "\""
   620	      }
   621	      return out "]"
   622	    }
   623	    BEGIN { headers = "[]"; rows = ""; nbody = 0 }
   624	    NR == 1 {
   625	      line = $0
   626	      c = gsub(/,/, ",", line)
   627	      line = $0
   628	      t = gsub(/\t/, "\t", line)
   629	      line = $0
   630	      s = gsub(/;/, ";", line)
   631	      line = $0
   632	      p = gsub(/\|/, "|", line)
   633	      FS = ","
   634	      if (t > c && t >= s && t >= p) FS = "\t"
   635	      else if (s > c && s >= t && s >= p) FS = ";"
   636	      else if (p > c && p >= t && p >= s) FS = "|"
   637	      $0 = $0
   638	      headers = arr($0)
   639	      next
   640	    }
   641	    {
   642	      if (nbody) rows = rows ","
   643	      rows = rows arr($0)
   644	      nbody++
   645	    }
   646	    END {
   647	      trunc = (NR > 501) ? "true" : "false"
   648	      printf "{\"kind\":\"csv\",\"headers\":%s,\"rows\":[%s],\"truncated\":%s}", headers, rows, trunc
   649	    }
   650	  '
   651	}
   652	
   653	dir_preview_json() {
   654	  path="$1"
   655	  tmp=$(mktemp)
   656	  # Byte-cap the listing (bounds pathological huge-filename dirs) then line-cap.
   657	  read_user_file ls -1 "$path" 2>/dev/null | cap_stream | head -n 200 > "$tmp"
   658	  entries=""
   659	  while IFS= read -r name || [ -n "$name" ]; do
   660	    [ -n "$name" ] || continue
   661	    full="$path/$name"
   662	    k=$(kind_of "$full")
   663	    sz=0
   664	    if [ -f "$full" ] && watchdog_ok; then
   665	      sz=$(run_watchdog 1 stat -c %s "$full" 2>/dev/null) || \
   666	        sz=$(run_watchdog 1 stat -f %z "$full" 2>/dev/null) || sz=0
   667	      [ -n "$sz" ] || sz=0
   668	    fi
   669	    ent="{\"name\":\"$(json_escape "$name")\",\"kind\":\"$k\",\"size\":$sz}"
   670	    if [ -z "$entries" ]; then
   671	      entries="$ent"
   672	    else
   673	      entries="$entries,$ent"
   674	    fi
   675	  done < "$tmp"
   676	  rm -f "$tmp"
   677	  printf '{"kind":"dir","entries":[%s],"path":"%s"}' "$entries" "$(json_escape "$path")"
   678	}
   679	
   680	isolation_ok() {
   681	  watchdog_ok
   682	}
   683	
   684	run_isolated() {
   685	  watchdog_ok || return 1
   686	  (
   687	    ulimit -t 8 2>/dev/null || true
   688	    ulimit -v 524288 2>/dev/null || true
   689	    ulimit -f 65536 2>/dev/null || true
   690	    ulimit -u 32 2>/dev/null || true
   691	    run_watchdog 8 "$@"
   692	  ) >/dev/null 2>&1 || true
   693	}
   694	
   695	run_pdftoppm() {
   696	  path="$1"
   697	  page="$2"
   698	  dest="$3"
   699	  prefix="${dest%.png}"
   700	  if ! isolation_ok; then
   701	    return 1
   702	  fi
   703	  run_isolated pdftoppm -f "$page" -l "$page" -png -r 140 -singlefile "$path" "$prefix"
   704	}
   705	
   706	downsample_image() {
   707	  src="$1"
   708	  dest="$2"
   709	  nw="$3"
   710	  nh="$4"
   711	  if ! isolation_ok; then
   712	    return 1
   713	  fi
   714	  if command -v ffmpeg >/dev/null 2>&1; then
   715	    run_isolated ffmpeg -nostdin -hide_banner -loglevel error -i "$src" -vf "scale=${nw}:${nh}" -frames:v 1 -y "$dest"
   716	    [ -s "$dest" ] && return 0
   717	  fi
   718	  if command -v magick >/dev/null 2>&1; then
   719	    run_isolated magick "$src" -resize "${nw}x${nh}" "$dest"
   720	    [ -s "$dest" ] && return 0
   721	  fi
   722	  if command -v convert >/dev/null 2>&1; then
   723	    run_isolated convert "$src" -resize "${nw}x${nh}" "$dest"
   724	    [ -s "$dest" ] && return 0
   725	  fi
   726	  return 1
   727	}
   728	
   729	reply_preview() {
   730	  id="$1"
   731	  path="$2"
   732	  page="${3:-1}"
   733	  [ -n "$page" ] || page=1
   734	  kind=$(kind_of "$path")
   735	  case "$kind" in
   736	    image)
   737	      ext=$(printf '%s' "$path" | awk -F. '{print tolower($NF)}')
   738	      wh=""
   739	      case "$ext" in
   740	        png) wh=$(png_wh "$path") || wh="" ;;
   741	        gif) wh=$(gif_wh "$path") || wh="" ;;
   742	        svg) wh=$(svg_wh "$path") || wh="" ;;
   743	        *) wh="" ;;
   744	      esac
   745	      if [ -n "$wh" ]; then
   746	        set -- $wh
   747	        w=$1
   748	        h=$2
   749	        pix=$((w * h))
   750	        if [ "$pix" -le 20000000 ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   751	          anim=false
   752	          [ "$ext" = gif ] && anim=true
   753	          printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":%s,"width":%s,"height":%s}}\n' \
   754	            "$id" "$(json_escape "$path")" "$anim" "$w" "$h"
   755	        elif [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   756	          nw=$w
   757	          nh=$h
   758	          # integer sqrt-ish shrink so nw*nh <= 20e6
   759	          while [ $((nw * nh)) -gt 20000000 ]; do
   760	            nw=$((nw / 2))
   761	            nh=$((nh / 2))
   762	            [ "$nw" -gt 0 ] && [ "$nh" -gt 0 ] || break
   763	          done
   764	          [ "$nw" -gt 0 ] || nw=1
   765	          [ "$nh" -gt 0 ] || nh=1
   766	          cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/previews"
   767	          mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-previews"
   768	          mkdir -p "$cache_dir"
   769	          dest="$cache_dir/ds-$$.png"
   770	          if downsample_image "$path" "$dest" "$nw" "$nh" && [ -s "$dest" ]; then
   771	            printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":false,"width":%s,"height":%s,"label":"downsampled"}}\n' \
   772	              "$id" "$(json_escape "$dest")" "$nw" "$nh"
   773	          else
   774	            printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"image %sx%s","label":"image exceeds 20 MP — hex view","width":%s,"height":%s,"path":"%s"}}\n' \
   775	              "$id" "$(json_escape "$(hex_head "$path")")" "$w" "$h" "$w" "$h" "$(json_escape "$path")"
   776	          fi
   777	        fi
   778	      else
   779	        printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"unverifiable image","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   780	          "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   781	      fi
   782	      ;;
   783	    pdf)
   784	      if command -v pdftoppm >/dev/null 2>&1 && isolation_ok; then
   785	        cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/pdf"
   786	        mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-pdf"
   787	        mkdir -p "$cache_dir"
   788	        dest="$cache_dir/p${page}-$$.png"
   789	        run_pdftoppm "$path" "$page" "$dest"
   790	        if [ ! -s "$dest" ] && [ -s "${dest%.png}-1.png" ]; then
   791	          dest="${dest%.png}-1.png"
   792	        fi
   793	        if [ -s "$dest" ]; then
   794	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","path":"%s","page":%s,"page_count":1,"need_poppler":false}}\n' \
   795	            "$id" "$(json_escape "$dest")" "$page"
   796	        else
   797	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"render_error":true,"page":%s,"page_count":1,"label":"couldn'\''t render this page","magic":"PDF document","hex":"%s"}}\n' \
   798	            "$id" "$page" "$(json_escape "$(hex_head "$path")")"
   799	        fi
   800	      elif command -v pdftoppm >/dev/null 2>&1; then
   801	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"page":%s,"page_count":1,"label":"PDF metadata only — no isolated renderer","magic":"PDF document"}}\n' \
   802	          "$id" "$page"
   803	      else
   804	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":true,"page":%s,"page_count":1,"label":"install poppler for PDF previews","magic":"PDF document","path":"%s"}}\n' \
   805	          "$id" "$page" "$(json_escape "$path")"
   806	      fi
   807	      ;;
   808	    code)
   809	      printf '{"id":%s,"kind":"preview","preview":{"kind":"code","html":"<pre>%s</pre>","lang":"text","path":"%s"}}\n' \
   810	        "$id" "$(json_escape "$(html_escape_file "$path")")" "$(json_escape "$path")"
   811	      ;;
   812	    csv)
   813	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(csv_preview_json "$path")"
   814	      ;;
   815	    dir)
   816	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(dir_preview_json "$path")"
   817	      ;;
   818	    *)
   819	      printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"data","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   820	        "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   821	      ;;
   822	  esac
   823	}
   824	
   825	do_open() {
   826	  path="$1"
   827	  reveal="$2"
   828	  if [ ! -e "$path" ]; then
   829	    return 1
   830	  fi
   831	  target="$path"
   832	  if [ "$reveal" = 1 ] && [ ! -d "$path" ]; then
   833	    target=$(dirname "$path")
   834	  fi
   835	  watchdog_ok || return 2
   836	  if command -v gio >/dev/null 2>&1; then
   837	    run_watchdog 8 gio open "$target" >/dev/null 2>&1 || true
   838	    return 0
   839	  fi
   840	  if command -v xdg-open >/dev/null 2>&1; then
   841	    run_watchdog 8 xdg-open "$target" >/dev/null 2>&1 || true
   842	    return 0
   843	  fi
   844	  if command -v open >/dev/null 2>&1; then
   845	    run_watchdog 8 open "$target" >/dev/null 2>&1 || true
   846	    return 0
   847	  fi
   848	  return 2
   849	}
