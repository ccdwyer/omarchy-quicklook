   154	def should_skip_result(path: Path, extra: list[str] | None = None) -> bool:
   155	    extra = extra if extra is not None else list(SETTINGS["extraExclude"])
   156	    roots = [Path(r) for r in SETTINGS["roots"] if r]
   157	    if path_is_secret(path):
   158	        return True
   159	    for parent in [path] + list(path.parents):
   160	        if any(parent == r or parent == Path(str(r)) for r in roots):
   161	            break
   162	        if hidden_or_heavy_dir(parent.name, extra):
   163	            return True
   164	    return False
