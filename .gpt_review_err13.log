   194	def demo() -> list[dict]:
   195	    names = ["invoice.pdf", "photo.png", "sales.csv", "themed.rs", "README.md"]
   196	    out = []
   197	    for i, name in enumerate(names):
   198	        p = SAMPLES / name
   199	        out.append(
   200	            {
   201	                "path": str(p),
   202	                "name": name,
   203	                "kind": kind_of(p),
   204	                "score": 900 - i * 10,
   205	                "mtime": int(p.stat().st_mtime * 1000) if p.exists() else 0,
   206	                "size": p.stat().st_size if p.exists() else 0,
   207	            }
   208	        )
   209	    return out
