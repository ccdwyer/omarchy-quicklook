   302	def find_names(q: str, limit: int) -> list[dict]:
   303	    roots = [r for r in SETTINGS["roots"] if r]
   304	    if not roots:
   305	        roots = [str(HOME)]
   306	    cap = min(int(limit), 40)
   307	    q = "".join(ch for ch in q if ch.isalnum() or ch in "._-")
   308	    if not q:
   309	        return []
   310	    located = plocate_names(q, cap)
   311	    if located:
   312	        return located
   313	    if shutil.which("find") is None:
   314	        return []
   315	    skip = skip_parts()
   316	    prune: list[str] = []
   317	    for name in skip:
   318	        if prune:
   319	            prune.append("-o")
   320	        prune.extend(["-name", name])
   321	    if prune:
   322	        prune.extend(["-o", "-name", ".*"])
   323	    else:
   324	        prune.extend(["-name", ".*"])
   325	    cmd = ["find", *roots, "-mindepth", "1"]
   326	    cmd.extend(["(", *prune, ")", "-prune", "-o", "-iname", f"*{q}*", "-print"])
   327	    try:
   328	        proc = run_killable(cmd, timeout_s=2, capture_output=True, text=True)
   329	    except (subprocess.TimeoutExpired, OSError):
   330	        return []
   331	    return _hits_from_paths(proc.stdout.splitlines(), q, cap)
