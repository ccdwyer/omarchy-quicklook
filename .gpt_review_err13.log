   276	def plocate_names(q: str, limit: int) -> list[dict] | None:
   277	    binary = shutil.which("plocate") or shutil.which("locate")
   278	    if not binary:
   279	        return None
   280	    try:
   281	        proc = run_killable(
   282	            [binary, "-il", str(limit), "--", q],
   283	            timeout_s=2,
   284	            capture_output=True,
   285	            text=True,
   286	        )
   287	    except (subprocess.TimeoutExpired, OSError):
   288	        return None
   289	    if not proc.stdout.strip():
   290	        return None
   291	    hits = _hits_from_paths(proc.stdout.splitlines(), q, limit)
   292	    roots = [Path(r) for r in SETTINGS["roots"] if r]
   293	    if roots:
   294	        hits = [
   295	            h
   296	            for h in hits
   297	            if any(Path(h["path"]) == r or str(h["path"]).startswith(str(r) + "/") for r in roots)
   298	        ]
   299	    return hits or None
