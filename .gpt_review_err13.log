   170	  shift 2
   171	  [ "$1" = "--" ] && shift
   172	  run_watchdog "$_secs" "$@" 2>/dev/null | cap_stream > "$_out" || true
   173	}
   174	
   175	HOME_DIR=${HOME:-/tmp}
   176	STATE_DIR="${XDG_STATE_HOME:-$HOME_DIR/.local/state}/quicklook"
   177	CONFIG_FILE="$STATE_DIR/compat-config.env"
   178	SAMP="$ROOT/samples"
   179	
   180	ROOTS="$HOME_DIR"
   181	EXTRA_EXCLUDE=""
   182	WATCH_CAP=2000
   183	CACHE_MB=500
   184	MAX_FILES=500000
   185	
   186	expand_tilde() {
   187	  case "$1" in
   188	    "~") printf '%s' "$HOME_DIR" ;;
   189	    ~/*) printf '%s' "$HOME_DIR/${1#~/}" ;;
   190	    *) printf '%s' "$1" ;;
   191	  esac
   192	}
   193	
   194	# Config is a tagged line file (never sourced / eval'd).
   195	#   R<TAB>absolute-root
   196	#   E<TAB>exclude-name
   197	#   W<TAB>watchCap
   198	#   C<TAB>cacheMb
   199	#   M<TAB>maxFiles
   200	load_config() {
   201	  ROOTS="$HOME_DIR"
   202	  EXTRA_EXCLUDE=""
   203	  WATCH_CAP=2000
   204	  CACHE_MB=500
   205	  MAX_FILES=500000
   206	  [ -f "$CONFIG_FILE" ] || return 0
   207	  loaded_roots=""
   208	  while IFS= read -r line || [ -n "$line" ]; do
   209	    tag=${line%%	*}
   210	    val=${line#*	}
   211	    case "$tag" in
   212	      R)
   213	        [ -n "$val" ] || continue
   214	        if [ -z "$loaded_roots" ]; then
   215	          loaded_roots=$val
   216	        else
   217	          loaded_roots="$loaded_roots|$val"
   218	        fi
   219	        ;;
   220	      E)
   221	        [ -n "$val" ] || continue
   222	        if [ -z "$EXTRA_EXCLUDE" ]; then
   223	          EXTRA_EXCLUDE=$val
   224	        else
   225	          EXTRA_EXCLUDE="$EXTRA_EXCLUDE|$val"
   226	        fi
   227	        ;;
   228	      W) WATCH_CAP=$val ;;
   229	      C) CACHE_MB=$val ;;
   230	      M) MAX_FILES=$val ;;
   231	    esac
   232	  done < "$CONFIG_FILE"
   233	  [ -n "$loaded_roots" ] && ROOTS=$loaded_roots
   234	}
   235	
   236	save_config() {
   237	  mkdir -p "$STATE_DIR"
   238	  : > "$CONFIG_FILE"
   239	  oldifs=$IFS
   240	  IFS='|'
   241	  for r in $ROOTS; do
   242	    [ -n "$r" ] || continue
   243	    printf 'R\t%s\n' "$r" >> "$CONFIG_FILE"
   244	  done
   245	  for e in $EXTRA_EXCLUDE; do
   246	    [ -n "$e" ] || continue
   247	    printf 'E\t%s\n' "$e" >> "$CONFIG_FILE"
   248	  done
   249	  IFS=$oldifs
   250	  printf 'W\t%s\n' "$WATCH_CAP" >> "$CONFIG_FILE"
   251	  printf 'C\t%s\n' "$CACHE_MB" >> "$CONFIG_FILE"
   252	  printf 'M\t%s\n' "$MAX_FILES" >> "$CONFIG_FILE"
   253	}
   254	
   255	json_escape() {
   256	  # JSON string contents: \, ", C0 controls (including newline).
   257	  printf '%s' "$1" | od -An -t u1 -v | awk '
   258	    BEGIN { ORS="" }
   259	    {
   260	      for (i = 1; i <= NF; i++) {
   261	        n = $i + 0
   262	        if (n == 92) printf "\\\\"
   263	        else if (n == 34) printf "\\\""
   264	        else if (n == 10) printf "\\n"
   265	        else if (n == 13) printf "\\r"
   266	        else if (n == 9) printf "\\t"
   267	        else if (n < 32) printf "\\u%04x", n
   268	        else printf "%c", n
   269	      }
   270	    }
   271	  '
   272	}
   273	
   274	extract_id() {
   275	  printf '%s' "$1" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p'
   276	}
   277	
   278	extract_string() {
   279	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"
   280	}
   281	
   282	extract_number() {
   283	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p"
   284	}
   285	
   286	extract_array_inner() {
   287	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\[\\([^]]*\\)\\].*/\\1/p"
   288	}
   289	
   290	quoted_to_pipe() {
   291	  printf '%s' "$1" | sed 's/"[[:space:]]*,[[:space:]]*"/|/g; s/^[[:space:]]*"//; s/"[[:space:]]*$//; s/"//g'
   292	}
   293	
   294	apply_config_line() {
   295	  inner=$(extract_array_inner "$1" "roots")
   296	  if [ -n "$inner" ]; then
   297	    ROOTS=""
   298	    oldifs=$IFS
   299	    IFS='|'
   300	    set -- $(quoted_to_pipe "$inner")
   301	    IFS=$oldifs
   302	    for item in "$@"; do
   303	      [ -n "$item" ] || continue
   304	      exp=$(expand_tilde "$item")
   305	      if [ -z "$ROOTS" ]; then
   306	        ROOTS="$exp"
   307	      else
   308	        ROOTS="$ROOTS|$exp"
   309	      fi
   310	    done
   311	    [ -n "$ROOTS" ] || ROOTS="$HOME_DIR"
   312	  fi
   313	  inner=$(extract_array_inner "$1" "extraExclude")
   314	  if [ -n "$inner" ]; then
   315	    EXTRA_EXCLUDE=$(quoted_to_pipe "$inner")
   316	  fi
   317	  n=$(extract_number "$1" "watchCap")
   318	  [ -n "$n" ] && WATCH_CAP=$n
   319	  n=$(extract_number "$1" "cacheMb")
   320	  [ -n "$n" ] && CACHE_MB=$n
   321	  n=$(extract_number "$1" "maxFiles")
   322	  [ -n "$n" ] && MAX_FILES=$n
   323	  save_config
   324	}
   325	
   326	safe_glob() {
   327	  printf '%s' "$1" | tr -cd 'A-Za-z0-9._-'
   328	}
   329	
   330	kind_of() {
   331	  base=$(printf '%s' "$1" | sed 's|.*/||')
   332	  ext=$(printf '%s' "$base" | awk -F. '{print tolower($NF)}')
   333	  if [ -d "$1" ]; then
   334	    printf 'dir'
   335	    return
   336	  fi
   337	  case "$ext" in
   338	    png|jpg|jpeg|webp|svg|gif|bmp|ico) printf 'image' ;;
   339	    pdf) printf 'pdf' ;;
   340	    csv|tsv) printf 'csv' ;;
   341	    rs|js|ts|py|go|c|h|md|txt|toml|json|yml|yaml|qml|lua) printf 'code' ;;
   342	    *) printf 'hex' ;;
   343	  esac
   344	}
   345	
   346	score_name() {
   347	  name=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
   348	  q=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
   349	  case "$name" in
   350	    "$q") printf '1000' ;;
   351	    "$q"*) printf '800' ;;
   352	    *"$q"*) printf '600' ;;
   353	    *) printf '0' ;;
   354	  esac
   355	}
   356	
   357	demo_hit() {
   358	  path="$SAMP/$1"
   359	  kind=$(kind_of "$path")
   360	  printf '{"path":"%s","name":"%s","kind":"%s","score":%s,"mtime":0,"size":0}' \
   361	    "$(json_escape "$path")" "$1" "$kind" "$2"
   362	}
   363	
   364	demo_results() {
   365	  printf '[%s,%s,%s,%s,%s]' \
   366	    "$(demo_hit invoice.pdf 900)" \
   367	    "$(demo_hit photo.png 880)" \
   368	    "$(demo_hit sales.csv 860)" \
   369	    "$(demo_hit themed.rs 840)" \
   370	    "$(demo_hit README.md 820)"
   371	}
   372	
   373	prune_names() {
   374	  printf '%s' ".ssh|.gnupg|.password-store|node_modules|target|.git|.hg|.svn|.bzr|__pycache__|.venv|venv|.tox|.mypy_cache|.pytest_cache|.cargo|.rustup|.npm|.cache|.Trash|.local|keyrings|kwalletd|Keychains"
   375	  if [ -n "$EXTRA_EXCLUDE" ]; then
   376	    printf '|%s' "$EXTRA_EXCLUDE"
   377	  fi
   378	}
   379	
   380	is_secret_file() {
   381	  case "$1" in
   382	    .env|.env.*|*.env) return 0 ;;
   383	    id_rsa|id_ed25519|id_rsa.*) return 0 ;;
   384	  esac
   385	  return 1
   386	}
   387	
   388	path_is_secret() {
   389	  case "$1" in
   390	    */.ssh/*|*/.gnupg/*|*/.password-store/*|*/.local/share/keyrings/*|*/.local/share/kwalletd/*|*/Library/Keychains/*)
   391	      return 0
   392	      ;;
   393	  esac
   394	  is_secret_file "$(printf '%s' "$1" | sed 's|.*/||')"
   395	}
   396	
   397	hidden_ancestor() {
   398	  # Skip hidden/heavy directories unless they are an explicit root.
   399	  cur=$(dirname "$1")
   400	  while [ -n "$cur" ] && [ "$cur" != "/" ]; do
   401	    skip_this=0
   402	    oldifs=$IFS
   403	    IFS='|'
   404	    for r in $ROOTS; do
   405	      [ "$cur" = "$r" ] && skip_this=1
   406	    done
   407	    IFS=$oldifs
   408	    [ "$skip_this" -eq 0 ] || return 1
   409	    base=$(printf '%s' "$cur" | sed 's|.*/||')
   410	    case "$base" in
   411	      .*) return 0 ;;
   412	    esac
   413	    oldifs=$IFS
   414	    IFS='|'
   415	    for n in $(prune_names); do
   416	      [ "$base" = "$n" ] && return 0
   417	    done
   418	    IFS=$oldifs
   419	    np=$(dirname "$cur")
   420	    [ "$np" = "$cur" ] && break
   421	    cur=$np
   422	  done
   423	  return 1
   424	}
   425	
   426	append_hit() {
   427	  dest="$1"
   428	  p="$2"
   429	  q="$3"
   430	  path_is_secret "$p" && return 0
   431	  hidden_ancestor "$p" && return 0
   432	  sc=$(score_name "$(printf '%s' "$p" | sed 's|.*/||')" "$q")
   433	  [ "$sc" -gt 0 ] || return 0
   434	  k=$(kind_of "$p")
   435	  bn=$(printf '%s' "$p" | sed 's|.*/||')
   436	  printf '%s {"path":"%s","name":"%s","kind":"%s","score":%s,"mtime":0,"size":0}\n' \
   437	    "$sc" "$(json_escape "$p")" "$(json_escape "$bn")" "$k" "$sc" >> "$dest"
   438	}
   439	
   440	run_capped_find() {
   441	  root="$1"
   442	  q="$2"
   443	  out="$3"
   444	  names=$(prune_names)
   445	  set -f
   446	  set -- find "$root" -mindepth 1 -maxdepth 6 '(' -name '.*'
   447	  oldifs=$IFS
   448	  IFS='|'
   449	  for n in $names; do
   450	    [ -n "$n" ] || continue
   451	    set -- "$@" -o -name "$n"
   452	  done
   453	  IFS=$oldifs
   454	  set -- "$@" ')' -prune -o -iname "*$q*" -print
   455	  set +f
   456	  run_watchdog_capped 2 "$out" -- "$@"
   457	}
   458	
   459	find_hits() {
   460	  q=$(safe_glob "$1")
   461	  dest="$2"
   462	  [ -n "$q" ] || return 0
   463	  raw=$(mktemp)
   464	  located=$(mktemp)
   465	  if command -v plocate >/dev/null 2>&1; then
   466	    run_watchdog_capped 2 "$located" -- plocate -il 40 -- "$q"
   467	  elif command -v locate >/dev/null 2>&1; then
   468	    run_watchdog_capped 2 "$located" -- locate -il 40 -- "$q"
   469	  fi
   470	  if [ -s "$located" ]; then
   471	    while IFS= read -r lp; do
   472	      [ -n "$lp" ] || continue
   473	      under=0
   474	      oldifs=$IFS
   475	      IFS='|'
   476	      for root in $ROOTS; do
   477	        case "$lp" in
   478	          "$root"|"$root"/*) under=1 ;;
   479	        esac
   480	      done
   481	      IFS=$oldifs
   482	      [ "$under" -eq 1 ] && printf '%s\n' "$lp" >> "$raw"
   483	    done < "$located"
   484	  fi
   485	  rm -f "$located"
   486	  if [ ! -s "$raw" ]; then
   487	    oldifs=$IFS
   488	    IFS='|'
   489	    set -- $ROOTS
   490	    IFS=$oldifs
   491	    : > "$raw"
   492	    for root in "$@"; do
   493	      [ -d "$root" ] || continue
   494	      part=$(mktemp)
   495	      run_capped_find "$root" "$q" "$part"
   496	      cat "$part" >> "$raw" 2>/dev/null || true
   497	      rm -f "$part"
   498	    done
   499	  fi
   500	  n=0
   501	  while IFS= read -r p; do
   502	    [ -n "$p" ] || continue
   503	    n=$((n + 1))
   504	    [ "$n" -le 80 ] || break
   505	    append_hit "$dest" "$p" "$q"
   506	  done < "$raw"
   507	  rm -f "$raw"
   508	}
   509	
   510	reply_status() {
   511	  id="$1"
   512	  roots_json=""
   513	  oldifs=$IFS
   514	  IFS='|'
   515	  for r in $ROOTS; do
   516	    [ -n "$r" ] || continue
   517	    if [ -z "$roots_json" ]; then
   518	      roots_json="\"$(json_escape "$r")\""
   519	    else
   520	      roots_json="$roots_json,\"$(json_escape "$r")\""
   521	    fi
   522	  done
   523	  IFS=$oldifs
   524	  budget=$((CACHE_MB * 1024 * 1024))
   525	  poppler=false
   526	  command -v pdftoppm >/dev/null 2>&1 && poppler=true
   527	  plocate=false
   528	  { command -v plocate >/dev/null 2>&1 || command -v locate >/dev/null 2>&1; } && plocate=true
   529	  printf '{"id":%s,"kind":"status","indexing":false,"progress":1,"backend":"compat","status":{"indexing":false,"progress":1,"backend":"compat","files":5,"watchCount":0,"watchCap":%s,"roots":[%s],"cacheBytes":0,"cacheBudget":%s,"poppler":%s,"plocate":%s,"ffmpeg":false,"helper":"compat","version":"1.0.0"}}\n' \
   530	    "$id" "$WATCH_CAP" "$roots_json" "$budget" "$poppler" "$plocate"
   531	}
   532	
   533	reply_query() {
   534	  id="$1"
   535	  q="$2"
   536	  if [ -z "$q" ]; then
   537	    printf '{"id":%s,"kind":"results","results":%s,"indexing":false,"progress":1,"backend":"demo"}\n' "$id" "$(demo_results)"
   538	    return
   539	  fi
   540	  tmp=$(mktemp)
   541	  ql=$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')
   542	  for name in invoice.pdf photo.png sales.csv themed.rs README.md; do
   543	    sc=$(score_name "$name" "$ql")
   544	    if [ "$sc" -gt 0 ]; then
   545	      printf '%s %s\n' "$((sc + 200))" "$(demo_hit "$name" "$((sc + 200))")" >> "$tmp"
   546	    fi
   547	  done
   548	  find_hits "$q" "$tmp"
   549	  sorted=$(mktemp)
   550	  sort -nr -k1,1 "$tmp" > "$sorted" 2>/dev/null || true
   551	  body=""
   552	  n=0
   553	  while read -r _sc hit; do
   554	    [ -n "$hit" ] || continue
   555	    n=$((n + 1))
   556	    [ "$n" -le 40 ] || break
   557	    if [ -z "$body" ]; then
   558	      body="$hit"
   559	    else
   560	      body="$body,$hit"
   561	    fi
   562	  done < "$sorted"
   563	  printf '{"id":%s,"kind":"results","results":[%s],"indexing":false,"progress":1,"backend":"compat"}\n' "$id" "$body"
   564	  rm -f "$tmp" "$sorted"
   565	}
   566	
   567	png_wh() {
   568	  hex=$(read_user_file dd if="$1" bs=1 skip=16 count=8 2>/dev/null | od -An -tx1 | tr -cd '0-9a-f')
   569	  [ "${#hex}" -ge 16 ] || return 1
   570	  w=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c1-8)")
   571	  h=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c9-16)")
   572	  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   573	  printf '%s %s' "$w" "$h"
   574	}
   575	
   576	gif_wh() {
   577	  hex=$(read_user_file dd if="$1" bs=1 skip=6 count=4 2>/dev/null | od -An -tx1 | tr -cd '0-9a-f')
   578	  [ "${#hex}" -ge 8 ] || return 1
   579	  w=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c3-4)$(printf '%s' "$hex" | cut -c1-2)")
   580	  h=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c7-8)$(printf '%s' "$hex" | cut -c5-6)")
   581	  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   582	  printf '%s %s' "$w" "$h"
   583	}
   584	
   585	svg_wh() {
   586	  head=$(read_user_file dd if="$1" bs=1 count=8192 2>/dev/null)
   587	  vb=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Vv]iew[Bb]ox=["'\'']\([^"'\'']*\)["'\''].*/\1/p')
   588	  if [ -n "$vb" ]; then
   589	    set -- $vb
   590	    if [ "$#" -ge 4 ]; then
   591	      w=$(printf '%s' "$3" | tr -cd '0-9.')
   592	      h=$(printf '%s' "$4" | tr -cd '0-9.')
   593	      w=${w%%.*}
   594	      h=${h%%.*}
   595	      [ -n "$w" ] && [ -n "$h" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   596	      printf '%s %s' "$w" "$h"
   597	      return 0
   598	    fi
   599	  fi
   600	  w=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Ww]idth=["'\'']\([0-9.][0-9.]*\).*/\1/p')
   601	  h=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Hh]eight=["'\'']\([0-9.][0-9.]*\).*/\1/p')
   602	  w=${w%%.*}
   603	  h=${h%%.*}
   604	  [ -n "$w" ] && [ -n "$h" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   605	  printf '%s %s' "$w" "$h"
   606	}
   607	
   608	read_user_file() {
   609	  run_watchdog 1 "$@"
   610	}
   611	
   612	hex_head() {
   613	  read_user_file od -An -tx1 -N 256 "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //'
   614	}
   615	
   616	html_escape_file() {
   617	  read_user_file head -c "$OUTPUT_CAP" "$1" 2>/dev/null | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
   618	}
   619	
   620	csv_preview_json() {
   621	  path="$1"
   622	  # Byte-cap FIRST (bounds a pathological single no-newline row), then line-cap.
   623	  read_user_file head -c "$OUTPUT_CAP" "$path" 2>/dev/null | head -n 501 | awk '
   624	    function esc(s) {
   625	      gsub(/\\/, "\\\\", s)
   626	      gsub(/"/, "\\\"", s)
   627	      return s
   628	    }
   629	    function arr(line,    n, i, out, a) {
   630	      n = split(line, a, FS)
   631	      out = "["
   632	      for (i = 1; i <= n; i++) {
   633	        if (i > 1) out = out ","
   634	        out = out "\"" esc(a[i]) "\""
   635	      }
   636	      return out "]"
   637	    }
   638	    BEGIN { headers = "[]"; rows = ""; nbody = 0 }
   639	    NR == 1 {
   640	      line = $0
   641	      c = gsub(/,/, ",", line)
   642	      line = $0
   643	      t = gsub(/\t/, "\t", line)
   644	      line = $0
   645	      s = gsub(/;/, ";", line)
   646	      line = $0
   647	      p = gsub(/\|/, "|", line)
   648	      FS = ","
   649	      if (t > c && t >= s && t >= p) FS = "\t"
   650	      else if (s > c && s >= t && s >= p) FS = ";"
   651	      else if (p > c && p >= t && p >= s) FS = "|"
   652	      $0 = $0
   653	      headers = arr($0)
   654	      next
   655	    }
   656	    {
   657	      if (nbody) rows = rows ","
   658	      rows = rows arr($0)
   659	      nbody++
   660	    }
   661	    END {
   662	      trunc = (NR > 501) ? "true" : "false"
   663	      printf "{\"kind\":\"csv\",\"headers\":%s,\"rows\":[%s],\"truncated\":%s}", headers, rows, trunc
   664	    }
   665	  '
   666	}
   667	
   668	dir_preview_json() {
   669	  path="$1"
   670	  tmp=$(mktemp)
   671	  # Byte-cap the listing (bounds pathological huge-filename dirs) then line-cap.
   672	  read_user_file ls -1 "$path" 2>/dev/null | cap_stream | head -n 200 > "$tmp"
   673	  entries=""
   674	  while IFS= read -r name || [ -n "$name" ]; do
   675	    [ -n "$name" ] || continue
   676	    full="$path/$name"
   677	    k=$(kind_of "$full")
   678	    sz=0
   679	    if [ -f "$full" ] && watchdog_ok; then
   680	      sz=$(run_watchdog 1 stat -c %s "$full" 2>/dev/null) || \
   681	        sz=$(run_watchdog 1 stat -f %z "$full" 2>/dev/null) || sz=0
   682	      [ -n "$sz" ] || sz=0
   683	    fi
   684	    ent="{\"name\":\"$(json_escape "$name")\",\"kind\":\"$k\",\"size\":$sz}"
   685	    if [ -z "$entries" ]; then
   686	      entries="$ent"
   687	    else
   688	      entries="$entries,$ent"
   689	    fi
   690	  done < "$tmp"
   691	  rm -f "$tmp"
   692	  printf '{"kind":"dir","entries":[%s],"path":"%s"}' "$entries" "$(json_escape "$path")"
   693	}
   694	
   695	isolation_ok() {
   696	  watchdog_ok
   697	}
   698	
   699	run_isolated() {
   700	  watchdog_ok || return 1
   701	  (
   702	    # CPU seconds and file size are always safe to cap. Address space (-v) is
   703	    # Linux-only: on macOS RLIMIT_AS can prevent the renderer from exec'ing.
   704	    # NPROC (-u) is deliberately NOT set: it counts the user's ENTIRE existing
   705	    # process table, so a judge already running many processes could be unable
   706	    # to start any renderer. Fork bombs remain bounded by the CPU limit and the
   707	    # process-group wall-clock watchdog (run_watchdog).
   708	    ulimit -t 8 2>/dev/null || true
   709	    ulimit -f 65536 2>/dev/null || true
   710	    [ "$OS_NAME" = Linux ] && ulimit -v 524288 2>/dev/null || true
   711	    run_watchdog 8 "$@"
   712	  ) >/dev/null 2>&1 || true
   713	}
   714	
   715	run_pdftoppm() {
   716	  path="$1"
   717	  page="$2"
   718	  dest="$3"
   719	  prefix="${dest%.png}"
   720	  if ! isolation_ok; then
   721	    return 1
   722	  fi
   723	  run_isolated pdftoppm -f "$page" -l "$page" -png -r 140 -singlefile "$path" "$prefix"
   724	}
   725	
   726	downsample_image() {
   727	  src="$1"
   728	  dest="$2"
   729	  nw="$3"
   730	  nh="$4"
   731	  if ! isolation_ok; then
   732	    return 1
   733	  fi
   734	  if command -v ffmpeg >/dev/null 2>&1; then
   735	    run_isolated ffmpeg -nostdin -hide_banner -loglevel error -i "$src" -vf "scale=${nw}:${nh}" -frames:v 1 -y "$dest"
   736	    [ -s "$dest" ] && return 0
   737	  fi
   738	  if command -v magick >/dev/null 2>&1; then
   739	    run_isolated magick "$src" -resize "${nw}x${nh}" "$dest"
   740	    [ -s "$dest" ] && return 0
   741	  fi
   742	  if command -v convert >/dev/null 2>&1; then
   743	    run_isolated convert "$src" -resize "${nw}x${nh}" "$dest"
   744	    [ -s "$dest" ] && return 0
   745	  fi
   746	  return 1
   747	}
   748	
   749	reply_preview() {
   750	  id="$1"
   751	  path="$2"
   752	  page="${3:-1}"
   753	  [ -n "$page" ] || page=1
   754	  kind=$(kind_of "$path")
   755	  case "$kind" in
   756	    image)
   757	      ext=$(printf '%s' "$path" | awk -F. '{print tolower($NF)}')
   758	      wh=""
   759	      case "$ext" in
   760	        png) wh=$(png_wh "$path") || wh="" ;;
   761	        gif) wh=$(gif_wh "$path") || wh="" ;;
   762	        svg) wh=$(svg_wh "$path") || wh="" ;;
   763	        *) wh="" ;;
   764	      esac
   765	      if [ -n "$wh" ]; then
   766	        set -- $wh
   767	        w=$1
   768	        h=$2
   769	        pix=$((w * h))
   770	        if [ "$pix" -le 20000000 ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   771	          anim=false
   772	          [ "$ext" = gif ] && anim=true
   773	          printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":%s,"width":%s,"height":%s}}\n' \
   774	            "$id" "$(json_escape "$path")" "$anim" "$w" "$h"
   775	        elif [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   776	          nw=$w
   777	          nh=$h
   778	          # integer sqrt-ish shrink so nw*nh <= 20e6
   779	          while [ $((nw * nh)) -gt 20000000 ]; do
   780	            nw=$((nw / 2))
   781	            nh=$((nh / 2))
   782	            [ "$nw" -gt 0 ] && [ "$nh" -gt 0 ] || break
   783	          done
   784	          [ "$nw" -gt 0 ] || nw=1
   785	          [ "$nh" -gt 0 ] || nh=1
   786	          cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/previews"
   787	          mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-previews"
   788	          mkdir -p "$cache_dir"
   789	          dest="$cache_dir/ds-$$.png"
   790	          if downsample_image "$path" "$dest" "$nw" "$nh" && [ -s "$dest" ]; then
   791	            printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":false,"width":%s,"height":%s,"label":"downsampled"}}\n' \
   792	              "$id" "$(json_escape "$dest")" "$nw" "$nh"
   793	          else
   794	            printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"image %sx%s","label":"image exceeds 20 MP — hex view","width":%s,"height":%s,"path":"%s"}}\n' \
   795	              "$id" "$(json_escape "$(hex_head "$path")")" "$w" "$h" "$w" "$h" "$(json_escape "$path")"
   796	          fi
   797	        fi
   798	      else
   799	        printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"unverifiable image","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   800	          "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   801	      fi
   802	      ;;
   803	    pdf)
   804	      if command -v pdftoppm >/dev/null 2>&1 && isolation_ok; then
   805	        cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/pdf"
   806	        mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-pdf"
   807	        mkdir -p "$cache_dir"
   808	        dest="$cache_dir/p${page}-$$.png"
   809	        run_pdftoppm "$path" "$page" "$dest"
   810	        if [ ! -s "$dest" ] && [ -s "${dest%.png}-1.png" ]; then
   811	          dest="${dest%.png}-1.png"
   812	        fi
   813	        if [ -s "$dest" ]; then
   814	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","path":"%s","page":%s,"page_count":1,"need_poppler":false}}\n' \
   815	            "$id" "$(json_escape "$dest")" "$page"
   816	        else
   817	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"render_error":true,"page":%s,"page_count":1,"label":"couldn'\''t render this page","magic":"PDF document","hex":"%s"}}\n' \
   818	            "$id" "$page" "$(json_escape "$(hex_head "$path")")"
   819	        fi
   820	      elif command -v pdftoppm >/dev/null 2>&1; then
   821	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"page":%s,"page_count":1,"label":"PDF metadata only — no isolated renderer","magic":"PDF document"}}\n' \
   822	          "$id" "$page"
   823	      else
   824	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":true,"page":%s,"page_count":1,"label":"install poppler for PDF previews","magic":"PDF document","path":"%s"}}\n' \
   825	          "$id" "$page" "$(json_escape "$path")"
   826	      fi
   827	      ;;
   828	    code)
   829	      printf '{"id":%s,"kind":"preview","preview":{"kind":"code","html":"<pre>%s</pre>","lang":"text","path":"%s"}}\n' \
   830	        "$id" "$(json_escape "$(html_escape_file "$path")")" "$(json_escape "$path")"
   831	      ;;
   832	    csv)
   833	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(csv_preview_json "$path")"
   834	      ;;
   835	    dir)
   836	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(dir_preview_json "$path")"
   837	      ;;
   838	    *)
   839	      printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"data","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   840	        "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   841	      ;;
   842	  esac
   843	}
   844	
   845	do_open() {
   846	  path="$1"
   847	  reveal="$2"
   848	  if [ ! -e "$path" ]; then
   849	    return 1
   850	  fi
   851	  target="$path"
   852	  if [ "$reveal" = 1 ] && [ ! -d "$path" ]; then
   853	    target=$(dirname "$path")
   854	  fi
   855	  watchdog_ok || return 2
   856	  if command -v gio >/dev/null 2>&1; then
   857	    run_watchdog 8 gio open "$target" >/dev/null 2>&1 || true
   858	    return 0
   859	  fi
   860	  if command -v xdg-open >/dev/null 2>&1; then
   861	    run_watchdog 8 xdg-open "$target" >/dev/null 2>&1 || true
   862	    return 0
   863	  fi
   864	  if command -v open >/dev/null 2>&1; then
   865	    run_watchdog 8 open "$target" >/dev/null 2>&1 || true
   866	    return 0
   867	  fi
   868	  return 2
   869	}
   870	
   871	handle_line() {
   872	  load_config
   873	  line="$1"
   874	  id=$(extract_id "$line")
   875	  [ -n "$id" ] || id=0
   876	  case "$line" in
   877	    *'"cmd":"config"'*|*'cmd": "config"'*)
   878	      apply_config_line "$line"
   879	      reply_status "$id"
   880	      ;;
   881	    *'"cmd":"status"'*|*'cmd": "status"'*|*'cmd":"capabilities"'*)
   882	      reply_status "$id"
   883	      ;;
   884	    *'"cmd":"preview"'*|*'cmd": "preview"'*|*'cmd":"prefetch"'*|*'cmd": "prefetch"'*|*'cmd":"page"'*|*'cmd": "page"'*)
   885	      reply_preview "$id" "$(extract_string "$line" "path")" "$(extract_number "$line" "page")"
   886	      ;;
   887	    *'"cmd":"open"'*|*'cmd": "open"'*)
   888	      path=$(extract_string "$line" "path")
   889	      if do_open "$path" 0; then
   890	        printf '{"id":%s,"kind":"ok"}\n' "$id"
   891	      else
   892	        printf '{"id":%s,"kind":"error","error":"open failed"}\n' "$id"
   893	      fi
   894	      ;;
   895	    *'"cmd":"reveal"'*|*'cmd": "reveal"'*)
   896	      path=$(extract_string "$line" "path")
   897	      if do_open "$path" 1; then
   898	        printf '{"id":%s,"kind":"ok"}\n' "$id"
   899	      else
   900	        printf '{"id":%s,"kind":"error","error":"reveal failed"}\n' "$id"
     1	import QtQuick
     2	import Quickshell
     3	import Quickshell.Io
     4	import "js/Protocol.js" as Protocol
     5	import "js/Config.js" as Config
     6	import "js/Fallback.js" as Fallback
     7	import "js/Theme.js" as Theme
     8	import "js/Format.js" as Format
     9	
    10	Item {
    11	  id: root
    12	
    13	  property var shell: null
    14	  property var manifest: null
    15	  property var pluginRegistry: null
    16	  property string omarchyPath: Quickshell.env("OMARCHY_PATH") || ""
    17	
    18	  readonly property string pluginId: "io.github.chris.quicklook"
    19	  readonly property string pluginDir: {
    20	    var u = String(Qt.resolvedUrl("."))
    21	    if (u.indexOf("file://") === 0)
    22	      u = u.slice(7)
    23	    if (u.length > 1 && u.charAt(u.length - 1) === "/")
    24	      u = u.slice(0, u.length - 1)
    25	    return u
    26	  }
    27	
    28	  // Inline shell.json fields. The host may assign these from the plugins[] entry.
    29	  property var roots: []
    30	  property int watchCap: 2000
    31	  property int cacheMb: 500
    32	  property int maxFiles: 500000
    33	  property var extraExclude: []
    34	
    35	  readonly property string home: Quickshell.env("HOME") || "/tmp"
    36	  readonly property string stateDir: {
    37	    var xdg = Quickshell.env("XDG_STATE_HOME")
    38	    if (xdg && xdg.length)
    39	      return xdg + "/quicklook"
    40	    return home + "/.local/state/quicklook"
    41	  }
    42	  readonly property string helperBin: pluginDir + "/bin/quicklookd"
    43	  readonly property string helperSh: pluginDir + "/compat/quicklookd.sh"
    44	
    45	  property string helperCmd: helperSh
    46	  property bool helperIsBinary: false
    47	  property bool helperReady: false
    48	  property bool helperDead: false
    49	  property bool usingFallback: false
    50	  property bool oneshotMode: false
    51	  property int restarts: 0
    52	  property bool shuttingDown: false
    53	  property string lastStatus: "starting"
    54	  property string lastLine: ""
    55	  property var lastResults: []
    56	  property var lastPreview: ({})
    57	  property var lastCaps: ({})
    58	  property int resultsRevision: 0
    59	  property int previewRevision: 0
    60	  property int statusRevision: 0
    61	  property bool indexing: false
    62	  property real indexProgress: 0
    63	  property string backend: "demo"
    64	  property bool stdinWorks: false
    65	  property bool pingSent: false
    66	  property var sendQueue: []
    67	
    68	  function applyHostSettings() {
    69	    var entry = {
    70	      roots: root.roots,
    71	      watchCap: root.watchCap,
    72	      cacheMb: root.cacheMb,
    73	      maxFiles: root.maxFiles,
    74	      extraExclude: root.extraExclude
    75	    }
    76	    Config.applyInline(entry, root.home)
    77	  }
    78	
    79	  function helperCommand() {
    80	    return root.helperIsBinary ? root.helperBin : root.helperSh
    81	  }
    82	
    83	  function helperLaunch(oneshotJson) {
    84	    var cmd = [root.helperCommand(), "--plugin-dir", root.pluginDir]
    85	    if (oneshotJson !== undefined && oneshotJson !== null) {
    86	      cmd.push("--oneshot")
    87	      cmd.push(String(oneshotJson))
    88	    }
    89	    return cmd
    90	  }
    91	
    92	  function writeLine(line) {
    93	    try {
    94	      if (typeof helper.write === "function") {
    95	        helper.write(line)
    96	        return true
    97	      }
    98	    } catch (e) {}
    99	    try {
   100	      if (helper.stdin && typeof helper.stdin.write === "function") {
   101	        helper.stdin.write(line)
   102	        return true
   103	      }
   104	    } catch (e2) {}
   105	    return false
   106	  }
   107	
   108	  function send(obj) {
   109	    if (!obj)
   110	      return 0
   111	    if (!obj.id)
   112	      obj.id = Protocol.nextId()
   113	    var line = JSON.stringify(obj) + "\n"
   114	    if (root.oneshotMode || !helper.running) {
   115	      root.enqueueOneshot(obj)
   116	      return obj.id
   117	    }
   118	    if (!root.writeLine(line)) {
   119	      root.sendQueue.push(obj)
   120	      if (!root.oneshotMode && root.pingSent)
   121	        root.oneshotMode = true
   122	      root.flushSendQueue()
   123	    }
   124	    return obj.id
   125	  }
   126	
   127	  function flushSendQueue() {
   128	    var leftover = []
   129	    for (var i = 0; i < root.sendQueue.length; i++) {
   130	      var job = root.sendQueue[i]
   131	      if (root.oneshotMode || !helper.running) {
   132	        root.enqueueOneshot(job)
   133	      } else if (!root.writeLine(JSON.stringify(job) + "\n")) {
   134	        leftover.push(job)
   135	      }
   136	    }
   137	    root.sendQueue = leftover
   138	  }
   139	
   140	  function enterCompatFallback() {
   141	    root.helperDead = true
   142	    root.usingFallback = true
   143	    root.oneshotMode = true
   144	    root.helperIsBinary = false
   145	    root.helperCmd = root.helperSh
   146	    root.lastStatus = "compat"
   147	    helper.running = false
   148	    var abandoned = Protocol.abandonInFlight()
   149	    root.flushSendQueue()
   150	    if (abandoned.queuedPreview)
   151	      root.enqueueOneshot(abandoned.queuedPreview)
   152	    if (abandoned.previewId && abandoned.previewPath) {
   153	      root.applyLocalPreview(abandoned.previewId, abandoned.previewPath)
   154	      root.enqueueOneshot({
   155	        id: Protocol.nextId(),
   156	        cmd: "preview",
   157	        path: abandoned.previewPath
   158	      })
   159	    }
   160	    if (abandoned.queuedPrefetch)
   161	      root.enqueueOneshot(abandoned.queuedPrefetch)
   162	  }
   163	
   164	  function enqueueOneshot(obj) {
   165	    if (obj && (obj.cmd === "preview" || obj.cmd === "prefetch" || obj.cmd === "page")) {
   166	      var kept = []
   167	      for (var i = 0; i < oneshotQueue.length; i++) {
   168	        var c = oneshotQueue[i].cmd
   169	        var same = obj.cmd === "prefetch" ? c === "prefetch" : (c === "preview" || c === "page")
   170	        if (!same)
   171	          kept.push(oneshotQueue[i])
   172	      }
   173	      oneshotQueue = kept
   174	    }
   175	    oneshotQueue.push(obj)
   176	    runOneshot()
   177	  }
   178	
   179	  function dispatchPending() {
   180	    var nextPrev = Protocol.takeReadyPreview()
   181	    if (nextPrev)
   182	      root.send(nextPrev)
   183	    var nextPref = Protocol.takeReadyPrefetch()
   184	    if (nextPref)
   185	      root.send(nextPref)
   186	  }
   187	
   188	  function applyLocalPreview(id, path) {
   189	    Protocol.dropInFlight(id)
   190	    root.lastPreview = Format.localPreview(path)
   191	    root.previewRevision += 1
   192	    root.dispatchPending()
   193	  }
   194	
   195	  property var oneshotQueue: []
   196	  property var oneshotCurrent: null
   197	
   198	  function runOneshot() {
   199	    if (oneshotProc.running || root.oneshotCurrent)
   200	      return
   201	    if (!oneshotQueue.length)
   202	      return
   203	    root.oneshotCurrent = oneshotQueue.shift()
   204	    oneshotProc.command = root.helperLaunch(JSON.stringify(root.oneshotCurrent))
   205	    oneshotProc.running = true
   206	  }
   207	
   208	  function onHelperLine(line) {
   209	    root.lastLine = String(line || "")
   210	    var msg = Protocol.parseLine(line)
   211	    if (!msg)
   212	      return
   213	    root.stdinWorks = true
   214	    if (msg.kind === "results") {
   215	      if (!Protocol.acceptQuery(msg))
   216	        return
   217	      root.lastResults = msg.results || []
   218	      if (msg.indexing !== undefined)
   219	        root.indexing = !!msg.indexing
   220	      if (msg.progress !== undefined)
   221	        root.indexProgress = Number(msg.progress) || 0
   222	      if (msg.backend)
   223	        root.backend = String(msg.backend)
   224	      root.resultsRevision += 1
   225	    } else if (msg.kind === "preview") {
   226	      var cls = Protocol.slotClass(msg.id)
   227	      var inflightPath = Protocol.pathForInFlight(msg.id)
   228	      Protocol.classifyAndClear(msg.id)
   229	      root.dispatchPending()
   230	      if (cls === "prefetch")
   231	        return
   232	      if (msg.error === "stale" && !msg.preview)
   233	        return
   234	      if (!Protocol.acceptForegroundPreview(msg))
   235	        return
   236	      root.lastPreview = msg.preview || Format.localPreview(inflightPath)
   237	      root.previewRevision += 1
   238	    } else if (msg.kind === "status") {
   239	      root.lastCaps = msg.status || {}
   240	      if (msg.indexing !== undefined)
   241	        root.indexing = !!msg.indexing
   242	      if (msg.status && msg.status.indexing !== undefined)
   243	        root.indexing = !!msg.status.indexing
   244	      if (msg.progress !== undefined)
   245	        root.indexProgress = Number(msg.progress) || 0
   246	      if (msg.status && msg.status.progress !== undefined)
   247	        root.indexProgress = Number(msg.status.progress) || 0
   248	      if (msg.backend)
   249	        root.backend = String(msg.backend)
   250	      else if (msg.status && msg.status.backend)
   251	        root.backend = String(msg.status.backend)
   252	      root.statusRevision += 1
   253	    } else if (msg.kind === "error") {
   254	      var errPath = Protocol.pathForInFlight(msg.id)
   255	      var errClass = Protocol.slotClass(msg.id)
   256	      Protocol.dropInFlight(msg.id)
   257	      root.lastStatus = "error:" + String(msg.error || "")
   258	      if (errClass === "preview")
   259	        root.applyLocalPreview(msg.id, errPath)
   260	      else
   261	        root.dispatchPending()
   262	    } else if (msg.kind === "ok") {
   263	      root.lastStatus = "ok"
   264	    }
   265	  }
   266	
   267	  function localQuery(q) {
   268	    var items = Fallback.defaultSamples(root.pluginDir)
   269	    var hits = Fallback.search(items, q, 40)
   270	    root.lastResults = hits
   271	    root.backend = "local"
   272	    root.indexing = false
   273	    root.indexProgress = 1
   274	    root.resultsRevision += 1
   275	    return hits
   276	  }
   277	
   278	  function query(q) {
   279	    if (root.helperDead && !helper.running && root.oneshotMode === false && !root.helperReady) {
   280	      return root.localQuery(q)
   281	    }
   282	    var req = Protocol.queryRequest(q)
   283	    root.send(req)
   284	    return req.id
   285	  }
   286	
   287	  function requestPreview(path, page) {
   288	    var req = Protocol.previewRequest(path, page)
   289	    var ready = Protocol.queueOrStartPreview(req)
   290	    if (ready)
   291	      root.send(ready)
   292	    return req.id
   293	  }
   294	
   295	  function prefetch(path) {
   296	    var req = Protocol.prefetchRequest(path)
   297	    var ready = Protocol.queueOrStartPrefetch(req)
   298	    if (ready)
   299	      root.send(ready)
   300	    return req.id
   301	  }
   302	
   303	  function openPath(path) {
   304	    if (path)
   305	      root.send(Protocol.selectRequest(path))
   306	    return root.send(Protocol.openRequest(path))
   307	  }
   308	
   309	  function reveal(path) {
   310	    return root.send(Protocol.revealRequest(path))
   311	  }
   312	
   313	  function select(path) {
   314	    return root.send(Protocol.selectRequest(path))
   315	  }
   316	
   317	  function setTheme(palette) {
   318	    return root.send(Protocol.themeRequest(palette))
   319	  }
   320	
   321	  function pushConfig() {
   322	    var snap = Config.snapshot()
   323	    return root.send(Protocol.configRequest(snap))
   324	  }
   325	
   326	  function warmup() {
   327	    return root.send(Protocol.warmupRequest())
   328	  }
   329	
   330	  function requestStatus() {
   331	    return root.send(Protocol.statusRequest())
   332	  }
   333	
   334	  function statusJson() {
   335	    return JSON.stringify({
   336	      id: root.pluginId,
   337	      helper: root.helperCmd,
   338	      helperIsBinary: root.helperIsBinary,
   339	      helperDead: root.helperDead,
   340	      oneshot: root.oneshotMode,
   341	      backend: root.backend,
   342	      indexing: root.indexing,
   343	      progress: root.indexProgress,
   344	      results: root.lastResults.length,
   345	      caps: root.lastCaps,
   346	      status: root.lastStatus
   347	    })
   348	  }
   349	
   350	  function summonOverlay(payload) {
   351	    var body = payload || "{}"
   352	    Quickshell.execDetached(["omarchy-shell", "shell", "summon", root.pluginId, body])
   353	    return "ok"
