   725	def pdf_page_count(path: Path) -> int:
   726	    info = shutil.which("pdfinfo")
   727	    if info:
   728	        try:
   729	            proc = run_killable(
   730	                [info, str(path)],
   731	                timeout_s=2,
   732	                capture_output=True,
   733	                text=True,
   734	            )
   735	            for line in proc.stdout.splitlines():
   736	                if line.startswith("Pages:"):
   737	                    n = int(line.split(":", 1)[1].strip() or "1")
   738	                    return max(1, n)
   739	        except (subprocess.TimeoutExpired, OSError, ValueError):
   740	            pass
   741	    head = read_capped(path, 256 * 1024).decode("latin-1", errors="replace")
   742	    best = 1
   743	    idx = 0
   744	    while True:
   745	        at = head.find("/Count", idx)
   746	        if at < 0:
   747	            break
   748	        rest = head[at + 6 :].lstrip()
   749	        digits = ""
   750	        for ch in rest:
   751	            if ch.isdigit():
   752	                digits += ch
   753	            elif digits:
   754	                break
   755	        if digits:
   756	            n = int(digits)
   757	            if 1 < n < 10_000 and n > best:
   758	                best = n
   759	        idx = at + 6
   760	    return best
   761	
