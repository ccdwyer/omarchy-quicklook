     3	function clampByte(n) {
     4	  var v = Math.round(Number(n) || 0)
     5	  if (v < 0)
     6	    return 0
     7	  if (v > 255)
     8	    return 255
     9	  return v
    10	}
    11	
    12	function parseColor(value) {
    13	  var s = String(value || "").trim()
    14	  if (!s.length)
    15	    return { r: 26, g: 26, b: 26, a: 255 }
    16	  if (s.indexOf("#") === 0) {
    17	    var hex = s.slice(1)
    18	    if (hex.length === 8)
    19	      hex = hex.slice(2)
    20	    if (hex.length === 3) {
    21	      return {
    22	        r: parseInt(hex.charAt(0) + hex.charAt(0), 16),
    23	        g: parseInt(hex.charAt(1) + hex.charAt(1), 16),
    24	        b: parseInt(hex.charAt(2) + hex.charAt(2), 16),
    25	        a: 255
    26	      }
    27	    }
    28	    if (hex.length === 6) {
    29	      return {
    30	        r: parseInt(hex.slice(0, 2), 16),
    31	        g: parseInt(hex.slice(2, 4), 16),
    32	        b: parseInt(hex.slice(4, 6), 16),
    33	        a: 255
    34	      }
    35	    }
    36	  }
    37	  var m = s.match(/rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/)
    38	  if (m) {
    39	    return { r: Number(m[1]), g: Number(m[2]), b: Number(m[3]), a: 255 }
    40	  }
    41	  return { r: 26, g: 26, b: 26, a: 255 }
    42	}
    43	
    44	function toHex(c) {
    45	  function h(n) {
    46	    var s = clampByte(n).toString(16)
    47	    return s.length === 1 ? "0" + s : s
    48	  }
    49	  return "#" + h(c.r) + h(c.g) + h(c.b)
    50	}
    51	
    52	function mix(a, b, t) {
    53	  var u = Number(t)
    54	  if (isNaN(u))
    55	    u = 0.5
    56	  return {
    57	    r: clampByte(a.r + (b.r - a.r) * u),
    58	    g: clampByte(a.g + (b.g - a.g) * u),
    59	    b: clampByte(a.b + (b.b - a.b) * u),
    60	    a: 255
    61	  }
    62	}
    63	
    64	function paletteFromTokens(bg, fg, accent, surface) {
    65	  var pbg = parseColor(bg)
    66	  var pfg = parseColor(fg)
    67	  var pac = parseColor(accent)
    68	  var psu = surface ? parseColor(surface) : mix(pbg, pfg, 0.08)
    69	  return {
    70	    bg: toHex(pbg),
    71	    fg: toHex(pfg),
    72	    accent: toHex(pac),
    73	    surface: toHex(psu),
    74	    zebra: toHex(mix(pbg, pfg, 0.06)),
    75	    zebraAlt: toHex(mix(pbg, pfg, 0.12)),
    76	    comment: toHex(mix(pfg, pbg, 0.55)),
    77	    string: toHex(mix(pac, { r: 232, g: 176, b: 96, a: 255 }, 0.45)),
    78	    keyword: toHex(pac),
    79	    number: toHex(mix(pac, { r: 140, g: 210, b: 180, a: 255 }, 0.35)),
    80	    func: toHex(mix(pfg, pac, 0.28)),
    81	    checkerA: toHex(mix(pbg, pfg, 0.08)),
    82	    checkerB: toHex(mix(pbg, pfg, 0.16))
    83	  }
    84	}
    85	
    86	function defaultPalette() {
    87	  return paletteFromTokens("#1a1b26", "#c0caf5", "#7aa2f7", "#24283b")
