   368	    }
   369	
   370	    #[test]
   371	    fn plocate_kills_hung_child() {
   372	        crate::limits::with_path_lock(|| {
   373	            let dir = std::env::temp_dir().join(format!("ql-plocate-{}", std::process::id()));
   374	            let _ = std::fs::create_dir_all(&dir);
   375	            let fake = dir.join("plocate");
   376	            std::fs::write(&fake, "#!/bin/sh\nexec sleep 30\n").unwrap();
   377	            #[cfg(unix)]
   378	            {
   379	                use std::os::unix::fs::PermissionsExt;
   380	                let mut p = std::fs::metadata(&fake).unwrap().permissions();
   381	                p.set_mode(0o755);
   382	                std::fs::set_permissions(&fake, p).unwrap();
   383	            }
   384	            let old = std::env::var("PATH").unwrap_or_default();
   385	            std::env::set_var("PATH", format!("{}:{old}", dir.display()));
   386	            let start = std::time::Instant::now();
   387	            let hits = plocate("invoice", 10, &[], &[dir.clone()]);
   388	            let elapsed = start.elapsed();
   389	            std::env::set_var("PATH", old);
   390	            assert!(
   391	                elapsed < std::time::Duration::from_secs(5),
   392	                "hung plocate was not killed: {elapsed:?}"
   393	            );
   394	            assert!(hits.is_none());
   395	            let _ = std::fs::remove_dir_all(&dir);
   396	        });
   397	    }
   398	}
