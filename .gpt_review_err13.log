### tests/run.js
     1	#!/usr/bin/env node
     2	"use strict"
     3	
     4	const fs = require("fs")
     5	const path = require("path")
     6	const vm = require("vm")
     7	const assert = require("assert")
     8	
     9	const ROOT = path.resolve(__dirname, "..")
    10	const JS = path.join(ROOT, "js")
    11	const FIX = path.join(__dirname, "fixtures")
    12	const SAMPLES = path.join(ROOT, "samples")
    13	
    14	function loadEngine(file) {
    15	  const src = fs
    16	    .readFileSync(path.join(JS, file), "utf8")
    17	    .replace(/^\.pragma library\s*\n/, "")
    18	  const sandbox = {
    19	    console,
    20	    Date,
    21	    Math,
    22	    JSON,
    23	    String,
    24	    Number,
    25	    Array,
    26	    Object,
    27	    parseInt,
    28	    isNaN,
    29	    exports: {},
    30	    module: { exports: {} }
    31	  }
    32	  vm.createContext(sandbox)
    33	  vm.runInContext(src, sandbox, { filename: file })
    34	  const exported = {}
    35	  for (const key of Object.keys(sandbox)) {
    36	    if (["console", "Date", "Math", "JSON", "String", "Number", "Array", "Object", "parseInt", "isNaN", "exports", "module"].indexOf(key) >= 0)
    37	      continue
    38	    exported[key] = sandbox[key]
    39	  }
    40	  return exported
    41	}
    42	
    43	const Protocol = loadEngine("Protocol.js")
    44	const Format = loadEngine("Format.js")
    45	const Theme = loadEngine("Theme.js")
    46	const Config = loadEngine("Config.js")
    47	const Fallback = loadEngine("Fallback.js")
    48	const Binds = loadEngine("Binds.js")
    49	
    50	let passed = 0
    51	let failed = 0
    52	
    53	function test(name, fn) {
    54	  try {
    55	    Protocol.reset()
    56	    Config.reset()
    57	    fn()
    58	    passed += 1
    59	    process.stdout.write("ok  " + name + "\n")
    60	  } catch (err) {
    61	    failed += 1
    62	    process.stderr.write("FAIL " + name + "\n" + (err && err.stack ? err.stack : err) + "\n")
    63	  }
    64	}
    65	
    66	test("protocol: ids are monotonic", () => {
    67	  const a = Protocol.nextId()
    68	  const b = Protocol.nextId()
    69	  const c = Protocol.nextId()
    70	  assert.strictEqual(a + 1, b)
    71	  assert.strictEqual(b + 1, c)
    72	})
    73	
    74	test("protocol: stale responses drop", () => {
    75	  assert.strictEqual(Protocol.isStale(10, 9), true)
    76	  assert.strictEqual(Protocol.isStale(10, 10), false)
    77	  assert.strictEqual(Protocol.isStale(10, 11), false)
    78	  const first = Protocol.parseLine('{"id":10,"kind":"results","results":[]}')
    79	  assert.strictEqual(Protocol.acceptQuery(first), true)
    80	  const stale = Protocol.parseLine('{"id":9,"kind":"results","results":[]}')
    81	  assert.strictEqual(Protocol.acceptQuery(stale), false)
    82	  const fresh = Protocol.parseLine('{"id":11,"kind":"results","results":[{"path":"/a"}]}')
    83	  assert.strictEqual(Protocol.acceptQuery(fresh), true)
    84	  assert.strictEqual(Protocol.acceptedQueryId(), 11)
    85	})
    86	
    87	test("protocol: createSession isolates slots from the module", () => {
    88	  const a = Protocol.createSession()
    89	  const b = Protocol.createSession()
    90	  a.markPreview(7, "/a")
    91	  assert.strictEqual(a.canStartPreview(), false)
    92	  assert.strictEqual(b.canStartPreview(), true)
    93	  assert.strictEqual(Protocol.canStartPreview(), true)
    94	  assert.strictEqual(a.previewRequest("/x.png").id, 1)
    95	  assert.strictEqual(b.previewRequest("/y.png").id, 1)
    96	})
    97	
    98	test("protocol: preview backpressure slots", () => {
    99	  assert.strictEqual(Protocol.canStartPreview(), true)
   100	  assert.strictEqual(Protocol.canStartPrefetch(), true)
   101	  Protocol.markPreview(4)
   102	  Protocol.markPrefetch(5)
   103	  assert.strictEqual(Protocol.canStartPreview(), false)
   104	  assert.strictEqual(Protocol.canStartPrefetch(), false)
   105	  const msg = Protocol.parseLine('{"id":4,"kind":"preview","preview":{"kind":"image"}}')
   106	  assert.strictEqual(Protocol.acceptPreview(msg), true)
   107	  assert.strictEqual(Protocol.previewSlot(), 0)
   108	})
   109	
   110	test("protocol: latest preview replaces queued work", () => {
   111	  const a = Protocol.previewRequest("/a.pdf")
   112	  const first = Protocol.queueOrStartPreview(a)
   113	  assert.ok(first)
   114	  assert.strictEqual(Protocol.canStartPreview(), false)
   115	  const b = Protocol.previewRequest("/b.pdf")
   116	  const c = Protocol.previewRequest("/c.pdf")
   117	  assert.strictEqual(Protocol.queueOrStartPreview(b), null)
   118	  assert.strictEqual(Protocol.queueOrStartPreview(c), null)
   119	  assert.strictEqual(Protocol.pendingPreviewId(), c.id)
   120	  Protocol.acceptPreview({ id: a.id, kind: "preview", preview: { kind: "pdf" } })
   121	  const next = Protocol.takeReadyPreview()
   122	  assert.ok(next)
   123	  assert.strictEqual(next.path, "/c.pdf")
   124	  assert.strictEqual(Protocol.pendingPreviewId(), 0)
   125	})
   126	
   127	test("protocol: prefetch is a separate slot", () => {
   128	  const p = Protocol.previewRequest("/sel.rs")
   129	  assert.ok(Protocol.queueOrStartPreview(p))
   130	  const f = Protocol.prefetchRequest("/top.rs")
   131	  assert.ok(Protocol.queueOrStartPrefetch(f))
   132	  assert.strictEqual(Protocol.canStartPreview(), false)
   133	  assert.strictEqual(Protocol.canStartPrefetch(), false)
   134	  const f2 = Protocol.prefetchRequest("/other.rs")
   135	  assert.strictEqual(Protocol.queueOrStartPrefetch(f2), null)
   136	  assert.strictEqual(Protocol.slotClass(f.id), "prefetch")
   137	  assert.strictEqual(Protocol.acceptPreview({ id: f.id, kind: "preview", preview: { kind: "code" } }), false)
   138	  const next = Protocol.takeReadyPrefetch()
   139	  assert.ok(next)
   140	  assert.strictEqual(next.path, "/other.rs")
   141	  assert.strictEqual(Protocol.slotClass(p.id), "preview")
   142	})
   143	
   144	test("protocol: abandonInFlight clears both slots", () => {
   145	  const p = Protocol.previewRequest("/sel.rs")
   146	  const f = Protocol.prefetchRequest("/top.rs")
   147	  assert.ok(Protocol.queueOrStartPreview(p))
   148	  assert.ok(Protocol.queueOrStartPrefetch(f))
   149	  const extra = Protocol.previewRequest("/queued.rs")
   150	  assert.strictEqual(Protocol.queueOrStartPreview(extra), null)
   151	  const snap = Protocol.abandonInFlight()
   152	  assert.strictEqual(Protocol.canStartPreview(), true)
   153	  assert.strictEqual(Protocol.canStartPrefetch(), true)
