    39	pub fn skip_dir_name(name: &str, extra: &[String]) -> bool {
    40	    if SKIP_DIR_NAMES.iter().any(|n| *n == name) {
    41	        return true;
    42	    }
    43	    extra.iter().any(|e| e == name)
    44	}
    45	
    46	pub fn skip_hidden_dir(name: &str) -> bool {
    47	    name.starts_with('.') && name != "." && name != ".."
    48	}
    49	
    50	pub fn path_is_secret(path: &Path) -> bool {
    51	    let s = path.to_string_lossy();
    52	    if SKIP_PATH_PARTS.iter().any(|p| s.contains(p)) {
    53	        return true;
    54	    }
    55	    if let Some(name) = path.file_name().and_then(|n| n.to_str()) {
    56	        if name == ".env" || name.starts_with(".env.") || name.ends_with(".env") {
    57	            return true;
    58	        }
    59	        if name == "id_rsa" || name == "id_ed25519" || name.starts_with("id_rsa.") {
    60	            return true;
    61	        }
    62	    }
    63	    false
    64	}
    65	
    66	pub fn should_skip_dir(path: &Path, extra: &[String], root: &Path) -> bool {
    67	    if path == root {
    68	        return false;
    69	    }
    70	    if path_is_secret(path) {
    71	        return true;
    72	    }
    73	    if let Some(name) = path.file_name().and_then(|n| n.to_str()) {
    74	        if skip_dir_name(name, extra) {
    75	            return true;
    76	        }
    77	        if skip_hidden_dir(name) {
    78	            return true;
    79	        }
    80	    }
    81	    false
    82	}
    83	
    84	pub fn should_skip_file(path: &Path) -> bool {
    85	    path_is_secret(path)
    86	}
    87	
    88	pub fn under_root(path: &Path, roots: &[std::path::PathBuf]) -> bool {
    89	    roots.iter().any(|r| path.starts_with(r))
    90	}
    91	
    92	/// Same ancestor-aware policy as the indexed walk: drop secrets, off-root
    93	/// hits, and any path whose ancestor (except an explicit root) is hidden or heavy.
    94	pub fn should_skip_located(path: &Path, extra: &[String], roots: &[std::path::PathBuf]) -> bool {
    95	    if !normalize_components(path) {
    96	        return true;
    97	    }
    98	    if path_is_secret(path) {
    99	        return true;
   100	    }
   101	    if !roots.is_empty() && !under_root(path, roots) {
   102	        return true;
   103	    }
   104	    let mut ancestor = path.parent();
   105	    while let Some(dir) = ancestor {
   106	        if roots.iter().any(|r| dir == r.as_path()) {
   107	            break;
   108	        }
   109	        if dir.as_os_str().is_empty() || dir == Path::new("/") {
   110	            break;
   111	        }
   112	        if should_skip_dir(dir, extra, Path::new("/")) {
   113	            return true;
   114	        }
   115	        let next = dir.parent();
   116	        if next == Some(dir) {
   117	            break;
   118	        }
   119	        ancestor = next;
   120	    }
   121	    false
   122	}
   123	
   124	pub fn normalize_components(path: &Path) -> bool {
   125	    !path.components().any(|c| matches!(c, Component::ParentDir))
   126	}
