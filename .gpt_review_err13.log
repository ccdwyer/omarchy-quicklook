### tests/killable.test.sh
     1	#!/bin/sh
     2	# Behavioral: TERM-ignoring descendants in the process group must be reaped.
     3	set -eu
     4	ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
     5	WORKDIR=$(mktemp -d)
     6	trap 'rm -rf "$WORKDIR"' EXIT
     7	
     8	ignore="$WORKDIR/ignore-term"
     9	cat > "$ignore" << 'EOF'
    10	#!/bin/sh
    11	trap '' TERM
    12	sleep 30
    13	EOF
    14	chmod +x "$ignore"
    15	
    16	parent="$WORKDIR/parent"
    17	cat > "$parent" << 'EOF'
    18	#!/bin/sh
    19	# TERM-responsive leader that leaves a TERM-ignoring descendant.
    20	"$1" &
    21	echo $! > "$2"
    22	wait
    23	EOF
    24	chmod +x "$parent"
    25	
    26	# Early-leader-exit leader: spawns a TERM-ignoring descendant that inherits
    27	# stdout, then EXITS IMMEDIATELY. This is the regression case — the leader
    28	# returns cleanly while the descendant keeps the pipes open, which used to hang
    29	# the drain join on the normal-exit path. The post-exit unconditional group KILL
    30	# must reap the descendant and the call must return promptly.
    31	parent_early="$WORKDIR/parent-early"
    32	cat > "$parent_early" << 'EOF'
    33	#!/bin/sh
    34	"$1" &
    35	echo $! > "$2"
    36	# no wait: leader exits now, descendant lingers holding stdout
    37	EOF
    38	chmod +x "$parent_early"
    39	
    40	alive() {
    41	  kill -0 "$1" 2>/dev/null
    42	}
    43	
    44	# --- Shell watchdog: descendant PID must disappear, on BOTH backends ---
    45	# Run once with whatever backend the host has (GNU timeout if present) and once
    46	# with the portable setsid path forced, so the portable group-kill is covered
    47	# even on hosts that ship GNU coreutils.
    48	run_shell_case() {
    49	  label="$1"
    50	  forceportable="$2"
    51	  descfile="$WORKDIR/desc-$label.pid"
    52	  : > "$descfile"
    53	  set +e
    54	  env QUICKLOOK_FORCE_SH=1 QUICKLOOK_FORCE_PORTABLE="$forceportable" \
    55	    sh "$ROOT/compat/quicklookd.sh" --watchdog-selftest 2 "$parent" "$ignore" "$descfile"
    56	  st=$?
    57	  set -e
    58	  sleep 1
    59	  if [ ! -s "$descfile" ]; then
    60	    echo "FAIL shell parent ($label) did not record descendant pid"
    61	    exit 1
    62	  fi
    63	  dpid=$(tr -d ' \n' < "$descfile")
    64	  if alive "$dpid"; then
    65	    echo "FAIL shell watchdog ($label) left TERM-ignoring descendant pid $dpid alive"
    66	    kill -KILL "$dpid" 2>/dev/null || true
    67	    exit 1
    68	  fi
    69	  echo "ok  shell watchdog ($label) KILL reaps TERM-ignoring descendant (status $st, pid $dpid)"
    70	}
    71	
    72	run_shell_case "host-default" ""
    73	run_shell_case "forced-portable" "1"
    74	
    75	# --- Shell watchdog: EARLY leader exit must still reap the descendant ---
    76	# The leader exits at once; without the post-exit unconditional group KILL the
    77	# TERM-ignoring descendant would survive (and, in the capturing paths, hold the
    78	# pipe open). run_watchdog must return promptly AND leave no descendant alive.
    79	run_shell_early_case() {
    80	  label="$1"
    81	  forceportable="$2"
    82	  descfile="$WORKDIR/desc-early-$label.pid"
    83	  : > "$descfile"
    84	  set +e
    85	  start=$(date +%s)
    86	  env QUICKLOOK_FORCE_SH=1 QUICKLOOK_FORCE_PORTABLE="$forceportable" \
    87	    sh "$ROOT/compat/quicklookd.sh" --watchdog-selftest 5 "$parent_early" "$ignore" "$descfile"
    88	  st=$?
    89	  end=$(date +%s)
    90	  set -e
    91	  if [ "$((end - start))" -ge 4 ]; then
    92	    echo "FAIL shell early-exit ($label) did not return promptly ($((end - start))s)"
    93	    exit 1
    94	  fi
    95	  sleep 1
    96	  if [ ! -s "$descfile" ]; then
    97	    echo "FAIL shell early-exit parent ($label) did not record descendant pid"
    98	    exit 1
    99	  fi
   100	  dpid=$(tr -d ' \n' < "$descfile")
   101	  if alive "$dpid"; then
   102	    echo "FAIL shell early-exit ($label) left TERM-ignoring descendant pid $dpid alive"
   103	    kill -KILL "$dpid" 2>/dev/null || true
   104	    exit 1
   105	  fi
   106	  echo "ok  shell early-leader-exit ($label) reaps descendant + returns promptly (status $st, pid $dpid)"
   107	}
   108	
   109	run_shell_early_case "host-default" ""
   110	run_shell_early_case "forced-portable" "1"
   111	
   112	# --- GNU-timeout branch: early leader exit must also reap the descendant ---
   113	# The GNU path now wraps `timeout` in its own process group (setsid) and reaps
   114	# the whole group after the leader exits, identical to the portable path. It is
   115	# the branch a Linux judge machine actually takes. With FORCE_PORTABLE unset the
   116	# script prefers GNU timeout when present, so this deterministically exercises
   117	# gnu_group_watchdog wherever a GNU-style timeout exists; on hosts without one
   118	# (e.g. stock macOS) it is skipped and covered in Linux CI.
   119	if { command -v timeout >/dev/null 2>&1 && timeout --kill-after=1s 1s true >/dev/null 2>&1; } \
   120	   || { command -v gtimeout >/dev/null 2>&1 && gtimeout --kill-after=1s 1s true >/dev/null 2>&1; }; then
   121	  run_shell_early_case "gnu-timeout" ""
   122	else
   123	  echo "ok  shell GNU-timeout early-exit branch: skipped (no GNU timeout on host; exercised in Linux CI)"
   124	fi
   125	
   126	# --- Python process-group: same descendant case ---
   127	python3 - << PY
   128	import os, stat, sys, time, subprocess, importlib.util
   129	from pathlib import Path
   130	
   131	root = Path("$ROOT")
   132	work = Path("$WORKDIR")
   133	spec = importlib.util.spec_from_file_location("ql", root / "compat" / "quicklookd.py")
   134	ql = importlib.util.module_from_spec(spec)
   135	spec.loader.exec_module(ql)
   136	
   137	ignore = work / "py-ignore-term"
   138	ignore.write_text("#!/bin/sh\ntrap '' TERM\nsleep 30\n")
   139	ignore.chmod(ignore.stat().st_mode | stat.S_IXUSR)
   140	parent = work / "py-parent"
   141	parent.write_text("#!/bin/sh\n\"\$1\" &\necho \$! > \"\$2\"\nwait\n")
   142	parent.chmod(parent.stat().st_mode | stat.S_IXUSR)
   143	pidfile = work / "py-desc.pid"
   144	pidfile.write_text("")
   145	
   146	def run_case(limits, tag):
   147	    pidfile.write_text("")
   148	    start = time.monotonic()
   149	    try:
   150	        ql.run_killable(
   151	            [str(parent), str(ignore), str(pidfile)],
   152	            timeout_s=2,
   153	            capture_output=True,
   154	            limits=limits,
   155	        )
   156	        sys.stderr.write("FAIL python run_killable (%s) returned without timeout\n" % tag)
   157	        sys.exit(1)
   158	    except subprocess.TimeoutExpired:
   159	        pass
   160	    elapsed = time.monotonic() - start
   161	    if elapsed >= 8:
   162	        sys.stderr.write("FAIL python run_killable (%s) too slow: %.1fs\n" % (tag, elapsed))
   163	        sys.exit(1)
   164	    time.sleep(0.3)
   165	    raw = pidfile.read_text().strip()
   166	    if not raw.isdigit():
   167	        sys.stderr.write("FAIL python parent (%s) did not record descendant pid: %r\n" % (tag, raw))
   168	        sys.exit(1)
   169	    dpid = int(raw)
   170	    try:
   171	        os.kill(dpid, 0)
   172	    except OSError:
   173	        print("ok  python process-group KILL reaps TERM-ignoring descendant [%s] (%.1fs, pid %d)" % (tag, elapsed, dpid))
   174	    else:
   175	        try:
   176	            os.kill(dpid, 9)
   177	        except OSError:
   178	            pass
   179	        sys.stderr.write("FAIL python (%s) left TERM-ignoring descendant pid %d alive\n" % (tag, dpid))
   180	        sys.exit(1)
   181	
   182	# Exercise BOTH the production limits=True branch (setsid + rlimits, the path a
   183	# judge actually runs) and the limits=False branch.
   184	run_case(True, "limits=production")
   185	run_case(False, "limits=off")
   186	
   187	# --- Early leader exit: leader returns cleanly, descendant lingers ---
   188	# The regression: run_killable's normal-exit path used to skip the group kill and
   189	# then join the drains with a 2s timeout, leaking the TERM-ignoring descendant
   190	# and its reader thread. The fix group-kills whenever the group is non-empty
   191	# before joining, so this must return a CompletedProcess (NOT a timeout), return
   192	# promptly, and leave no descendant alive.
   193	parent_early = work / "py-parent-early"
   194	parent_early.write_text("#!/bin/sh\n\"\$1\" &\necho \$! > \"\$2\"\n")  # no wait: exits now
   195	parent_early.chmod(parent_early.stat().st_mode | stat.S_IXUSR)
   196	
   197	def run_early_case(limits, tag):
   198	    pidfile.write_text("")
   199	    start = time.monotonic()
   200	    try:
   201	        cp = ql.run_killable(
   202	            [str(parent_early), str(ignore), str(pidfile)],
   203	            timeout_s=8,
   204	            capture_output=True,
   205	            limits=limits,
   206	        )
   207	    except subprocess.TimeoutExpired:
   208	        sys.stderr.write("FAIL python early-exit (%s) hung into a timeout\n" % tag)
   209	        sys.exit(1)
   210	    elapsed = time.monotonic() - start
   211	    if elapsed >= 4:
   212	        sys.stderr.write("FAIL python early-exit (%s) did not return promptly: %.1fs\n" % (tag, elapsed))
   213	        sys.exit(1)
   214	    time.sleep(0.3)
   215	    raw = pidfile.read_text().strip()
   216	    if not raw.isdigit():
   217	        sys.stderr.write("FAIL python early-exit parent (%s) did not record descendant pid: %r\n" % (tag, raw))
   218	        sys.exit(1)
   219	    dpid = int(raw)
   220	    try:
   221	        os.kill(dpid, 0)
   222	    except OSError:
   223	        print("ok  python early-leader-exit reaps descendant, no hang [%s] (%.1fs, pid %d)" % (tag, elapsed, dpid))
   224	    else:
   225	        try:
   226	            os.kill(dpid, 9)
   227	        except OSError:
   228	            pass
   229	        sys.stderr.write("FAIL python early-exit (%s) left descendant pid %d alive\n" % (tag, dpid))
   230	        sys.exit(1)
   231	
   232	run_early_case(True, "limits=production")
   233	run_early_case(False, "limits=off")
   234	
   235	# --- Flooding output must be bounded (no OOM / no deadlock) ---
   236	flood = work / "py-flood"
   237	flood.write_text("#!/bin/sh\nexec yes ABCDEFGHIJKLMNOP\n")
   238	flood.chmod(flood.stat().st_mode | stat.S_IXUSR)
   239	start = time.monotonic()
   240	try:
   241	    ql.run_killable([str(flood)], timeout_s=1, capture_output=True, limits=True)
   242	    sys.stderr.write("FAIL flooding child did not time out\n")
   243	    sys.exit(1)
   244	except subprocess.TimeoutExpired as exc:
   245	    out = exc.output or b""
   246	    if isinstance(out, str):
   247	        out = out.encode()
   248	    if len(out) > ql.OUTPUT_CAP:
   249	        sys.stderr.write("FAIL captured output %d exceeds cap %d\n" % (len(out), ql.OUTPUT_CAP))
   250	        sys.exit(1)
   251	elapsed = time.monotonic() - start
   252	if elapsed >= 6:
   253	    sys.stderr.write("FAIL flooding child not killed promptly: %.1fs\n" % elapsed)
   254	    sys.exit(1)
   255	print("ok  python flooding output bounded to <= %d bytes (%.1fs)" % (ql.OUTPUT_CAP, elapsed))
   256	PY
