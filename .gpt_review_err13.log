   699	def preview_image(path: Path) -> dict:
   700	    ext = path.suffix.lower().lstrip(".")
   701	    dims = svg_dims(path) if ext == "svg" else image_dims(path)
   702	    if not dims or dims[0] <= 0 or dims[1] <= 0:
   703	        return hex_preview(path, "unverifiable image", "can't render this — hex view")
   704	    w, h = dims
   705	    if w * h > MEGAPIXELS:
   706	        ds = downsample_image(path, w, h)
   707	        if ds:
   708	            return ds
   709	        return hex_preview(
   710	            path,
   711	            f"image {w}x{h}",
   712	            "image exceeds 20 MP — hex view",
   713	            width=w,
   714	            height=h,
   715	        )
   716	    return {
   717	        "kind": "image",
   718	        "path": str(path),
   719	        "animated": ext == "gif",
   720	        "width": w,
   721	        "height": h,
   722	    }
