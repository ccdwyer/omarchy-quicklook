    23	
    24	impl IndexedFile {
    25	    pub fn from_path(path: &Path) -> Option<Self> {
    26	        let meta = fs::symlink_metadata(path).ok()?;
    27	        if meta.file_type().is_symlink() {
    28	            return None;
    29	        }
    30	        let is_dir = meta.is_dir();
    31	        let name = path
    32	            .file_name()
    33	            .and_then(|s| s.to_str())
    34	            .unwrap_or("")
    35	            .to_string();
    36	        if name.is_empty() {
    37	            return None;
    38	        }
    39	        Some(Self {
    40	            path: path.to_string_lossy().to_string(),
    41	            name,
    42	            mtime: mtime_ms(&meta),
    43	            size: if is_dir { 0 } else { meta.len() },
    44	            kind: kind_of(path, is_dir).as_str().into(),
    45	            is_dir,
    46	        })
    47	    }
    48	
    49	    pub fn to_hit(&self, score: i64) -> Hit {
    50	        Hit {
    51	            path: self.path.clone(),
    52	            name: self.name.clone(),
    53	            kind: self.kind.clone(),
    54	            score,
    55	            mtime: self.mtime,
    56	            size: self.size,
    57	        }
    58	    }
    59	}
    60	
    61	pub fn mtime_ms(meta: &fs::Metadata) -> u64 {
    62	    meta.modified()
    63	        .ok()
    64	        .and_then(|t| t.duration_since(UNIX_EPOCH).ok())
    65	        .map(|d| d.as_millis() as u64)
    66	        .unwrap_or(0)
    67	}
    68	
    69	pub fn now_ms() -> u64 {
    70	    SystemTime::now()
    71	        .duration_since(UNIX_EPOCH)
    72	        .map(|d| d.as_millis() as u64)
    73	        .unwrap_or(0)
    74	}
    75	
    76	pub fn rank(files: &[IndexedFile], query: &str, frecency: &Frecency, limit: usize) -> Vec<Hit> {
    77	    if query.trim().is_empty() {
    78	        return files.iter().take(limit).map(|f| f.to_hit(1)).collect();
    79	    }
    80	    let mut matcher = Matcher::new(Config::DEFAULT.match_paths());
    81	    let pattern = Pattern::parse(query, CaseMatching::Smart, Normalization::Smart);
    82	    let mut path_buf = Vec::new();
    83	    let mut name_buf = Vec::new();
    84	    let mut scored: Vec<(i64, &IndexedFile)> = Vec::new();
    85	    for f in files {
    86	        let mut score = 0i64;
    87	        if let Some(s) = pattern.score(Utf32Str::new(&f.path, &mut path_buf), &mut matcher) {
    88	            score = s as i64;
    89	        }
    90	        if let Some(s) = pattern.score(Utf32Str::new(&f.name, &mut name_buf), &mut matcher) {
    91	            score = score.max(s as i64 + 40);
    92	        }
    93	        if score <= 0 {
    94	            continue;
    95	        }
    96	        score += mtime_boost(f.mtime);
    97	        score += frecency.boost(&f.path);
    98	        scored.push((score, f));
    99	    }
   100	    scored.sort_by(|a, b| b.0.cmp(&a.0).then_with(|| a.1.path.cmp(&b.1.path)));
   101	    scored
   102	        .into_iter()
   103	        .take(limit)
   104	        .map(|(s, f)| f.to_hit(s))
   105	        .collect()
   106	}
