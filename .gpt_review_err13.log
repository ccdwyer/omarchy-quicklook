     1	use syntect::highlighting::{Color, FontStyle, ScopeSelectors, StyleModifier, Theme, ThemeItem, ThemeSettings};
     2	
     3	#[derive(Clone, Debug)]
     4	pub struct Palette {
     5	    pub bg: Color,
     6	    pub fg: Color,
     7	    pub accent: Color,
     8	    pub surface: Color,
     9	}
    10	
    11	impl Default for Palette {
    12	    fn default() -> Self {
    13	        Self {
    14	            bg: rgb(26, 27, 38),
    15	            fg: rgb(192, 202, 245),
    16	            accent: rgb(122, 162, 247),
    17	            surface: rgb(36, 40, 59),
    18	        }
    19	    }
    20	}
    21	
    22	pub fn rgb(r: u8, g: u8, b: u8) -> Color {
    23	    Color { r, g, b, a: 255 }
    24	}
    25	
    26	pub fn parse_hex(s: &str) -> Option<Color> {
    27	    let t = s.trim();
    28	    let h = t.strip_prefix('#').unwrap_or(t);
    29	    let h = if h.len() == 8 { &h[2..] } else { h };
    30	    if h.len() == 3 {
    31	        let r = u8::from_str_radix(&h[0..1].repeat(2), 16).ok()?;
    32	        let g = u8::from_str_radix(&h[1..2].repeat(2), 16).ok()?;
    33	        let b = u8::from_str_radix(&h[2..3].repeat(2), 16).ok()?;
    34	        return Some(rgb(r, g, b));
    35	    }
    36	    if h.len() == 6 {
    37	        let r = u8::from_str_radix(&h[0..2], 16).ok()?;
    38	        let g = u8::from_str_radix(&h[2..4], 16).ok()?;
    39	        let b = u8::from_str_radix(&h[4..6], 16).ok()?;
    40	        return Some(rgb(r, g, b));
    41	    }
    42	    None
    43	}
    44	
    45	fn mix(a: Color, b: Color, t: f32) -> Color {
    46	    let t = t.clamp(0.0, 1.0);
    47	    rgb(
    48	        (a.r as f32 + (b.r as f32 - a.r as f32) * t) as u8,
    49	        (a.g as f32 + (b.g as f32 - a.g as f32) * t) as u8,
    50	        (a.b as f32 + (b.b as f32 - a.b as f32) * t) as u8,
    51	    )
    52	}
    53	
    54	fn item(sel: &str, fg: Color, bold: bool) -> ThemeItem {
    55	    ThemeItem {
    56	        scope: sel.parse::<ScopeSelectors>().unwrap_or_else(|_| {
    57	            "text"
    58	                .parse::<ScopeSelectors>()
    59	                .unwrap_or_else(|_| ScopeSelectors { selectors: vec![] })
    60	        }),
    61	        style: StyleModifier {
    62	            foreground: Some(fg),
    63	            background: None,
    64	            font_style: if bold { Some(FontStyle::BOLD) } else { None },
    65	        },
    66	    }
    67	}
    68	
    69	pub fn syntect_theme(p: &Palette) -> Theme {
    70	    let comment = mix(p.fg, p.bg, 0.55);
    71	    let string = mix(p.accent, rgb(232, 176, 96), 0.45);
    72	    let number = mix(p.accent, rgb(140, 210, 180), 0.35);
    73	    let func = mix(p.fg, p.accent, 0.28);
    74	    let ty = mix(p.accent, rgb(180, 140, 230), 0.4);
    75	    Theme {
    76	        name: Some("omarchy-quicklook".into()),
    77	        author: Some("quicklook".into()),
    78	        settings: ThemeSettings {
    79	            foreground: Some(p.fg),
    80	            background: Some(p.bg),
    81	            caret: Some(p.accent),
    82	            line_highlight: Some(p.surface),
    83	            selection: Some(mix(p.accent, p.bg, 0.65)),
    84	            ..ThemeSettings::default()
    85	        },
    86	        scopes: vec![
    87	            item("comment, comment.line, comment.block", comment, false),
    88	            item("keyword, keyword.control, keyword.operator.word, storage, storage.type, storage.modifier", p.accent, true),
    89	            item("string, string.quoted, string.quoted.double, string.quoted.single", string, false),
    90	            item("constant.numeric, constant.language, constant.character", number, false),
    91	            item("entity.name.function, support.function, variable.function", func, false),
    92	            item("entity.name.type, entity.name.class, support.type, support.class", ty, false),
    93	            item("variable, variable.other, variable.parameter", p.fg, false),
    94	            item("punctuation, meta.brace", mix(p.fg, p.bg, 0.25), false),
    95	        ],
    96	    }
    97	}
    98	
    99	pub fn apply_in(p: &mut Palette, incoming: &crate::protocol::PaletteIn) {
   100	    if let Some(s) = incoming.bg.as_deref().and_then(parse_hex) {
   101	        p.bg = s;
   102	    }
   103	    if let Some(s) = incoming.fg.as_deref().and_then(parse_hex) {
   104	        p.fg = s;
   105	    }
   106	    if let Some(s) = incoming.accent.as_deref().and_then(parse_hex) {
   107	        p.accent = s;
   108	    }
   109	    if let Some(s) = incoming.surface.as_deref().and_then(parse_hex) {
   110	        p.surface = s;
   111	    } else {
   112	        p.surface = mix(p.bg, p.fg, 0.08);
   113	    }
   114	}
   115	
   116	pub fn hex_of(c: Color) -> String {
   117	    format!("#{:02x}{:02x}{:02x}", c.r, c.g, c.b)
   118	}
