   301	    let mut reader = reader.with_guessed_format().map_err(|e| e.to_string())?;
   302	    let mut limits = image::Limits::default();
   303	    limits.max_image_width = Some(20_000);
   304	    limits.max_image_height = Some(20_000);
   305	    limits.max_alloc = Some(96 * 1024 * 1024);
   306	    reader.limits(limits);
   307	    reader.decode().map_err(|e| e.to_string())
   308	}
