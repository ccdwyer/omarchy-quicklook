   527	pub fn preview_pdf(path: &Path, page: u32, cache: &PreviewCache, poppler: bool) -> Preview {
   528	    let page_count = pdf_page_count(path).max(1);
   529	    let page = page.clamp(1, page_count);
   530	    if !poppler {
   531	        return Preview {
   532	            kind: "pdf".into(),
   533	            need_poppler: Some(true),
   534	            page: Some(page),
   535	            page_count: Some(page_count),
   536	            magic: Some("PDF document".into()),
   537	            label: Some("install poppler for PDF previews".into()),
   538	            path: Some(path.to_string_lossy().into()),
   539	            ..Preview::default()
   540	        };
   541	    }
   542	    let mtime = fs::metadata(path)
   543	        .ok()
   544	        .and_then(|m| m.modified().ok())
   545	        .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
   546	        .map(|d| d.as_millis().to_string())
   547	        .unwrap_or_default();
   548	    let dest = cache.path_for(
   549	        &[&path.to_string_lossy(), &mtime, &page.to_string(), "pdf"],
   550	        "png",
   551	    );
   552	    if usable_cache_file(&dest) {
   553	        return Preview {
   554	            kind: "pdf".into(),
   555	            path: Some(dest.to_string_lossy().into()),
   556	            page: Some(page),
   557	            page_count: Some(page_count),
   558	            need_poppler: Some(false),
   559	            ..Preview::default()
   560	        };
   561	    }
   562	    if let Some(parent) = dest.parent() {
   563	        let _ = fs::create_dir_all(parent);
   564	    }
   565	    let prefix = dest.with_extension("");
   566	    let bin = which("pdftoppm").unwrap_or_else(|| Path::new("pdftoppm").to_path_buf());
   567	    let mut cmd = Command::new(bin);
   568	    cmd.args([
   569	        "-f",
   570	        &page.to_string(),
   571	        "-l",
   572	        &page.to_string(),
   573	        "-png",
   574	        "-r",
   575	        "140",
   576	        "-singlefile",
   577	        &path.to_string_lossy(),
   578	        &prefix.to_string_lossy(),
   579	    ]);
   580	    match run_limited(cmd, Duration::from_secs(8), 512 * 1024 * 1024, 8) {
   581	        Ok(out) if out.status.success() && usable_cache_file(&dest) => {
   582	            cache.gc();
   583	            Preview {
   584	                kind: "pdf".into(),
   585	                path: Some(dest.to_string_lossy().into()),
   586	                page: Some(page),
   587	                page_count: Some(page_count),
   588	                need_poppler: Some(false),
   589	                ..Preview::default()
   590	            }
   591	        }
   592	        Ok(_) | Err(_) => {
   593	            let head = read_capped(path, HEX_BYTES).unwrap_or_default();
   594	            let hex = hex_dump(&head);
   595	            Preview {
   596	                kind: "pdf".into(),
   597	                need_poppler: Some(false),
   598	                render_error: Some(true),
   599	                page: Some(page),
   600	                page_count: Some(page_count),
   601	                label: Some("couldn't render this page".into()),
   602	                magic: Some("PDF document".into()),
   603	                hex: Some(hex),
   604	                path: None,
   605	                ..Preview::default()
   606	            }
   607	        }
   608	    }
   609	}
