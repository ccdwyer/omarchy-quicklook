   108	pub fn rank_owned(files: &[IndexedFile], query: &str, limit: usize) -> Vec<Hit> {
   109	    if query.trim().is_empty() {
   110	        return files.iter().take(limit).map(|f| f.to_hit(1)).collect();
   111	    }
   112	    let mut matcher = Matcher::new(Config::DEFAULT.match_paths());
   113	    let pattern = Pattern::parse(query, CaseMatching::Smart, Normalization::Smart);
   114	    let mut path_buf = Vec::new();
   115	    let mut name_buf = Vec::new();
   116	    let mut scored: Vec<(i64, &IndexedFile)> = Vec::new();
   117	    for f in files {
   118	        let mut score = 0i64;
   119	        if let Some(s) = pattern.score(Utf32Str::new(&f.path, &mut path_buf), &mut matcher) {
   120	            score = s as i64;
   121	        }
   122	        if let Some(s) = pattern.score(Utf32Str::new(&f.name, &mut name_buf), &mut matcher) {
   123	            score = score.max(s as i64 + 40);
   124	        }
   125	        if score <= 0 {
   126	            continue;
   127	        }
   128	        score += mtime_boost(f.mtime);
   129	        scored.push((score, f));
   130	    }
   131	    scored.sort_by(|a, b| b.0.cmp(&a.0).then_with(|| a.1.path.cmp(&b.1.path)));
   132	    scored
   133	        .into_iter()
   134	        .take(limit)
   135	        .map(|(s, f)| f.to_hit(s))
   136	        .collect()
   137	}
