    70	pub fn preview_image(path: &Path, cache: &PreviewCache) -> Preview {
    71	    let ext = ext_of(path);
    72	    let dims = if ext == "svg" {
    73	        svg_dims(path)
    74	    } else {
    75	        header_dims(path)
    76	    };
    77	    let Some((w, h)) = dims else {
    78	        return image_unsafe(path, "unverifiable image");
    79	    };
    80	    if w == 0 || h == 0 {
    81	        return image_unsafe(path, "unverifiable image");
    82	    }
    83	    let pixels = w as u64 * h as u64;
    84	    if pixels > MEGAPIXELS {
    85	        if let Some(p) = downsample_cached(path, cache, w, h) {
    86	            return p;
    87	        }
    88	        return oversized_image(path, w, h);
    89	    }
    90	    if ext == "svg" || ext == "gif" {
    91	        return Preview {
    92	            kind: "image".into(),
    93	            path: Some(path.to_string_lossy().into()),
    94	            width: Some(w),
    95	            height: Some(h),
    96	            animated: Some(ext == "gif"),
    97	            ..Preview::default()
    98	        };
    99	    }
   100	    match decode_bounded(path) {
   101	        Ok(_) => Preview {
   102	            kind: "image".into(),
   103	            path: Some(path.to_string_lossy().into()),
   104	            width: Some(w),
   105	            height: Some(h),
   106	            animated: Some(false),
