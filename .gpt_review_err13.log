   230	def search(q: str) -> tuple[list[dict], str]:
   231	    if not q.strip():
   232	        return demo(), "demo"
   233	    hits = []
   234	    for item in demo():
   235	        s = max(fuzzy(item["name"], q), fuzzy(item["path"], q))
   236	        if s > 0:
   237	            item = dict(item)
   238	            item["score"] = s + 200
   239	            hits.append(item)
   240	    backend = "compat"
   241	    found = find_names(q, 40)
   242	    for item in found:
   243	        if any(h["path"] == item["path"] for h in hits):
   244	            continue
   245	        hits.append(item)
   246	    hits.sort(key=lambda x: (-x["score"], x["name"]))
   247	    return hits[:40], backend
