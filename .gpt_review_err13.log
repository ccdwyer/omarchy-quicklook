### bindings.lua
     1	-- QuickLook keybind snippet for Omarchy / Hyprland.
     2	-- Default: SUPER + period (.). Alternate: SUPER+SHIFT+P.
     3	-- First-run collision check: parse hyprctl binds -j objects and require
     4	-- both key=period and SUPER (modmask bit 64) without SHIFT/CTRL/ALT.
     5	--
     6	-- This file is a snippet. Paste the bind line into hyprland.conf (or your
     7	-- Omarchy bindings file). QuickLook does not write compositor config itself.
     8	--
     9	-- Hyprland:
    10	--   bind = SUPER, period, exec, omarchy-shell shell toggle io.github.chris.quicklook '{}'
    11	--   bind = SUPER SHIFT, P, exec, omarchy-shell shell toggle io.github.chris.quicklook '{}'
    12	-- File manager custom action:
    13	--   omarchy-shell shell summon io.github.chris.quicklook '{"path":"%f"}'
    14	
    15	local SUPER, SHIFT, CTRL, ALT = 64, 1, 4, 8
    16	
    17	local function binds_json()
    18	  local h = io.popen("hyprctl binds -j 2>/dev/null")
    19	  if not h then
    20	    return ""
    21	  end
    22	  local json = h:read("*a") or ""
    23	  h:close()
    24	  return json
    25	end
    26	
    27	local function has_bit(mask, bit)
    28	  return math.floor(mask / bit) % 2 == 1
    29	end
    30	
    31	local function key_is_period(key)
    32	  return key == "period" or key == "." or key == "Period"
    33	end
    34	
    35	local function super_period_bound(json)
    36	  if not json or json == "" then
    37	    return false
    38	  end
    39	  for obj in json:gmatch("%b{}") do
    40	    local key = obj:match('"key"%s*:%s*"([^"]*)"')
    41	    local mask = tonumber(obj:match('"modmask"%s*:%s*(%-?%d+)'))
    42	    if key and mask and key_is_period(key) and has_bit(mask, SUPER)
    43	        and not has_bit(mask, SHIFT) and not has_bit(mask, CTRL) and not has_bit(mask, ALT) then
    44	      return true
    45	    end
    46	  end
    47	  return false
    48	end
    49	
    50	if super_period_bound(binds_json()) then
    51	  io.stderr:write("quicklook: SUPER+. looks already bound; use SUPER+SHIFT+P instead\n")
    52	  io.stderr:write("  bind = SUPER SHIFT, P, exec, omarchy-shell shell toggle io.github.chris.quicklook '{}'\n")
    53	else
    54	  io.stderr:write("quicklook: suggested bind\n")
    55	  io.stderr:write("  bind = SUPER, period, exec, omarchy-shell shell toggle io.github.chris.quicklook '{}'\n")
    56	end
### build.sh
     1	#!/bin/sh
     2	# Build quicklookd. QML degrades to compat/quicklookd.sh when the binary is
     3	# missing, so a failed build is not fatal at runtime.
     4	
     5	set -eu
     6	
     7	ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
     8	SRC="$ROOT/src/quicklookd"
     9	OUT="$ROOT/bin"
    10	
    11	mkdir -p "$OUT"
    12	chmod +x "$ROOT/compat/quicklookd.sh" "$ROOT/compat/quicklookd.py" 2>/dev/null || true
    13	
    14	write_checksums() {
    15	  if command -v sha256sum >/dev/null 2>&1; then
    16	    (cd "$OUT" && sha256sum quicklookd > "$ROOT/CHECKSUMS.txt") || true
    17	  elif command -v shasum >/dev/null 2>&1; then
    18	    (cd "$OUT" && shasum -a 256 quicklookd > "$ROOT/CHECKSUMS.txt") || true
    19	  fi
    20	}
    21	
    22	if ! command -v cargo >/dev/null 2>&1; then
    23	  echo "build.sh: cargo not found; not installing a fake bin/quicklookd." >&2
    24	  echo "build.sh: Service will use compat/quicklookd.sh (degraded fallback)." >&2
    25	  exit 1
    26	fi
    27	
    28	if ! cargo build --release --manifest-path "$SRC/Cargo.toml"; then
    29	  echo "build.sh: cargo build FAILED; not installing the POSIX fallback as bin/quicklookd." >&2
    30	  echo "build.sh: the authentic helper did not compile. Service will use compat/quicklookd.sh." >&2
    31	  exit 1
    32	fi
    33	
    34	BIN="$SRC/target/release/quicklookd"
    35	if [ ! -x "$BIN" ]; then
    36	  echo "build.sh: release binary missing after cargo build" >&2
    37	  exit 1
    38	fi
    39	cp "$BIN" "$OUT/quicklookd"
    40	chmod +x "$OUT/quicklookd"
    41	write_checksums
    42	echo "build.sh: wrote $OUT/quicklookd"
    43	if [ -f "$ROOT/CHECKSUMS.txt" ]; then
    44	  echo "build.sh: checksums -> $ROOT/CHECKSUMS.txt"
    45	fi
### bin/quicklook
     1	#!/bin/sh
     2	# File-manager / terminal bridge: summon QuickLook on a path, or toggle the finder.
     3	set -eu
     4	id="io.github.chris.quicklook"
     5	if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
     6	  printf '%s\n' "usage: quicklook [path]" "  no args  toggle the finder overlay" "  path     summon a preview of that file"
     7	  exit 0
     8	fi
     9	if [ -n "${1:-}" ]; then
    10	  path=$1
    11	  case "$path" in
    12	    /*) ;;
    13	    *) path=$(pwd)/$path ;;
    14	  esac
    15	  esc=$(printf '%s' "$path" | od -An -t u1 -v | awk '
    16	    BEGIN { ORS="" }
    17	    {
    18	      for (i = 1; i <= NF; i++) {
    19	        n = $i + 0
    20	        if (n == 92) printf "\\\\"
    21	        else if (n == 34) printf "\\\""
    22	        else if (n == 10) printf "\\n"
    23	        else if (n == 13) printf "\\r"
    24	        else if (n == 9) printf "\\t"
    25	        else if (n < 32) printf "\\u%04x", n
    26	        else printf "%c", n
    27	      }
    28	    }
    29	  ')
    30	  exec omarchy-shell shell summon "$id" "{\"path\":\"$esc\"}"
    31	fi
    32	exec omarchy-shell shell toggle "$id" '{}'
### compat/quicklookd.sh
     1	#!/bin/sh
     2	# Dependency-free fallback when bin/quicklookd is missing.
     3	# Prefers Python 3 (compat/quicklookd.py). Without Python this POSIX
     4	# responder still honors inline config, does a pruned bounded find, and
     5	# actually opens/reveals files.
     6	set -eu
     7	
     8	ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
     9	export QUICKLOOK_PLUGIN_DIR="${QUICKLOOK_PLUGIN_DIR:-$ROOT}"
    10	OS_NAME=$(uname -s 2>/dev/null || echo unknown)
    11	
    12	if [ "${QUICKLOOK_FORCE_SH:-}" != "1" ] && command -v python3 >/dev/null 2>&1; then
    13	  exec python3 "$ROOT/compat/quicklookd.py" "$@"
    14	fi
    15	
    16	# One watchdog for every path-consuming command: new process group, TERM the
    17	# group, grace, then UNCONDITIONAL KILL of the group. GNU timeout already
    18	# uses a new process group + --kill-after. The portable path needs setsid
    19	# (or python os.setsid). If neither isolation method exists, skip.
    20	TIMEOUT_BIN=""
    21	TIMEOUT_STYLE=""
    22	HAVE_SETSID=0
    23	SETSID_PY=0
    24	
    25	init_watchdog() {
    26	  # Test hook: force the portable setsid watchdog even when GNU timeout exists,
    27	  # so the portable process-group path is exercised in CI on every host.
    28	  if [ "${QUICKLOOK_FORCE_PORTABLE:-}" = "1" ]; then
    29	    TIMEOUT_STYLE=""
    30	    if command -v setsid >/dev/null 2>&1; then
    31	      HAVE_SETSID=1
    32	    elif command -v python3 >/dev/null 2>&1; then
    33	      SETSID_PY=1
    34	    fi
    35	    return
    36	  fi
    37	  if command -v timeout >/dev/null 2>&1; then
    38	    if timeout --kill-after=1s 1s true >/dev/null 2>&1; then
    39	      TIMEOUT_BIN=timeout
    40	      TIMEOUT_STYLE=gnu-long
    41	    elif timeout -k 1 1 true >/dev/null 2>&1; then
    42	      TIMEOUT_BIN=timeout
    43	      TIMEOUT_STYLE=gnu-short
    44	    fi
    45	  fi
    46	  if [ -z "$TIMEOUT_STYLE" ] && command -v gtimeout >/dev/null 2>&1; then
    47	    if gtimeout --kill-after=1s 1s true >/dev/null 2>&1; then
    48	      TIMEOUT_BIN=gtimeout
    49	      TIMEOUT_STYLE=gnu-long
    50	    fi
    51	  fi
    52	  if command -v setsid >/dev/null 2>&1; then
    53	    HAVE_SETSID=1
    54	  elif command -v python3 >/dev/null 2>&1; then
    55	    SETSID_PY=1
    56	  fi
    57	}
    58	
    59	init_watchdog
    60	
    61	watchdog_ok() {
    62	  # A new process group (setsid, or python os.setsid) is REQUIRED even when GNU
    63	  # timeout exists: --kill-after only bounds timeout's direct child, so a
    64	  # descendant that outlives a normal (or timed-out) leader exit would leak and
    65	  # keep the capture pipes open. Without group isolation we cannot forge a group
    66	  # to reap, so the path-consuming command is disabled (caller falls back to
    67	  # metadata-only) rather than run unprotected.
    68	  [ "$HAVE_SETSID" = 1 ] || [ "$SETSID_PY" = 1 ]
    69	}
    70	
    71	spawn_group() {
    72	  if [ "$HAVE_SETSID" = 1 ]; then
    73	    setsid "$@" &
    74	    return
    75	  fi
    76	  python3 -c 'import os, sys
    77	os.setsid()
    78	os.execvp(sys.argv[1], sys.argv[1:])
    79	' "$@" &
    80	}
    81	
    82	# Reap any survivors in process group $1 after the leader has exited (normal OR
    83	# timed out). TERM -> grace -> unconditional KILL, matching the Rust/Python
    84	# contract. Skipped entirely when the group is already empty, so a well-behaved
    85	# tool that exits cleanly with no lingering descendants adds zero latency.
    86	reap_group() {
    87	  _pgid=$1
    88	  kill -0 -"$_pgid" 2>/dev/null || return 0
    89	  kill -TERM -"$_pgid" 2>/dev/null || true
    90	  sleep 1
    91	  kill -KILL -"$_pgid" 2>/dev/null || true
    92	}
    93	
    94	# Portable: own process group, TERM the group, then KILL the group.
    95	portable_watchdog() {
    96	  secs=$1
    97	  shift
    98	  spawn_group "$@"
    99	  pid=$!
   100	  pgid=$pid
   101	  (
   102	    n=0
   103	    while [ "$n" -lt "$secs" ]; do
   104	      sleep 1
   105	      n=$((n + 1))
   106	      kill -0 "$pid" 2>/dev/null || exit 0
   107	    done
   108	    kill -TERM -"$pgid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
   109	    sleep 1
   110	    kill -KILL -"$pgid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
   111	  ) &
   112	  killer=$!
   113	  st=0
   114	  wait "$pid" || st=$?
   115	  # Stop the in-flight timeout killer, then reap any descendants that outlived
   116	  # the leader: TERM -> grace -> unconditional KILL, skipped when the group is
   117	  # already empty (no latency for well-behaved tools).
   118	  kill -KILL "$killer" 2>/dev/null || true
   119	  wait "$killer" 2>/dev/null || true
   120	  reap_group "$pgid"
   121	  return $st
   122	}
   123	
   124	# Run GNU `timeout ...` inside a new session so the whole subtree shares one
   125	# process group, then reap that group once timeout returns. `timeout
   126	# --kill-after` already bounds the *direct* child on the timeout path; this adds
   127	# the portable watchdog's guarantee that a descendant which outlives a NORMAL
   128	# (or timed-out) leader exit is reaped instead of leaking / holding the capture
   129	# pipes open. Group isolation is guaranteed by watchdog_ok (setsid or python
   130	# os.setsid), so there is no unprotected foreground fallback: if a group cannot
   131	# be forged the caller has already disabled this path (metadata-only).
   132	gnu_group_watchdog() {
   133	  spawn_group "$@"
   134	  gpid=$!
   135	  st=0
   136	  wait "$gpid" || st=$?
   137	  reap_group "$gpid"
   138	  return $st
   139	}
   140	
   141	run_watchdog() {
   142	  secs=$1
   143	  shift
   144	  [ "$#" -ge 1 ] || return 1
   145	  watchdog_ok || return 124
   146	  case "$TIMEOUT_STYLE" in
   147	    gnu-long)
   148	      gnu_group_watchdog "$TIMEOUT_BIN" --kill-after=1s "${secs}s" "$@"
   149	      ;;
   150	    gnu-short)
   151	      gnu_group_watchdog "$TIMEOUT_BIN" -k 1 "$secs" "$@"
   152	      ;;
   153	    *)
   154	      portable_watchdog "$secs" "$@"
   155	      ;;
   156	  esac
   157	}
   158	
   159	# Hard cap on captured subprocess output / user-file reads (96 KiB). Excess is
   160	# dropped; `head -c` closing the pipe also sends SIGPIPE upstream so a flooding
   161	# producer (find/locate) stops early instead of filling a temp file unbounded.
   162	OUTPUT_CAP=98304
   163	cap_stream() { head -c "$OUTPUT_CAP"; }
   164	
   165	# Run a command under the watchdog with its output bounded to OUTPUT_CAP bytes.
   166	# Usage: run_watchdog_capped <secs> <outfile> -- cmd args...
   167	run_watchdog_capped() {
   168	  _secs=$1
   169	  _out=$2
   170	  shift 2
   171	  [ "$1" = "--" ] && shift
   172	  run_watchdog "$_secs" "$@" 2>/dev/null | cap_stream > "$_out" || true
   173	}
   174	
   175	HOME_DIR=${HOME:-/tmp}
   176	STATE_DIR="${XDG_STATE_HOME:-$HOME_DIR/.local/state}/quicklook"
   177	CONFIG_FILE="$STATE_DIR/compat-config.env"
   178	SAMP="$ROOT/samples"
   179	
   180	ROOTS="$HOME_DIR"
   181	EXTRA_EXCLUDE=""
   182	WATCH_CAP=2000
   183	CACHE_MB=500
   184	MAX_FILES=500000
   185	
   186	expand_tilde() {
   187	  case "$1" in
   188	    "~") printf '%s' "$HOME_DIR" ;;
   189	    ~/*) printf '%s' "$HOME_DIR/${1#~/}" ;;
   190	    *) printf '%s' "$1" ;;
   191	  esac
   192	}
   193	
   194	# Config is a tagged line file (never sourced / eval'd).
   195	#   R<TAB>absolute-root
   196	#   E<TAB>exclude-name
   197	#   W<TAB>watchCap
   198	#   C<TAB>cacheMb
   199	#   M<TAB>maxFiles
   200	load_config() {
   201	  ROOTS="$HOME_DIR"
   202	  EXTRA_EXCLUDE=""
   203	  WATCH_CAP=2000
   204	  CACHE_MB=500
   205	  MAX_FILES=500000
   206	  [ -f "$CONFIG_FILE" ] || return 0
   207	  loaded_roots=""
   208	  while IFS= read -r line || [ -n "$line" ]; do
   209	    tag=${line%%	*}
   210	    val=${line#*	}
   211	    case "$tag" in
   212	      R)
   213	        [ -n "$val" ] || continue
   214	        if [ -z "$loaded_roots" ]; then
   215	          loaded_roots=$val
   216	        else
   217	          loaded_roots="$loaded_roots|$val"
   218	        fi
   219	        ;;
   220	      E)
   221	        [ -n "$val" ] || continue
   222	        if [ -z "$EXTRA_EXCLUDE" ]; then
   223	          EXTRA_EXCLUDE=$val
   224	        else
   225	          EXTRA_EXCLUDE="$EXTRA_EXCLUDE|$val"
   226	        fi
   227	        ;;
   228	      W) WATCH_CAP=$val ;;
   229	      C) CACHE_MB=$val ;;
   230	      M) MAX_FILES=$val ;;
   231	    esac
   232	  done < "$CONFIG_FILE"
   233	  [ -n "$loaded_roots" ] && ROOTS=$loaded_roots
   234	}
   235	
   236	save_config() {
   237	  mkdir -p "$STATE_DIR"
   238	  : > "$CONFIG_FILE"
   239	  oldifs=$IFS
   240	  IFS='|'
   241	  for r in $ROOTS; do
   242	    [ -n "$r" ] || continue
   243	    printf 'R\t%s\n' "$r" >> "$CONFIG_FILE"
   244	  done
   245	  for e in $EXTRA_EXCLUDE; do
   246	    [ -n "$e" ] || continue
   247	    printf 'E\t%s\n' "$e" >> "$CONFIG_FILE"
   248	  done
   249	  IFS=$oldifs
   250	  printf 'W\t%s\n' "$WATCH_CAP" >> "$CONFIG_FILE"
   251	  printf 'C\t%s\n' "$CACHE_MB" >> "$CONFIG_FILE"
   252	  printf 'M\t%s\n' "$MAX_FILES" >> "$CONFIG_FILE"
   253	}
   254	
   255	json_escape() {
   256	  # JSON string contents: \, ", C0 controls (including newline).
   257	  printf '%s' "$1" | od -An -t u1 -v | awk '
   258	    BEGIN { ORS="" }
   259	    {
   260	      for (i = 1; i <= NF; i++) {
   261	        n = $i + 0
   262	        if (n == 92) printf "\\\\"
   263	        else if (n == 34) printf "\\\""
   264	        else if (n == 10) printf "\\n"
   265	        else if (n == 13) printf "\\r"
   266	        else if (n == 9) printf "\\t"
   267	        else if (n < 32) printf "\\u%04x", n
   268	        else printf "%c", n
   269	      }
   270	    }
   271	  '
   272	}
   273	
   274	extract_id() {
   275	  printf '%s' "$1" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p'
   276	}
   277	
   278	extract_string() {
   279	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"
   280	}
   281	
   282	extract_number() {
   283	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p"
   284	}
   285	
   286	extract_array_inner() {
   287	  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\[\\([^]]*\\)\\].*/\\1/p"
   288	}
   289	
   290	quoted_to_pipe() {
   291	  printf '%s' "$1" | sed 's/"[[:space:]]*,[[:space:]]*"/|/g; s/^[[:space:]]*"//; s/"[[:space:]]*$//; s/"//g'
   292	}
   293	
   294	apply_config_line() {
   295	  inner=$(extract_array_inner "$1" "roots")
   296	  if [ -n "$inner" ]; then
   297	    ROOTS=""
   298	    oldifs=$IFS
   299	    IFS='|'
   300	    set -- $(quoted_to_pipe "$inner")
   301	    IFS=$oldifs
   302	    for item in "$@"; do
   303	      [ -n "$item" ] || continue
   304	      exp=$(expand_tilde "$item")
   305	      if [ -z "$ROOTS" ]; then
   306	        ROOTS="$exp"
   307	      else
   308	        ROOTS="$ROOTS|$exp"
   309	      fi
   310	    done
   311	    [ -n "$ROOTS" ] || ROOTS="$HOME_DIR"
   312	  fi
   313	  inner=$(extract_array_inner "$1" "extraExclude")
   314	  if [ -n "$inner" ]; then
   315	    EXTRA_EXCLUDE=$(quoted_to_pipe "$inner")
   316	  fi
   317	  n=$(extract_number "$1" "watchCap")
   318	  [ -n "$n" ] && WATCH_CAP=$n
   319	  n=$(extract_number "$1" "cacheMb")
   320	  [ -n "$n" ] && CACHE_MB=$n
   321	  n=$(extract_number "$1" "maxFiles")
   322	  [ -n "$n" ] && MAX_FILES=$n
   323	  save_config
   324	}
   325	
   326	safe_glob() {
   327	  printf '%s' "$1" | tr -cd 'A-Za-z0-9._-'
   328	}
   329	
   330	kind_of() {
   331	  base=$(printf '%s' "$1" | sed 's|.*/||')
   332	  ext=$(printf '%s' "$base" | awk -F. '{print tolower($NF)}')
   333	  if [ -d "$1" ]; then
   334	    printf 'dir'
   335	    return
   336	  fi
   337	  case "$ext" in
   338	    png|jpg|jpeg|webp|svg|gif|bmp|ico) printf 'image' ;;
   339	    pdf) printf 'pdf' ;;
   340	    csv|tsv) printf 'csv' ;;
   341	    rs|js|ts|py|go|c|h|md|txt|toml|json|yml|yaml|qml|lua) printf 'code' ;;
   342	    *) printf 'hex' ;;
   343	  esac
   344	}
   345	
   346	score_name() {
   347	  name=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
   348	  q=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
   349	  case "$name" in
   350	    "$q") printf '1000' ;;
   351	    "$q"*) printf '800' ;;
   352	    *"$q"*) printf '600' ;;
   353	    *) printf '0' ;;
   354	  esac
   355	}
   356	
   357	demo_hit() {
   358	  path="$SAMP/$1"
   359	  kind=$(kind_of "$path")
   360	  printf '{"path":"%s","name":"%s","kind":"%s","score":%s,"mtime":0,"size":0}' \
   361	    "$(json_escape "$path")" "$1" "$kind" "$2"
   362	}
   363	
   364	demo_results() {
   365	  printf '[%s,%s,%s,%s,%s]' \
   366	    "$(demo_hit invoice.pdf 900)" \
   367	    "$(demo_hit photo.png 880)" \
   368	    "$(demo_hit sales.csv 860)" \
   369	    "$(demo_hit themed.rs 840)" \
   370	    "$(demo_hit README.md 820)"
   371	}
   372	
   373	prune_names() {
   374	  printf '%s' ".ssh|.gnupg|.password-store|node_modules|target|.git|.hg|.svn|.bzr|__pycache__|.venv|venv|.tox|.mypy_cache|.pytest_cache|.cargo|.rustup|.npm|.cache|.Trash|.local|keyrings|kwalletd|Keychains"
   375	  if [ -n "$EXTRA_EXCLUDE" ]; then
   376	    printf '|%s' "$EXTRA_EXCLUDE"
   377	  fi
   378	}
   379	
   380	is_secret_file() {
   381	  case "$1" in
   382	    .env|.env.*|*.env) return 0 ;;
   383	    id_rsa|id_ed25519|id_rsa.*) return 0 ;;
   384	  esac
   385	  return 1
   386	}
   387	
   388	path_is_secret() {
   389	  case "$1" in
   390	    */.ssh/*|*/.gnupg/*|*/.password-store/*|*/.local/share/keyrings/*|*/.local/share/kwalletd/*|*/Library/Keychains/*)
   391	      return 0
   392	      ;;
   393	  esac
   394	  is_secret_file "$(printf '%s' "$1" | sed 's|.*/||')"
   395	}
   396	
   397	hidden_ancestor() {
   398	  # Skip hidden/heavy directories unless they are an explicit root.
   399	  cur=$(dirname "$1")
   400	  while [ -n "$cur" ] && [ "$cur" != "/" ]; do
   401	    skip_this=0
   402	    oldifs=$IFS
   403	    IFS='|'
   404	    for r in $ROOTS; do
   405	      [ "$cur" = "$r" ] && skip_this=1
   406	    done
   407	    IFS=$oldifs
   408	    [ "$skip_this" -eq 0 ] || return 1
   409	    base=$(printf '%s' "$cur" | sed 's|.*/||')
   410	    case "$base" in
   411	      .*) return 0 ;;
   412	    esac
   413	    oldifs=$IFS
   414	    IFS='|'
   415	    for n in $(prune_names); do
   416	      [ "$base" = "$n" ] && return 0
   417	    done
   418	    IFS=$oldifs
   419	    np=$(dirname "$cur")
   420	    [ "$np" = "$cur" ] && break
   421	    cur=$np
   422	  done
   423	  return 1
   424	}
   425	
   426	append_hit() {
   427	  dest="$1"
   428	  p="$2"
   429	  q="$3"
   430	  path_is_secret "$p" && return 0
   431	  hidden_ancestor "$p" && return 0
   432	  sc=$(score_name "$(printf '%s' "$p" | sed 's|.*/||')" "$q")
   433	  [ "$sc" -gt 0 ] || return 0
   434	  k=$(kind_of "$p")
   435	  bn=$(printf '%s' "$p" | sed 's|.*/||')
   436	  printf '%s {"path":"%s","name":"%s","kind":"%s","score":%s,"mtime":0,"size":0}\n' \
   437	    "$sc" "$(json_escape "$p")" "$(json_escape "$bn")" "$k" "$sc" >> "$dest"
   438	}
   439	
   440	run_capped_find() {
   441	  root="$1"
   442	  q="$2"
   443	  out="$3"
   444	  names=$(prune_names)
   445	  set -f
   446	  set -- find "$root" -mindepth 1 -maxdepth 6 '(' -name '.*'
   447	  oldifs=$IFS
   448	  IFS='|'
   449	  for n in $names; do
   450	    [ -n "$n" ] || continue
   451	    set -- "$@" -o -name "$n"
   452	  done
   453	  IFS=$oldifs
   454	  set -- "$@" ')' -prune -o -iname "*$q*" -print
   455	  set +f
   456	  run_watchdog_capped 2 "$out" -- "$@"
   457	}
   458	
   459	find_hits() {
   460	  q=$(safe_glob "$1")
   461	  dest="$2"
   462	  [ -n "$q" ] || return 0
   463	  raw=$(mktemp)
   464	  located=$(mktemp)
   465	  if command -v plocate >/dev/null 2>&1; then
   466	    run_watchdog_capped 2 "$located" -- plocate -il 40 -- "$q"
   467	  elif command -v locate >/dev/null 2>&1; then
   468	    run_watchdog_capped 2 "$located" -- locate -il 40 -- "$q"
   469	  fi
   470	  if [ -s "$located" ]; then
   471	    while IFS= read -r lp; do
   472	      [ -n "$lp" ] || continue
   473	      under=0
   474	      oldifs=$IFS
   475	      IFS='|'
   476	      for root in $ROOTS; do
   477	        case "$lp" in
   478	          "$root"|"$root"/*) under=1 ;;
   479	        esac
   480	      done
   481	      IFS=$oldifs
   482	      [ "$under" -eq 1 ] && printf '%s\n' "$lp" >> "$raw"
   483	    done < "$located"
   484	  fi
   485	  rm -f "$located"
   486	  if [ ! -s "$raw" ]; then
   487	    oldifs=$IFS
   488	    IFS='|'
   489	    set -- $ROOTS
   490	    IFS=$oldifs
   491	    : > "$raw"
   492	    for root in "$@"; do
   493	      [ -d "$root" ] || continue
   494	      part=$(mktemp)
   495	      run_capped_find "$root" "$q" "$part"
   496	      cat "$part" >> "$raw" 2>/dev/null || true
   497	      rm -f "$part"
   498	    done
   499	  fi
   500	  n=0
   501	  while IFS= read -r p; do
   502	    [ -n "$p" ] || continue
   503	    n=$((n + 1))
   504	    [ "$n" -le 80 ] || break
   505	    append_hit "$dest" "$p" "$q"
   506	  done < "$raw"
   507	  rm -f "$raw"
   508	}
   509	
   510	reply_status() {
   511	  id="$1"
   512	  roots_json=""
   513	  oldifs=$IFS
   514	  IFS='|'
   515	  for r in $ROOTS; do
   516	    [ -n "$r" ] || continue
   517	    if [ -z "$roots_json" ]; then
   518	      roots_json="\"$(json_escape "$r")\""
   519	    else
   520	      roots_json="$roots_json,\"$(json_escape "$r")\""
   521	    fi
   522	  done
   523	  IFS=$oldifs
   524	  budget=$((CACHE_MB * 1024 * 1024))
   525	  poppler=false
   526	  command -v pdftoppm >/dev/null 2>&1 && poppler=true
   527	  plocate=false
   528	  { command -v plocate >/dev/null 2>&1 || command -v locate >/dev/null 2>&1; } && plocate=true
   529	  printf '{"id":%s,"kind":"status","indexing":false,"progress":1,"backend":"compat","status":{"indexing":false,"progress":1,"backend":"compat","files":5,"watchCount":0,"watchCap":%s,"roots":[%s],"cacheBytes":0,"cacheBudget":%s,"poppler":%s,"plocate":%s,"ffmpeg":false,"helper":"compat","version":"1.0.0"}}\n' \
   530	    "$id" "$WATCH_CAP" "$roots_json" "$budget" "$poppler" "$plocate"
   531	}
   532	
   533	reply_query() {
   534	  id="$1"
   535	  q="$2"
   536	  if [ -z "$q" ]; then
   537	    printf '{"id":%s,"kind":"results","results":%s,"indexing":false,"progress":1,"backend":"demo"}\n' "$id" "$(demo_results)"
   538	    return
   539	  fi
   540	  tmp=$(mktemp)
   541	  ql=$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')
   542	  for name in invoice.pdf photo.png sales.csv themed.rs README.md; do
   543	    sc=$(score_name "$name" "$ql")
   544	    if [ "$sc" -gt 0 ]; then
   545	      printf '%s %s\n' "$((sc + 200))" "$(demo_hit "$name" "$((sc + 200))")" >> "$tmp"
   546	    fi
   547	  done
   548	  find_hits "$q" "$tmp"
   549	  sorted=$(mktemp)
   550	  sort -nr -k1,1 "$tmp" > "$sorted" 2>/dev/null || true
   551	  body=""
   552	  n=0
   553	  while read -r _sc hit; do
   554	    [ -n "$hit" ] || continue
   555	    n=$((n + 1))
   556	    [ "$n" -le 40 ] || break
   557	    if [ -z "$body" ]; then
   558	      body="$hit"
   559	    else
   560	      body="$body,$hit"
   561	    fi
   562	  done < "$sorted"
   563	  printf '{"id":%s,"kind":"results","results":[%s],"indexing":false,"progress":1,"backend":"compat"}\n' "$id" "$body"
   564	  rm -f "$tmp" "$sorted"
   565	}
   566	
   567	png_wh() {
   568	  hex=$(read_user_file dd if="$1" bs=1 skip=16 count=8 2>/dev/null | od -An -tx1 | tr -cd '0-9a-f')
   569	  [ "${#hex}" -ge 16 ] || return 1
   570	  w=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c1-8)")
   571	  h=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c9-16)")
   572	  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   573	  printf '%s %s' "$w" "$h"
   574	}
   575	
   576	gif_wh() {
   577	  hex=$(read_user_file dd if="$1" bs=1 skip=6 count=4 2>/dev/null | od -An -tx1 | tr -cd '0-9a-f')
   578	  [ "${#hex}" -ge 8 ] || return 1
   579	  w=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c3-4)$(printf '%s' "$hex" | cut -c1-2)")
   580	  h=$(printf '%d' "0x$(printf '%s' "$hex" | cut -c7-8)$(printf '%s' "$hex" | cut -c5-6)")
   581	  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   582	  printf '%s %s' "$w" "$h"
   583	}
   584	
   585	svg_wh() {
   586	  head=$(read_user_file dd if="$1" bs=1 count=8192 2>/dev/null)
   587	  vb=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Vv]iew[Bb]ox=["'\'']\([^"'\'']*\)["'\''].*/\1/p')
   588	  if [ -n "$vb" ]; then
   589	    set -- $vb
   590	    if [ "$#" -ge 4 ]; then
   591	      w=$(printf '%s' "$3" | tr -cd '0-9.')
   592	      h=$(printf '%s' "$4" | tr -cd '0-9.')
   593	      w=${w%%.*}
   594	      h=${h%%.*}
   595	      [ -n "$w" ] && [ -n "$h" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   596	      printf '%s %s' "$w" "$h"
   597	      return 0
   598	    fi
   599	  fi
   600	  w=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Ww]idth=["'\'']\([0-9.][0-9.]*\).*/\1/p')
   601	  h=$(printf '%s' "$head" | tr '\n' ' ' | sed -n 's/.*[Hh]eight=["'\'']\([0-9.][0-9.]*\).*/\1/p')
   602	  w=${w%%.*}
   603	  h=${h%%.*}
   604	  [ -n "$w" ] && [ -n "$h" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
   605	  printf '%s %s' "$w" "$h"
   606	}
   607	
   608	read_user_file() {
   609	  run_watchdog 1 "$@"
   610	}
   611	
   612	hex_head() {
   613	  read_user_file od -An -tx1 -N 256 "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //'
   614	}
   615	
   616	html_escape_file() {
   617	  read_user_file head -c "$OUTPUT_CAP" "$1" 2>/dev/null | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
   618	}
   619	
   620	csv_preview_json() {
   621	  path="$1"
   622	  # Byte-cap FIRST (bounds a pathological single no-newline row), then line-cap.
   623	  read_user_file head -c "$OUTPUT_CAP" "$path" 2>/dev/null | head -n 501 | awk '
   624	    function esc(s) {
   625	      gsub(/\\/, "\\\\", s)
   626	      gsub(/"/, "\\\"", s)
   627	      return s
   628	    }
   629	    function arr(line,    n, i, out, a) {
   630	      n = split(line, a, FS)
   631	      out = "["
   632	      for (i = 1; i <= n; i++) {
   633	        if (i > 1) out = out ","
   634	        out = out "\"" esc(a[i]) "\""
   635	      }
   636	      return out "]"
   637	    }
   638	    BEGIN { headers = "[]"; rows = ""; nbody = 0 }
   639	    NR == 1 {
   640	      line = $0
   641	      c = gsub(/,/, ",", line)
   642	      line = $0
   643	      t = gsub(/\t/, "\t", line)
   644	      line = $0
   645	      s = gsub(/;/, ";", line)
   646	      line = $0
   647	      p = gsub(/\|/, "|", line)
   648	      FS = ","
   649	      if (t > c && t >= s && t >= p) FS = "\t"
   650	      else if (s > c && s >= t && s >= p) FS = ";"
   651	      else if (p > c && p >= t && p >= s) FS = "|"
   652	      $0 = $0
   653	      headers = arr($0)
   654	      next
   655	    }
   656	    {
   657	      if (nbody) rows = rows ","
   658	      rows = rows arr($0)
   659	      nbody++
   660	    }
   661	    END {
   662	      trunc = (NR > 501) ? "true" : "false"
   663	      printf "{\"kind\":\"csv\",\"headers\":%s,\"rows\":[%s],\"truncated\":%s}", headers, rows, trunc
   664	    }
   665	  '
   666	}
   667	
   668	dir_preview_json() {
   669	  path="$1"
   670	  tmp=$(mktemp)
   671	  # Byte-cap the listing (bounds pathological huge-filename dirs) then line-cap.
   672	  read_user_file ls -1 "$path" 2>/dev/null | cap_stream | head -n 200 > "$tmp"
   673	  entries=""
   674	  while IFS= read -r name || [ -n "$name" ]; do
   675	    [ -n "$name" ] || continue
   676	    full="$path/$name"
   677	    k=$(kind_of "$full")
   678	    sz=0
   679	    if [ -f "$full" ] && watchdog_ok; then
   680	      sz=$(run_watchdog 1 stat -c %s "$full" 2>/dev/null) || \
   681	        sz=$(run_watchdog 1 stat -f %z "$full" 2>/dev/null) || sz=0
   682	      [ -n "$sz" ] || sz=0
   683	    fi
   684	    ent="{\"name\":\"$(json_escape "$name")\",\"kind\":\"$k\",\"size\":$sz}"
   685	    if [ -z "$entries" ]; then
   686	      entries="$ent"
   687	    else
   688	      entries="$entries,$ent"
   689	    fi
   690	  done < "$tmp"
   691	  rm -f "$tmp"
   692	  printf '{"kind":"dir","entries":[%s],"path":"%s"}' "$entries" "$(json_escape "$path")"
   693	}
   694	
   695	isolation_ok() {
   696	  watchdog_ok
   697	}
   698	
   699	run_isolated() {
   700	  watchdog_ok || return 1
   701	  (
   702	    # CPU seconds and file size are always safe to cap. Address space (-v) is
   703	    # Linux-only: on macOS RLIMIT_AS can prevent the renderer from exec'ing.
   704	    # NPROC (-u) is deliberately NOT set: it counts the user's ENTIRE existing
   705	    # process table, so a judge already running many processes could be unable
   706	    # to start any renderer. Fork bombs remain bounded by the CPU limit and the
   707	    # process-group wall-clock watchdog (run_watchdog).
   708	    ulimit -t 8 2>/dev/null || true
   709	    ulimit -f 65536 2>/dev/null || true
   710	    [ "$OS_NAME" = Linux ] && ulimit -v 524288 2>/dev/null || true
   711	    run_watchdog 8 "$@"
   712	  ) >/dev/null 2>&1 || true
   713	}
   714	
   715	run_pdftoppm() {
   716	  path="$1"
   717	  page="$2"
   718	  dest="$3"
   719	  prefix="${dest%.png}"
   720	  if ! isolation_ok; then
   721	    return 1
   722	  fi
   723	  run_isolated pdftoppm -f "$page" -l "$page" -png -r 140 -singlefile "$path" "$prefix"
   724	}
   725	
   726	downsample_image() {
   727	  src="$1"
   728	  dest="$2"
   729	  nw="$3"
   730	  nh="$4"
   731	  if ! isolation_ok; then
   732	    return 1
   733	  fi
   734	  if command -v ffmpeg >/dev/null 2>&1; then
   735	    run_isolated ffmpeg -nostdin -hide_banner -loglevel error -i "$src" -vf "scale=${nw}:${nh}" -frames:v 1 -y "$dest"
   736	    [ -s "$dest" ] && return 0
   737	  fi
   738	  if command -v magick >/dev/null 2>&1; then
   739	    run_isolated magick "$src" -resize "${nw}x${nh}" "$dest"
   740	    [ -s "$dest" ] && return 0
   741	  fi
   742	  if command -v convert >/dev/null 2>&1; then
   743	    run_isolated convert "$src" -resize "${nw}x${nh}" "$dest"
   744	    [ -s "$dest" ] && return 0
   745	  fi
   746	  return 1
   747	}
   748	
   749	reply_preview() {
   750	  id="$1"
   751	  path="$2"
   752	  page="${3:-1}"
   753	  [ -n "$page" ] || page=1
   754	  kind=$(kind_of "$path")
   755	  case "$kind" in
   756	    image)
   757	      ext=$(printf '%s' "$path" | awk -F. '{print tolower($NF)}')
   758	      wh=""
   759	      case "$ext" in
   760	        png) wh=$(png_wh "$path") || wh="" ;;
   761	        gif) wh=$(gif_wh "$path") || wh="" ;;
   762	        svg) wh=$(svg_wh "$path") || wh="" ;;
   763	        *) wh="" ;;
   764	      esac
   765	      if [ -n "$wh" ]; then
   766	        set -- $wh
   767	        w=$1
   768	        h=$2
   769	        pix=$((w * h))
   770	        if [ "$pix" -le 20000000 ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   771	          anim=false
   772	          [ "$ext" = gif ] && anim=true
   773	          printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":%s,"width":%s,"height":%s}}\n' \
   774	            "$id" "$(json_escape "$path")" "$anim" "$w" "$h"
   775	        elif [ "$w" -gt 0 ] && [ "$h" -gt 0 ]; then
   776	          nw=$w
   777	          nh=$h
   778	          # integer sqrt-ish shrink so nw*nh <= 20e6
   779	          while [ $((nw * nh)) -gt 20000000 ]; do
   780	            nw=$((nw / 2))
   781	            nh=$((nh / 2))
   782	            [ "$nw" -gt 0 ] && [ "$nh" -gt 0 ] || break
   783	          done
   784	          [ "$nw" -gt 0 ] || nw=1
   785	          [ "$nh" -gt 0 ] || nh=1
   786	          cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/previews"
   787	          mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-previews"
   788	          mkdir -p "$cache_dir"
   789	          dest="$cache_dir/ds-$$.png"
   790	          if downsample_image "$path" "$dest" "$nw" "$nh" && [ -s "$dest" ]; then
   791	            printf '{"id":%s,"kind":"preview","preview":{"kind":"image","path":"%s","animated":false,"width":%s,"height":%s,"label":"downsampled"}}\n' \
   792	              "$id" "$(json_escape "$dest")" "$nw" "$nh"
   793	          else
   794	            printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"image %sx%s","label":"image exceeds 20 MP — hex view","width":%s,"height":%s,"path":"%s"}}\n' \
   795	              "$id" "$(json_escape "$(hex_head "$path")")" "$w" "$h" "$w" "$h" "$(json_escape "$path")"
   796	          fi
   797	        fi
   798	      else
   799	        printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"unverifiable image","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   800	          "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   801	      fi
   802	      ;;
   803	    pdf)
   804	      if command -v pdftoppm >/dev/null 2>&1 && isolation_ok; then
   805	        cache_dir="${XDG_CACHE_HOME:-$HOME_DIR/.cache}/quicklook/pdf"
   806	        mkdir -p "$cache_dir" 2>/dev/null || cache_dir="/tmp/quicklook-pdf"
   807	        mkdir -p "$cache_dir"
   808	        dest="$cache_dir/p${page}-$$.png"
   809	        run_pdftoppm "$path" "$page" "$dest"
   810	        if [ ! -s "$dest" ] && [ -s "${dest%.png}-1.png" ]; then
   811	          dest="${dest%.png}-1.png"
   812	        fi
   813	        if [ -s "$dest" ]; then
   814	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","path":"%s","page":%s,"page_count":1,"need_poppler":false}}\n' \
   815	            "$id" "$(json_escape "$dest")" "$page"
   816	        else
   817	          printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"render_error":true,"page":%s,"page_count":1,"label":"couldn'\''t render this page","magic":"PDF document","hex":"%s"}}\n' \
   818	            "$id" "$page" "$(json_escape "$(hex_head "$path")")"
   819	        fi
   820	      elif command -v pdftoppm >/dev/null 2>&1; then
   821	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":false,"page":%s,"page_count":1,"label":"PDF metadata only — no isolated renderer","magic":"PDF document"}}\n' \
   822	          "$id" "$page"
   823	      else
   824	        printf '{"id":%s,"kind":"preview","preview":{"kind":"pdf","need_poppler":true,"page":%s,"page_count":1,"label":"install poppler for PDF previews","magic":"PDF document","path":"%s"}}\n' \
   825	          "$id" "$page" "$(json_escape "$path")"
   826	      fi
   827	      ;;
   828	    code)
   829	      printf '{"id":%s,"kind":"preview","preview":{"kind":"code","html":"<pre>%s</pre>","lang":"text","path":"%s"}}\n' \
   830	        "$id" "$(json_escape "$(html_escape_file "$path")")" "$(json_escape "$path")"
   831	      ;;
   832	    csv)
   833	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(csv_preview_json "$path")"
   834	      ;;
   835	    dir)
   836	      printf '{"id":%s,"kind":"preview","preview":%s}\n' "$id" "$(dir_preview_json "$path")"
   837	      ;;
   838	    *)
   839	      printf '{"id":%s,"kind":"preview","preview":{"kind":"hex","hex":"%s","magic":"data","label":"can'\''t render this — hex view","path":"%s"}}\n' \
   840	        "$id" "$(json_escape "$(hex_head "$path")")" "$(json_escape "$path")"
   841	      ;;
   842	  esac
   843	}
   844	
   845	do_open() {
   846	  path="$1"
   847	  reveal="$2"
   848	  if [ ! -e "$path" ]; then
   849	    return 1
   850	  fi
   851	  target="$path"
   852	  if [ "$reveal" = 1 ] && [ ! -d "$path" ]; then
   853	    target=$(dirname "$path")
   854	  fi
   855	  watchdog_ok || return 2
   856	  if command -v gio >/dev/null 2>&1; then
   857	    run_watchdog 8 gio open "$target" >/dev/null 2>&1 || true
   858	    return 0
   859	  fi
   860	  if command -v xdg-open >/dev/null 2>&1; then
   861	    run_watchdog 8 xdg-open "$target" >/dev/null 2>&1 || true
   862	    return 0
   863	  fi
   864	  if command -v open >/dev/null 2>&1; then
   865	    run_watchdog 8 open "$target" >/dev/null 2>&1 || true
   866	    return 0
   867	  fi
   868	  return 2
   869	}
   870	
   871	handle_line() {
   872	  load_config
   873	  line="$1"
   874	  id=$(extract_id "$line")
   875	  [ -n "$id" ] || id=0
   876	  case "$line" in
   877	    *'"cmd":"config"'*|*'cmd": "config"'*)
   878	      apply_config_line "$line"
   879	      reply_status "$id"
   880	      ;;
   881	    *'"cmd":"status"'*|*'cmd": "status"'*|*'cmd":"capabilities"'*)
   882	      reply_status "$id"
   883	      ;;
   884	    *'"cmd":"preview"'*|*'cmd": "preview"'*|*'cmd":"prefetch"'*|*'cmd": "prefetch"'*|*'cmd":"page"'*|*'cmd": "page"'*)
   885	      reply_preview "$id" "$(extract_string "$line" "path")" "$(extract_number "$line" "page")"
   886	      ;;
   887	    *'"cmd":"open"'*|*'cmd": "open"'*)
   888	      path=$(extract_string "$line" "path")
   889	      if do_open "$path" 0; then
   890	        printf '{"id":%s,"kind":"ok"}\n' "$id"
   891	      else
   892	        printf '{"id":%s,"kind":"error","error":"open failed"}\n' "$id"
   893	      fi
   894	      ;;
   895	    *'"cmd":"reveal"'*|*'cmd": "reveal"'*)
   896	      path=$(extract_string "$line" "path")
   897	      if do_open "$path" 1; then
   898	        printf '{"id":%s,"kind":"ok"}\n' "$id"
   899	      else
   900	        printf '{"id":%s,"kind":"error","error":"reveal failed"}\n' "$id"
   901	      fi
   902	      ;;
   903	    *'"cmd":"theme"'*|*'cmd":"select"'*|*'cmd":"warmup"'*)
   904	      printf '{"id":%s,"kind":"ok"}\n' "$id"
   905	      ;;
   906	    *'"q":'*|*'cmd":"query"'*|*'cmd": "query"'*)
   907	      q=$(extract_string "$line" "q")
   908	      reply_query "$id" "$q"
   909	      ;;
   910	    *)
   911	      reply_preview "$id" "$(extract_string "$line" "path")" "$(extract_number "$line" "page")"
   912	      ;;
   913	  esac
   914	}
   915	
   916	oneshot=0
   917	payload=""
   918	while [ "$#" -gt 0 ]; do
   919	  case "$1" in
   920	    --plugin-dir)
   921	      shift
   922	      if [ -n "${1:-}" ]; then
   923	        export QUICKLOOK_PLUGIN_DIR="$1"
   924	        SAMP="$1/samples"
   925	      fi
   926	      ;;
   927	    --oneshot)
   928	      oneshot=1
   929	      shift
   930	      payload="${1:-}"
   931	      ;;
   932	    --watchdog-selftest)
   933	      shift
   934	      secs=${1:-2}
   935	      [ "$#" -gt 0 ] && shift
   936	      run_watchdog "$secs" "$@"
   937	      exit $?
   938	      ;;
   939	    *)
   940	      break
   941	      ;;
   942	  esac
   943	  [ "$#" -gt 0 ] && shift
   944	done
   945	
   946	load_config
   947	
   948	if [ "$oneshot" -eq 1 ]; then
   949	  if [ -z "$payload" ]; then
   950	    IFS= read -r payload || payload="{}"
   951	  fi
   952	  handle_line "$payload"
   953	  exit 0
   954	fi
   955	
   956	while IFS= read -r line; do
   957	  [ -n "$line" ] || continue
   958	  handle_line "$line"
   959	done
### compat/quicklookd.py
     1	#!/usr/bin/env python3
     2	"""POSIX/Python fallback for quicklookd when the Rust binary is missing.
     3	
     4	Speaks the same newline-delimited JSON protocol. No nucleo, no sqlite, no
     5	watches — demo corpus + a bounded find walk + basic previews.
     6	"""
     7	from __future__ import annotations
     8	
     9	import json
    10	import os
    11	import shutil
    12	import signal
    13	import subprocess
    14	import sys
    15	import threading
    16	from pathlib import Path
    17	
    18	# Hard cap on captured stdout/stderr from any child subprocess. Excess bytes are
    19	# drained and dropped so a flooding child can neither exhaust memory nor block on
    20	# a full pipe.
    21	OUTPUT_CAP = 96 * 1024
    22	
    23	def _argv_value(flag: str) -> str | None:
    24	    argv = sys.argv
    25	    for i, a in enumerate(argv):
    26	        if a == flag and i + 1 < len(argv):
    27	            return argv[i + 1]
    28	    return None
    29	
    30	
    31	_pd = _argv_value("--plugin-dir") or os.environ.get("QUICKLOOK_PLUGIN_DIR")
    32	PLUGIN_DIR = Path(_pd) if _pd else Path(__file__).resolve().parent.parent
    33	SAMPLES = PLUGIN_DIR / "samples"
    34	HOME = Path(os.environ.get("HOME", "/tmp"))
    35	STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "quicklook"
    36	CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "quicklook"
    37	SETTINGS_PATH = STATE / "compat-config.json"
    38	
    39	DEFAULT_SKIP = (
    40	    ".ssh",
    41	    ".gnupg",
    42	    ".password-store",
    43	    "node_modules",
    44	    "target",
    45	    ".git",
    46	    ".hg",
    47	    ".svn",
    48	    ".bzr",
    49	    "__pycache__",
    50	    ".venv",
    51	    "venv",
    52	    ".tox",
    53	    ".mypy_cache",
    54	    ".pytest_cache",
    55	    ".cargo",
    56	    ".rustup",
    57	    ".npm",
    58	    ".cache",
    59	    ".Trash",
    60	    ".local",
    61	    "keyrings",
    62	    "kwalletd",
    63	    "Keychains",
    64	)
    65	SKIP_PATH_PARTS = (
    66	    "/.ssh/",
    67	    "/.gnupg/",
    68	    "/.password-store/",
    69	    "/.local/share/keyrings/",
    70	    "/.local/share/kwalletd/",
    71	    "/Library/Keychains/",
    72	)
    73	MEGAPIXELS = 20_000_000
    74	
    75	SETTINGS = {
    76	    "roots": [str(HOME)],
    77	    "extraExclude": [],
    78	    "watchCap": 2000,
    79	    "cacheMb": 500,
    80	    "maxFiles": 500000,
    81	}
    82	
    83	
    84	def _expand(p: str) -> str:
    85	    if p == "~":
    86	        return str(HOME)
    87	    if p.startswith("~/"):
    88	        return str(HOME / p[2:])
    89	    return p
    90	
    91	
    92	def load_settings() -> None:
    93	    if not SETTINGS_PATH.is_file():
    94	        return
    95	    try:
    96	        data = json.loads(SETTINGS_PATH.read_text())
    97	    except (OSError, json.JSONDecodeError):
    98	        return
    99	    apply_settings(data, persist=False)
