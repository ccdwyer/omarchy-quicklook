   554	def svg_dims(path: Path) -> tuple[int, int] | None:
   555	    text = read_capped(path, 16 * 1024).decode("utf-8", errors="replace")
   556	    lower = text.lower()
   557	    def token_len(raw: str) -> int | None:
   558	        raw = raw.strip().strip("\"'")
   559	        if raw.endswith("%"):
   560	            return None
   561	        i = 0
   562	        while i < len(raw) and (raw[i].isdigit() or raw[i] in ".+-"):
   563	            i += 1
   564	        if not i:
   565	            return None
   566	        try:
   567	            v = float(raw[:i])
   568	        except ValueError:
   569	            return None
   570	        if v <= 0 or v > 1_000_000:
   571	            return None
   572	        return int(round(v))
   573	
   574	    idx = lower.find("viewbox")
   575	    if idx >= 0:
   576	        rest = text[idx + 7 :].lstrip(" \t=\n\"'")
   577	        parts = rest.replace(",", " ").split()
   578	        if len(parts) >= 4:
   579	            w = token_len(parts[2])
   580	            h = token_len(parts[3])
   581	            if w and h:
   582	                return w, h
   583	    def attr(name: str) -> int | None:
   584	        key = name + "="
   585	        at = lower.find(key)
   586	        if at < 0:
   587	            return None
   588	        rest = text[at + len(key) :].lstrip()
   589	        rest = rest.lstrip("\"'")
   590	        tok = ""
   591	        for ch in rest:
   592	            if ch in "\"' \t>/":
   593	                break
   594	            tok += ch
   595	        return token_len(tok)
   596	
   597	    w = attr("width")
   598	    h = attr("height")
   599	    if w and h:
   600	        return w, h
   601	    return None
   602	
   603	
   604	def image_dims(path: Path) -> tuple[int, int] | None:
   605	    head = read_capped(path, 96 * 1024)
   606	    if not head:
   607	        return None
   608	    if len(head) >= 24 and head[:8] == b"\x89PNG\r\n\x1a\n":
   609	        return _be_u32(head[16:20]), _be_u32(head[20:24])
   610	    if len(head) >= 10 and head[:6] in (b"GIF87a", b"GIF89a"):
   611	        return int.from_bytes(head[6:8], "little"), int.from_bytes(head[8:10], "little")
   612	    if head[:2] == b"\xff\xd8":
   613	        i = 2
   614	        while i + 9 < len(head):
   615	            if head[i] != 0xFF:
   616	                i += 1
   617	                continue
   618	            marker = head[i + 1]
   619	            if marker in (0xC0, 0xC1, 0xC2, 0xC3):
   620	                return int.from_bytes(head[i + 5 : i + 7], "big"), int.from_bytes(
   621	                    head[i + 7 : i + 9], "big"
   622	                )
   623	            if marker in (0xD8, 0xD9):
   624	                i += 2
   625	                continue
   626	            seglen = int.from_bytes(head[i + 2 : i + 4], "big")
   627	            i += 2 + seglen
   628	        return None
   629	    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
   630	        kind = head[12:16]
   631	        if kind == b"VP8X" and len(head) >= 30:
   632	            w = 1 + int.from_bytes(head[24:27], "little")
   633	            h = 1 + int.from_bytes(head[27:30], "little")
   634	            return w, h
   635	        if kind == b"VP8 " and len(head) >= 26:
   636	            return int.from_bytes(head[26:28], "little") & 0x3FFF, int.from_bytes(
   637	                head[28:30], "little"
   638	            ) & 0x3FFF
   639	    return None
