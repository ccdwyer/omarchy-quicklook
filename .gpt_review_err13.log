   268	pub fn merge_unique(head: Vec<IndexedFile>, tail: Vec<IndexedFile>) -> Vec<IndexedFile> {
   269	    let mut out = head;
   270	    for item in tail {
   271	        if !out.iter().any(|e| e.path == item.path) {
   272	            out.push(item);
   273	        }
   274	    }
   275	    out
   276	}
   277	
   278	pub fn top_dirs(files: &[IndexedFile], cap: usize) -> Vec<PathBuf> {
   279	    use std::collections::HashMap;
   280	    let mut best: HashMap<String, u64> = HashMap::new();
   281	    for f in files {
   282	        let parent = Path::new(&f.path)
   283	            .parent()
   284	            .map(|p| p.to_string_lossy().to_string())
   285	            .unwrap_or_else(|| "/".into());
   286	        let e = best.entry(parent).or_insert(0);
   287	        if f.mtime > *e {
   288	            *e = f.mtime;
   289	        }
   290	    }
   291	    let mut dirs: Vec<(u64, String)> = best.into_iter().map(|(p, t)| (t, p)).collect();
   292	    dirs.sort_by(|a, b| b.0.cmp(&a.0));
   293	    dirs.into_iter()
   294	        .take(cap)
   295	        .map(|(_, p)| PathBuf::from(p))
   296	        .collect()
   297	}
   298	
   299	pub fn rescan_dir(dir: &Path, extra: &[String]) -> Vec<IndexedFile> {
   300	    let mut out = Vec::new();
   301	    let rd = match fs::read_dir(dir) {
   302	        Ok(r) => r,
   303	        Err(_) => return out,
   304	    };
   305	    for ent in rd.flatten() {
   306	        let p = ent.path();
   307	        if p.is_dir() && exclude::should_skip_dir(&p, extra, dir) {
   308	            continue;
   309	        }
   310	        if p.is_file() && exclude::should_skip_file(&p) {
   311	            continue;
   312	        }
   313	        if let Some(rec) = IndexedFile::from_path(&p) {
   314	            out.push(rec);
   315	        }
   316	    }
   317	    out
   318	}
