   346	def hex_dump(data: bytes) -> str:
   347	    hex_lines = []
   348	    for i in range(0, len(data), 16):
   349	        chunk = data[i : i + 16]
   350	        hx = " ".join(f"{b:02x}" for b in chunk)
   351	        asc = "".join(chr(b) if 32 <= b < 127 else "." for b in chunk)
   352	        hex_lines.append(f"{i:08x}  {hx:<48} {asc}")
   353	    return "\n".join(hex_lines) or "(empty)"
