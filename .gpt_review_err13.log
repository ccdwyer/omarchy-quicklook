    29	pub fn render(
    30	    path: &Path,
    31	    page: u32,
    32	    theme: &Theme,
    33	    _palette: &Palette,
    34	    cache: &PreviewCache,
    35	    ffmpeg: bool,
    36	    poppler: bool,
    37	) -> Preview {
    38	    let page = page.max(1);
    39	    let meta = fs::metadata(path).ok();
    40	    let is_dir = meta.as_ref().map(|m| m.is_dir()).unwrap_or(false);
    41	    let kind = kind_of(path, is_dir);
    42	    let result = with_timeout(2000, {
    43	        let path = path.to_path_buf();
    44	        let theme = theme.clone();
    45	        let cache_dir = cache.dir.clone();
    46	        let budget = cache.budget();
    47	        move || {
    48	            let cache = PreviewCache::new(cache_dir, budget);
    49	            match kind {
    50	                Kind::Dir => preview_dir(&path),
    51	                Kind::Image => preview_image(&path, &cache),
    52	                Kind::Code => preview_code(&path, &theme),
    53	                Kind::Csv => preview_csv(&path),
    54	                Kind::Pdf => preview_pdf(&path, page, &cache, poppler),
    55	                Kind::Video => preview_video(&path, &cache, ffmpeg),
    56	                Kind::Hex => preview_hex(&path),
    57	            }
    58	        }
    59	    });
    60	    match result {
    61	        Ok(p) => p,
    62	        Err(e) => {
    63	            let mut p = preview_hex(path);
    64	            p.label = Some(e);
    65	            p
    66	        }
    67	    }
    68	}
