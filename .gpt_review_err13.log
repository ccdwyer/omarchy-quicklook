   170	def kind_of(path: Path, is_dir: bool = False) -> str:
   171	    if is_dir or path.is_dir():
   172	        return "dir"
   173	    ext = path.suffix.lower().lstrip(".")
   174	    name = path.name.lower()
   175	    if name in ("makefile", "dockerfile"):
   176	        return "code"
   177	    if ext in ("png", "jpg", "jpeg", "webp", "svg", "gif", "bmp", "ico"):
   178	        return "image"
   179	    if ext == "pdf":
   180	        return "pdf"
   181	    if ext in ("csv", "tsv"):
   182	        return "csv"
   183	    if ext in ("mp4", "webm", "mkv", "mov", "avi"):
   184	        return "video"
   185	    if ext in (
   186	        "rs", "js", "ts", "py", "go", "c", "h", "cpp", "java", "kt", "rb", "php",
   187	        "sh", "lua", "qml", "json", "yaml", "yml", "toml", "md", "html", "css",
   188	        "xml", "sql", "swift", "txt", "conf", "ini",
   189	    ):
   190	        return "code"
   191	    return "hex"
