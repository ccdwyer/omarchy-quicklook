     8	function keyIsPeriod(key) {
     9	  var k = String(key || "").toLowerCase()
    10	  return k === "period" || k === "."
    11	}
    12	
    13	function hasBit(mask, bit) {
    14	  return (Number(mask) & bit) === bit
    15	}
    16	
    17	function isSuperPeriod(bind) {
    18	  if (!bind || typeof bind !== "object")
    19	    return false
    20	  if (!keyIsPeriod(bind.key))
    21	    return false
    22	  var mask = Number(bind.modmask)
    23	  if (isNaN(mask))
    24	    return false
    25	  if (!hasBit(mask, SUPER))
    26	    return false
    27	  if (hasBit(mask, SHIFT) || hasBit(mask, CTRL) || hasBit(mask, ALT))
    28	    return false
    29	  return true
    30	}
    31	
    32	function parseBinds(jsonText) {
    33	  var s = String(jsonText || "").trim()
    34	  if (!s.length)
    35	    return []
    36	  try {
    37	    var arr = JSON.parse(s)
    38	    if (arr && typeof arr.length === "number")
    39	      return arr
    40	  } catch (e) {}
    41	  return []
    42	}
    43	
    44	function superPeriodBound(jsonText) {
    45	  var binds = parseBinds(jsonText)
    46	  for (var i = 0; i < binds.length; i++) {
    47	    if (isSuperPeriod(binds[i]))
    48	      return true
    49	  }
    50	  return false
    51	}
