   102	def apply_settings(data: dict, persist: bool = True) -> None:
   103	    if not isinstance(data, dict):
   104	        return
   105	    if data.get("roots") is not None:
   106	        roots = data["roots"]
   107	        if isinstance(roots, str):
   108	            roots = [r.strip() for r in roots.split(",") if r.strip()]
   109	        SETTINGS["roots"] = [_expand(str(r)) for r in roots] or [str(HOME)]
   110	    if data.get("extraExclude") is not None:
   111	        extra = data["extraExclude"]
   112	        if isinstance(extra, str):
   113	            extra = [x.strip() for x in extra.split(",") if x.strip()]
   114	        SETTINGS["extraExclude"] = [str(x) for x in extra]
   115	    if data.get("watchCap") is not None:
   116	        SETTINGS["watchCap"] = max(16, int(data["watchCap"] or 2000))
   117	    if data.get("cacheMb") is not None:
   118	        SETTINGS["cacheMb"] = max(16, int(data["cacheMb"] or 500))
   119	    if data.get("maxFiles") is not None:
   120	        SETTINGS["maxFiles"] = max(1000, int(data["maxFiles"] or 500000))
   121	    if persist:
   122	        try:
   123	            STATE.mkdir(parents=True, exist_ok=True)
   124	            SETTINGS_PATH.write_text(json.dumps(SETTINGS))
   125	        except OSError:
   126	            pass
