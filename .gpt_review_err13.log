   250	def _hits_from_paths(paths: list[str], q: str, cap: int) -> list[dict]:
   251	    extra = list(SETTINGS["extraExclude"])
   252	    out: list[dict] = []
   253	    for line in paths:
   254	        p = Path(line)
   255	        if should_skip_result(p, extra):
   256	            continue
   257	        try:
   258	            st = p.stat()
   259	        except OSError:
   260	            continue
   261	        out.append(
   262	            {
   263	                "path": str(p),
   264	                "name": p.name,
   265	                "kind": kind_of(p, p.is_dir()),
   266	                "score": fuzzy(p.name, q),
   267	                "mtime": int(st.st_mtime * 1000),
   268	                "size": st.st_size,
   269	            }
   270	        )
   271	        if len(out) >= cap:
   272	            break
   273	    return out
