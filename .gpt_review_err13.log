   305	    #[cfg(unix)]
   306	    #[test]
   307	    fn run_limited_kills_term_ignoring_descendant() {
   308	        // Parent ignores TERM and spawns a TERM-ignoring descendant that writes
   309	        // its pid to a marker file, then both sleep well past the timeout. After
   310	        // run_limited returns, a group SIGKILL must have reaped the descendant.
   311	        let marker = std::env::temp_dir().join(format!("ql_desc_{}", std::process::id()));
   312	        let _ = std::fs::remove_file(&marker);
   313	        let script = format!(
   314	            "trap '' TERM; ( trap '' TERM; echo $$ > '{m}'; sleep 30 ) & sleep 30",
   315	            m = marker.display()
   316	        );
   317	        let mut cmd = Command::new("sh");
   318	        cmd.arg("-c").arg(&script);
   319	        let start = Instant::now();
   320	        let r = run_limited(cmd, Duration::from_millis(400), 128 * 1024 * 1024, 4);
   321	        assert!(r.is_err());
   322	        assert!(start.elapsed() < Duration::from_secs(3));
   323	        // Give the group KILL a moment to take effect, then confirm the
   324	        // descendant pid recorded in the marker is gone.
   325	        thread::sleep(Duration::from_millis(200));
   326	        if let Ok(txt) = std::fs::read_to_string(&marker) {
   327	            if let Ok(desc) = txt.trim().parse::<i32>() {
   328	                // kill(pid, 0) returns -1/ESRCH when the process no longer exists.
   329	                let alive = unsafe { libc::kill(desc, 0) } == 0;
   330	                assert!(!alive, "TERM-ignoring descendant {desc} survived group kill");
   331	            }
   332	        }
   333	        let _ = std::fs::remove_file(&marker);
   334	    }
   335	
   336	    #[cfg(unix)]
   337	    #[test]
   338	    fn run_limited_early_leader_exit_does_not_hang() {
   339	        // The regression this guards: the group LEADER exits cleanly and
   340	        // immediately, but a TERM-ignoring descendant it spawned inherits
   341	        // stdout/stderr and keeps them open. The old code sent only TERM on the
   342	        // normal-exit path and then joined the drain threads, which hung forever
   343	        // because the descendant ignored TERM and never closed the pipes. The
   344	        // fix must group-KILL before joining so this returns promptly.
   345	        let marker = std::env::temp_dir().join(format!("ql_early_{}", std::process::id()));
   346	        let _ = std::fs::remove_file(&marker);
   347	        // Descendant: its own sh (so `$$` is its real pid), ignores TERM, keeps
   348	        // stdout open in an infinite loop — only SIGKILL ends it. Leader spawns
   349	        // it in the background, then exits 0 at once.
   350	        let script = format!(
   351	            "sh -c 'trap \"\" TERM; echo $$ > \"{m}\"; while true; do sleep 1; done' & exit 0",
   352	            m = marker.display()
   353	        );
   354	        let mut cmd = Command::new("sh");
   355	        cmd.arg("-c").arg(&script);
   356	        let start = Instant::now();
   357	        // Generous timeout: if the fix is wrong the drain join hangs and this
   358	        // never returns, so completing far under the timeout proves the fix.
   359	        let r = run_limited(cmd, Duration::from_secs(20), 128 * 1024 * 1024, 30);
   360	        let elapsed = start.elapsed();
   361	        assert!(
   362	            elapsed < Duration::from_secs(3),
   363	            "early-leader-exit hung on the drain join: {elapsed:?}"
   364	        );
   365	        // Leader exited 0, so run_limited returns Ok with the leader's status.
   366	        assert!(r.is_ok(), "expected Ok on clean leader exit, got {r:?}");
   367	        // The TERM-ignoring descendant must have been reaped by the group KILL.
   368	        thread::sleep(Duration::from_millis(200));
   369	        if let Ok(txt) = std::fs::read_to_string(&marker) {
   370	            if let Ok(desc) = txt.trim().parse::<i32>() {
   371	                let alive = unsafe { libc::kill(desc, 0) } == 0;
   372	                assert!(
   373	                    !alive,
   374	                    "TERM-ignoring descendant {desc} survived after early leader exit"
   375	                );
   376	            }
   377	        }
   378	        let _ = std::fs::remove_file(&marker);
   379	    }
