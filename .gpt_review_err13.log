    13	
    14	impl Kind {
    15	    pub fn as_str(self) -> &'static str {
    16	        match self {
    17	            Kind::Image => "image",
    18	            Kind::Pdf => "pdf",
    19	            Kind::Csv => "csv",
    20	            Kind::Code => "code",
    21	            Kind::Dir => "dir",
    22	            Kind::Video => "video",
    23	            Kind::Hex => "hex",
    24	        }
    25	    }
