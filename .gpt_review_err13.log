     1	use std::io;
     2	use std::io::Read;
     3	use std::path::Path;
     4	use std::process::{Command, ExitStatus, Output, Stdio};
     5	use std::sync::atomic::{AtomicU32, Ordering};
     6	use std::sync::mpsc;
     7	use std::sync::Mutex;
     8	use std::thread;
     9	use std::time::{Duration, Instant};
    10	
    11	/// Hard cap on captured stdout/stderr from any child subprocess. Excess is
    12	/// drained and discarded so a flooding child can neither exhaust memory nor
    13	/// deadlock on a full pipe.
    14	pub const OUTPUT_CAP: usize = 96 * 1024;
    15	
    16	static PARSE_THREADS: AtomicU32 = AtomicU32::new(0);
    17	static LIVE_THREADS: AtomicU32 = AtomicU32::new(0);
    18	const MAX_PARSE_THREADS: u32 = 2;
    19	const MAX_LIVE_THREADS: u32 = 16;
    20	
    21	pub fn with_timeout<T, F>(ms: u64, f: F) -> Result<T, String>
    22	where
    23	    T: Send + 'static,
    24	    F: FnOnce() -> T + Send + 'static,
    25	{
    26	    let live = LIVE_THREADS.fetch_add(1, Ordering::SeqCst);
    27	    if live >= MAX_LIVE_THREADS {
    28	        LIVE_THREADS.fetch_sub(1, Ordering::SeqCst);
    29	        return Err("parser busy".into());
    30	    }
    31	    loop {
    32	        let n = PARSE_THREADS.load(Ordering::SeqCst);
    33	        if n >= MAX_PARSE_THREADS {
    34	            LIVE_THREADS.fetch_sub(1, Ordering::SeqCst);
    35	            return Err("parser busy".into());
    36	        }
    37	        if PARSE_THREADS
    38	            .compare_exchange(n, n + 1, Ordering::SeqCst, Ordering::SeqCst)
    39	            .is_ok()
    40	        {
    41	            break;
    42	        }
    43	    }
    44	    let released = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
    45	    let released_t = released.clone();
    46	    let (tx, rx) = mpsc::channel();
    47	    thread::spawn(move || {
    48	        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));
    49	        if !released_t.swap(true, Ordering::SeqCst) {
    50	            PARSE_THREADS.fetch_sub(1, Ordering::SeqCst);
    51	        }
    52	        LIVE_THREADS.fetch_sub(1, Ordering::SeqCst);
    53	        let _ = tx.send(result);
    54	    });
    55	    match rx.recv_timeout(Duration::from_millis(ms)) {
    56	        Ok(Ok(v)) => Ok(v),
    57	        Ok(Err(_)) => Err("parser panicked".into()),
    58	        Err(_) => {
    59	            if !released.swap(true, Ordering::SeqCst) {
    60	                PARSE_THREADS.fetch_sub(1, Ordering::SeqCst);
    61	            }
    62	            Err("timeout".into())
    63	        }
    64	    }
    65	}
    66	
    67	/// Read `src` to EOF, retaining at most `OUTPUT_CAP` bytes and discarding the
    68	/// rest. Keeps draining after the cap so the writer never blocks on a full pipe.
    69	fn spawn_capped_reader<R: Read + Send + 'static>(mut src: R) -> thread::JoinHandle<Vec<u8>> {
    70	    thread::spawn(move || {
    71	        let mut kept: Vec<u8> = Vec::new();
    72	        let mut chunk = [0u8; 16 * 1024];
    73	        loop {
    74	            match src.read(&mut chunk) {
    75	                Ok(0) => break,
    76	                Ok(n) => {
    77	                    if kept.len() < OUTPUT_CAP {
    78	                        let room = OUTPUT_CAP - kept.len();
    79	                        kept.extend_from_slice(&chunk[..n.min(room)]);
    80	                    }
    81	                    // Bytes beyond the cap are read and dropped so the child's
    82	                    // write() never blocks on a full pipe buffer.
    83	                }
    84	                Err(_) => break,
    85	            }
    86	        }
    87	        kept
    88	    })
    89	}
    90	
    91	#[cfg(unix)]
    92	fn signal_group(pid: u32, sig: libc::c_int) {
    93	    // Child is its own process-group leader (pgid == pid) via process_group(0),
    94	    // so a negative pid signals the whole group, reaping descendants too.
    95	    unsafe {
    96	        libc::kill(-(pid as i32), sig);
    97	    }
    98	}
    99	#[cfg(not(unix))]
   100	fn signal_group(_pid: u32, _sig: i32) {}
   101	
   102	/// True if the process group `pid` still has at least one signalable member.
   103	/// `kill(-pgid, 0)` returns 0 when the group exists with a member and -1/ESRCH
   104	/// when it is empty. Once the leader has exited, this is true iff a descendant
   105	/// is still alive in the group (and may be holding the child's pipes open).
   106	#[cfg(unix)]
   107	fn group_has_members(pid: u32) -> bool {
   108	    unsafe { libc::kill(-(pid as i32), 0) == 0 }
   109	}
   110	
   111	/// Force the whole process group down before we join the drain threads: TERM,
   112	/// a brief grace, then an unconditional KILL. SIGKILL is uncatchable, so any
   113	/// TERM-ignoring descendant is guaranteed dead afterward — which closes the
   114	/// child's stdout/stderr and lets the drain joins complete instead of hanging.
   115	#[cfg(unix)]
   116	fn reap_group(pid: u32) {
   117	    signal_group(pid, libc::SIGTERM);
   118	    thread::sleep(Duration::from_millis(50));
   119	    signal_group(pid, libc::SIGKILL);
   120	}
   121	#[cfg(not(unix))]
   122	fn reap_group(_pid: u32) {}
   123	
   124	/// Spawn `cmd` in its own process group, drain its output under a hard cap, and
   125	/// enforce a wall-clock timeout with a group TERM-then-KILL so no descendant
   126	/// outlives the deadline. Never buffers more than `OUTPUT_CAP` of output.
   127	pub fn run_limited(mut cmd: Command, timeout: Duration, mem_bytes: u64, cpu_secs: u64) -> io::Result<Output> {
   128	    apply_rlimits(&mut cmd, mem_bytes, cpu_secs);
   129	    cmd.stdin(Stdio::null());
   130	    cmd.stdout(Stdio::piped());
   131	    cmd.stderr(Stdio::piped());
   132	    #[cfg(unix)]
   133	    {
   134	        use std::os::unix::process::CommandExt;
   135	        // New process group with pgid == child pid; lets us kill the whole tree.
   136	        cmd.process_group(0);
   137	    }
   138	    let mut child = cmd.spawn()?;
   139	    let pid = child.id();
   140	    let out_h = child.stdout.take().map(spawn_capped_reader);
   141	    let err_h = child.stderr.take().map(spawn_capped_reader);
   142	
   143	    let collect = |h: Option<thread::JoinHandle<Vec<u8>>>| -> Vec<u8> {
   144	        h.map(|j| j.join().unwrap_or_default()).unwrap_or_default()
   145	    };
   146	
   147	    let start = Instant::now();
   148	    loop {
   149	        match child.try_wait()? {
   150	            Some(status) => {
   151	                // The leader exited. A descendant still in the group may hold the
   152	                // child's stdout/stderr open, which would hang the drain joins
   153	                // below forever. If the group is non-empty, force it down (TERM,
   154	                // grace, unconditional KILL) *before* joining so the pipes are
   155	                // guaranteed closed. The common clean-exit case leaves the group
   156	                // empty, so a well-behaved tool returns with no added latency.
   157	                #[cfg(unix)]
   158	                if group_has_members(pid) {
   159	                    reap_group(pid);
   160	                }
   161	                let stdout = collect(out_h);
   162	                let stderr = collect(err_h);
   163	                return Ok(build_output(status, stdout, stderr));
   164	            }
   165	            None => {
   166	                if start.elapsed() >= timeout {
   167	                    // Timed out: TERM, grace, unconditional group KILL, reap the
   168	                    // leader, then join the (now-closed) drains.
   169	                    reap_group(pid);
   170	                    let _ = child.wait();
   171	                    let _ = collect(out_h);
   172	                    let _ = collect(err_h);
   173	                    return Err(io::Error::new(io::ErrorKind::TimedOut, "killed"));
   174	                }
   175	                thread::sleep(Duration::from_millis(20));
   176	            }
   177	        }
   178	    }
   179	}
   180	
   181	fn build_output(status: ExitStatus, stdout: Vec<u8>, stderr: Vec<u8>) -> Output {
   182	    Output {
   183	        status,
   184	        stdout,
   185	        stderr,
   186	    }
   187	}
   188	
   189	fn apply_rlimits(cmd: &mut Command, mem_bytes: u64, cpu_secs: u64) {
   190	    #[cfg(unix)]
   191	    {
   192	        use std::os::unix::process::CommandExt;
   193	        let mem = mem_bytes;
   194	        let cpu = cpu_secs;
   195	        unsafe {
   196	            cmd.pre_exec(move || {
   197	                // RLIMIT_AS is applied on Linux only: on macOS a low
   198	                // address-space cap makes dyld fail to map shared libraries and
   199	                // exec aborts, so it is unusable there. Linux enforces it
   200	                // cleanly, bounding a hostile renderer's memory.
   201	                #[cfg(target_os = "linux")]
   202	                {
   203	                    let as_lim = libc::rlimit {
   204	                        rlim_cur: mem,
   205	                        rlim_max: mem,
   206	                    };
   207	                    libc::setrlimit(libc::RLIMIT_AS, &as_lim);
   208	                }
   209	                #[cfg(not(target_os = "linux"))]
   210	                let _ = mem;
   211	                let cpu_lim = libc::rlimit {
   212	                    rlim_cur: cpu,
   213	                    rlim_max: cpu,
   214	                };
   215	                libc::setrlimit(libc::RLIMIT_CPU, &cpu_lim);
   216	                // RLIMIT_NPROC is intentionally NOT set: it counts the real
   217	                // user's entire existing process table, so any absolute cap
   218	                // makes fork/pthread_create fail (EAGAIN) for a normally-busy
   219	                // user — which would break threaded tools like pdftoppm. Fork
   220	                // bombs are bounded by RLIMIT_CPU plus the wall-clock group
   221	                // TERM-then-KILL in run_limited.
   222	                Ok(())
   223	            });
   224	        }
   225	    }
   226	    #[cfg(not(unix))]
   227	    {
   228	        let _ = (cmd, mem_bytes, cpu_secs);
   229	    }
   230	}
   231	
   232	pub fn which(name: &str) -> Option<std::path::PathBuf> {
   233	    let path = std::env::var_os("PATH")?;
   234	    for dir in std::env::split_paths(&path) {
   235	        let candidate = dir.join(name);
   236	        if candidate.is_file() {
   237	            return Some(candidate);
   238	        }
   239	    }
   240	    None
   241	}
   242	
   243	pub fn file_exists(path: &Path) -> bool {
   244	    path.is_file()
   245	}
   246	
   247	/// Serialize tests that mutate process-wide `PATH`. Restores PATH on unwind.
   248	pub fn with_path_lock<R, F: FnOnce() -> R>(f: F) -> R {
   249	    static LOCK: Mutex<()> = Mutex::new(());
   250	    let _g = LOCK.lock().unwrap_or_else(|e| e.into_inner());
   251	    let old = std::env::var("PATH").unwrap_or_default();
   252	    struct Restore(String);
   253	    impl Drop for Restore {
   254	        fn drop(&mut self) {
   255	            std::env::set_var("PATH", &self.0);
   256	        }
   257	    }
   258	    let _restore = Restore(old);
   259	    f()
   260	}
