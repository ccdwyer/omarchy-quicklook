   291	        // it unboundedly (OOM) or block on the full pipe; the capped drain must
   292	        // keep memory bounded and the timeout must still fire promptly.
   293	        let mut cmd = Command::new("sh");
   294	        cmd.arg("-c").arg("yes ABCDEFGHIJKLMNOP");
   295	        let start = Instant::now();
