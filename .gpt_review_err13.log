    14	#[derive(Clone, Debug)]
    15	pub struct IndexedFile {
    16	    pub path: String,
    17	    pub name: String,
    18	    pub mtime: u64,
    19	    pub size: u64,
    20	    pub kind: String,
    21	    pub is_dir: bool,
