   933	def status() -> dict:
   934	    return {
   935	        "indexing": False,
   936	        "progress": 1.0,
   937	        "backend": "compat",
   938	        "files": 5,
   939	        "watchCount": 0,
   940	        "watchCap": SETTINGS["watchCap"],
   941	        "roots": list(SETTINGS["roots"]),
   942	        "cacheBytes": 0,
   943	        "cacheBudget": SETTINGS["cacheMb"] * 1024 * 1024,
   944	        "poppler": shutil.which("pdftoppm") is not None,
   945	        "plocate": shutil.which("plocate") is not None or shutil.which("locate") is not None,
   946	        "ffmpeg": shutil.which("ffmpeg") is not None,
   947	        "helper": "compat",
   948	        "version": "1.0.0",
   949	    }
