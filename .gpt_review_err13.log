   642	def fit_megapixels(w: int, h: int, cap: int = MEGAPIXELS) -> tuple[int, int]:
   643	    pixels = max(1, w * h)
   644	    if pixels <= cap:
   645	        return max(1, w), max(1, h)
   646	    scale = (cap / pixels) ** 0.5
   647	    return max(1, int(w * scale)), max(1, int(h * scale))
   648	
   649	
   650	def downsample_image(path: Path, w: int, h: int) -> dict | None:
   651	    nw, nh = fit_megapixels(w, h)
   652	    cache_dir = CACHE / "previews"
   653	    try:
   654	        cache_dir.mkdir(parents=True, exist_ok=True)
   655	    except OSError:
   656	        cache_dir = Path("/tmp") / "quicklook-previews"
   657	        cache_dir.mkdir(parents=True, exist_ok=True)
   658	    dest = cache_dir / f"ds-{abs(hash((str(path), w, h, nw, nh)))}.png"
   659	    if dest.is_file() and dest.stat().st_size > 0:
   660	        return {
   661	            "kind": "image",
   662	            "path": str(dest),
   663	            "width": nw,
   664	            "height": nh,
   665	            "label": "downsampled",
