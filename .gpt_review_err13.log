     1	use crate::limits::{run_limited, which};
     2	use std::path::Path;
     3	use std::process::Command;
     4	use std::time::Duration;
     5	
     6	pub fn open_path(path: &Path) -> Result<(), String> {
     7	    if !path.exists() {
     8	        return Err("missing".into());
     9	    }
    10	    let target = path.to_string_lossy().to_string();
    11	    if let Some(gio) = which("gio") {
    12	        let mut cmd = Command::new(gio);
    13	        cmd.args(["open", &target]);
    14	        return run_limited(cmd, Duration::from_secs(8), 128 * 1024 * 1024, 4)
    15	            .map(|_| ())
    16	            .map_err(|e| e.to_string());
    17	    }
    18	    if let Some(xdg) = which("xdg-open") {
    19	        let mut cmd = Command::new(xdg);
    20	        cmd.arg(&target);
    21	        return run_limited(cmd, Duration::from_secs(8), 128 * 1024 * 1024, 4)
    22	            .map(|_| ())
    23	            .map_err(|e| e.to_string());
    24	    }
    25	    if let Some(open) = which("open") {
    26	        let mut cmd = Command::new(open);
    27	        cmd.arg(&target);
    28	        return run_limited(cmd, Duration::from_secs(8), 128 * 1024 * 1024, 4)
    29	            .map(|_| ())
    30	            .map_err(|e| e.to_string());
    31	    }
    32	    Err("no opener".into())
    33	}
    34	
    35	pub fn reveal_path(path: &Path) -> Result<(), String> {
    36	    let parent = if path.is_dir() {
    37	        path
    38	    } else {
    39	        path.parent().unwrap_or(path)
    40	    };
    41	    open_path(parent)
    42	}
