   368	def _limit_child() -> None:
   369	    try:
   370	        import resource
   371	    except ImportError:
   372	        return
   373	    limits = [
   374	        ("RLIMIT_CPU", 8),
   375	        ("RLIMIT_FSIZE", 32 * 1024 * 1024),
   376	    ]
   377	    # NOTE: RLIMIT_NPROC is deliberately NOT set. It counts the real user's
   378	    # entire existing process table, so any absolute cap makes exec/fork fail on
   379	    # a normally-busy machine. Fork bombs are instead bounded by the wall-clock
   380	    # group TERM-then-KILL in run_killable plus RLIMIT_CPU.
   381	    #
   382	    # RLIMIT_AS is applied on Linux only (matching the Rust helper). On
   383	    # macOS/Darwin the dynamic linker reserves a huge virtual-address range and
   384	    # a 512 MiB cap makes exec fail outright; other platforms are left to the
   385	    # CPU + wall-clock group kill. Cap address space only where it behaves.
   386	    if sys.platform.startswith("linux"):
   387	        limits.insert(1, ("RLIMIT_AS", 512 * 1024 * 1024))
   388	    for name, soft in limits:
   389	        lim = getattr(resource, name, None)
   390	        if lim is None:
   391	            continue
   392	        try:
   393	            resource.setrlimit(lim, (soft, soft))
   394	        except (ValueError, OSError):
   395	            pass
   396	
   397	
   398	def _kill_group(proc: subprocess.Popen, pgid: int | None = None) -> None:
   399	    gid = pgid if pgid is not None else proc.pid
   400	    try:
   401	        os.killpg(gid, signal.SIGTERM)
   402	    except OSError:
   403	        try:
   404	            proc.terminate()
   405	        except OSError:
   406	            pass
   407	    try:
   408	        proc.wait(timeout=1)
   409	    except (subprocess.TimeoutExpired, OSError):
   410	        pass
   411	    # Always SIGKILL the recorded group, even if the leader already exited.
   412	    try:
   413	        os.killpg(gid, signal.SIGKILL)
   414	    except OSError:
   415	        try:
   416	            proc.kill()
   417	        except OSError:
   418	            pass
   419	    try:
   420	        proc.wait(timeout=1)
   421	    except (subprocess.TimeoutExpired, OSError):
   422	        pass
   423	
   424	
   425	def _group_has_members(pgid: int) -> bool:
   426	    """True if process group `pgid` still has at least one signalable member.
   427	
   428	    `killpg(pgid, 0)` is a permission/existence probe: it succeeds when the
   429	    group exists with a member and raises ProcessLookupError when it is empty.
   430	    After the leader has exited this is true iff a descendant is still alive in
   431	    the group (and may be holding the child's stdout/stderr open).
   432	    """
   433	    try:
   434	        os.killpg(pgid, 0)
   435	        return True
   436	    except ProcessLookupError:
   437	        return False
   438	    except OSError:
   439	        # EPERM or similar: something is there we can't probe cleanly — assume
   440	        # a member exists so the caller reaps the group rather than hanging.
   441	        return True
   442	
   443	
   444	def _drain_capped(stream, sink: dict, key: str) -> None:
   445	    """Read `stream` to EOF, keeping at most OUTPUT_CAP bytes in sink[key] and
   446	    discarding the rest so the writer never blocks on a full pipe."""
   447	    kept = bytearray()
   448	    try:
   449	        while True:
   450	            chunk = stream.read(65536)
   451	            if not chunk:
   452	                break
   453	            if len(kept) < OUTPUT_CAP:
   454	                room = OUTPUT_CAP - len(kept)
   455	                kept.extend(chunk[:room])
   456	            # bytes past the cap are read and dropped
   457	    except OSError:
   458	        pass
   459	    finally:
   460	        try:
   461	            stream.close()
   462	        except OSError:
   463	            pass
   464	    sink[key] = bytes(kept)
   465	
   466	
   467	def run_killable(
   468	    argv: list[str],
   469	    timeout_s: float = 8,
   470	    capture_output: bool = False,
   471	    text: bool = False,
   472	    limits: bool = True,
   473	) -> subprocess.CompletedProcess:
   474	    """Spawn in a new session and kill the whole process group on timeout.
   475	
   476	    Output is drained concurrently under a hard OUTPUT_CAP so a flooding child
   477	    cannot exhaust memory or deadlock on a full pipe. When `limits` is set, the
   478	    child MUST become its own session leader; if setsid() fails the child exits
   479	    without exec-ing, so we never run untrusted code without a group guarantee.
   480	    """
   481	    stdout = subprocess.PIPE if capture_output else subprocess.DEVNULL
   482	    stderr = subprocess.PIPE if capture_output else subprocess.DEVNULL
   483	
   484	    if limits:
   485	        def preexec() -> None:
   486	            try:
   487	                os.setsid()
   488	            except OSError:
   489	                # Cannot establish the process-group guarantee — do NOT exec the
   490	                # untrusted command. Exit so the parent sees a failed run and
   491	                # skips the path-consuming feature rather than running unbounded.
   492	                os._exit(127)
   493	            _limit_child()
   494	
   495	        extra = {"preexec_fn": preexec}
   496	    else:
   497	        extra = {"start_new_session": True}
   498	
   499	    proc = subprocess.Popen(
   500	        argv,
   501	        stdout=stdout,
   502	        stderr=stderr,
   503	        **extra,
   504	    )
   505	    pgid = proc.pid
   506	
   507	    sink: dict = {}
   508	    drains: list[threading.Thread] = []
   509	    if capture_output:
   510	        if proc.stdout is not None:
   511	            t = threading.Thread(target=_drain_capped, args=(proc.stdout, sink, "out"), daemon=True)
   512	            t.start()
   513	            drains.append(t)
   514	        if proc.stderr is not None:
   515	            t = threading.Thread(target=_drain_capped, args=(proc.stderr, sink, "err"), daemon=True)
   516	            t.start()
   517	            drains.append(t)
   518	
   519	    timed_out = False
   520	    try:
   521	        proc.wait(timeout=timeout_s)
   522	    except subprocess.TimeoutExpired:
   523	        timed_out = True
   524	        _kill_group(proc, pgid)
   525	
   526	    # The leader has now exited (cleanly or via the timeout kill above). A
   527	    # descendant may still be in the group holding stdout/stderr open, which
   528	    # would make the drain joins below hang and leak the descendant + threads.
   529	    # On the clean-exit path _kill_group has NOT run, so force the group down
   530	    # here whenever it is non-empty (TERM, grace, unconditional KILL) before
   531	    # joining. Skipped when the group is already empty — the common clean case —
   532	    # so a well-behaved tool returns with no added latency.
   533	    if not timed_out and _group_has_members(pgid):
   534	        _kill_group(proc, pgid)
   535	
   536	    # The group is guaranteed down, so every drain reaches EOF and joins
   537	    # promptly; the bounded join is a belt-and-suspenders backstop (the threads
   538	    # are daemons and can never wedge process exit).
   539	    for t in drains:
   540	        t.join(timeout=2)
   541	
   542	    out = sink.get("out", b"")
   543	    err = sink.get("err", b"")
   544	    if text:
   545	        enc = sys.getdefaultencoding()
   546	        out = out.decode(enc, errors="replace") if isinstance(out, (bytes, bytearray)) else (out or "")
   547	        err = err.decode(enc, errors="replace") if isinstance(err, (bytes, bytearray)) else (err or "")
   548	
   549	    if timed_out:
   550	        raise subprocess.TimeoutExpired(argv, timeout_s, output=out, stderr=err)
   551	    return subprocess.CompletedProcess(argv, proc.returncode, out, err)
   552	
