    40	impl AppConfig {
    41	    pub fn from_env_and_args(args: &[String]) -> Self {
    42	        let home = PathBuf::from(std::env::var("HOME").unwrap_or_else(|_| "/tmp".into()));
    43	        let cache_home = std::env::var("XDG_CACHE_HOME")
    44	            .map(PathBuf::from)
    45	            .unwrap_or_else(|_| home.join(".cache"));
    46	        let state_home = std::env::var("XDG_STATE_HOME")
    47	            .map(PathBuf::from)
    48	            .unwrap_or_else(|_| home.join(".local/state"));
    49	        let plugin_dir = std::env::var("QUICKLOOK_PLUGIN_DIR")
    50	            .map(PathBuf::from)
    51	            .unwrap_or_else(|_| PathBuf::from("."));
    52	        let mut cfg = Self {
    53	            roots: vec![home.clone()],
    54	            samples_dir: plugin_dir.join("samples"),
    55	            cache_dir: cache_home.join("quicklook"),
    56	            state_dir: state_home.join("quicklook"),
    57	            home,
    58	            watch_cap: 2000,
    59	            cache_bytes: 500 * 1024 * 1024,
    60	            max_files: 500_000,
    61	            extra_exclude: Vec::new(),
    62	        };
    63	        let mut i = 0;
    64	        while i < args.len() {
    65	            match args[i].as_str() {
    66	                "--plugin-dir" => {
    67	                    if let Some(v) = args.get(i + 1) {
    68	                        cfg.samples_dir = PathBuf::from(v).join("samples");
    69	                        i += 1;
    70	                    }
    71	                }
    72	                "--cache-dir" => {
    73	                    if let Some(v) = args.get(i + 1) {
    74	                        cfg.cache_dir = PathBuf::from(v);
    75	                        i += 1;
    76	                    }
    77	                }
    78	                "--state-dir" => {
    79	                    if let Some(v) = args.get(i + 1) {
    80	                        cfg.state_dir = PathBuf::from(v);
    81	                        i += 1;
    82	                    }
    83	                }
    84	                "--home" => {
    85	                    if let Some(v) = args.get(i + 1) {
    86	                        cfg.home = PathBuf::from(v);
    87	                        i += 1;
    88	                    }
    89	                }
    90	                "--watch-cap" => {
    91	                    if let Some(v) = args.get(i + 1) {
    92	                        cfg.watch_cap = v.parse().unwrap_or(cfg.watch_cap);
    93	                        i += 1;
    94	                    }
    95	                }
    96	                "--cache-mb" => {
    97	                    if let Some(v) = args.get(i + 1) {
    98	                        let mb: u64 = v.parse().unwrap_or(500);
    99	                        cfg.cache_bytes = mb.max(16) * 1024 * 1024;
   100	                        i += 1;
   101	                    }
   102	                }
   103	                "--max-files" => {
   104	                    if let Some(v) = args.get(i + 1) {
   105	                        cfg.max_files = v.parse().unwrap_or(cfg.max_files);
   106	                        i += 1;
   107	                    }
   108	                }
   109	                "--root" => {
   110	                    if let Some(v) = args.get(i + 1) {
   111	                        let p = expand_home(v, &cfg.home);
   112	                        if cfg.roots == [cfg.home.clone()] {
   113	                            cfg.roots.clear();
   114	                        }
   115	                        cfg.roots.push(p);
   116	                        i += 1;
   117	                    }
   118	                }
   119	                _ => {}
   120	            }
   121	            i += 1;
   122	        }
   123	        if let Ok(dir) = std::env::var("QUICKLOOK_PLUGIN_DIR") {
   124	            cfg.samples_dir = PathBuf::from(dir).join("samples");
   125	        }
   126	        cfg
   127	    }
   128	}
   129	
   130	fn expand_home(s: &str, home: &std::path::Path) -> PathBuf {
   131	    if s == "~" {
   132	        return home.to_path_buf();
   133	    }
   134	    if let Some(rest) = s.strip_prefix("~/") {
   135	        return home.join(rest);
   136	    }
   137	    PathBuf::from(s)
   138	}
