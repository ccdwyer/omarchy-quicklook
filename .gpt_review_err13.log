     1	use rusqlite::{params, Connection};
     2	use std::path::Path;
     3	use std::time::{SystemTime, UNIX_EPOCH};
     4	
     5	pub struct Frecency {
     6	    conn: Option<Connection>,
     7	}
     8	
     9	impl Frecency {
    10	    pub fn disabled() -> Self {
    11	        Self { conn: None }
    12	    }
    13	
    14	    pub fn open(path: &Path) -> Self {
    15	        match Self::try_open(path) {
    16	            Ok(store) => store,
    17	            Err(_) => Self::disabled(),
    18	        }
    19	    }
    20	
    21	    fn try_open(path: &Path) -> Result<Self, String> {
    22	        if let Some(parent) = path.parent() {
    23	            std::fs::create_dir_all(parent).map_err(|e| e.to_string())?;
    24	        }
    25	        let conn = Connection::open(path).map_err(|e| e.to_string())?;
    26	        conn.execute_batch(
    27	            "CREATE TABLE IF NOT EXISTS files (
    28	                path TEXT PRIMARY KEY,
    29	                name TEXT NOT NULL,
    30	                mtime INTEGER NOT NULL,
    31	                size INTEGER NOT NULL,
    32	                kind TEXT NOT NULL,
    33	                is_dir INTEGER NOT NULL
    34	             );
    35	             CREATE TABLE IF NOT EXISTS selects (
    36	                path TEXT PRIMARY KEY,
    37	                count INTEGER NOT NULL,
    38	                last_ms INTEGER NOT NULL
    39	             );
    40	             CREATE TABLE IF NOT EXISTS meta (
    41	                k TEXT PRIMARY KEY,
    42	                v TEXT NOT NULL
    43	             );",
    44	        )
    45	        .map_err(|e| e.to_string())?;
    46	        Ok(Self { conn: Some(conn) })
    47	    }
    48	
    49	    pub fn touch(&self, path: &str) -> Result<(), String> {
    50	        let Some(conn) = self.conn.as_ref() else {
    51	            return Ok(());
    52	        };
    53	        let now = now_ms();
    54	        conn
    55	            .execute(
    56	                "INSERT INTO selects(path, count, last_ms) VALUES (?1, 1, ?2)
    57	                 ON CONFLICT(path) DO UPDATE SET count = count + 1, last_ms = ?2",
    58	                params![path, now as i64],
    59	            )
    60	            .map_err(|e| e.to_string())?;
    61	        Ok(())
    62	    }
    63	
    64	    pub fn boost(&self, path: &str) -> i64 {
    65	        let Some(conn) = self.conn.as_ref() else {
    66	            return 0;
    67	        };
    68	        let row = conn.query_row(
    69	            "SELECT count, last_ms FROM selects WHERE path = ?1",
    70	            params![path],
    71	            |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?)),
    72	        );
    73	        let (count, last) = match row {
    74	            Ok(v) => v,
    75	            Err(_) => return 0,
    76	        };
    77	        let freq = log2_boost(count);
    78	        let recency = recency_boost(last as u64, now_ms());
    79	        freq + recency
    80	    }
    81	
    82	    pub fn recent(&self, limit: usize) -> Vec<String> {
    83	        let Some(conn) = self.conn.as_ref() else {
    84	            return Vec::new();
    85	        };
    86	        let mut stmt = match conn
    87	            .prepare("SELECT path FROM selects ORDER BY last_ms DESC LIMIT ?1")
    88	        {
    89	            Ok(s) => s,
    90	            Err(_) => return Vec::new(),
    91	        };
    92	        let rows = stmt.query_map(params![limit as i64], |r| r.get::<_, String>(0));
    93	        match rows {
    94	            Ok(iter) => iter.flatten().collect(),
    95	            Err(_) => Vec::new(),
    96	        }
    97	    }
    98	
    99	    pub fn replace_files(&self, files: &[crate::search::IndexedFile]) -> Result<(), String> {
   100	        let Some(conn) = self.conn.as_ref() else {
   101	            return Ok(());
   102	        };
   103	        let tx = conn.unchecked_transaction().map_err(|e| e.to_string())?;
   104	        tx.execute("DELETE FROM files", []).map_err(|e| e.to_string())?;
   105	        {
   106	            let mut stmt = tx
   107	                .prepare("INSERT INTO files(path, name, mtime, size, kind, is_dir) VALUES (?1,?2,?3,?4,?5,?6)")
   108	                .map_err(|e| e.to_string())?;
   109	            for f in files {
   110	                stmt.execute(params![
   111	                    f.path,
   112	                    f.name,
   113	                    f.mtime as i64,
   114	                    f.size as i64,
   115	                    f.kind,
   116	                    if f.is_dir { 1 } else { 0 }
   117	                ])
   118	                .map_err(|e| e.to_string())?;
   119	            }
   120	        }
   121	        tx.commit().map_err(|e| e.to_string())?;
   122	        Ok(())
   123	    }
   124	
   125	    pub fn load_files(&self) -> Vec<crate::search::IndexedFile> {
   126	        let Some(conn) = self.conn.as_ref() else {
   127	            return Vec::new();
   128	        };
   129	        let mut stmt = match conn
   130	            .prepare("SELECT path, name, mtime, size, kind, is_dir FROM files")
   131	        {
   132	            Ok(s) => s,
   133	            Err(_) => return Vec::new(),
   134	        };
   135	        let rows = stmt.query_map([], |r| {
   136	            Ok(crate::search::IndexedFile {
   137	                path: r.get(0)?,
   138	                name: r.get(1)?,
   139	                mtime: r.get::<_, i64>(2)? as u64,
   140	                size: r.get::<_, i64>(3)? as u64,
   141	                kind: r.get(4)?,
   142	                is_dir: r.get::<_, i64>(5)? != 0,
   143	            })
   144	        });
   145	        match rows {
   146	            Ok(iter) => iter.flatten().collect(),
   147	            Err(_) => Vec::new(),
   148	        }
   149	    }
   150	
   151	    pub fn set_meta(&self, k: &str, v: &str) {
   152	        let Some(conn) = self.conn.as_ref() else {
   153	            return;
   154	        };
   155	        let _ = conn.execute(
   156	            "INSERT INTO meta(k, v) VALUES (?1, ?2)
   157	             ON CONFLICT(k) DO UPDATE SET v = ?2",
   158	            params![k, v],
   159	        );
   160	    }
   161	
   162	    pub fn get_meta(&self, k: &str) -> Option<String> {
   163	        let conn = self.conn.as_ref()?;
   164	        conn
   165	            .query_row("SELECT v FROM meta WHERE k = ?1", params![k], |r| r.get(0))
   166	            .ok()
   167	    }
   168	}
   169	
   170	pub fn now_ms() -> u64 {
   171	    SystemTime::now()
   172	        .duration_since(UNIX_EPOCH)
   173	        .map(|d| d.as_millis() as u64)
   174	        .unwrap_or(0)
   175	}
   176	
   177	pub fn mtime_boost(mtime_ms: u64) -> i64 {
   178	    recency_boost(mtime_ms, now_ms())
   179	}
   180	
   181	pub fn recency_boost(then_ms: u64, now: u64) -> i64 {
   182	    if then_ms == 0 || now < then_ms {
   183	        return 0;
   184	    }
   185	    let age = now.saturating_sub(then_ms);
   186	    const HOUR: u64 = 3_600_000;
   187	    const DAY: u64 = 24 * HOUR;
   188	    const WEEK: u64 = 7 * DAY;
   189	    const MONTH: u64 = 30 * DAY;
   190	    if age < HOUR {
   191	        200
   192	    } else if age < DAY {
   193	        100
   194	    } else if age < WEEK {
   195	        40
   196	    } else if age < MONTH {
   197	        15
   198	    } else {
   199	        0
   200	    }
   201	}
   202	
   203	pub fn log2_boost(count: i64) -> i64 {
   204	    if count <= 0 {
   205	        return 0;
   206	    }
   207	    let mut n = count as u64 + 1;
   208	    let mut bits = 0i64;
   209	    while n > 1 {
   210	        n >>= 1;
   211	        bits += 1;
   212	    }
   213	    bits * 80
   214	}
