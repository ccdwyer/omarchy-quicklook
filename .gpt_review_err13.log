   673	        if (event.key === Qt.Key_Escape) {
   674	          root.escapeOut()
   675	          event.accepted = true
   676	        } else if (event.key === Qt.Key_J || event.key === Qt.Key_Down) {
   677	          root.turnPage(1)
   678	          event.accepted = true
   679	        } else if (event.key === Qt.Key_K || event.key === Qt.Key_Up) {
   680	          root.turnPage(-1)
   681	          event.accepted = true
   682	        } else if (event.key === Qt.Key_Space) {
   683	          root.pinToggle()
   684	          event.accepted = true
   685	        } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
   686	          root.openCurrent()
   687	          event.accepted = true
   688	        }
