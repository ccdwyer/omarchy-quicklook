   143	    #[test]
   144	    fn set_budget_evicts_immediately() {
   145	        let dir = env::temp_dir().join(format!("ql-cache-budget-{}", std::process::id()));
   146	        let _ = fs::remove_dir_all(&dir);
   147	        let cache = PreviewCache::new(dir.clone(), 200);
   148	        cache.store_bytes(&["a"], "bin", &[0u8; 80]).unwrap();
   149	        std::thread::sleep(std::time::Duration::from_millis(20));
   150	        cache.store_bytes(&["b"], "bin", &[1u8; 80]).unwrap();
   151	        assert!(cache.bytes_used() > 80);
   152	        cache.set_budget(80);
   153	        assert_eq!(cache.budget(), 80);
   154	        assert!(cache.bytes_used() <= 80);
   155	        let _ = fs::remove_dir_all(&dir);
   156	    }
