   951	
   952	def handle(req: dict) -> dict:
   953	    rid = int(req.get("id") or 0)
   954	    cmd = req.get("cmd") or ("query" if "q" in req else "preview" if "path" in req else "status")
   955	    if cmd == "query":
   956	        hits, backend = search(str(req.get("q") or ""))
   957	        return {"id": rid, "kind": "results", "results": hits, "indexing": False, "progress": 1.0, "backend": backend}
   958	    if cmd in ("preview", "prefetch", "page"):
   959	        return {"id": rid, "kind": "preview", "preview": preview(str(req.get("path") or ""), int(req.get("page") or 1))}
   960	    if cmd == "open":
   961	        r = open_path(str(req.get("path") or ""), False)
   962	        return {"id": rid, "kind": "ok" if r.get("ok") else "error", "error": r.get("error")}
   963	    if cmd == "reveal":
   964	        r = open_path(str(req.get("path") or ""), True)
   965	        return {"id": rid, "kind": "ok" if r.get("ok") else "error", "error": r.get("error")}
   966	    if cmd == "config":
   967	        apply_settings(req, persist=True)
   968	        body = {"id": rid, "kind": "status", "status": status(), "indexing": False, "progress": 1.0, "backend": "compat"}
   969	        return body
   970	    if cmd in ("status", "capabilities", "warmup", "theme", "select"):
   971	        body = {"id": rid, "kind": "status" if cmd in ("status", "capabilities") else "ok"}
   972	        if body["kind"] == "status":
   973	            body["status"] = status()
   974	            body["indexing"] = False
   975	            body["progress"] = 1.0
   976	            body["backend"] = "compat"
   977	        return body
   978	    return {"id": rid, "kind": "error", "error": f"unknown cmd {cmd}"}
   979	
   980	
   981	def main() -> None:
   982	    oneshot = "--oneshot" in sys.argv
   983	    if oneshot:
   984	        payload = ""
   985	        if "--oneshot" in sys.argv:
   986	            i = sys.argv.index("--oneshot")
   987	            if i + 1 < len(sys.argv):
   988	                payload = sys.argv[i + 1]
   989	        if not payload:
   990	            payload = sys.stdin.readline()
   991	        try:
   992	            req = json.loads(payload)
   993	        except json.JSONDecodeError as e:
   994	            print(json.dumps({"id": 0, "kind": "error", "error": str(e)}), flush=True)
   995	            return
   996	        print(json.dumps(handle(req), ensure_ascii=False), flush=True)
   997	        return
   998	    for line in sys.stdin:
   999	        line = line.strip()
  1000	        if not line:
  1001	            continue
  1002	        try:
  1003	            req = json.loads(line)
  1004	        except json.JSONDecodeError as e:
  1005	            print(json.dumps({"id": 0, "kind": "error", "error": str(e)}), flush=True)
  1006	            continue
  1007	        print(json.dumps(handle(req), ensure_ascii=False), flush=True)
