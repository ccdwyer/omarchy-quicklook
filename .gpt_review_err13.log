    30	const SKIP_PATH_PARTS: &[&str] = &[
    31	    "/.ssh/",
    32	    "/.gnupg/",
    33	    "/.password-store/",
    34	    "/.local/share/keyrings/",
    35	    "/.local/share/kwalletd/",
