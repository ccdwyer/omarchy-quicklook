   914	def open_path(path_s: str, reveal: bool = False) -> dict:
   915	    path = Path(path_s)
   916	    if not path.exists():
   917	        return {"ok": False, "error": "missing"}
   918	    target = path if not reveal else (path if path.is_dir() else path.parent)
   919	    opener = shutil.which("gio")
   920	    args = ["open", str(target)] if opener else None
   921	    if opener is None:
   922	        opener = shutil.which("xdg-open") or shutil.which("open")
   923	        args = [str(target)]
   924	    if opener is None:
   925	        return {"ok": False, "error": "no opener"}
   926	    try:
   927	        run_killable([opener, *args], timeout_s=8, limits=False)
   928	    except (subprocess.TimeoutExpired, OSError):
   929	        return {"ok": False, "error": "opener timeout"}
   930	    return {"ok": True}
