   707	pub fn preview_hex(path: &Path) -> Preview {
   708	    let mut buf = vec![0u8; HEX_BYTES];
   709	    let n = fs::File::open(path)
   710	        .and_then(|mut f| f.read(&mut buf))
   711	        .unwrap_or(0);
   712	    buf.truncate(n);
   713	    Preview {
   714	        kind: "hex".into(),
   715	        hex: Some(hex_dump(&buf)),
   716	        magic: Some(magic_of(path, &buf)),
   717	        path: Some(path.to_string_lossy().into()),
   718	        label: Some("can't render this — hex view".into()),
   719	        ..Preview::default()
   720	    }
   721	}
   722	
   723	pub fn hex_dump(bytes: &[u8]) -> String {
   724	    let mut out = String::new();
   725	    for (i, chunk) in bytes.chunks(16).enumerate() {
   726	        out.push_str(&format!("{:08x}  ", i * 16));
   727	        for (j, b) in chunk.iter().enumerate() {
   728	            out.push_str(&format!("{:02x} ", b));
   729	            if j == 7 {
   730	                out.push(' ');
   731	            }
   732	        }
   733	        for _ in chunk.len()..16 {
   734	            out.push_str("   ");
   735	        }
   736	        if chunk.len() <= 8 {
   737	            out.push(' ');
   738	        }
   739	        out.push(' ');
   740	        for b in chunk {
   741	            let c = if b.is_ascii_graphic() || *b == b' ' {
   742	                *b as char
   743	            } else {
   744	                '.'
   745	            };
   746	            out.push(c);
   747	        }
   748	        out.push('\n');
   749	    }
   750	    if out.is_empty() {
   751	        out.push_str("(empty)");
   752	    }
   753	    out
   754	}
   755	
   756	fn usable_cache_file(path: &Path) -> bool {
   757	    fs::metadata(path).map(|m| m.is_file() && m.len() > 0).unwrap_or(false)
   758	}
   759	
   760	fn magic_of(path: &Path, head: &[u8]) -> String {
   761	    if let Some(kind) = infer::get(head) {
   762	        return format!("{} ({})", kind.mime_type(), kind.extension());
   763	    }
   764	    if let Ok(k) = infer::get_from_path(path) {
   765	        if let Some(kind) = k {
   766	            return format!("{} ({})", kind.mime_type(), kind.extension());
   767	        }
   768	    }
   769	    if let Some(file) = which("file") {
   770	        let mut cmd = Command::new(file);
   771	        cmd.args(["-b", "--", &path.to_string_lossy()]);
   772	        if let Ok(out) = run_limited(cmd, Duration::from_millis(800), 32 * 1024 * 1024, 1) {
   773	            let s = String::from_utf8_lossy(&out.stdout).trim().to_string();
   774	            if !s.is_empty() {
   775	                return s;
   776	            }
   777	        }
   778	    }
   779	    "data".into()
   780	}
   781	
   782	pub fn preview_video(path: &Path, cache: &PreviewCache, ffmpeg: bool) -> Preview {
   783	    let meta = fs::metadata(path).ok();
   784	    let size = meta.as_ref().map(|m| m.len()).unwrap_or(0);
   785	    let magic = magic_of(path, &[]);
   786	    if !ffmpeg {
   787	        return Preview {
   788	            kind: "video".into(),
   789	            magic: Some(magic),
   790	            label: Some("video metadata only".into()),
   791	            path: Some(path.to_string_lossy().into()),
   792	            total_size: Some(size),
   793	            ..Preview::default()
   794	        };
   795	    }
   796	    let mtime = meta
   797	        .and_then(|m| m.modified().ok())
   798	        .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
   799	        .map(|d| d.as_millis().to_string())
   800	        .unwrap_or_default();
   801	    let dest = cache.path_for(&[&path.to_string_lossy(), &mtime, "poster"], "png");
   802	    if !usable_cache_file(&dest) {
   803	        if let Some(parent) = dest.parent() {
   804	            let _ = fs::create_dir_all(parent);
   805	        }
   806	        let bin = which("ffmpeg").unwrap_or_else(|| Path::new("ffmpeg").to_path_buf());
   807	        let mut cmd = Command::new(bin);
   808	        cmd.args([
   809	            "-nostdin",
   810	            "-hide_banner",
   811	            "-loglevel",
   812	            "error",
   813	            "-ss",
   814	            "1",
   815	            "-i",
   816	            &path.to_string_lossy(),
   817	            "-frames:v",
   818	            "1",
   819	            "-y",
   820	            &dest.to_string_lossy(),
   821	        ]);
   822	        let _ = run_limited(cmd, Duration::from_secs(6), 512 * 1024 * 1024, 6);
   823	    }
   824	    if usable_cache_file(&dest) {
   825	        cache.gc();
   826	        Preview {
   827	            kind: "image".into(),
   828	            path: Some(dest.to_string_lossy().into()),
   829	            label: Some("video poster".into()),
   830	            magic: Some(magic),
   831	            total_size: Some(size),
   832	            ..Preview::default()
   833	        }
   834	    } else {
   835	        Preview {
   836	            kind: "video".into(),
   837	            magic: Some(magic),
   838	            label: Some("video metadata only".into()),
   839	            path: Some(path.to_string_lossy().into()),
   840	            total_size: Some(size),
   841	            ..Preview::default()
   842	        }
   843	    }
   844	}
   845	
   846	fn read_capped(path: &Path, cap: usize) -> std::io::Result<Vec<u8>> {
   847	    let mut f = fs::File::open(path)?;
   848	    let mut buf = Vec::new();
   849	    let mut tmp = [0u8; 8192];
   850	    while buf.len() < cap {
   851	        let n = f.read(&mut tmp)?;
   852	        if n == 0 {
   853	            break;
   854	        }
   855	        let take = n.min(cap - buf.len());
   856	        buf.extend_from_slice(&tmp[..take]);
   857	    }
   858	    Ok(buf)
   859	}
   860	
   861	fn looks_binary(bytes: &[u8]) -> bool {
   862	    let n = bytes.len().min(800);
   863	    if n == 0 {
   864	        return false;
   865	    }
   866	    let zeros = bytes[..n].iter().filter(|b| **b == 0).count();
   867	    zeros > n / 8
   868	}
