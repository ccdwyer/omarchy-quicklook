   212	def fuzzy(hay: str, needle: str) -> int:
   213	    h = hay.lower()
   214	    n = needle.lower()
   215	    if not n:
   216	        return 1
   217	    if n in h:
   218	        return 800 - h.find(n)
   219	    hi = 0
   220	    score = 0
   221	    for ch in n:
   222	        pos = h.find(ch, hi)
   223	        if pos < 0:
   224	            return 0
   225	        score += 8
   226	        hi = pos + 1
   227	    return score
   228	
