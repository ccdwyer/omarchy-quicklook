    58	  }
    59	  if (typeof value.length === "number") {
    60	    var out = []
    61	    for (var i = 0; i < value.length; i++) {
    62	      var item = String(value[i] || "").trim()
    63	      if (item.length)
    64	        out.push(item)
    65	    }
    66	    return out
    67	  }
    68	  return []
    69	}
