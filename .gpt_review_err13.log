    27	
    28	pub fn ext_of(path: &Path) -> String {
    29	    let name = path
    30	        .file_name()
    31	        .and_then(|s| s.to_str())
    32	        .unwrap_or("")
    33	        .to_ascii_lowercase();
    34	    match name.as_str() {
    35	        "makefile" | "dockerfile" => return name,
    36	        "cmakelists.txt" => return "cmake".into(),
    37	        _ => {}
    38	    }
    39	    path.extension()
    40	        .and_then(|s| s.to_str())
    41	        .map(|s| s.to_ascii_lowercase())
    42	        .unwrap_or_default()
    43	}
    44	
    45	pub fn kind_of(path: &Path, is_dir: bool) -> Kind {
    46	    if is_dir {
    47	        return Kind::Dir;
    48	    }
    49	    match ext_of(path).as_str() {
    50	        "png" | "jpg" | "jpeg" | "webp" | "svg" | "gif" | "bmp" | "ico" | "tif" | "tiff" => {
    51	            Kind::Image
    52	        }
    53	        "pdf" => Kind::Pdf,
    54	        "csv" | "tsv" => Kind::Csv,
    55	        "mp4" | "webm" | "mkv" | "mov" | "avi" | "m4v" => Kind::Video,
    56	        "rs" | "js" | "jsx" | "ts" | "tsx" | "mjs" | "cjs" | "py" | "go" | "c" | "h" | "cc"
    57	        | "cpp" | "hpp" | "hh" | "java" | "kt" | "kts" | "rb" | "php" | "sh" | "bash" | "zsh"
    58	        | "fish" | "lua" | "qml" | "json" | "yaml" | "yml" | "toml" | "md" | "html" | "htm"
    59	        | "css" | "scss" | "xml" | "sql" | "swift" | "cs" | "scala" | "ex" | "exs" | "hs"
    60	        | "elm" | "zig" | "nim" | "r" | "pl" | "pm" | "vim" | "dockerfile" | "makefile"
    61	        | "mk" | "txt" | "conf" | "ini" | "log" | "lock" | "gradle" | "cmake" | "s" | "asm"
    62	        | "proto" | "graphql" | "vue" | "svelte" | "nix" | "tf" | "hcl" => Kind::Code,
    63	        _ => Kind::Hex,
    64	    }
    65	}
    66	
    67	pub fn is_animated(path: &Path) -> bool {
    68	    ext_of(path) == "gif"
    69	}
    70	
    71	pub fn pass_through_image(path: &Path) -> bool {
    72	    matches!(ext_of(path).as_str(), "svg" | "gif")
    73	}
