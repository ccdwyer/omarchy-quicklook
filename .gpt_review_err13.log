   346	    fn do_query(&self, req: &Request) -> Response {
   347	        let q = req.q.clone().unwrap_or_default();
   348	        let samples = self.inner.samples.lock().unwrap().clone();
   349	        let indexed = self.inner.files.lock().unwrap().clone();
   350	        let cfg = self.inner.cfg.lock().unwrap().clone();
   351	        let frecency = self.inner.frecency.lock().unwrap();
   352	        let (hits, backend) = if q.trim().is_empty() {
   353	            let recent_paths = frecency.recent(12);
   354	            let mut recent = Vec::new();
   355	            for p in recent_paths {
   356	                if let Some(f) = indexed.iter().find(|x| x.path == p).cloned() {
   357	                    recent.push(f);
   358	                } else if let Some(f) = search::IndexedFile::from_path(std::path::Path::new(&p)) {
   359	                    recent.push(f);
   360	                }
   361	            }
   362	            let merged = search::merge_unique(samples, recent);
   363	            (search::rank(&merged, "", &frecency, 40), "demo".to_string())
   364	        } else if !indexed.is_empty() && self.inner.progress_cents.load(Ordering::SeqCst) > 0 {
   365	            let backend = if self.inner.indexing.load(Ordering::SeqCst) {
   366	                "index-warming".to_string()
   367	            } else {
   368	                "index".to_string()
   369	            };
   370	            let pool = search::merge_unique(samples, indexed);
   371	            (search::rank(&pool, &q, &frecency, 40), backend)
   372	        } else if let Some(found) = search::plocate(&q, 80, &cfg.extra_exclude, &cfg.roots) {
   373	            let pool = search::merge_unique(samples, found);
   374	            (search::rank(&pool, &q, &frecency, 40), "plocate".to_string())
   375	        } else {
   376	            let walk_cfg = WalkConfig {
   377	                roots: cfg.roots.clone(),
   378	                extra_exclude: cfg.extra_exclude.clone(),
   379	                max_files: 2500,
   380	                max_depth: 8,
   381	            };
   382	            let walked = search::bounded_walk_query(&walk_cfg, &q, 2500);
   383	            let pool = search::merge_unique(samples, walked);
   384	            (search::rank(&pool, &q, &frecency, 40), "walk".to_string())
   385	        };
   386	        *self.inner.backend.lock().unwrap() = backend.clone();
   387	        drop(frecency);
   388	        Response {
   389	            id: req.id,
   390	            kind: "results".into(),
   391	            results: Some(hits),
   392	            preview: None,
   393	            status: None,
   394	            error: None,
   395	            indexing: Some(self.inner.indexing.load(Ordering::SeqCst)),
   396	            progress: Some(self.progress()),
   397	            backend: Some(backend),
   398	        }
   399	    }
