   135	        let cache = PreviewCache::new(dir, 100);
   136	        let a = cache.key(&["/tmp/x", "1", "png"]);
   137	        let b = cache.key(&["/tmp/x", "1", "png"]);
   138	        let c = cache.key(&["/tmp/x", "2", "png"]);
   139	        assert_eq!(a, b);
   140	        assert_ne!(a, c);
