   216	#[cfg(test)]
   217	mod tests {
   218	    use super::*;
   219	    use std::env;
   220	
   221	    #[test]
   222	    fn atime_is_not_used_in_boost() {
   223	        let now = 1_700_000_000_000u64;
   224	        assert_eq!(recency_boost(now - 1_000, now), 200);
   225	        assert_eq!(recency_boost(now - 3_600_000 * 2, now), 100);
   226	        assert_eq!(recency_boost(0, now), 0);
   227	    }
   228	
   229	    #[test]
   230	    fn sqlite_roundtrip_and_boost() {
   231	        let dir = env::temp_dir().join(format!("ql-fre-{}", std::process::id()));
   232	        let _ = std::fs::create_dir_all(&dir);
   233	        let db = dir.join("i.sqlite");
   234	        let _ = std::fs::remove_file(&db);
   235	        let f = Frecency::open(&db);
   236	        f.touch("/tmp/invoice.pdf").unwrap();
   237	        f.touch("/tmp/invoice.pdf").unwrap();
   238	        assert!(f.boost("/tmp/invoice.pdf") > 0);
   239	        assert_eq!(f.boost("/nope"), 0);
   240	        assert_eq!(f.recent(4)[0], "/tmp/invoice.pdf");
   241	        let _ = std::fs::remove_dir_all(&dir);
   242	    }
   243	
   244	    #[test]
   245	    fn unwritable_db_disables_history() {
   246	        let f = Frecency::open(Path::new("/"));
   247	        assert_eq!(f.boost("/tmp/x"), 0);
   248	        assert!(f.touch("/tmp/x").is_ok());
   249	        assert!(f.recent(4).is_empty());
   250	        assert!(f.replace_files(&[]).is_ok());
   251	    }
   252	
   253	    #[test]
   254	    fn log2_grows_slowly() {
   255	        assert_eq!(log2_boost(1), 80);
   256	        assert_eq!(log2_boost(3), 160);
   257	        assert!(log2_boost(1000) < 10000);
   258	    }
   259	}
