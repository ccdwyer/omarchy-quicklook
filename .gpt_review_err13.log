   165	# JSON escape: quotes, newlines, and other C0 controls (same pipeline as json_escape).
   166	esc=$(printf 'a\nb"c\t' | od -An -t u1 -v | awk '
   167	  BEGIN { ORS="" }
   168	  {
   169	    for (i = 1; i <= NF; i++) {
   170	      n = $i + 0
   171	      if (n == 92) printf "\\\\"
   172	      else if (n == 34) printf "\\\""
   173	      else if (n == 10) printf "\\n"
   174	      else if (n == 13) printf "\\r"
   175	      else if (n == 9) printf "\\t"
   176	      else if (n < 32) printf "\\u%04x", n
   177	      else printf "%c", n
   178	    }
   179	  }
   180	')
   181	printf '%s\n' "$esc" | grep -Fq '\n' || { printf 'FAIL json_escape newline: %s\n' "$esc"; exit 1; }
   182	printf '%s\n' "$esc" | grep -Fq '\"' || { printf 'FAIL json_escape quote: %s\n' "$esc"; exit 1; }
   183	printf '%s\n' "$esc" | grep -Fq '\t' || { printf 'FAIL json_escape tab: %s\n' "$esc"; exit 1; }
   184	printf '%s\n' "$esc" | grep -q 'a' || { printf 'FAIL json_escape dropped text: %s\n' "$esc"; exit 1; }
   185	echo "ok  json escape quote/newline/tab"
