    99	  function open(payloadJson) {
   100	    root.opened = true
   101	    root.pinned = false
   102	    root.showInfo = false
   103	    root.pdfPage = 1
   104	    root.directPath = ""
   105	    root.firstRun = !Config.current.firstRunShown
   106	    root.pushTheme()
   107	    var payload = {}
   108	    try {
   109	      payload = payloadJson && String(payloadJson).length ? JSON.parse(payloadJson) : {}
   110	    } catch (e) {
   111	      payload = {}
   112	    }
   113	    if (payload && payload.firstRun)
   114	      root.firstRun = true
   115	    if (payload && payload.path) {
   116	      root.directPath = String(payload.path)
   117	      root.queryText = Format.basename(root.directPath)
   118	      searchField.text = root.queryText
   119	      root.results = [{
   120	        path: root.directPath,
   121	        name: Format.basename(root.directPath),
   122	        kind: Format.kindOf(root.directPath, false),
   123	        score: 1000,
   124	        mtime: 0,
   125	        size: 0
   126	      }]
   127	      root.selectedIndex = 0
   128	      root.requestPreview(root.directPath, 1)
   129	    } else if (payload && payload.q) {
   130	      root.queryText = String(payload.q)
   131	      searchField.text = root.queryText
   132	      debounce.restart()
   133	    } else {
   134	      root.queryText = ""
   135	      searchField.text = ""
   136	      root.requestQuery("")
   137	    }
   138	    Qt.callLater(function() { searchField.forceActiveFocus() })
   139	    bindCheck.running = true
   140	  }
   141	
   142	  function close() {
   143	    root.opened = false
   144	    root.pinned = false
   145	  }
   146	
   147	  function toggle() {
   148	    if (root.opened)
   149	      root.close()
   150	    else
   151	      root.open("{}")
   152	  }
   153	
   154	  function callIpc(method, arg) {
   155	    var job = { method: String(method || ""), arg: arg === undefined || arg === null ? "" : String(arg) }
   156	    if (job.method === "snapshot") {
   157	      var kept = []
   158	      for (var i = 0; i < root.ipcQueue.length; i++) {
   159	        if (root.ipcQueue[i].method !== "snapshot")
   160	          kept.push(root.ipcQueue[i])
   161	      }
   162	      root.ipcQueue = kept
   163	    }
   164	    root.ipcQueue.push(job)
   165	    root.runIpc()
   166	  }
   167	
   168	  function runIpc() {
   169	    if (ipcProc.running || root.ipcCurrent)
   170	      return
   171	    if (!root.ipcQueue.length)
   172	      return
   173	    var next = null
   174	    var rest = []
   175	    var snap = null
   176	    for (var i = 0; i < root.ipcQueue.length; i++) {
   177	      var job = root.ipcQueue[i]
   178	      if (job.method === "snapshot")
   179	        snap = job
   180	      else if (!next)
   181	        next = job
   182	      else
   183	        rest.push(job)
   184	    }
   185	    if (!next)
   186	      next = snap
   187	    else if (snap)
   188	      rest.push(snap)
   189	    root.ipcQueue = rest
   190	    root.ipcCurrent = next
   191	    ipcProc.command = ["omarchy-shell", "shell", "call", root.pluginId, next.method, next.arg]
   192	    ipcProc.running = true
   193	  }
   194	
   195	  function applySnapshot(raw) {
   196	    var snap = null
   197	    try {
   198	      snap = JSON.parse(String(raw || ""))
   199	    } catch (e) {
   200	      return
   201	    }
   202	    if (!snap || typeof snap !== "object")
   203	      return
   204	    if (snap.backend)
   205	      root.backend = String(snap.backend)
   206	    if (snap.indexing !== undefined)
   207	      root.indexing = !!snap.indexing
   208	    if (snap.indexProgress !== undefined)
   209	      root.indexProgress = Number(snap.indexProgress) || 0
   210	    if (snap.lastCaps)
   211	      root.lastCaps = snap.lastCaps
   212	    if (snap.helperCmd)
   213	      root.helperLabel = String(snap.helperCmd)
   214	    if (snap.resultsRevision !== root.lastQueryRev) {
   215	      root.lastQueryRev = Number(snap.resultsRevision) || 0
   216	      var list = snap.results || []
   217	      root.results = list
   218	      if (!list.length) {
   219	        if (root.queryText.length)
   220	          root.setEmpty("no matches", "The index will keep warming; try a shorter query.")
   221	        else
   222	          root.setEmpty("no matches", "")
   223	      } else {
   224	        root.emptyReason = ""
   225	        if (root.selectedIndex >= list.length)
   226	          root.selectedIndex = 0
   227	        var hit = list[root.selectedIndex] || list[0]
   228	        if (hit)
   229	          root.requestPreview(hit.path, 1)
   230	        var top = list[0]
   231	        if (top && hit && top.path !== hit.path)
   232	          root.requestPrefetch(top.path)
   233	      }
   234	    }
   235	    if (snap.previewRevision !== root.lastPreviewRev) {
   236	      root.lastPreviewRev = Number(snap.previewRevision) || 0
   237	      root.preview = snap.preview || {}
   238	      root.previewLoading = false
   239	      if (root.preview && root.preview.page)
   240	        root.pdfPage = Number(root.preview.page) || 1
   241	    }
   242	  }
   243	
   244	  function pushTheme() {
   245	    root.callIpc("theme", JSON.stringify(root.palette))
   246	  }
   247	
   248	  function requestQuery(q) {
   249	    root.callIpc("query", q)
