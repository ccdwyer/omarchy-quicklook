   260	fn decode_for_downsample(path: &Path) -> Result<image::DynamicImage, String> {
   261	    let reader = image::ImageReader::open(path).map_err(|e| e.to_string())?;
   262	    let mut reader = reader.with_guessed_format().map_err(|e| e.to_string())?;
   263	    let mut limits = image::Limits::default();
   264	    limits.max_image_width = Some(100_000);
   265	    limits.max_image_height = Some(100_000);
   266	    limits.max_alloc = Some(400 * 1024 * 1024);
   267	    reader.limits(limits);
   268	    reader.decode().map_err(|e| e.to_string())
   269	}
