     1	use quicklookd::{AppConfig, Engine};
     2	use std::io::{self, BufRead, Write};
     3	
     4	fn main() {
     5	    let args: Vec<String> = std::env::args().skip(1).collect();
     6	    if let Some(i) = args.iter().position(|a| a == "--downsample") {
     7	        let src = args.get(i + 1).map(std::path::PathBuf::from);
     8	        let dest = args.get(i + 2).map(std::path::PathBuf::from);
     9	        let nw: u32 = args.get(i + 3).and_then(|s| s.parse().ok()).unwrap_or(1);
    10	        let nh: u32 = args.get(i + 4).and_then(|s| s.parse().ok()).unwrap_or(1);
    11	        let rc = match (src, dest) {
    12	            (Some(s), Some(d)) => quicklookd::preview::downsample_cli(&s, &d, nw, nh),
    13	            _ => 1,
    14	        };
    15	        std::process::exit(rc);
    16	    }
    17	    let oneshot = args.iter().any(|a| a == "--oneshot");
    18	    let cfg = AppConfig::from_env_and_args(&args);
    19	    let engine = Engine::new(cfg);
    20	    // Indexing starts on `config` / `warmup` so inline shell.json roots
    21	    // win the first walk. Oneshot queries use plocate / a bounded walk.
    22	
    23	    if oneshot {
    24	        let payload = oneshot_payload(&args);
    25	        let out = engine.handle_line(&payload);
    26	        println!("{out}");
    27	        return;
    28	    }
    29	
    30	    let stdin = io::stdin();
    31	    let mut stdout = io::stdout();
    32	    for line in stdin.lock().lines() {
    33	        let line = match line {
    34	            Ok(l) => l,
    35	            Err(_) => break,
    36	        };
    37	        if line.trim().is_empty() {
    38	            continue;
    39	        }
    40	        if line.trim() == r#"{"cmd":"quit"}"# {
    41	            break;
    42	        }
    43	        let out = engine.handle_line(&line);
    44	        if writeln!(stdout, "{out}").is_err() {
    45	            break;
    46	        }
    47	        let _ = stdout.flush();
    48	    }
    49	}
    50	
    51	fn oneshot_payload(args: &[String]) -> String {
    52	    let mut saw = false;
    53	    for a in args {
    54	        if saw {
    55	            return a.clone();
    56	        }
    57	        if a == "--oneshot" {
    58	            saw = true;
    59	        }
    60	    }
    61	    let mut s = String::new();
    62	    let _ = io::stdin().read_line(&mut s);
    63	    s
    64	}
