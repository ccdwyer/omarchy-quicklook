   846	def preview(path_s: str, page: int = 1) -> dict:
   847	    path = Path(path_s)
   848	    if not path.exists():
   849	        return {"kind": "hex", "magic": "missing", "label": "can't render this — hex view"}
   850	    if path.is_dir():
   851	        entries = []
   852	        total = 0
   853	        try:
   854	            kids = []
   855	            for i, kid in enumerate(path.iterdir()):
   856	                if i >= 200:
   857	                    break
   858	                kids.append(kid)
   859	            kids.sort(key=lambda p: p.name)
   860	        except OSError:
   861	            kids = []
   862	        for kid in kids:
   863	            try:
   864	                st = kid.stat()
   865	                total += st.st_size if kid.is_file() else 0
   866	                entries.append({"name": kid.name, "kind": kind_of(kid, kid.is_dir()), "size": st.st_size})
   867	            except OSError:
   868	                continue
   869	        return {"kind": "dir", "entries": entries, "total_size": total, "path": str(path)}
   870	    k = kind_of(path)
   871	    if k == "image":
   872	        return preview_image(path)
   873	    if k == "code":
   874	        data = read_capped(path, 200 * 1024)
   875	        try:
   876	            large = path.stat().st_size > 200 * 1024
   877	        except OSError:
   878	            large = False
   879	        text = data.decode("utf-8", errors="replace")
   880	        html = "<pre>" + (
   881	            text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
   882	        ) + "</pre>"
   883	        return {"kind": "code", "html": html, "lang": path.suffix.lstrip("."), "large": large,
   884	                "capped": large, "label": "large file" if large else "", "path": str(path)}
   885	    if k == "csv":
   886	        text = read_capped(path, 1024 * 1024).decode("utf-8", errors="replace")
   887	        first = text.split("\n", 1)[0]
   888	        delim = ","
   889	        if first.count("\t") > first.count(","):
   890	            delim = "\t"
   891	        elif first.count(";") > first.count(","):
   892	            delim = ";"
   893	        elif first.count("|") > first.count(","):
   894	            delim = "|"
   895	        lines = text.splitlines()
   896	        rows = [ln.split(delim) for ln in lines[:501]]
   897	        headers = rows[0] if rows else []
   898	        body = rows[1:501] if rows else []
   899	        try:
   900	            oversized = path.stat().st_size > 1024 * 1024
   901	        except OSError:
   902	            oversized = False
   903	        return {
   904	            "kind": "csv",
   905	            "headers": headers,
   906	            "rows": body,
   907	            "truncated": len(lines) > 501 or oversized,
   908	        }
   909	    if k == "pdf":
   910	        return preview_pdf(path, page)
   911	    return hex_preview(path, "data", "can't render this — hex view")
   912	
