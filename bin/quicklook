#!/bin/sh
# File-manager / terminal bridge: summon QuickLook on a path, or toggle the finder.
set -eu
id="io.github.chris.quicklook"
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  printf '%s\n' "usage: quicklook [path]" "  no args  toggle the finder overlay" "  path     summon a preview of that file"
  exit 0
fi
if [ -n "${1:-}" ]; then
  path=$1
  case "$path" in
    /*) ;;
    *) path=$(pwd)/$path ;;
  esac
  esc=$(printf '%s' "$path" | od -An -t u1 -v | awk '
    BEGIN { ORS="" }
    {
      for (i = 1; i <= NF; i++) {
        n = $i + 0
        if (n == 92) printf "\\\\"
        else if (n == 34) printf "\\\""
        else if (n == 10) printf "\\n"
        else if (n == 13) printf "\\r"
        else if (n == 9) printf "\\t"
        else if (n < 32) printf "\\u%04x", n
        else printf "%c", n
      }
    }
  ')
  exec omarchy-shell shell summon "$id" "{\"path\":\"$esc\"}"
fi
exec omarchy-shell shell toggle "$id" '{}'
